{
  "viewSetting": {
    "html": "<table width='100%' border='0' cellpadding='5' cellspacing='0' styles='editTable' style='table-layout:fixed;'></table>"
  },
  "headSetting": {
    "html": "<tr styles='viewHeadNode'></tr>"
  },
  "documentSetting": {
    "html": "<tr styles='documentNode'></tr>",
    "mouseoverStyles": "documentNode_over",
    "mousedownStyles": "documentNode_down",
    "holdMouseDownStyles" : true,
    //    "action": "open"
  },
  "items": [
    {
      "name": "$checkbox",
      "head": {
        "html": "<th styles='normalThNode'></th>",
        "width": "30"
      },
      "content": {
        "html": "<td styles='normalTdNode'></td>"
      }
    },
    {
      "name": "title",
      "head": {
        "html": "<th styles='normalThNode' lable='name'></th>",
        "width": ""
      },
      "content": {
        "html": "<td styles='normalTdNode' width='58%' item='name'></td>",
        "items": {
          "name": {
            "action" : "open"

          }
        }
      }
    },
    {
      "name": "creator",
      "head": {
        "html": "<th styles='normalThNode' lable='creator'></th>",
        "width": ""
      },
      "content": {
        "html": "<td styles='normalTdNode' item='creator'></td>",
        "items": {
          "creator": {"value" : "function(d){ return d.creator.split('@')[0] }"}
        }
      }
    },
    {
      "name": "version",
      "head": {
        "html": "<th styles='normalThNode' lable='version'></th>",
        "width": ""
      },
      "content": {
        "html": "<td styles='normalTdNode' item='version'></td>",
        "items": { "version" : {} }
      }
    },
    {
      "name": "length",
      "head": {
        "html": "<th styles='normalThNode' lable='length'></th>",
        "width": ""
      },
      "content": {
        "html": "<td styles='normalTdNode' item='length'></td>",
        "items": { "length" : {} }
      }
    },
    {
      "name": "id",
      "head": {
        "html": "<th styles='normalThNode' lable='id'></th>",
        "width": ""
      },
      "content": {
        "html": "<td styles='normalTdNode' item='id'></td>",
        "items": { "id" : {} }
      }
    },
    {
      "name": "createTime",
      "head": {
        "html": "<th styles='normalThNode' lable='createTime'></th>",
        "width": ""
      },
      "content": {
        "html": "<td styles='normalTdNode' item='createTime'></td>",
        "items": { "createTime" : {} }
      }
    },
    {
      "name": "actionList",
      "head": {
        "html": "<th styles='normalThNode' lable='data_op'></th>",
        "width": "130"
      },
      "content": {
        "html": "<td styles='normalTdNode'><div styles='editAction' item='editAction'></div><div styles='renameAction' item='renameAction'></div><div styles='removeAction' item='removeAction'></div><div styles='downloadAction' item='downloadAction'></div></td>",
        "items": {
          "editAction": {
            "title": "editAction",
            "action": "edit",
            "styles" : "opinionAction",
            "mouseoverStyles": "opinionAction_over"
          },
          "renameAction": {
            "title": "rename",
            "action": "rename",
            "styles" : "flowAction",
            "mouseoverStyles": "flowAction_over"
          },
          "removeAction": {
            "title": "remove",
            "action": "remove",
            "styles" : "removeAction",
            "mouseoverStyles": "removeAction_over"
          },
          "downloadAction": {
            "title": "download",
            "action": "download",
            "styles" : "downloadAction",
            "mouseoverStyles": "downloadeAction_over"
          }
        }
      }
    }
  ]
}
