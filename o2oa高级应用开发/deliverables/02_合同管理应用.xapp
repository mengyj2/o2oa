        {
          "id": "q2002004-receive-full-join-000000001",
          "name": "合同收款全量",
          "alias": "合同收款全量",
          "description": "收款单带合同与计划三表联查，expense_no 向财务推送",
          "query": "a2002001-contract-dataapp-00000000000001",
          "creatorPerson": "xadmin",
          "lastUpdatePerson": "xadmin",
