 transition: opacity 0.3s;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.ooicon-create:hover {\\\\r\\\\n    opacity: 0.8;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 自定义布局样式 *************************/\\\\r\\\\n.page-custom-layout {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 60em;\\\\r\\\\n    right: -60em;\\\\r\\\\n    padding: 2em;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n.page-custom-layout-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 30em;\\\\r\\\\n    right: -30em;\\\\r\\\\n    padding: 2em 0;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.page-custom-widget-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n.page-custom-title {\\\\r\\\\n    display: flex;\\\\r\\\\n    font-size: 1.125rem;\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: space-between;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close:hover {\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-description {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-area {\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n    position: relative;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category {\\\\r\\\\n    /* border-left: 0.25rem solid var(--oo-color-main); */\\\\r\\\\n    background-color: var(--oo-color-bg-white);\\\\r\\\\n    padding: 1em 0;\\\\r\\\\n    gap: 0.5em;\\\\r\\\\n    display: flex;\\\\r\\\\n    align-items: center;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:first-child {\\\\r\\\\n    font-size: 1.125em;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:last-child {\\\\r\\\\n    transform: rotate(90deg);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item {\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n.add-widget-item:hover .title {\\\\r\\\\n    color: var(--oo-color-main);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .title {\\\\r\\\\n    color: var(--oo-color-text1);\\\\r\\\\n    text-align: center;\\\\r\\\\n    line-height: 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .big-title {\\\\r\\\\n    color: var(--oo-color-text1);\\\\r\\\\n    text-align: center;\\\\r\\\\n    line-height: 2em;\\\\r\\\\n    font-size: 1.125em;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .preview {\\\\r\\\\n    background: #F7F7F7;\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    text-align: center;\\\\r\\\\n    padding: 0.5em;\\\\r\\\\n    justify-content: center;\\\\r\\\\n    position: relative;\\\\r\\\\n}\\\\r\\\\n.add-widget-item .preview:hover {\\\\r\\\\n    box-shadow: 0 0 1px 2px var(--oo-color-main);\\\\r\\\\n}\\\\r\\\\n.add-widget-item .preview div {\\\\r\\\\n    position: absolute;\\\\r\\\\n    top: 1em;\\\\r\\\\n    right: 1em;\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n.add-widget-item .preview:hover div {\\\\r\\\\n    color: var(--oo-color-main);\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .preview\u003eimg {\\\\r\\\\n    width: 18em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .description {\\\\r\\\\n    padding: 0.5em;\\\\r\\\\n    font-size: 0.875em;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-area{\\\\r\\\\n    display: flex;\\\\r\\\\n    gap: 1em;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-area .preview{\\\\r\\\\n    flex: 2;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-content{\\\\r\\\\n    flex: 3;\\\\r\\\\n    background: #F7F7F7;\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    display: flex;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    padding: 1em;\\\\r\\\\n    position: relative;\\\\r\\\\n    flex-wrap: wrap;\\\\r\\\\n    align-content: flex-start;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-tab{\\\\r\\\\n    display: flex;\\\\r\\\\n    flex: 100%;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-tab-title{\\\\r\\\\n    padding: 0.5em 0.35em;\\\\r\\\\n    margin-right: 0.5em;\\\\r\\\\n    height: 100%;\\\\r\\\\n    display: flex;\\\\r\\\\n    align-items: center;\\\\r\\\\n    min-width: 4.4em;\\\\r\\\\n    max-width: 4.4em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-tab-content{\\\\r\\\\n    border: 1px solid #dedede;\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    border-radius: 4px;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-tab-content td, .add-widget-par-tab-content th{\\\\r\\\\n    border-bottom: 1px solid #dedede;\\\\r\\\\n    text-align: center;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-tab-content th{\\\\r\\\\n    background-color: #f7f7f7;\\\\r\\\\n    padding: 0.3em;\\\\r\\\\n}\\\\r\\\\n\\\"},\\\"pageStyleType\\\":\\\"blue-simple\\\",\\\"pid\\\":\\\"Mobileafe3bfb5-a270-4eef-9d30-cc8c641eb9d3afe3bfb5-a270-4eef-9d30-cc8c641eb9d3\\\",\\\"languageType\\\":\\\"none\\\",\\\"languageScript\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"widgetList\\\":[],\\\"formStyleType\\\":\\\"v10\\\",\\\"cssLink\\\":\\\"../x_component_process_FormDesigner/Module/Form/skin/styles_v10.css\\\",\\\"styleConfig\\\":{\\\"name\\\":\\\"v10\\\",\\\"file\\\":\\\"styles_v10.json\\\",\\\"extendFile\\\":\\\"styles_v10_extend.json\\\",\\\"mode\\\":[\\\"pc\\\",\\\"mobile\\\"]},\\\"validationOpinion\\\":{},\\\"validationRoute\\\":{},\\\"validationFormCustom\\\":{},\\\"textareaDisableResize\\\":true,\\\"confirmStyle\\\":\\\"v10_confirm\\\",\\\"dialogStyle\\\":\\\"v10\\\",\\\"nodeStyleWithhideModuleIcon\\\":{\\\"margin-right\\\":\\\"0px\\\"},\\\"confirmIcon\\\":{\\\"success\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/ok.png\\\",\\\"error\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/error.png\\\",\\\"info\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/info.png\\\",\\\"warn\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/notice.png\\\"},\\\"buttonStyle\\\":{\\\"color\\\":\\\"#777\\\",\\\"border-radius\\\":\\\"4px\\\",\\\"border\\\":\\\"1px solid #DCDFE6\\\",\\\"cursor\\\":\\\"pointer\\\",\\\"height\\\":\\\"36px\\\",\\\"line-height\\\":\\\"36px\\\",\\\"padding\\\":\\\"0px 15px\\\",\\\"background-color\\\":\\\"#f4f7f6\\\"},\\\"errorStyle\\\":{\\\"node\\\":{\\\"background\\\":\\\"url(../x_component_process_FormDesigner/Module/Form/notice/icon/error_v10.png) no-repeat 0px center\\\",\\\"color\\\":\\\"var(--oo-color-error)\\\",\\\"min-height\\\":\\\"30px\\\",\\\"padding-left\\\":\\\"20px\\\",\\\"padding-right\\\":\\\"30px\\\",\\\"line-height\\\":\\\"30px\\\",\\\"background-color\\\":\\\"initial\\\",\\\"border\\\":\\\"none\\\",\\\"border-radius\\\":\\\"\\\",\\\"position\\\":\\\"relative\\\",\\\"display\\\":\\\"flex\\\"},\\\"close\\\":\\\"\\\"},\\\"includeScripts\\\":[{\\\"appType\\\":\\\"portal\\\",\\\"type\\\":\\\"script\\\",\\\"name\\\":\\\"widget.js\\\",\\\"alias\\\":\\\"widget.js\\\",\\\"id\\\":\\\"f652b393-093e-4318-b19d-51bd55245eb2\\\",\\\"appName\\\":\\\"主页\\\",\\\"appId\\\":\\\"62cc80f7-2b9c-48ea-a023-0312e65459bf\\\"},{\\\"appType\\\":\\\"portal\\\",\\\"type\\\":\\\"script\\\",\\\"name\\\":\\\"start_process.js\\\",\\\"alias\\\":\\\"start_process.js\\\",\\\"id\\\":\\\"5bf04d8a-4f33-4972-b18d-33742f6444ea\\\",\\\"appName\\\":\\\"主页\\\",\\\"appId\\\":\\\"62cc80f7-2b9c-48ea-a023-0312e65459bf\\\"},{\\\"appType\\\":\\\"portal\\\",\\\"type\\\":\\\"script\\\",\\\"name\\\":\\\"widget_task.js\\\",\\\"alias\\\":\\\"widget_task.js\\\",\\\"id\\\":\\\"773b6d24-db85-44d7-ace0-5d7c507ddf3e\\\",\\\"appName\\\":\\\"主页\\\",\\\"appId\\\":\\\"62cc80f7-2b9c-48ea-a023-0312e65459bf\\\"},{\\\"appType\\\":\\\"portal\\\",\\\"type\\\":\\\"script\\\",\\\"name\\\":\\\"document.js\\\",\\\"alias\\\":\\\"document.js\\\",\\\"id\\\":\\\"ff28dc30-268b-453c-bff6-157524a5cae7\\\",\\\"appName\\\":\\\"公文管理\\\",\\\"appId\\\":\\\"20b2bbc0-60c2-4213-a93e-b202850aaf71\\\"}],\\\"alias\\\":\\\"\\\",\\\"cssUrl\\\":\\\"../x_portal_assemble_surface/jaxrs/file/6bcdc4e2-0172-4b67-8317-6830c0682a0f/portal/441f59d9-ebda-49f6-a3b8-2a7992825738/content\\\",\\\"flowStyle\\\":\\\"v10\\\",\\\"selectorStyle\\\":{\\\"style\\\":\\\"v10\\\",\\\"tabStyle\\\":\\\"v10\\\"},\\\"appType\\\":\\\"portal.PageDesigner\\\"},\\\"html\\\":\\\"\u003cdiv mwftype\u003d\\\\\\\"form\\\\\\\" id\u003d\\\\\\\"afe3bfb5-a270-4eef-9d30-cc8c641eb9d3_undefined\\\\\\\" class\u003d\\\\\\\"form-layout\\\\\\\" style\u003d\\\\\\\"\\\\\\\" nodragging\u003d\\\\\\\"true\\\\\\\" no-dragging\u003d\\\\\\\"true\\\\\\\" data-no-dragging\u003d\\\\\\\"true\\\\\\\"\u003e\u003c/div\u003e\\\",\\\"id\\\":\\\"\\\",\\\"isNewPage\\\":false,\\\"applicationName\\\":\\\"合同管理\\\"}",
          "hasMobile": false,
          "properties": {
            "relatedWidgetList": [
              "5589eadd-a9ee-4057-ab6c-ded716d88379"
            ],
            "mobileRelatedWidgetList": [],
            "relatedScriptMap": {
