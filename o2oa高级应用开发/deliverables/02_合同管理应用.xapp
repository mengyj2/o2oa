uttonaction\u003d\\\\\\\"monitor\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程监控\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 1px solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: none;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-work-management\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e流程监控\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div\\\\\\\" style\u003d\\\\\\\"height: 100%; overflow: auto; position: relative; padding: 2em 0px 3em;\\\\\\\" class\u003d\\\\\\\"form-content\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_12\\\\\\\" style\u003d\\\\\\\"width: 80%; margin: auto; min-width: 42em; display: flex; flex-direction: column; gap: 2em;\\\\\\\" class\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_2\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-title\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label\\\\\\\" style\u003d\\\\\\\"font-weight: normal; color: var(--oo-color-main-deep); text-align: center; font-size: 2.25em; padding: 0.3em;\\\\\\\" class\u003d\\\\\\\"form-title-text\\\\\\\"\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_1\\\\\\\" style\u003d\\\\\\\"text-align: center;\\\\\\\"\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_7\\