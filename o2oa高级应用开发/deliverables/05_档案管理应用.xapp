l\u003d\\\\\\\"标　　题\\\\\\\" requir\u003d\\\\\\\"\\\\\\\" type\u003d\\\\\\\"text\\\\\\\" right-icon\u003d\\\\\\\"edit\\\\\\\" required\u003d\\\\\\\"true\\\\\\\"\u003e\u003c/oo-input\u003e\u003coo-input mwftype\u003d\\\\\\\"OOInput\\\\\\\" id\u003d\\\\\\\"document\\\\\\\" placeholder\u003d\\\\\\\"document\\\\\\\" style\u003d\\\\\\\"\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\" disabled\u003d\\\\\\\"false\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" label\u003d\\\\\\\"借阅文件\\\\\\\" requir\u003d\\\\\\\"\\\\\\\" type\u003d\\\\\\\"text\\\\\\\" right-icon\u003d\\\\\\\"edit\\\\\\\" required\u003d\\\\\\\"true\\\\\\\"\u003e\u003c/oo-input\u003e\u003cdiv mwftype\u003d\\\\\\\"button\\\\\\\" id\u003d\\\\\\\"viewSelector\\\\\\\" style\u003d\\\\\\\"border-radius: 5px; border-width: 1px; border-style: solid; border-color: rgb(153, 153, 153) rgb(51, 51, 51) rgb(51, 51, 51) rgb(153, 153, 153); overflow: hidden; cursor: pointer; margin: 3px; user-select: none; position: static; top: auto; left: auto; opacity: 1; height: 26px; display: inline-block;\\\\\\\" class\u003d\\\\\\\"form-content-view-selector\\\\\\\"\u003e\u003cbutton style\u003d\\\\\\\"\\\\\\\"\u003e选择文件\u003c/button\u003e\u003c/div\u003e\u003coo-datetime mwftype\u003d\\\\\\\"OODatetime\\\\\\\" id\u003d\\\\\\\"returnDate\\\\\\\" placeholder\u003d\\\\\\\"returnDate\\\\\\\" read\u003d\\\\\\\"true\\\\\\\" right-icon\u003d\\\\\\\"calendar\\\\\\\" style\u003d\\\\\\\"\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" label\u003d\\\\\\\"归还日期\\\\\\\" required\u003d\\\\\\\"true\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\"\u003e\u003cdiv style\u003d\\\\\\\"background: url(\u0026quot;../x_component_process_FormDesigner/Module/Textfield/default/icon/inputtext.png\u0026quot;) center center no-repeat; width: 18px; height: 18px; float: right;\\\\\\\"\u003e\u003c/div\u003e\u003cdiv style\u003d\\\\\\\"white-space: nowrap; margin-right: 18px; overflow: hidden; margin-left: 2px; line-height: 18px; color: rgb(102, 102, 102); font-family: Verdana, Geneva, s