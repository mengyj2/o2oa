          "data": "SELECT o FROM Task o where o.person\u003d:person and ( o.applicationName \u003d \u0027发文管理\u0027 or o.applicationName \u003d \u0027收文管理\u0027 or o.applicationName \u003d \u0027会议既要类\u0027) order by o.startTime desc",
          "scriptText": "var paramObj \u003d  parameters;\nvar sql \u003d \"SELECT o FROM Task o where o.person\u003d:person \";\n\nsql \u003d sql + \" and (o.processName \u003d \u0027档案借阅\u0027)\"\n\n\nif(paramObj.startTime){\n    sql \u003d sql + \" AND o.startTime \u003e\u003d :startTime \"\n}\nif(paramObj.endTime){\n    sql \u003d sql + \" AND o.startTime \u003c\u003d :endTime \"\n}\nif(paramObj.title){\n    sql \u003d sql + \" AND o.title like :title \"\n}\nsql \u003d sql + \" order by o.startTime desc\"\nreturn sql",
          "countData": "SELECT count(o.id) FROM Task o where o.person\u003d:person and ( o.applicationName \u003d \u0027发文管理\u0027 or o.applicationName \u003d \u0027收文管理\u0027 or o.applicationName \u003d \u0027会议既要类\u0027)",
          "countScriptText": "var paramObj \u003d  parameters;\nvar sql \u003d \"SELECT count(o.id) FROM Task o where o.person\u003d:person \";\n\nsql \u003d sql + \" and (o.processName \u003d \u0027档案借阅\u0027)\"\n\nif(paramObj.startTime){\n    sql \u003d sql + \" AND o.startTime \u003e\u003d :startTime \"\n}\nif(paramObj.endTime){\n    sql \u003d sql + \" AND o.startTime \u003c\u003d :endTime \"\n}\nif(paramObj.title){\n    sql \u003d sql + \" AND o.title like :title \"\n}\nreturn sql",
