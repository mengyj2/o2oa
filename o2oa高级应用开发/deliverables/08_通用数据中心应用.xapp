        {
          "id": "2e16b0e8-ec4f-4079-a3f6-55046a833e68",
          "name": "view.html",
          "alias": "",
          "description": "",
          "validated": false,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003ctable class\u003d\"layout_table\"\u003e\n    \u003cthead class\u003d\"table_thead\" data-o2-element\u003d\"thead\"\u003e\n        \u003ctr\u003e\n            {{each $.data.fields}}\n            \u003ctd\u003e\n                \u003cdiv class\u003d\"table_th\"\u003e\n                    \u003cspan\u003e{{$.displayName}}\u003c/span\u003e\n                \u003c/div\u003e\n            \u003c/td\u003e\n            {{end each}}\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody class\u003d\"table_body\" data-o2-element\u003d\"tbody\"\u003e\n        {{each $.data.data}}\n        \u003ctr title\u003d\"双击打开\" data-o2-events\u003d\"dblclick:viewOpenRow:{{$.bundle}};\"\u003e\n            {{each $.fields}}\n            \u003ctd\u003e{{\n                (function(){ \n                    var key \u003d $.column;\n                    var value \u003d $._.data[key]; \n\n                    return value\n                })()\n            }}\u003c/td\u003e\n            {{end each}}\n        \u003c/tr\u003e\n        {{end each}}\n    \u003c/tbody\u003e\n\n\u003c/table\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
