        {
          "id": "d189eb26-6354-45a5-80f7-011d17c2bfa6",
          "name": "通用-所有工作",
          "alias": "common-allWork",
          "format": "script",
          "description": "流转中和已完成工作（我参与的所有工作）",
          "query": "685fefa0-7366-4cce-8071-3f9a1ef645a0",
          "fv": 8.0,
