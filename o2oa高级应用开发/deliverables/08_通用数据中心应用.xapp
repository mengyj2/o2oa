          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "31ca3c4c-bb7f-4aa6-8bb1-739d09de19cc",
          "name": "TableClass",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "var _this \u003d this;\nvar TableClass \u003d new Class({\n    Implements: [Events, Options],\n    options: {\n        id:\"xxxxxx\", //数据表id\n    },\n    initialize: function (options) {\n        this.setOptions(options);\n        this.id \u003d this.options.id; \n        this.page \u003d 1;\n        this.firstResult \u003d 0;\n        this.totalPage \u003d 1;\n        this.where \u003d \u00271 \u003d 1\u0027;\n        this.order \u003d \"updateTime\";\n        this.sort \u003d \"desc\"\n        this.size \u003d 20;\n        this.load();\n    },\n    load:function(){ \n        _self.form.get(\u0027statement\u0027).node.getElement(\u0027input\u0027).set(\u0027placeholder\u0027,\"where 条件查询，格式为jpql语法:o.name\u003d\u0027zhangsan\u0027 order by o.createtime desc\");\n        _self.form.get(\"statement\").setData(\"\");\n        this.firstRow \u003d 1;\n        \n        this.loadTableInfor();\n        this.loadTable();\n    },\n    reload:function(keep){ \n        if(keep){\n            const statement \u003d _self.form.get(\"statement\").getData();\n            if(statement !\u003d \"\"){\n                this.search(statement)\n            }else{\n                this.loadTable()\n            }\n        }else{\n            _self.form.get(\"statement\").setData(\"\");\n            this.firstResult \u003d 0;\n            this.page \u003d 1;\n            \n            this.where \u003d \u00271 \u003d 1\u0027\n            this.order \u003d \"updateTime\";\n            this.sort \u003d \"desc\"\n            this.loadTable();\n        }\n        \n    },\n    loadTableInfor:function(){\n        Table.actions_query.get(this.id,function(json){ \n            var fields \u003d new Array();\n            var str \u003d json.data.data;\n            var obj \u003d JSON.parse(str); \n            this.tableFields \u003d obj.fieldList; \n            this.name \u003d json.data.name;\n            \n            var node \u003d _self.form.get(\u0027layout_infor\u0027).node;\n            node.loadHtmlDomDB({\"view\":\"tableInfor.html\",data:json.data,\u0027module\u0027:_this})\n            \n        }.bind(this),null,false);\n    },\n    \n    loadPagination:function(){\n        var node \u003d _self.form.get(\u0027layout_pagination\u0027).node;\n        var data \u003d {\n            \"page\":this.page,\n            \"size\":this.size,\n            \"total\":this.total,\n            \"totalPage\":this.totalPage\n        }\n        node.loadHtmlDomDB({\"view\":\u0027tablePagination.html\u0027,\"data\":data,\u0027module\u0027:_this})\n    },\n    loadTable:function(){ \n        var node \u003d _self.form.get(\u0027layout_table\u0027).node;\n        node.empty();\n        \n        Tools.loading({\"node\":node,\"color\":\"var(--o2-table-main)\"}); \n        \n        this.tableLoading \u003d true;\n        const filter \u003d {\n            \"type\":\"select\",\n            \"data\":`select o from ${this.name} o where ${this.where} order by o.${this.order} ${this.sort}`,\n            \"countData\":`select count(o) from ${this.name} o where ${this.where}`,\n            \"firstResult\":this.firstResult || 0,\n            \"maxResults\":this.size\n        }\n        \n        var table_promise \u003d Table.actions_designer.TableAction.execute(this.id,filter)\n        table_promise.then(function(json){ \n            this.total \u003d json.count;\n            this.totalPage \u003d Math.ceil(this.total / this.size);\n            this.loadPagination();\n            \n            var data \u003d {\n                \"data\":json.data,\n                \"sort\": {\n                    \"orderBy\":this.order,\n                    \"descOrder\":this.sort\n                },\n                \"fields\":this.tableFields\n            }\n            \n            json.data.forEach(function(d){\n                d.fields \u003d this.tableFields\n            }.bind(this));\n            \n            node.loadHtmlDomDB({\"view\":\"table.html\",\"style\":\"style.css\",\"data\":data,\"application\":_self.form.infor.portal,\u0027module\u0027:_this});\n            \n            this.tableLoading \u003d false;\n        }.bind(this),function(){\n            this.tableLoading \u003d false;\n        }.bind(this))\n\n    },\n    \n    loadNext:function(){ \n        if(this.totalPage \u003d\u003d 0 || this.page \u003d\u003d this.totalPage) return;\n        this.firstResult \u003d this.firstResult + this.size ;\n        this.page ++ ;\n        this.loadPagination();\n        this.loadTable()\n    },\n    loadPrev:function(){\n        if(this.page \u003d\u003d 1) return;\n        this.firstResult \u003d this.firstResult - this.size ;\n        this.page \u003d this.page - 1;\n        this.loadPagination();\n        this.loadTable()\n    },\n    getStructure:function(name){\n        var result \u003d [];\n        for (var i \u003d 0; i \u003c this.tableStructure.length; i++) {\n            if (name \u003d\u003d this.tableStructure[i].name) result \u003d this.tableStructure[i]\n        }\n        return result;\n    },\n    \n    search:function(statement){\n        if(this.tableLoading) return;\n        // var _statement \u003d statement.toLowerCase();\n        var _statement \u003d statement;\n        const s_arr \u003d _statement.split(\"order by\");\n        this.where \u003d s_arr[0];\n        if(s_arr.length \u003e 1){\n            const orderStr \u003d s_arr[1].trim();\n            const order_arr \u003d orderStr.split(\" \");\n            this.order \u003d order_arr[0].replace(\"o.\",\u0027\u0027);\n            this.sort \u003d order_arr[1]\n        }\n        this.page \u003d 1;\n        this.firstResult \u003d 0;\n        this.totalPage \u003d 1;\n        this.loadTable();\n    }\n})\n\n\n\n\n",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-11-04 17:46:44",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "48394661-b0a5-4c96-b2fe-3fcd0b98315e",
          "name": "dialog.html",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003cdiv class\u003d\"dlg_layout\"\u003e\n    \u003cdiv class\u003d\"dlg_top\"\u003e\n        \u003cdiv class\u003d\"dlg_top_left\"\u003e\n            \u003cdiv class\u003d\"dlg_top_item\" title\u003d\"保存\"  data-o2-events\u003d\"click:dlgSave:{{$.data.tableId}}:{{$.data.id}};\"\u003e\n                \u003cdiv class\u003d\"o2-table o2-table-baocun1\"\u003e\u003c/div\u003e\n            \u003c/div\u003e\n            \u003cdiv class\u003d\"dlg_top_item\" title\u003d\"删除\"  data-o2-events\u003d\"click:dlgDelete:{{$.data.tableId}}:{{$.data.id}};\"\u003e\n                \u003cdiv class\u003d\"o2-table o2-table-shanchu\"\u003e\u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"dlg_top_right\"\u003e\n            \u003cdiv class\u003d\"dlg_top_item\" title\u003d\"关闭\"  data-o2-events\u003d\"click:dlgClose;\"\u003e\n                \u003cdiv class\u003d\"o2-table o2-table-close-bold\"\u003e\u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \n    \u003cdiv class\u003d\"dlg_content\"\u003e\n        \u003ctable\u003e\n            {{each $.data.fields}}\n            \u003ctr class\u003d\"dlg_item\"\u003e\n                \u003ctd class\u003d\"dlg_table_title\"  title \u003d \"{{$.description}}\"\u003e{{$.name}}({{$.type}})\u003c/td\u003e\n                \u003ctd class\u003d\"dlg_table_value\"\u003e\n                    \u003cdiv\u003e\n                        \u003ctextarea o2-element-name\u003d\"{{$.name}}\" o2-element-type\u003d\"{{$.type}}\"\u003e{{\n                            (function(){\n                                var res \u003d \u0027\u0027;\n                                var value \u003d $._.data.data[$.name];\n                                if($.type \u003d\u003d \u0027stringMap\u0027 || $.type.indexOf(\u0027List\u0027)\u003e0){\n                                    res \u003d JSON.stringify(value)\n                                }else{\n                                    res \u003d value\n                                }\n                                \n                                return res\n                            })()\n                        \n                        }}\u003c/textarea\u003e\n                    \u003c/div\u003e    \n                \u003c/td\u003e\n            \u003c/tr\u003e\n        {{end each}}\n        \u003c/table\u003e\n        \n    \u003c/div\u003e\n\n\u003c/div\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-10-31 10:25:15",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "5bbdd5dc-9f3b-40e3-9779-74e5eae7803e",
          "name": "tableInfor.html",
          "alias": "",
          "description": "",
          "validated": false,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003cdiv class\u003d\"infor_content\"\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e应用名：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.queryName}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e表名：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.name}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e创建者：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.creatorPerson}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e创建时间：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.createTime}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e描述：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.description}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e状态：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.status}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003ebuildSuccess：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.buildSuccess}}\u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2024-09-27 13:33:34",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "63df0e82-cefb-464e-985a-10282dd562b3",
          "name": "home",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\nthis.name \u003d \"数据管理\";\nthis.version \u003d \"V2.0\";\nthis.portal \u003d this.page.infor.portal;\n\nvar Table \u003d window.Table || {};\nTable.action_org \u003d this.Actions.load(\"x_organization_assemble_control\").RoleAction;\nTable.actions_query \u003d this.Actions.load(\"x_query_assemble_surface\").TableAction;\nTable.actions_view \u003d this.Actions.load(\"x_query_assemble_surface\").ViewAction;\nTable.actions_designer \u003d this.Actions.load(\"x_query_assemble_designer\");\n\nvar _self \u003d _this \u003d this;\nthis.tableOnly \u003d true; //只是显示数据表，false展示数据表和视图\n\nthis.form.addEvent(\"afterLoad\", function(){\n    this.loadStyles();\n    this.load()\n}.bind(this));\n\n\nthis.define(\"loadStyles\",function(){\n    //载入样式\n    var _style \u003d Tools.getScriptText(\u0027style.css\u0027);\n    var node \u003d this.form.node();\n    node.loadCssText(_style);\n    \n    //载入字体样式\n    this.loadFont()\n    \n})\n\nthis.define(\u0027loadFont\u0027,function(node){\n    //载入字体样式\n    var _style \u003d Tools.getScriptText(\u0027iconfont.css\u0027);\n    var content \u003d node || this.form.node();\n    content.loadCssText(_style)\n})\n\nthis.define(\u0027load\u0027,function(){\n    Table.action_org.get(\"Manager\", function (json) {\n        var uo \u003d this.session.user; //distinguishedName\n        var flag \u003d false;\n        for (var i \u003d 0; i \u003c json.data.woPersonList.length; i++) {\n            if (json.data.woPersonList[i].distinguishedName \u003d\u003d uo.distinguishedName) {\n                flag \u003d true;\n            }\n        }\n        if(!flag){\n            if(uo.id\u003d\u003d\"xadmin\") flag \u003d true;\n        }\n        if (flag) {\n            this.loadNavi()\n        } else {\n            var content  \u003d this.form.get(\"div_content\").node;\n            content.empty();\n            content.setStyles({\"background-color\":\"#ffffff\"})\n            new Element(\"div\",{text:\"无权限访问！\",styles:{\"width\":\"200px\",\"font-size\":\"16px\",\"margin\":\"10px auto\"}}).inject(content);\n        }\n    }.bind(this))\n})\n\nthis.define(\u0027loadNavi\u0027,function(){\n    \n    var node \u003d this.form.get(\u0027layout_navi\u0027).node;\n    var data \u003d [];\n    // Tools.loading(node)\n    Tools.loading({\"node\":node,\"color\":\"var(--o2-table-main)\"}); \n    var queryList \u003d Table.actions_designer.QueryAction.listAll();\n    queryList.then(async function(json){\n        let promises \u003d [];\n        json.data.forEach(function(d){\n            var _json \u003d {\n                \u0027id\u0027:d.id,\n                \u0027name\u0027:d.name,\n                \u0027viewList\u0027:d.viewList,\n                \u0027table\u0027:[]\n            }\n            data.push(_json)\n            let p \u003d Table.actions_designer.TableAction.listWithQuery(d.id);\n            promises.push(p)\n        });\n        let _data \u003d await Promise.all(promises);\n        _data.forEach(function(d,i){\n            data[i].table \u003d d.data;\n        });\n        \n        if(_this.tableOnly){\n            data \u003d data.map(function(d) {\n                if (d.table.length \u003e 0) {\n                    d.viewList \u003d [];\n                    return d;\n                }\n                return null; // 返回null表示不包含在新数组中\n                }).filter(function(d) {\n                    return d !\u003d\u003d null; // 过滤掉null值\n            });\n\n        }\n        \n        _this.form.get(\u0027layout_container\u0027).show();debugger\n        node.loadHtmlDomDB({\u0027view\u0027:\u0027navi.html\u0027,\"data\":data,\u0027module\u0027:_this,\"application\":_this.page.infor.portal},function(){ \n            \n            var firstItem \u003d _this.form.node().getElement(\u0027.navi_item_layout\u0027);\n            firstItem.getElement(\u0027.navi_item_title\u0027).click();\n            var firstChild \u003d firstItem.getElement(\u0027.navi_item_table_title\u0027);\n            if(firstChild) firstChild.click()\n            \n        })\n    })\n\n    var sep_node \u003d this.form.get(\"layout_sep\").node;\n    var content_node \u003d this.form.get(\"layout_content\").node;\n    Tools.drag({\n        node:sep_node,\n        axis: \u0027x\u0027,\n        minPosition: {x: 200}, // 设置最小X位置为200\n        onMoveEvent:function(x,y){\n            if(x \u003c 200) {\n                return;\n            }\n            node.style.width \u003d x + \"px\";\n            content_node.style.width \u003d `calc(100% - ${x+2}px)`;\n        }\n    });\n})\n\nthis.define(\u0027naviItemOpen\u0027,function(e){\n    var target \u003d e.currentTarget;\n    var content \u003d target.getNext();\n    var arrow \u003d target.getElement(\u0027.navi_item_arrow\u0027);\n    var status \u003d target.get(\u0027o2-element-status\u0027);\n    if(status \u003d\u003d \"false\"){\n        target.set(\u0027o2-element-status\u0027,\u0027true\u0027);\n        var _length \u003d content.children.length;\n        var _h \u003d content.children.length ? content.children[0].getHeight() : 0;\n        _height \u003d _length * _h;\n        content.setStyles({\u0027height\u0027:_height+\u0027px\u0027});\n        arrow.setStyles({\n            \"rotate\":\"180deg\"\n        })\n        //arrow.removeClass(\u0027o2-table-jiantou-down\u0027).addClass(\u0027o2-table-jiantou-up\u0027)\n    }else{\n        target.set(\u0027o2-element-status\u0027,\u0027false\u0027);\n        content.setStyles({\u0027height\u0027:\u00270px\u0027});\n        //arrow.removeClass(\u0027o2-table-jiantou-up\u0027).addClass(\u0027o2-table-jiantou-down\u0027)\n        arrow.setStyles({\n            \"rotate\":\"0deg\"\n        })\n    }\n})\n\n//打开数据表\nthis.define(\u0027openTable\u0027,function(id,e){\n    this.currentTable \u003d \u0027table\u0027;\n    this.tableId \u003d id;\n    var node \u003d this.form.get(\u0027layout_navi\u0027).node;\n    node.getElements(\u0027.navi_item_table_title\u0027).setStyles({\u0027background-color\u0027:\u0027\u0027});\n    var target \u003d e.target;\n    var _id \u003d target.get(\u0027id\u0027);\n    if(_id !\u003d\u003did) target \u003d target.getParent();\n    target.setStyles({\"background-color\":\"#f2f2f2\"});\n    Table.table \u003d new TableClass({\"id\":id}); \n})\n\nthis.define(\u0027tableAdd\u0027,function(){\n    this.include(\u0027Dialog\u0027,function(){ \n        Table.dialog \u003d new this.DialogClass({\u0027tableId\u0027:this.tableId,\u0027fields\u0027:Table.table.tableFields});\n        Table.dialog.open( () \u003d\u003e {\n            const drag \u003d Table.dialog.dlg.content.querySelector(\".dlg_top\");\n            const dragContent \u003d Table.dialog.dlg.node;\n                                        \n            Tools.drag({\n                dragEl:drag,\n                dragContainerEl:dragContent\n            })\n        });\n        \n        \n\n\n    }.bind(this),true);\n    // Table.dialog \u003d new DialogClass({\u0027tableId\u0027:this.tableId,\u0027fields\u0027:Table.table.tableFields});\n    // Table.dialog.open()\n})\nthis.define(\u0027tableReload\u0027,function(){\n    Table.table.reload();\n})\nthis.define(\u0027tableNext\u0027,function(){\n    Table.table.loadNext();\n})\nthis.define(\u0027tablePrev\u0027,function(){\n    Table.table.loadPrev();\n})\nthis.define(\u0027tableSort\u0027,function(field,sort){ \n    // Table.table.sort \u003d {\n    //     \"orderBy\":field,\n    //     \"descOrder\":sort\n    // };\n    Table.table.order \u003d field;\n    Table.table.sort \u003d sort\n    // Table.table.load()\n    Table.table.reload(true)\n})\nthis.define(\u0027tableSizeLoad\u0027,function(e){\n    var size \u003d e.target.get(\u0027value\u0027);\n    Table.table.size \u003d parseInt(size);\n    Table.table.reload()\n})\n// 清空\nthis.define(\"tableRemove\",function(){\n    this.form.confirm(\u0027warn\u0027,\u0027清空\u0027,\u0027会删除整个表的数据,确认吗？\u0027,300,120,function(){\n        const that \u003d this;\n        _this.form.confirm(\u0027warn\u0027,\u0027清空\u0027,\u0027再次确认要清空？\u0027,300,120,function(){\n            const loadingNode \u003d Tools.loading();\n            // this.close();\n            // that.close();\n            // window.setTimeout( () \u003d\u003e {\n            //     loadingNode.destroy()\n            // },5000)\n            Table.actions_designer.TableAction.rowDeleteAll(Table.table.id,() \u003d\u003e{\n                this.close();\n                that.close();\n                loadingNode.destroy()\n                Table.table.reload();\n            })\n            \n        },function(){\n            this.close();\n            that.close();\n        })\n\n    },function(){ \n        this.close(); \n    })\n})\n//删除\nthis.define(\u0027tableDelete\u0027,function(){\n    var node \u003d this.form.get(\u0027layout_table\u0027).node;\n    var rowList \u003d node.querySelectorAll(\u0027input[name\u003d\"rowcheck\"]:checked\u0027);\n    if(rowList.length \u003d\u003d 0) return;\n    this.form.confirm(\u0027warn\u0027,\u0027删除\u0027,\u0027确定删除？\u0027,300,120,function(){\n        var proArr \u003d [];\n        rowList.forEach(function(row){ \n            var id \u003d row.get(\u0027id\u0027);\n            proArr.push(Table.actions_query.rowDelete(Table.table.id,id));\n        })\n        \n        Promise.all(proArr).then(function(){\n            Tools.notification(\u0027删除成功!\u0027,function(){\n                Table.table.reload();\n            });\n            this.close();\n        }.bind(this)).catch(function(){\n            Table.table.reload();\n            this.close()\n        }.bind(this))\n\n    },function(){ this.close(); })\n})\n//全选\nthis.define(\u0027tableSelectAll\u0027,function(){\n    var node \u003d this.form.get(\u0027layout_table\u0027).node;\n    var rowList \u003d node.getElements(\u0027input[name\u003d\"rowcheck\"]\u0027);\n    var flag \u003d true;\n    for(var i \u003d 0;i \u003c rowList.length; i ++){\n        var _flag \u003d rowList[i].get(\"checked\");\n        if(!_flag){\n            flag \u003d false;\n            break;\n        }\n    }\n    if(flag)rowList.set(\u0027checked\u0027,false);  \n    else rowList.set(\u0027checked\u0027,true);   \n    //rowList.set(\u0027checked\u0027,true);\n})\n\n\nthis.define(\u0027tableOpenRow\u0027,function(id){ \n    this.include(\u0027Dialog\u0027,function(){ \n        Table.dialog \u003d new this.DialogClass({\u0027tableId\u0027:this.tableId,\u0027id\u0027:id,\u0027fields\u0027:Table.table.tableFields});\n        // Table.dialog.open()\n        Table.dialog.open( () \u003d\u003e {\n            const drag \u003d Table.dialog.dlg.content.querySelector(\".dlg_top\");\n            const dragContent \u003d Table.dialog.dlg.node;\n                                        \n            Tools.drag({\n                dragEl:drag,\n                dragContainerEl:dragContent\n            })\n        });\n    }.bind(this),true);\n    // Table.dialog \u003d new DialogClass({\u0027tableId\u0027:this.tableId,\u0027id\u0027:id,\u0027fields\u0027:Table.table.tableFields});\n    // Table.dialog.open()\n})\n\nthis.define(\u0027search\u0027,function(){\n    var val \u003d this.form.get(\u0027statement\u0027).getData().trim();\n    if(val!\u003d\"\" \u0026\u0026 this.currentTable \u003d\u003d \u0027table\u0027){ \n        Table.table.search(val)\n    }else if(val!\u003d\"\" \u0026\u0026 this.currentTable \u003d\u003d \u0027view\u0027){\n        Table.view.search(val)\n    }\n})\n\n//打开视图\nthis.define(\u0027openView\u0027,function(name,query,e){\n    this.currentTable \u003d \u0027view\u0027;\n    this.viewName \u003d name;\n    this.viewId \u003d query;\n    var node \u003d this.form.get(\u0027layout_navi\u0027).node;\n    node.getElements(\u0027.navi_item_table_title\u0027).setStyles({\u0027background-color\u0027:\u0027\u0027});\n    var target \u003d e.target;\n    var _id \u003d target.get(\u0027id\u0027);\n    if(_id !\u003d\u003d query) target \u003d target.getParent();\n    target.setStyles({\"background-color\":\"#f2f2f2\"});\n    Table.view \u003d new ViewClass({\"name\":name,\"query\":query}); \n    Table.view.loadView()\n})\nthis.define(\u0027viewOpenRow\u0027,function(id){\n    if(Table.view.type \u003d\u003d \u0027process\u0027){\n        this.form.openJob(id)\n    }else if(Table.view.type\u003d\u003d\u0027cms\u0027){\n        this.form.openDocument(id)\n    }\n})\n\nthis.define(\u0027viewReload\u0027,function(){ \n    Table.view.reload();\n})\nthis.define(\u0027viewNext\u0027,function(){\n    Table.view.loadNext();\n})\nthis.define(\u0027viewPrev\u0027,function(){\n    Table.view.loadPrev();\n})\n\n\n\nthis.define(\u0027naviFolder\u0027,function(){ \n    var _target \u003d this.event.target;\n    var _status \u003d _target.get(\u0027o2-element-status\u0027);\n    var naviNode \u003d this.form.get(\u0027layout_navi\u0027).node;\n    var contentNode \u003d this.form.get(\u0027layout_content\u0027).node;\n    if(_status \u003d\u003d \"false\"){\n        naviNode.setStyles({\"width\":\"300px\"});\n        contentNode.setStyles({\"width\":\"calc(100% - 302px)\"});\n        _target.setStyles({\n            \"left\":\"250px\",\n            \"rotate\":\"0deg\"\n        });\n        //_target.removeClass(\u0027o2-table-youjiantou-fill\u0027).addClass(\u0027o2-table-zuojiantou-fill\u0027)\n        //_target.removeClass(\u0027o2-table-youjiantou-fill\u0027).addClass(\u0027o2-table-zuojiantou-fill\u0027);\n        _target.set(\u0027o2-element-status\u0027,\"true\");\n    }else{ \n        naviNode.setStyles({\"width\":\"0px\"});\n        contentNode.setStyles({\"width\":\"calc(100% - 0px)\"});\n        _target.setStyles({\n            \"left\":\"15px\",\n            \"rotate\":\"180deg\"\n        });\n        //_target.removeClass(\u0027o2-table-zuojiantou-fill\u0027).addClass(\u0027o2-table-youjiantou-fill\u0027);\n        _target.set(\u0027o2-element-status\u0027,\"false\");\n    }\n})\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
