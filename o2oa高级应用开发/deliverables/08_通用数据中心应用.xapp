          "view": "{\"id\":\"e19b6965-f897-426e-8d86-0384b2a4b4cb_view\",\"data\":{\"noDataText\":\"未找到数据\",\"selectList\":[{\"id\":\"CB84D929BEA0000144321C50A3A0153A\",\"column\":\"createTime\",\"displayName\":\"创建时间\",\"orderType\":\"original\",\"events\":{\"loadTitle\":{\"code\":\"\",\"html\":\"\"},\"loadContent\":{\"code\":\"\",\"html\":\"\"},\"click\":{\"code\":\"\",\"html\":\"\"},\"mousedown\":{\"code\":\"\",\"html\":\"\"},\"mouseup\":{\"code\":\"\",\"html\":\"\"},\"mouseout\":{\"code\":\"\",\"html\":\"\"},\"mouseover\":{\"code\":\"\",\"html\":\"\"}},\"vid\":\"e19b6965-f897-426e-8d86-0384b2a4b4cb_view\",\"pid\":\"e19b6965-f897-426e-8d86-0384b2a4b4cb_viewCB84D929BEA0000144321C50A3A0153A\",\"mid\":\"CB84D929BEA0000144321C50A3A0153A\",\"allowOpen\":true,\"hideColumn\":false,\"isName\":true,\"isHtml\":false,\"exportEnable\":true,\"isTime\":false,\"isNumber\":false,\"total\":\"no\",\"path\":\"createTime\",\"defaultValue\":\"\",\"clickCode\":\"var env \u003d this.queryStatement.getParentEnvironment();\\nenv.editRow(this.target.data);\",\"contentStyles\":{},\"titleStyles\":{}}],\"filterList\":[],\"orderList\":[],\"group\":{},\"columnList\":[],\"actionbarHidden\":false,\"events\":{\"queryLoad\":{\"code\":\"\\nvar env \u003d this.queryStatement.getParentEnvironment();\\n\\nconst pars \u003d env.page.getWidgetPrameters();\\nconst id \u003d pars.table;\\nthis.target.viewJson.table \u003d id;\\no2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.get(id, function (json) {\\n    const fieldList \u003d JSON.parse(json.data.data).fieldList;\\n    fieldList.each(function (field) {\\n\\n        let itemTemplate \u003d Object.clone(this.target.viewJson.selectList[0]);\\n        itemTemplate.id \u003d o2.uuid();\\n        itemTemplate.column \u003d o2.uuid();\\n        itemTemplate.path \u003d field.name;\\n        itemTemplate.displayName \u003d field.description !\u003d\u003d \\\"\\\" ? field.description + \\\"(\\\"+field.name+\\\")\\\" : field.name\\n\\n        this.target.viewJson.selectList.unshift(itemTemplate);\\n\\n    }.bind(this));\\n\\n}.bind(this), null, false);\\n\\n\\nthis.target.loadCurrentPageData \u003d function (callback, async, type) {\\n\\n    //是否需要在翻页的时候清空之前的items ?\\n    if (this.pageloading) return;\\n    this.pageloading \u003d true;\\n\\n    if (this.io) {\\n        this.items.each(function (item) {\\n            this.io.unobserve(item.node);\\n        }.bind(this))\\n    }\\n\\n    this.items \u003d [];\\n\\n    var p \u003d this.currentPage;\\n\\n\\n    var table \u003d this.viewJson.table;\\n\\n\\n\\n    if (this.viewTable) {\\n        while (this.viewTable.rows.length \u003e 1) {\\n            this.viewTable.deleteRow(-1);\\n        }\\n        if (this.viewTable.rows.length \u003e 0 \u0026\u0026 !this.viewTable.rows[0].hasClass(\\\"viewTitleLine\\\")) {\\n            this.viewTable.deleteRow(0);\\n        }\\n    } else {\\n        this.contentAreaNode.empty();\\n    }\\n\\n    this.contentAreaNode.scrollTo(0, 0);\\n\\n    //this.createLoadding();\\n    this.fireEvent(\\\"beforeLoadPageData\\\", [d])\\n\\n\\n    var whereArr \u003d [];\\n    whereArr.push(\\\"1\u003e0\\\");\\n    if (this.parameter.jpql) {\\n        whereArr.push(this.parameter.jpql.replace(/%/g, \u0027\u0027));\\n    }\\n\\n    if (p \u003d\u003d\u003d 1) {\\n        firstResult \u003d 0;\\n    } else {\\n        firstResult \u003d (p - 1) * this.json.pageSize;\\n    }\\n\\n    var data \u003d {};\\n    data[\\\"type\\\"] \u003d \\\"select\\\";\\n    data[\\\"data\\\"] \u003d \\\"select o from \\\" + table + \\\" o where \\\" + whereArr.join(\\\" and \\\") + \\\" order by o.updateTime desc\\\";\\n    data[\\\"countData\\\"] \u003d \\\"select count(o) from \\\" + table + \\\" o where \\\" + whereArr.join(\\\" and \\\");\\n    data[\\\"maxResults\\\"] \u003d this.json.pageSize;\\n    data[\\\"firstResult\\\"] \u003d firstResult;\\n\\n    this.loadViewRes \u003d o2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.execute(table, data, function (json) {\\n\\n        if (type \u003d\u003d\u003d \\\"all\\\" || type \u003d\u003d\u003d \\\"count\\\") {\\n            if (typeOf(json.count) \u003d\u003d\u003d \\\"number\\\") {\\n                this.count \u003d json.count;\\n                var i \u003d this.count / this.json.pageSize;\\n                this.pages \u003d (i.toInt() \u003c i) ? i.toInt() + 1 : i;\\n            }\\n        }\\n\\n        this.gridJson \u003d json.data;\\n        this.setSelectedableFlag();\\n\\n        this.fireEvent(\\\"postLoadPageData\\\");\\n\\n        // if (this.viewJson.group.column){\\n        //     this.gridJson \u003d json.data.groupGrid;\\n        // }else{\\n        //     this.gridJson \u003d json.data.grid;\\n        this.loadData();\\n        // }\\n        if (this.gridJson.length) this._loadPageNode();\\n        if (this.loadingAreaNode) {\\n            this.loadingAreaNode.destroy();\\n            this.loadingAreaNode \u003d null;\\n        }\\n\\n        this.pageloading \u003d false;\\n\\n        this.fireEvent(\\\"loadView\\\"); //options 传入的事件\\n        this.fireEvent(\\\"postLoadPage\\\");\\n\\n        if (callback) callback(json);\\n    }.bind(this), null, async \u003d\u003d\u003d false ? false : true);\\n\\n}\\n\\nenv.define(\\\"editRow\\\", function (documentData) {\\n    var statement \u003d this.form.get(\\\"statement\\\");\\n    var pars \u003d env.page.getWidgetPrameters();\\n    var table \u003d pars.table;\\n    MWF.require(\\\"MWF.widget.JavascriptEditor\\\", null, false);\\n    var div \u003d new Element(\\\"div\\\", { \\\"style\\\": \\\"height:450px;border:1px solid rgb(230, 230, 230)\\\" });\\n    var editor;\\n    var dlg \u003d o2.DL.open({\\n        \\\"title\\\": \\\"修改\\\",\\n        \\\"width\\\": \\\"800px\\\",\\n        \\\"height\\\": \\\"560px\\\",\\n        \\\"mask\\\": true,\\n        \\\"style\\\": \\\"v10\\\",\\n        \\\"content\\\": div,\\n        \\\"container\\\": null,\\n        \\\"positionNode\\\": this.form.getApp().node,\\n        \\\"onQueryClose\\\": function () {\\n            div.destroy();\\n        }.bind(this),\\n        \\\"buttonList\\\": [\\n            {\\n                \\\"text\\\": \\\"保存\\\",\\n                \\\"action\\\": function () {\\n                    var str \u003d editor.editor.getValue();\\n                    o2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.rowSave(table, JSON.parse(str), function (json) {\\n                        \\n                        console.long(json.data)\\n                        \\n                        dlg.close();\\n                        statement.reload();\\n                    }.bind(this), null, false);\\n\\n                }.bind(this)\\n            },\\n            {\\n                \\\"text\\\": \\\"关闭\\\",\\n                \\\"action\\\": function () {\\n                    dlg.close();\\n                }.bind(this)\\n            }\\n        ],\\n        \\\"onPostShow\\\": function () {\\n\\n            editor \u003d new o2.widget.JavascriptEditor(div, { \\\"forceType\\\": \\\"ace\\\", \\\"option\\\": { \\\"mode\\\": \\\"json\\\" } });\\n            editor.load(function () {\\n                editor.editor.setValue(JSON.stringify(documentData, null, \\\"\\\\t\\\"));\\n            });\\n\\n            dlg.reCenter();\\n        }.bind(this)\\n    });\\n}.bind(env))\\n\\nenv.define(\\\"addRow\\\", function () {\\n    var statement \u003d this.form.get(\\\"statement\\\");\\n    var pars \u003d env.page.getWidgetPrameters();\\n    var table \u003d pars.table;\\n    var newLineData \u003d {};\\n    o2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.get(table, function (json) {\\n        const fieldList \u003d JSON.parse(json.data.data).fieldList;\\n\\n        fieldList.each(function (field) {\\n            switch (field.type) {\\n                case \\\"string\\\":\\n                    newLineData[field.name] \u003d \\\"\\\";\\n                    break;\\n                case \\\"integer\\\":\\n                case \\\"long\\\":\\n                case \\\"double\\\":\\n                    newLineData[field.name] \u003d 0;\\n                    break;\\n                case \\\"date\\\":\\n                    var str \u003d new Date().format(\\\"%Y-%m-%d\\\");\\n                    newLineData[field.name] \u003d str;\\n                    break;\\n                case \\\"time\\\":\\n                    var str \u003d new Date().format(\\\"%H:%M:%S\\\");\\n                    newLineData[field.name] \u003d str;\\n                    break;\\n                case \\\"dateTime\\\":\\n                    var str \u003d new Date().format(\\\"db\\\");\\n                    newLineData[field.name] \u003d str;\\n                    break;\\n                case \\\"boolean\\\":\\n                    newLineData[field.name] \u003d true;\\n                    break;\\n                case \\\"stringList\\\":\\n                case \\\"integerList\\\":\\n                case \\\"longList\\\":\\n                case \\\"doubleList\\\":\\n                    newLineData[field.name] \u003d [];\\n                    break;\\n                case \\\"stringLob\\\":\\n                    newLineData[field.name] \u003d \\\"\\\";\\n                    break;\\n                case \\\"stringMap\\\":\\n                    newLineData[field.name] \u003d {};\\n                    break;\\n            }\\n        });\\n\\n    }.bind(this), null, false);\\n\\n    this.editRow(newLineData);\\n}.bind(env));\\n\\nenv.define(\\\"removeRows\\\", function (e) {\\n    const _self \u003d this;\\n    const statement \u003d this.form.get(\\\"statement\\\");\\n    var pars \u003d env.page.getWidgetPrameters();\\n    var table \u003d pars.table;\\n    this.form.app.confirm(\\\"warn\\\", e.target ? e.target : e, \\\"提示\\\", \\\"您确定要删除吗？\\\", 350, 120, function () {\\n\\n        const selectedItems \u003d statement.view.selectedItems;\\n        if (selectedItems.length \u003e 0) {\\n            let count \u003d 0;\\n            selectedItems.each(function (d) {\\n\\n                _self._snap(d.data.id);\\n                o2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.rowDelete(table, d.data.id ,function (json) {\\n\\n                }.bind(this),null,false);\\n\\n\\n            });\\n        } else {\\n            _self.form.notice(\\\"请选择数据后再进行本次操作\\\", \\\"warn\\\");\\n            this.close();\\n            return;\\n        }\\n\\n        this.close();\\n        _self.form.app.notice(\\\"删除成功\\\", \\\"success\\\");\\n        statement.reload();\\n\\n    }, function () {\\n\\n        this.close();\\n    });\\n}.bind(env)); \",\"html\":\"\\nvar env \u003d this.queryStatement.getParentEnvironment();\\n\\nconst pars \u003d env.page.getWidgetPrameters();\\nconst id \u003d pars.table;\\nthis.target.viewJson.table \u003d id;\\no2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.get(id, function (json) {\\n    const fieldList \u003d JSON.parse(json.data.data).fieldList;\\n    fieldList.each(function (field) {\\n\\n        let itemTemplate \u003d Object.clone(this.target.viewJson.selectList[0]);\\n        itemTemplate.id \u003d o2.uuid();\\n        itemTemplate.column \u003d o2.uuid();\\n        itemTemplate.path \u003d field.name;\\n        itemTemplate.displayName \u003d field.description !\u003d\u003d \\\"\\\" ? field.description + \\\"(\\\"+field.name+\\\")\\\" : field.name\\n\\n        this.target.viewJson.selectList.unshift(itemTemplate);\\n\\n    }.bind(this));\\n\\n}.bind(this), null, false);\\n\\n\\nthis.target.loadCurrentPageData \u003d function (callback, async, type) {\\n\\n    //是否需要在翻页的时候清空之前的items ?\\n    if (this.pageloading) return;\\n    this.pageloading \u003d true;\\n\\n    if (this.io) {\\n        this.items.each(function (item) {\\n            this.io.unobserve(item.node);\\n        }.bind(this))\\n    }\\n\\n    this.items \u003d [];\\n\\n    var p \u003d this.currentPage;\\n\\n\\n    var table \u003d this.viewJson.table;\\n\\n\\n\\n    if (this.viewTable) {\\n        while (this.viewTable.rows.length \u003e 1) {\\n            this.viewTable.deleteRow(-1);\\n        }\\n        if (this.viewTable.rows.length \u003e 0 \u0026\u0026 !this.viewTable.rows[0].hasClass(\\\"viewTitleLine\\\")) {\\n            this.viewTable.deleteRow(0);\\n        }\\n    } else {\\n        this.contentAreaNode.empty();\\n    }\\n\\n    this.contentAreaNode.scrollTo(0, 0);\\n\\n    //this.createLoadding();\\n    this.fireEvent(\\\"beforeLoadPageData\\\", [d])\\n\\n\\n    var whereArr \u003d [];\\n    whereArr.push(\\\"1\u003e0\\\");\\n    if (this.parameter.jpql) {\\n        whereArr.push(this.parameter.jpql.replace(/%/g, \u0027\u0027));\\n    }\\n\\n    if (p \u003d\u003d\u003d 1) {\\n        firstResult \u003d 0;\\n    } else {\\n        firstResult \u003d (p - 1) * this.json.pageSize;\\n    }\\n\\n    var data \u003d {};\\n    data[\\\"type\\\"] \u003d \\\"select\\\";\\n    data[\\\"data\\\"] \u003d \\\"select o from \\\" + table + \\\" o where \\\" + whereArr.join(\\\" and \\\") + \\\" order by o.updateTime desc\\\";\\n    data[\\\"countData\\\"] \u003d \\\"select count(o) from \\\" + table + \\\" o where \\\" + whereArr.join(\\\" and \\\");\\n    data[\\\"maxResults\\\"] \u003d this.json.pageSize;\\n    data[\\\"firstResult\\\"] \u003d firstResult;\\n\\n    this.loadViewRes \u003d o2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.execute(table, data, function (json) {\\n\\n        if (type \u003d\u003d\u003d \\\"all\\\" || type \u003d\u003d\u003d \\\"count\\\") {\\n            if (typeOf(json.count) \u003d\u003d\u003d \\\"number\\\") {\\n                this.count \u003d json.count;\\n                var i \u003d this.count / this.json.pageSize;\\n                this.pages \u003d (i.toInt() \u003c i) ? i.toInt() + 1 : i;\\n            }\\n        }\\n\\n        this.gridJson \u003d json.data;\\n        this.setSelectedableFlag();\\n\\n        this.fireEvent(\\\"postLoadPageData\\\");\\n\\n        // if (this.viewJson.group.column){\\n        //     this.gridJson \u003d json.data.groupGrid;\\n        // }else{\\n        //     this.gridJson \u003d json.data.grid;\\n        this.loadData();\\n        // }\\n        if (this.gridJson.length) this._loadPageNode();\\n        if (this.loadingAreaNode) {\\n            this.loadingAreaNode.destroy();\\n            this.loadingAreaNode \u003d null;\\n        }\\n\\n        this.pageloading \u003d false;\\n\\n        this.fireEvent(\\\"loadView\\\"); //options 传入的事件\\n        this.fireEvent(\\\"postLoadPage\\\");\\n\\n        if (callback) callback(json);\\n    }.bind(this), null, async \u003d\u003d\u003d false ? false : true);\\n\\n}\\n\\nenv.define(\\\"editRow\\\", function (documentData) {\\n    var statement \u003d this.form.get(\\\"statement\\\");\\n    var pars \u003d env.page.getWidgetPrameters();\\n    var table \u003d pars.table;\\n    MWF.require(\\\"MWF.widget.JavascriptEditor\\\", null, false);\\n    var div \u003d new Element(\\\"div\\\", { \\\"style\\\": \\\"height:450px;border:1px solid rgb(230, 230, 230)\\\" });\\n    var editor;\\n    var dlg \u003d o2.DL.open({\\n        \\\"title\\\": \\\"修改\\\",\\n        \\\"width\\\": \\\"800px\\\",\\n        \\\"height\\\": \\\"560px\\\",\\n        \\\"mask\\\": true,\\n        \\\"style\\\": \\\"v10\\\",\\n        \\\"content\\\": div,\\n        \\\"container\\\": null,\\n        \\\"positionNode\\\": this.form.getApp().node,\\n        \\\"onQueryClose\\\": function () {\\n            div.destroy();\\n        }.bind(this),\\n        \\\"buttonList\\\": [\\n            {\\n                \\\"text\\\": \\\"保存\\\",\\n                \\\"action\\\": function () {\\n                    var str \u003d editor.editor.getValue();\\n                    o2.Actions.load(\\\"x_query_assemble_designer\\\").TableAction.rowSave(table, JSON.parse(str), function (json) {\\n                        \\n                     