        {
          "id": "c5d7a08d-c6a3-401e-8831-4568fbc73e63",
          "name": "MVC",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "const MVC_model \u003d class{\n    constructor(node,options){ \n        if(!options.module) return;\n        this.node \u003d node;\n        this.module \u003d options.module;\n        if(options.application){\n            this.application \u003d options.application;\n        }else{ \n            if(this.module.page \u0026\u0026 this.module.page.app){ \n                if(this.module.page.app.portal) this.application \u003d this.module.page.app.portal.id;\n                else if(this.module.page.app.pageInfor) this.application \u003d this.module.page.app.pageInfor.portal;\n            }else{\n                return;\n            }\n        }\n        this.view \u003d options.view || \u0027view.html\u0027;\n        this.style \u003d options.style;\n        this.data \u003d options.data || {};\n        this.load();\n    }\n    load(){\n        this.node.empty();\n        if(this.style)this.loadStyle();\n        this.loadHtml()\n    }\n    getScriptText(name){\n        let res \u003d \"\";\n        let portal \u003d this.application;\n        o2.Actions.load(\"x_portal_assemble_surface\").ScriptAction.getImported(portal,name,function( json ){ \n            res \u003d json.data.text\n        },null,false);\n        return res\n    }\n    loadHtml(){ \n        let _viewText \u003d this.getScriptText(this.view);\n        let json \u003d {\"data\":this.data};\n        \n        o2.injectHtml(_viewText,{\"dom\":this.node,\"bind\":json,\"module\":this.module}) \n    }\n    loadStyle(){ \n        let _css \u003d this.getScriptText(this.style);\n        this.node.loadCssText(_css)\n    } \n}\n\nif (window.Element){ \n    if(!(Object.prototype.hasOwnProperty.call(Element.prototype, \u0027loadHtmlDomDB\u0027) \u0026\u0026 typeof Element.prototype[\u0027loadHtmlDomDB\u0027] \u003d\u003d\u003d \"function\")){\n        Element.prototype.loadHtmlDomDB \u003d function(op,callback){ \n            new MVC_model(this,op);\n            if(callback)callback(op)\n        }\n    }\n} \n",
