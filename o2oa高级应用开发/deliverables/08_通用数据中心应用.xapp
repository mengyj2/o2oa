        {
          "id": "76473420-1e61-475f-9add-e41ef83fd9f7",
          "name": "style.css",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "/* #00BD67, #d4ede7 */\n\n\n\n:root{\n    --o2-table-bgcolor:#ff0000;\n    --o2-table-main:var(--oo-color-main);\n    --o2-table-sub: var(--oo-color-over);\n}\n\n.navi_item{\n    height:30px;\n    line-height:30px;\n    padding-left:10px;\n    cursor:pointer;\n}\n.navi_item:hover{\n    background-color:#f2f2f2;\n}\n\n.navi_item_layout{\n    width:100%;\n    border-bottom:1px solid var(--o2-table-sub);\n}\n.navi_item_title{\n    width:calc(100% - 20px);\n    padding:0px 10px;\n    height:40px;\n    display:flex;\n    cursor:pointer;\n    justify-content:space-between;\n}\n.navi_item_title:hover{\n    background-color:#f2f2f2;\n}\n.navi_item_title div:nth-child(1){\n    width:calc(100% - 30px);\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    word-break:keep-all;\n    text-wrap-mode:nowrap;\n    overflow:hidden;\n}\n.navi_item_title_count{\n    font-size:12px;\n    color:#999999;\n}\n.navi_item_arrow{\n    line-height:40px;\n    font-size:12px;\n    color:var(--o2-table-main);\n    transition:all 0.3s ease-out;\n}\n.navi_item_content{\n    background:rgba(0,0,0,.01);\n    width:100%;\n    height:0px;\n    overflow:hidden;\n    transition: all 0.3s ease-out;\n}\n.navi_item_table_title{\n    display:flex;\n    align-items:center;\n    padding-left:20px;\n    height:40px;\n    cursor:pointer;\n    word-break:keep-all;\n    overflow:hidden;\n}\n.navi_item_table_title:hover{\n    background-color:#f2f2f2;\n}\n.navi_item_table_title:hover .navi_item_table_title_icon{\n    opacity:1;\n}\n.navi_item_table_title_icon{\n    margin-right:6px;\n    color:var(--o2-table-main);\n    opacity:0.7;\n}\n\n.infor_content{\n    height:100%;\n    min-width:1000px;\n    display:flex;\n    align-items:center;\n}\n.infor_item{\n    padding-right:20px;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n.infor_title{\n    color:#333333;\n}\n.infor_value{\n    color:var(--o2-table-main)\n}\n\n.layout_table{\n    width:calc(100% - 2px);\n    border-collapse:collapse;\n    border:1px solid var(--o2-table-main);\n}\n.layout_table td{\n    height:30px;\n    border:1px solid var(--o2-table-main);\n    padding:2px 5px;\n    max-width:300px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n.table_thead{\n    \n}\n.table_thead td{\n    background-color:#f2f2f2;\n    text-align:center;\n}\n.table_th{\n    width:100%;\n    height:100%;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n.table_th div{\n    margin-left:5px;\n}\n.sort_item_content{\n    display:flex;\n    flex-direction:column;\n    justify-content:space-arround;\n}\n.sort_item{\n    font-size:12px;\n    color:#999999;\n}\n.sort_item_click{\n    color:var(--o2-table-main) !important;\n}\n\n\n.table_body{\n    \n}\n.table_body tr{\n    \n}\n.table_body tr:hover{\n    background-color:#f2f2f2;\n}\n\n.layout_pagination{\n    display:flex;\n    align-items:center;\n    height:100%;\n}\n.pagination_paging{\n    display:flex;\n    margin-left:6px;\n}\n.pagination_paging \u003e div{\n    margin-right:10px;\n}\n\n.pagination_item{\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    width:32px;\n    height:32px;\n    cursor:pointer;\n}\n\n.pagination_item div{\n    font-size:22px;\n    color:var(--o2-table-main);\n}\n.pagination_item:hover{\n    background-color:#dddddd;\n    border-radius:6px;\n}\n\n.dlg_layout{\n    height:100%;\n}\n.dlg_top{\n    height:40px;\n    width:calc(100% - 20px);\n    padding-left:10px;\n    padding-right:10px;\n    border-bottom:1px solid #cccccc;\n    background-color:#f2f2f2;\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n}\n.dlg_top_left{\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n.dlg_top_item{\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    width:32px;\n    height:32px;\n    cursor:pointer;\n}\n.dlg_top_item div{\n    font-size:22px;\n    color:var(--o2-table-main);\n}\n.dlg_top_item:hover{\n    background-color:#dddddd;\n    border-radius:4px;\n}\n\n.dlg_content{\n    width:calc(100% - 20px);\n    height:calc(100% - 61px);\n    overflow-y:auto;\n    padding:10px;\n}\n.dlg_content table{\n    width:calc(100% - 20px);\n    border-collapse: collapse;\n    border: 1px solid var(--o2-table-sub);\n}\n\n.dlg_content td{\n    border: 1px solid var(--o2-table-sub);\n    padding: 2px 5px;\n    min-width: 20px;\n}\n\n.dlg_table_title{\n    width:200px;\n}\n.dlg_table_value{\n    padding:10px !important;\n}\n.dlg_table_value div{\n    width:100%;\n    height:100%;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n\n.dlg_content textarea{\n    width: 99%; \n    min-height: 50px; \n    resize: vertical;\n    border:1px solid var(--o2-table-main);\n}\n\n#layout_navi, #layout_content, #div_folder{\n    /* transition: all 0.3s ease-out; */\n}\n\n#layout_sep:hover{\n    border-left:1px solid var(--o2-table-main) !important;\n    border-right:1px solid var(--o2-table-main) !important;\n    cursor:w-resize;\n}\n\n\n\n\n\n\n\n\n\n",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-12-11 10:54:23",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "7683ff8e-8971-4008-ab3d-c38b4ede794d",
          "name": "Dialog",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "var _this \u003d this;\nconst DialogClass \u003d this.DialogClass \u003d class{\n    constructor(options){\n        this.tableId \u003d options.tableId;\n        this.id \u003d options.id||\u0027\u0027;\n        this.fields \u003d options.fields;\n    }\n    open(cb){\n        var dlg \u003d this;\n        var size \u003d _this.form.getApp().content.getSize();\n        var _h \u003d size.y;\n        var _w \u003d size.x;\n        this.dlg \u003d o2.DL.open({\n            \"style\": \"blue_flat\",\n            \"title\": \"弹出框标题\",\n            \"height\": _h - 100 * 2,\n            \"width\": _w \u003e 1000 ? 1000 : _w,\n            \n            \"isTitle\": false,\n            \"maskNode\":_this.form.node(),\n            \"mask\": true,\n            \"duration\": 200,\n            \"onPostLoad\": function () { \n                this.content.setStyles({\n                    \"overflow\":\"hidden\",\n                    \"height\":\"100%\"\n                });\n                this.content.getParent().setStyles({\n                    \"margin-top\":\"0px\",\n                    \"height\":\"100%\"\n                });\n                var node \u003d new Element(\"div\",{styles:{\n                    \"width\":\"100%\",\n                    \"height\":\"100%\",\n                }}).inject(this.content);\n                \n                _this.loadFont(node)\n                \n                var data \u003d {\n                    \"tableId\":dlg.tableId,\n                    \"fields\":dlg.fields\n                };\n                \n                if(dlg.id!\u003d\"\"){\n                    data.id \u003d dlg.id;\n                    Table.actions_query.rowGet(dlg.tableId,dlg.id,function(json){\n                        data.data \u003d json.data; \n                        node.loadHtmlDomDB({\"view\":\u0027dialog.html\u0027,\"style\":\u0027style.css\u0027,\"data\":data,\"module\":_this},() \u003d\u003e {\n                            // const drag \u003d dlg.dlg.content.querySelector(\".dlg_top\");\n                            // const dragContent \u003d dlg.dlg.node;\n                                                        \n                            // Tools.drag({\n                            //     dragEl:drag,\n                            //     dragContainerEl:dragContent\n                            // })\n                            if(cb)cb()\n                        })\n                    })\n                }else{\n                    node.loadHtmlDomDB({\"view\":\u0027dialog.html\u0027,\"style\":\u0027style.css\u0027,\"data\":data,\"module\":_this}, () \u003d\u003e {\n                        if(cb)cb()\n                    })    \n                }\n            }\n        })\n    }\n    close(){\n        this.dlg.close()\n    }\n}\n\nthis.define(\u0027dlgSave\u0027,function(tableId,id){\n    var json \u003d {};\n    var fields \u003d Table.dialog.dlg.content.getElements(\u0027textarea\u0027);\n    fields.forEach(function(f){\n        var name \u003d f.get(\u0027o2-element-name\u0027);\n        var type \u003d f.get(\u0027o2-element-type\u0027);\n        var value \u003d f.get(\u0027value\u0027); \n        if(type\u003d\u003d\"stringMap\"){\n            if(value \u003d\u003d \"\"){\n                json[name] \u003d {};    \n            }else{\n                json[name] \u003d JSON.parse(value);        \n            }\n        }else if(type.indexOf(\"List\")\u003e0){\n            if(value \u003d\u003d \"\"){\n                json[name] \u003d [];    \n            }else{\n                json[name] \u003d JSON.parse(value);        \n            }\n        }else{\n            json[name] \u003d value\n        }\n    })\n    \n    if(id \u003d\u003d \u0027\u0027){\n       Table.actions_query.rowInsert(tableId,json,function(){\n           Tools.notification(\u0027保存成功!\u0027,function(){\n                Table.table.reload(true);\n            });\n           Table.dialog.close()\n       }) \n    }else{ \n        Table.actions_query.rowUpdate(tableId,id,json,function(){\n            Tools.notification(\u0027保存成功!\u0027,function(){\n                Table.table.reload(true);\n            });\n            Table.dialog.close();\n        })\n    }\n})\nthis.define(\u0027dlgDelete\u0027,function(tableId,id){\n    this.form.confirm(\u0027warn\u0027,\u0027删除\u0027,\u0027确定删除？\u0027,300,120,function(){\n        \n        Table.actions_query.rowDelete(tableId,id,function(){\n            Tools.notification(\u0027删除成功!\u0027,function(){\n                Table.table.reload(true);\n            });\n            Table.dialog.close();\n            this.close();\n        }.bind(this)) \n    },function(){ this.close(); })\n})\n\nthis.define(\u0027dlgClose\u0027,function(){\n    Table.dialog.dlg.close()\n})\n\n\n\n\n\n\n\n\n",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-11-04 17:46:14",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "7f0a69e6-3d48-4af7-ba4a-88fe53508abc",
          "name": "table.html",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003ctable class\u003d\"layout_table\"\u003e\n    \u003cthead class\u003d\"table_thead\" data-o2-element\u003d\"thead\"\u003e\n        \u003ctr\u003e\n            \u003ctd width\u003d\"30\"\u003e\u003cinput type\u003d\"checkbox\" data-o2-events\u003d\"click:tableSelectAll;\" /\u003e\u003c/td\u003e\n            \u003ctd\u003eid\u003c/td\u003e\n            \u003ctd width\u003d\"150\"\u003e\n                \u003cdiv class\u003d\"table_th\"\u003e\n                    \u003cspan\u003ecreateTime\u003c/span\u003e\n                    \u003cdiv class\u003d\"sort_item_content\"\u003e\n                        \u003cdiv class\u003d\"sort_item o2-table o2-table-shangjiantou {{ $.data.sort.orderBy\u003d\u003d\u0027createTime\u0027 \u0026\u0026 $.data.sort.descOrder\u003d\u003d\u0027asc\u0027?\u0027sort_item_click\u0027:\u0027\u0027 }}\n                            \" title\u003d\"升序\" data-o2-events\u003d\"click:tableSort:createTime:asc;\"\u003e\u003c/div\u003e\n                        \u003cdiv class\u003d\"sort_item o2-table o2-table-xiajiantou {{ $.data.sort.orderBy\u003d\u003d\u0027createTime\u0027 \u0026\u0026 $.data.sort.descOrder\u003d\u003d\u0027desc\u0027?\u0027sort_item_click\u0027:\u0027\u0027 }}\n                            \" title\u003d\"降序\" data-o2-events\u003d\"click:tableSort:createTime:desc;\"\u003e\u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/td\u003e\n            \u003ctd width\u003d\"150\"\u003e\n                \u003cdiv class\u003d\"table_th\"\u003e\n                    \u003cspan\u003eupdateTime\u003c/span\u003e\n                    \u003cdiv class\u003d\"sort_item_content\"\u003e\n                        \u003cdiv class\u003d\"sort_item o2-table o2-table-shangjiantou {{ $.data.sort.orderBy\u003d\u003d\u0027updateTime\u0027 \u0026\u0026 $.data.sort.descOrder\u003d\u003d\u0027asc\u0027?\u0027sort_item_click\u0027:\u0027\u0027 }}\n                            \" title\u003d\"升序\" data-o2-events\u003d\"click:tableSort:updateTime:asc;\"\u003e\u003c/div\u003e\n                        \u003cdiv class\u003d\"sort_item o2-table o2-table-xiajiantou {{ $.data.sort.orderBy\u003d\u003d\u0027updateTime\u0027 \u0026\u0026 $.data.sort.descOrder\u003d\u003d\u0027desc\u0027?\u0027sort_item_click\u0027:\u0027\u0027 }}\n                            \" title\u003d\"降序\" data-o2-events\u003d\"click:tableSort:updateTime:desc;\"\u003e\u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/td\u003e\n            {{each $.data.fields}}\n            \u003ctd\u003e\n                \u003cdiv class\u003d\"table_th\"\u003e\n                    \u003cspan title \u003d \"{{$.description}}\"\u003e{{$.name}}\u003c/span\u003e\n                    \u003cdiv class\u003d\"sort_item_content\"\u003e\n                        \u003cdiv class\u003d\"sort_item o2-table o2-table-shangjiantou {{ $._.data.sort.orderBy\u003d\u003d$.name \u0026\u0026 $._.data.sort.descOrder\u003d\u003d\u0027asc\u0027?\u0027sort_item_click\u0027:\u0027\u0027 }}\n                            \" title\u003d\"升序\" data-o2-events\u003d\"click:tableSort:{{$.name}}:asc;\"\u003e\u003c/div\u003e\n                        \u003cdiv class\u003d\"sort_item o2-table o2-table-xiajiantou {{ $._.data.sort.orderBy\u003d\u003d$.name \u0026\u0026 $._.data.sort.descOrder\u003d\u003d\u0027desc\u0027?\u0027sort_item_click\u0027:\u0027\u0027 }}\n                            \" title\u003d\"降序\" data-o2-events\u003d\"click:tableSort:{{$.name}}:desc;\"\u003e\u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/td\u003e\n            {{end each}}\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody class\u003d\"table_body\" data-o2-element\u003d\"tbody\"\u003e\n        {{each $.data.data}}\n        \u003c!-- \u003ctr title\u003d\"双击打开\" data-o2-events\u003d\"dblclick:tableOpenRow:{{$.id}};\"\u003e --\u003e\n        \u003ctr\u003e\n            \u003ctd style\u003d\"text-align:center;\"\u003e\u003cinput type\u003d\"checkbox\" name\u003d\"rowcheck\" id\u003d\"{{$.id}}\" /\u003e\u003c/td\u003e\n            \u003ctd style\u003d\"cursor:pointer;\" data-o2-events\u003d\"click:tableOpenRow:{{$.id}};\"\u003e{{$.id}}\u003c/td\u003e\n            \u003ctd\u003e{{$.createTime}}\u003c/td\u003e\n            \u003ctd\u003e{{$.updateTime}}\u003c/td\u003e\n            {{each $.fields}}\n            \u003ctd\u003e{{\n                (function(){ \n                    var name \u003d $.name; \n                    var type \u003d $.type;\n                    var value \u003d $._[name]; \n                    if(type \u003d\u003d \u0027stringMap\u0027){ \n                        return \u0027{...}\u0027\n                    }else if(type.indexOf(\u0027List\u0027)\u003e0){\n                        return \u0027[...]\u0027\n                    }else{\n                        //value \u003d value.length\u003e30?value.substring(0,28)+\"...\":value;\n                        \n                    }\n                    \n                    return value\n                })()\n            }}\u003c/td\u003e\n            {{end each}}\n        \u003c/tr\u003e\n        {{end each}}\n    \u003c/tbody\u003e\n\n\u003c/table\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-09-28 10:54:06",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "89ea5471-75ae-42a1-acf3-1e930618052b",
          "name": "viewInfor.html",
          "alias": "",
          "description": "",
          "validated": false,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003cdiv class\u003d\"infor_content\"\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e视图名称：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.name}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e创建时间：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.createTime}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e数据类型：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.type \u003d\u003d \u0027process\u0027 ? \u0027流程\u0027:\u0027信息\u0027}}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"infor_item\"\u003e\n        \u003cdiv class\u003d\"infor_title\"\u003e描述：\u003c/div\u003e\n        \u003cdiv class\u003d\"infor_value\"\u003e{{$.data.description \u003d\u003d \u0027\u0027?\u0027无\u0027:$.data.description}}\u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2023-03-03 14:03:29",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "9f7f346a-23b5-42f3-b8e3-0d4ce50a638d",
          "name": "Table",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "var _this \u003d this;\nwindow.Tools \u003d window.Tools || {};\n\nTools.Table \u003d new Class({\n    Implements: [Events, Options],\n    options: {\n        \n    },\n    initialize: function (node,data,options) { \n        this.setOptions(options);\n        this.container \u003d node || _this.form.getApp().content;\n        this.data \u003d data || {};\n        this.application \u003d this.options.application ||\u0027Tools\u0027,\n        this.view \u003d this.options.view || \u0027table.html\u0027;\n        this.style \u003d this.options.style || \u0027table.css\u0027;\n        this.callback \u003d this.options.callback || null;\n        \n        this.load();\n    },\n    load:function(){ \n        this.getData();\n        \n        this.container.loadHtmlDomDB({\"view\":this.view,\"style\":this.style,\"data\":this.data,\"application\":this.application,\u0027module\u0027:_this},function(){\n            if(this.callback)this.callback()\n        }.bind(this))\n    },\n    getData:function(){\n        this.data \u003d this.data || {}\n    }\n})",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-11-04 17:46:33",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "b0591621-f75f-4d93-b7e4-6d1998c0919b",
          "name": "Tools",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "var _this \u003d this;\nwindow.Tools \u003d window.Tools || {};\n\n/*\n* 获取设计中脚本内容（门户）\n* options json对象,如果是string 当前应用的脚本名称\n* application: 应用名称，id，别名\n* name: 脚本名称\n*/\nTools.getScriptText \u003d function(options){\n    var res \u003d \"\";\n    //var application \u003d _this.form.app.pageInfor.portal;\n    var application \u003d _this.page.infor.portal;\n    if(typeof(options) \u003d\u003d \u0027string\u0027){\n        name \u003d options\n    }else{\n        application \u003d options.application || application;\n        name \u003d options.name\n    }\n    o2.Actions.load(\"x_portal_assemble_surface\").ScriptAction.getImported(application,name,function( json ){ \n        var data \u003d json.data; \n        res \u003d data.text\n    },null,false);\n    return res\n}\n\n/*\n* 提示方法,成功，警告，错误\n*参数1：提示内容\n*参数2：提示类型，成功success，警告warn，错误error\n*参数3：提示区域\n*参数4：回调方法\n*\n*/\nTools.notice \u003d function(m,t,c,cb){\n    var type \u003d t || \"success\";\n    var message \u003d m || \"提示信息\";\n    //若要在container容器中显示，需把position设置为relative配合使用\n    var container \u003d c || _this.form.getApp().content || $(document.body);\n    var callback \u003d cb || null;\n    \n    var warnIcon \u003d \"data:image/png;base64,\";\n    var successIcon \u003d \"data:image/png;base64,\";\n    var errorIcon \u003d \"data:image/png;base64,\";\n    var curIcon \u003d successIcon;\n    \n    var stayTime \u003d 1500;\n    var showTime \u003d 200;\n    var destroyTime \u003d 400;\n    \n    var Funs \u003d {\n        show : function(){\n            var fx \u003d new Fx.Morph(node, {duration: showTime});\n            fx.start({\n                \u0027opacity\u0027: [\"0\", \"1\"],\n                \u0027top\u0027: [\"0px\",\"30px\"]\n            }).chain(function(){\n                window.setTimeout(function() {\n                    fx \u003d new Fx.Morph(node, {duration: destroyTime});\n                    fx.start({\n                        \"top\":[\"30px\",\"0px\"],\n                        \"opacity\":[\"1\",\"0\"]\n                    }).chain(function(){\n                        Funs.destroy();\n                    });\n                }, stayTime);\n            });\n        },\n        \n        destroy : function(){\n            node.destroy();\n            if(callback)callback();\n        },\n        \n        setPosition : function(){\n            var _size \u003d container.getSize();\n            var _left \u003d (_size.x - node.getSize().x) / 2 ;\n            node.setStyles({\n                \"left\":_left + \"px\"\n            });\n        }\n    };\n    \n    var getData \u003d function(){\n        var data \u003d {};\n        return data;\n    };\n    var getStyles \u003d function(){\n        var styles \u003d {};\n        styles.node \u003d {\n            \"min-width\":\"100px\",\n            \"display\":\"flex\",\n            \"align-items\":\"center\",\n            \"justify-content\":\"center\",\n            \"background-color\":\"#f0f9eb\",\n            \"border-radius\":\"8px\",\n            \"position\":\"absolute\",\n            \"top\":\"0px\",\n            \"opacity\":\"0\",\n            \"padding\":\"6px\",\n            \"z-index\":\"999999\"\n        };\n        styles.icon \u003d {\n            \"width\":\"20px\",\n            \"height\":\"20px\",\n            \"display\":\"flex\",\n            \"align-items\":\"center\",\n            \"justify-content\":\"center\",\n            \"background-position\":\"center\",\n            \"background-repeat\":\"no-repeat\",\n            \"background-size\":\"contain\",\n        };\n        styles.message \u003d {\n            \"display\":\"flex\",\n            \"max-width\":\"300px\",\n            \"margin-left\":\"10px\",\n            \"align-items\":\"center\",\n            \"justify-content\":\"center\",\n            \"color\":\"#67c23a\"\n        };\n        return styles;\n    };\n    \n    this.styles \u003d getStyles();\n    this.data \u003d getData();\n    \n    var node \u003d new Element(\"div\",{styles:this.styles.node}).inject(container);\n    var iconNode \u003d new Element(\"div\",{styles:this.styles.icon}).inject(node);\n    var messageNode \u003d new Element(\"div\",{styles:this.styles.message,text:message}).inject(node);\n    \n    if(type\u003d\u003d\"warn\"){\n        curIcon \u003d warnIcon;  \n        node.setStyles({\"background-color\":\"#fdf6ec\"});\n        messageNode.setStyles({\"color\":\"#e6a23c\"});\n    }else if(type\u003d\u003d\"error\"){\n        curIcon \u003d errorIcon;  \n        node.setStyles({\"background-color\":\"#fef0f0\"});\n        messageNode.setStyles({\"color\":\"#f56c6c\"});\n    } \n    iconNode.setStyles({\"background-image\":\"url(\u0027\"+curIcon+\"\u0027)\"});\n    \n    Funs.show();\n    Funs.setPosition();\n};\n\n\n/*\n*提示框\n*参数如果是string 值就是提示内容 config为默认值\n*参数如果是json对象\n* title:提示框标题，content:提示内容，placement:提示框位置(topright,bottomright,topleft,topbottom)\n* duration:提示框消失时间（秒），width:提示框宽度，height:提示框高度，gap:间隔像素\n*/\nTools.notification \u003d function(params,cb){ \n    var options \u003d {};\n    if(typeof(params) \u003d\u003d \u0027string\u0027) options.content \u003d params || \u0027\u0027\n    else options \u003d params\n    \n    var _gap \u003d options \u0026\u0026 options.gap || 20; //距边距多少像素\n    var container \u003d _this.form.getApp().content || $(document.body);\n    var layout;\n    if(container.getElement(\u0027.o2_layout_notification\u0027)){\n        layout \u003d container.getElement(\u0027.o2_layout_notification\u0027)\n    }else{\n        layout \u003d new Element(\u0027div.o2_layout_notification\u0027,{styles:{\n            \u0027display\u0027:\u0027flex\u0027,\n            \u0027position\u0027:\u0027fixed\u0027,\n            \u0027z-index\u0027:\u0027999999\u0027,\n            \u0027padding\u0027:_gap+\u0027px\u0027\n        }}).inject(container)\n    }\n    \n    let NotificationClass \u003d class{\n        constructor(options){ \n            this.layout \u003d options.layout;\n            this.title \u003d options.title || \u0027提示信息\u0027;\n            this.content \u003d options.content || \u0027\u0027;\n            this.placement \u003d options.placement || \u0027topright\u0027; //弹出位置 topright、topleft、bottomright、bottomleft、top、bottom\n            this.duration \u003d options.duration || 3000; //延时时间关闭\n            this.width \u003d options.width || 300;\n            this.height \u003d options.height || 100;\n            this.gap \u003d options.gap || 20; //距边距多少像素\n            this.cb \u003d options.cb; //回调方法\n        }\n        open(){\n            var sepHeight \u003d _this.form.app.inBrowser ? 0 : 71;\n            this.notificationItem \u003d new Element(\u0027div.notificationItem\u0027,{styles:{\n                \u0027position\u0027:\u0027relative\u0027,\n                \u0027border-radius\u0027:\u00278px\u0027,\n                \u0027background-color\u0027:\u0027#ffffff\u0027,\n                \u0027width\u0027:this.width+\u0027px\u0027,\n                \u0027height\u0027:this.height+\u0027px\u0027,\n                \u0027overflow\u0027:\u0027hidden\u0027,\n                \u0027padding\u0027:\u002710px \u0027+this.gap+\u0027px\u0027,\n                \u0027margin-bottom\u0027:this.gap+\u0027px\u0027,\n                \u0027box-shadow\u0027:\u00270 4px 16px 0 rgb(0 0 0 / 8%), 0 3px 6px -4px rgb(0 0 0 / 12%), 0 9px 28px 8px rgb(0 0 0 / 5%)\u0027\n            }}).inject(this.layout);\n            \n            window.setTimeout(function(){ \n                this.close()\n            }.bind(this),this.duration);\n            \n            var fx \u003d new Fx.Morph(this.notificationItem, {duration: 200});\n            if(this.placement \u003d\u003d \u0027topright\u0027 || this.placement \u003d\u003d \u0027bottomright\u0027){\n                this.layout.setStyles({\u0027right\u0027:\u00270px\u0027});\n                if(this.placement \u003d\u003d \u0027topright\u0027){\n                    this.layout.setStyles({\u0027flex-direction\u0027:\u0027column\u0027,\u0027top\u0027:(sepHeight)+\u0027px\u0027})\n                }else{\n                    this.layout.setStyles({\u0027flex-direction\u0027:\u0027column-reverse\u0027,\u0027bottom\u0027:\u00270px\u0027})\n                }\n                this.notificationItem.setStyles({\u0027left\u0027:(this.width + this.gap*4)+ \u0027px\u0027});\n                fx.start({\u0027left\u0027:[\u00270px\u0027]}).chain(function(){\n                    if(this.cb)this.cb()\n                }.bind(this))\n                \n            }else if(this.placement \u003d\u003d \u0027topleft\u0027 || this.placement \u003d\u003d \u0027bottomleft\u0027){\n                this.layout.setStyles({\u0027left\u0027:\u00270px\u0027});\n                if(this.placement \u003d\u003d \u0027topleft\u0027){\n                    this.layout.setStyles({\u0027flex-direction\u0027:\u0027column\u0027,\u0027top\u0027:(sepHeight)+\u0027px\u0027})\n                }else{\n                    this.layout.setStyles({\u0027flex-direction\u0027:\u0027column-reverse\u0027,\u0027bottom\u0027:\u00270px\u0027})\n                }\n                this.notificationItem.setStyles({\u0027left\u0027:-(this.width + this.gap*4)+ \u0027px\u0027});\n                fx.start({\u0027left\u0027:[\u00270px\u0027]}).chain(function(){\n                    if(this.cb)this.cb()\n                }.bind(this))\n            }\n        \n            var layout_title \u003d new Element(\u0027div\u0027,{styles:{ \u0027width\u0027:\u0027100%\u0027,\u0027height\u0027:\u002740px\u0027,\u0027display\u0027:\u0027flex\u0027,\u0027align-items\u0027:\u0027center\u0027,\u0027justify-content\u0027:\u0027space-between\u0027 }}).inject(this.notificationItem);\n            new Element(\u0027div\u0027,{text:this.title}).inject(layout_title);\n            var item_close \u003d new Element(\u0027div\u0027,{styles:{ \u0027width\u0027:\u002716px\u0027,\u0027height\u0027:\u002716px\u0027,\u0027border-radius\u0027:\u00274px\u0027,\u0027cursor\u0027:\u0027pointer\u0027,\u0027display\u0027:\u0027flex\u0027,\u0027align-items\u0027:\u0027center\u0027,\u0027justify-content\u0027:\u0027center\u0027 }}).inject(layout_title);\n            new Element(\u0027img\u0027,{styles:{\u0027width\u0027:\u002712px\u0027,\u0027height\u0027:\u002712px\u0027},\n                \u0027src\u0027:\u0027data:image/png;base64,\u003d\u0027\n            }).inject(item_close);\n            item_close.addEvents({\n                mouseover:function(){ this.setStyles({\u0027background-color\u0027:\u0027#dddddd\u0027}) },\n                mouseout:function(){ this.setStyles({\u0027background-color\u0027:\u0027\u0027}) },\n                click:function(){ this.close() }.bind(this)\n            })\n            var layout_content \u003d new Element(\u0027div\u0027,{text:this.content}).inject(this.notificationItem);\n        }\n        close(){\n            if(!this.notificationItem) return;\n            var desFx \u003d new Fx.Morph(this.notificationItem, {duration: 200});\n            desFx.start({\u0027height\u0027:[\u00270px\u0027],\u0027padding-top\u0027:[\u00270px\u0027],\u0027padding-bottom\u0027:[\u00270px\u0027],\u0027margin-bottom\u0027:[\u00270px\u0027]}).chain(function(){\n                this.notificationItem.destroy();\n            }.bind(this))\n        }\n    }\n    \n    options.layout \u003d layout;\n    options.gap \u003d _gap;\n    if(cb) options.cb \u003d cb;\n    new NotificationClass(options).open()\n}\n\n/*\n*提示\n*参数1：提示内容\n*参数2：触发dom，鼠标移上去的dom对象\n*参数3: 对象{\"direction\":\"top|left|right|bottom\"}\n*/\n\nTools.tips \u003d new Class({\n    Implements: [Events, Options],\n    initialize: function(m,t,options){\n        this.setOptions(options);\n        \n        this.message \u003d m || \"提示信息\";\n        this.container \u003d  _this.form.getApp().content || $(document.body);\n        \n        this.target \u003d t || this.container;\n        //this.callback \u003d cb || null;\n        this.direction \u003d this.options.direction || \"top\";\n        this.checkTime \u003d 0;\n        this.load();\n    },\n    load:function(){\n        //console.log(\"------\"+this.direction+\"------\");\n        this.checkTime ++;\n        //console.log(this.checkTime)\n        if(this.checkTime\u003e5){\n            this.node.destroy();\n            return;\n        } \n        \n        if(this.container.getElementById(\"toolTips\")) this.container.getElementById(\"toolTips\").destroy();\n        \n        this.styles \u003d this.getStyles();\n        Object.merge(this.styles,this.options.styles);\n        \n        this.createNode();\n        \n        var fx \u003d new Fx.Morph(this.node, {duration: 200});\n        fx.start().chain(function(){\n            var fx1 \u003d new Fx.Morph(this.node, {duration: 300});\n            fx1.start({\u0027opacity\u0027: [\"0\", \"1\"],})\n        }.bind(this));\n        \n    },\n    destroy:function(){\n        //console.log(\"-----destroy------\")\n        if(this.node)this.node.destroy();\n        \n    },\n    createNode:function(){\n        if(this.node) this.node.destroy();\n        this.node \u003d new Element(\"div\",{id:\"toolTips\",styles:this.styles.node}).inject(this.container);\n        \n        this.createTriangle();\n        this.createMessage();\n        this.setPosition();\n    },\n    createTriangle:function(){\n        var _style \u003d {};\n        switch(this.direction){\n            case \"top\":\n                _styles \u003d this.styles.topTriangle;\n                this.node.setStyle(\"flex-direction\",\"column-reverse\");\n                break;\n            case \"bottom\":\n                _styles \u003d this.styles.bottomTriangle;\n                this.node.setStyle(\"flex-direction\",\"column\");\n                break;\n            case \"left\":\n                _styles \u003d this.styles.leftTriangle;\n                this.node.setStyle(\"flex-direction\",\"row-reverse\");\n                break;\n            case \"right\":\n                _styles \u003d this.styles.rightTriangle;\n                this.node.setStyle(\"flex-direction\",\"row\");\n                break;\n            default:\n                _styles \u003d this.styles.topTriangle;\n        }\n        \n        this.triangleNode \u003d new Element(\"div.triangle\",{styles:_styles}).inject(this.node);\n    },\n    \n    createMessage:function(){\n        this.messageNode \u003d new Element(\"div.message\",{styles:this.styles.message,text:this.message}).inject(this.node);\n        this.messageNode.setStyles({\n            \n        })\n    },\n    getPosition:function(){\n        //var co \u003d this.container.getCoordinates();\n        \n    },\n    setPosition:function(){\n        var co \u003d this.target.getCoordinates(this.container);\n        var node \u003d this.node.getCoordinates(this.container);\n        var _size \u003d this.container.getSize(this.container);\n        var gap \u003d this.gap \u003d 6; \n        if(this.direction \u003d\u003d \"top\"){ \n            this.node.setStyles({\n                \"top\":(co.top - node.height - gap)+\"px\",\n                \"left\":(co.left + (co.width - node.width) / 2)+\"px\"\n            });\n            \n            this.checkPosition();\n        \n        }else if(this.direction \u003d\u003d \"bottom\"){ \n            \n            this.node.setStyles({\n                \"top\":(co.top + co.height + gap)+\"px\",\n                \"left\":(co.left + (co.width - node.width) / 2)+\"px\"\n            });\n            \n            this.checkPosition();\n            \n        }else if(this.direction \u003d\u003d \"left\"){ \n            \n            if(node.width \u003e co.left + gap){\n                this.node.setStyles({\n                    \"left\":\"0px\",\n                    \"width\":(co.left - gap)+\"px\"\n                });\n                var _node \u003d this.node.getCoordinates();\n                this.node.setStyles({\n                    \"top\":(co.top + (co.height - _node.height) / 2)+\"px\"\n                })\n            }else{\n                this.node.setStyles({\n                    \"top\":(co.top + (co.height - node.height) / 2 )+\"px\",\n                    \"left\":(co.left - node.width - gap)+\"px\"\n                });\n            }\n            \n            this.checkPosition();\n            \n        }else if(this.direction \u003d\u003d \"right\"){ \n            this.node.setStyles({\n                \"left\":(co.left + co.width + gap)+\"px\"\n            });\n            var _node \u003d this.node.getCoordinates();\n            this.node.setStyle(\"top\",(co.top + (co.height - _node.height) / 2)+\"px\");\n            \n            this.checkPosition();\n            \n        }\n    },\n    checkPosition:function(){\n        //切换顺序，顺时针，上-\u003e右-\u003e下-\u003e左\n        var co \u003d this.target.getCoordinates(this.container);\n        var node \u003d this.node.getCoordinates(this.container);\n        var _size \u003d this.container.getSize(this.container);\n        if(this.direction \u003d\u003d \"top\"){ \n            \n            if(node.height + this.gap \u003e co.top){ //上部高度不够切换到右\n                this.direction \u003d \"right\";\n                this.load();\n                return;\n            }\n            if(node.left\u003c0){ //左侧不够切换到右\n                this.direction \u003d \"right\";\n                this.load();\n                return;\n            }\n            if(co.left + co.width/2 !\u003d node.left+node.width/2){ //右侧不够切换到右\n                this.direction \u003d \"right\";\n                this.load();\n                return;\n            }\n        }else if(this.direction \u003d\u003d \"bottom\"){\n            if(co.top + node.height \u003e _size.y){ //下部空间不够切换到左\n                this.direction \u003d \"left\";\n                this.load();\n                return;\n            }\n            if(co.left + co.width/2 !\u003d node.left+node.width/2){ //右边空间不够切换到左\n                this.direction \u003d \"left\";\n                this.load();\n                return;\n            }\n            \n        }else if(this.direction \u003d\u003d \"left\"){\n            \n            if(node.top\u003c0){ //上部不够切换到上\n                this.direction \u003d \"top\";\n                this.load();\n                return;\n            }\n            if(node.left + node.width \u003e co.left){ //左侧不够切换到上\n                this.direction \u003d \"top\";\n                this.load();\n                return;\n            }\n            \n        }else if(this.direction \u003d\u003d \"right\"){ \n            //node位置不会超过浏览器左右窗口\n            if(node.top \u003c 0){ //上部不够切换到下\n                this.direction \u003d \"bottom\";\n                this.load();\n                return;\n            }\n            if(node.left+node.width\u003e_size.x){ //右侧不够切换到下\n                this.direction \u003d \"bottom\";\n                this.load();\n                return;\n            }\n            \n        }\n    },\n    getStyles : function(){\n        var styles \u003d {};\n        styles.node \u003d {\n            \"display\":\"flex\",\n            \"max-width\":\"400px\",\n            \"max-height\":\"400px\",\n            \"min-width\":\"10px\",\n            \"min-height\":\"10px\",\n            \"overflow\":\"hidden\",\n            \"align-items\":\"center\",\n            \"justify-content\":\"center\",\n            \"background\":\"rgba(255,255,255,0)\",\n            \"position\":\"absolute\",\n            \"opacity\":\"0\",\n            \"z-index\":\"999999\"\n        };\n        styles.topTriangle \u003d {\n            \"width\":\"0px\",\n            \"height\":\"0px\",\n            \"display\":\"flex\",\n            \"border-top\": \"6px solid #000000\",\n            \"border-left\": \"6px solid transparent\",\n            \"border-right\": \"6px solid transparent\"\n        };\n        styles.bottomTriangle \u003d {\n            \"width\":\"0px\",\n            \"height\":\"0px\",\n            \"display\":\"flex\",\n            \"border-bottom\": \"6px solid #000000\",\n            \"border-left\": \"6px solid transparent\",\n            \"border-right\": \"6px solid transparent\"\n        };\n        styles.leftTriangle \u003d {\n            \"width\":\"0px\",\n            \"height\":\"0px\",\n            \"display\":\"flex\",\n            \"border-bottom\": \"6px solid transparent\",\n            \"border-top\": \"6px solid transparent\",\n            \"border-left\": \"6px solid #000000\"\n        };\n        styles.rightTriangle \u003d {\n            \"width\":\"0px\",\n            \"height\":\"0px\",\n            \"display\":\"flex\",\n            \"border-bottom\": \"6px solid transparent\",\n            \"border-top\": \"6px solid transparent\",\n            \"border-right\": \"6px solid #000000\"\n        };\n        styles.message \u003d {\n            \"display\":\"flex\",\n            \"background-color\":\"#000000\",\n            \"align-items\":\"center\",\n            \"justify-content\":\"center\",\n            \"border-radius\":\"4px\",\n            \"padding\":\"10px\",\n            \"color\":\"#ffffff\"\n        };\n        return styles;\n    }\n})\n\n\n\n/*\n* loading\n* 显示载入等待\n*参数1：显示区域\n*参数2：回调方法\n*/\nTools.loading \u003d function(c,cb){\n    \n    this.container \u003d c || _this.form.getApp().content || $(document.body);\n    this.callback \u003d cb || null;\n    \n    var getData \u003d function(){\n        var data \u003d {};\n        return data;\n    };\n    var getStyles \u003d function(){\n        var styles \u003d {};\n        styles.maskNode \u003d {\n            \"display\":\"flex\",\n            \"justify-content\":\"center\",\n            \"align-items\":\"center\",\n            \"position\":\"absolute\",\n            \"left\":\"0px\",\n            \"right\":\"0px\",\n            \"top\":\"0px\",\n            \"bottom\":\"0px\",\n            \"background\":\"rgba(255,255,255,0.2)\",\n            \"z-index\":\"999998\"\n        };\n        styles.loadingNode \u003d {\n            \"display\":\"flex\",\n            \"justify-content\":\"center\",\n            \"align-items\":\"center\",\n            \"z-index\":\"999999\"\n        };\n        styles.loadingItemNode \u003d {\n            \"width\":\"10px\",\n            \"height\":\"10px\",\n            \"border-radius\":\"5px\",\n            \"background-color\":\"#d4ede7\", //#dedede\n            \"margin\":\"5px\"\n        };\n        return styles;\n    }\n    \n    this.styles \u003d getStyles();\n    this.data \u003d getData();\n    \n    var maskNode \u003d this.maskNode \u003d new Element(\"div.maskNode\",{styles:this.styles.maskNode}).inject(this.container);\n    var loadingNode \u003d new Element(\"div\",{styles:this.styles.loadingNode}).inject(maskNode);\n    \n    var total \u003d 6;\n    for(var i\u003d0;i\u003ctotal;i++){\n        new Element(\"div\",{styles:this.styles.loadingItemNode}).inject(loadingNode);\n    }\n    \n    var allItem \u003d loadingNode.getElements(\"div\");\n    var curInt \u003d 0;\n    var arrow \u003d \"right\";\n    var it \u003d window.setInterval(function(){\n        allItem.setStyles(this.styles.loadingItemNode);\n        allItem[curInt].setStyles({\"background-color\":\"#00BD67\",\"width\":\"12px\",\"height\":\"12px\",\"border-radius\":\"6px\"}); //#4a90e2\n        if(arrow\u003d\u003d\"right\")curInt++;\n        else curInt--;\n        if(curInt \u003d\u003d total-1){\n            arrow\u003d\"left\";\n        }\n        if(curInt \u003d\u003d 0){\n            arrow\u003d\"right\";\n        } \n    }.bind(this),150);\n    \n    //this.setPosition();\n    if(this.callback)this.callback();\n    \n    return maskNode;\n    \n}\n\n\n/*\n* loading 风格2\n\nvar op \u003d {\n    \"node\":this.target.node, //作用到的node\n    \"size\":\"large\", //samll medium large， 默认medium 默认大小30 当out，和inner参数不传时有效\n    \"color\":\"blue\", //圆颜色\n    \"out\":100, //自定义整体大小\n    \"inner\":50, //自定义圆大小\n    \"time\":2000, //旋转一周时间\n}\nTools.loading(op)\n\n如果参数不传，加载到整个表单上，\n如果传的是dom对象，加载到该对象\n传json\u0027对象可以自定义参数\n\n* 显示载入等待\ntips:容器的position:relative;\n*/\n\nTools.loading \u003d function(options){\n    //this.container \u003d options \u0026\u0026 options.node || _this.form.getApp().content || $(document.body);\n    options \u003d options || {};\n    if(options instanceof HTMLElement){\n       this.node \u003d options \n    }else{\n        this.node \u003d options.node ||  _this.form.getApp().content || $(document.body);    \n    }\n    this.duration \u003d options.time || 1000; \n    this.color \u003d options.color || \"#28bd53\";\n    this.size \u003d options.size || \"medium\"; //samll medium large\n    this.out \u003d options.out || 0;\n    this.inner \u003d options.inner || 0;\n    \n    if(!this.node) return;\n\n    let l_size \u003d 30; //大框宽度\n    if(this.size \u003d\u003d \"small\"){\n        l_size \u003d 24;\n    }else if(this.size \u003d\u003d \"large\"){\n        l_size \u003d 48;\n    }\n    let s_size \u003d l_size/2; //小圆宽度\n    if(this.out \u003e 0 \u0026\u0026 this.inner \u003e0){\n        l_size \u003d parseInt(this.out);\n        s_size \u003d parseInt(this.inner);\n    }\n    var timestamp \u003d new Date().getTime().toString();\n    var styleTag \u003d document.createElement(\u0027style\u0027);\n    styleTag.innerHTML \u003d `\n        @keyframes tools_loading_box_${timestamp} {\n    \t  0% { transform: rotate(0deg); }\n    \t  50% { transform: rotate(180deg); }\n    \t  100% { transform: rotate(360deg);}\n    \t}\n    \t@keyframes tools_loading_box_item_1_${timestamp} {\n    \t  0% { opacity:1; }\n    \t  50% { opacity:0.4; }\n    \t  100% { opacity:1; }\n    \t}\n    \t@keyframes tools_loading_box_item_2_${timestamp} {\n    \t  0% { opacity:0.8; }\n    \t  28%{ opacity:0.4; }\n    \t  71% { opacity:1; }\n    \t  100% { opacity:0.8; }\n    \t}\n    \t@keyframes tools_loading_box_item_3_${timestamp} {\n    \t  0% { opacity:0.6; }\n    \t  14%{ opacity:0.4; }\n    \t  85%{ opacity:1; }\n    \t  100% { opacity:0.6; }\n    \t}\n    \t@keyframes tools_loading_box_item_4_${timestamp} {\n    \t  0% { opacity:0.4; }\n    \t  50% { opacity:1; }\n    \t  100% { opacity:0.4; }\n    \t}\n    `;\n\n    document.head.appendChild(styleTag);\n    let _css \u003d `\n        .tools_loading_box{\n    \t    width:${l_size}px;\n    \t\theight:${l_size}px;\n    \t\tposition:relative;\n    \t\tanimation: tools_loading_box_${timestamp} ${this.duration/1000}s linear infinite;\n    \t}\n    \t.tools_loading_box_item{\n    \t    position:absolute;\n    \t    display:block;\n    \t\twidth:${s_size}px;\n    \t\theight:${s_size}px;\n    \t\tborder-radius:${s_size/2}px;\n    \t\tbackground-color:${this.color};\n    \t}\n    \t.tools_loading_box_item_1{\n    \t\ttop:-${s_size/2}px;\n    \t\tleft:-${s_size/2}px;\n    \t\tanimation: tools_loading_box_item_1_${timestamp} ${this.duration/1000}s linear infinite;\n    \t}\n    \t.tools_loading_box_item_2{\n    \t\ttop:-${s_size/2}px;\n    \t\tright:-${s_size/2}px;\n    \t\tanimation: tools_loading_box_item_2_${timestamp} ${this.duration/1000}s linear infinite;\n    \t}\n    \t.tools_loading_box_item_3{\n    \t\tbottom:-${s_size/2}px;\n    \t\tright:-${s_size/2}px;\n    \t\tanimation: tools_loading_box_item_3_${timestamp} ${this.duration/1000}s linear infinite;\n    \t}\n    \t.tools_loading_box_item_4{\n    \t\tbottom:-${s_size/2}px;\n    \t\tleft:-${s_size/2}px;\n    \t\tanimation: tools_loading_box_item_4_${timestamp} ${this.duration/1000}s linear infinite;\n    \t}\n    `\n    const container \u003d new Element(\"div\",{styles:{\n        \"display\":\"flex\",\n        \"justify-content\":\"center\",\n        \"align-items\":\"center\",\n        \"position\":\"absolute\",\n        \"left\":\"0px\",\n        \"right\":\"0px\",\n        \"top\":\"0px\",\n        \"bottom\":\"0px\",\n        \"background\":\"rgba(255,255,255,0.2)\",\n        \"z-index\":\"999998\"\n    }}).inject(this.node);\n    container.loadCssText(_css);\n    const content \u003d new Element(\"div.tools_loading_box\").inject(container);\n    new Element(\"div.tools_loading_box_item.tools_loading_box_item_1\").inject(content);\n    new Element(\"div.tools_loading_box_item.tools_loading_box_item_2\").inject(content);\n    new Element(\"div.tools_loading_box_item.tools_loading_box_item_3\").inject(content);\n    new Element(\"div.tools_loading_box_item.tools_loading_box_item_4\").inject(content);\n    \n    return container;\n}\n\n\n\n\nTools.drag \u003d  function(config) {\n    const dragEl \u003d config.dragEl || config.node;\n    const container \u003d config.container || null;\n    const dragContainerEl \u003d config.dragContainerEl || dragEl;\n    const onMoveEvent \u003d config.onMoveEvent || null; // 移动过程中的事件\n    const onStopDragEvent \u003d config.onStopDragEvent || null;\n    const target \u003d config.target || null;\n    const onTargetEvent \u003d config.onTargetEvent || null;\n    const axis \u003d config.axis || \u0027both\u0027;\n    const minPosition \u003d config.minPosition || {}; // 新增：用于设置最小位置\n    \n    let offsetX \u003d 0;\n    let offsetY \u003d 0;\n    let isInTargetDuringDragging \u003d false; // 标记是否在拖拽过程中进入目标\n\n    function dragMouseDown(event) { \n        event.preventDefault();\n        offsetX \u003d event.clientX - dragContainerEl.offsetLeft;\n        offsetY \u003d event.clientY - dragContainerEl.offsetTop;\n        document.addEventListener(\"mousemove\", elementDrag);\n        document.addEventListener(\"mouseup\", stopElementDrag);\n    }\n\n    function elementDrag(event) { \n        event.preventDefault();\n        let x \u003d event.clientX - offsetX;\n        let y \u003d event.clientY - offsetY;\n        if (container) {\n            let maxX \u003d container.offsetWidth - dragContainerEl.offsetWidth;\n            let maxY \u003d container.offsetHeight - dragContainerEl.offsetHeight;\n            x \u003d Math.max(0, Math.min(x, maxX));\n            y \u003d Math.max(0, Math.min(y, maxY));\n        }\n        \n        // dragContainerEl.style.left \u003d x + \"px\";\n        // dragContainerEl.style.top \u003d y + \"px\";\n        // if(axis \u003d\u003d\u003d \u0027x\u0027 || axis \u003d\u003d\u003d \u0027both\u0027) dragContainerEl.style.left \u003d x + \"px\";\n        // if(axis \u003d\u003d\u003d \u0027y\u0027 || axis \u003d\u003d\u003d \u0027both\u0027) dragContainerEl.style.top \u003d y + \"px\";\n        if ((axis \u003d\u003d\u003d \u0027x\u0027 || axis \u003d\u003d\u003d \u0027both\u0027) \u0026\u0026 (minPosition.x \u003d\u003d\u003d undefined || x \u003e\u003d minPosition.x)) {\n            dragContainerEl.style.left \u003d x + \"px\";\n        }\n        if ((axis \u003d\u003d\u003d \u0027y\u0027 || axis \u003d\u003d\u003d \u0027both\u0027) \u0026\u0026 (minPosition.y \u003d\u003d\u003d undefined || y \u003e\u003d minPosition.y)) {\n            dragContainerEl.style.top \u003d y + \"px\";\n        }\n\n        // 调用移动事件处理器\n        if (onMoveEvent) {\n            onMoveEvent(x, y); // 传递当前位置给回调函数\n        }\n\n        // 在拖动过程中持续检查是否进入或离开目标容器\n        if (target \u0026\u0026 onTargetEvent) {\n            const rect \u003d target.getBoundingClientRect();\n            const isIn \u003d x \u003e\u003d rect.left \u0026\u0026 x \u003c\u003d rect.right \u0026\u0026 y \u003e\u003d rect.top \u0026\u0026 y \u003c\u003d rect.bottom;\n            onTargetEvent(target, isIn ? \u0027enter\u0027 : \u0027leave\u0027); // 触发相应事件\n        }\n\n    }\n\n    function stopElementDrag() {\n        document.removeEventListener(\"mousemove\", elementDrag);\n        document.removeEventListener(\"mouseup\", stopElementDrag);\n\n        // 在拖动结束后再次检查是否在目标容器内\n        if (target \u0026\u0026 onTargetEvent) {\n            const rect \u003d target.getBoundingClientRect();\n            const x \u003d dragContainerEl.offsetLeft;\n            const y \u003d dragContainerEl.offsetTop;\n            const isIn \u003d x \u003e\u003d rect.left \u0026\u0026 x \u003c\u003d rect.right \u0026\u0026 y \u003e\u003d rect.top \u0026\u0026 y \u003c\u003d rect.bottom;\n            onTargetEvent(target, isIn ? \u0027stopped\u0027 : \u0027\u0027); // 停止拖动是否在target内\n        }\n\n        if (onStopDragEvent) {\n            onStopDragEvent(); // 执行停止拖动事件\n        }\n    }\n\n    dragEl.addEventListener(\"mousedown\", dragMouseDown);\n}\n\n\n\n\n\nconst O8_model \u003d class {\n    constructor(node, options, cb) { \n        if (!options.module) return;\n        \n        this.node \u003d node;\n        this.module \u003d options.module;\n        this.view \u003d options.view || \u0027view.html\u0027;\n        this.viewText \u003d options.viewText || null;\n        this.style \u003d options.style;\n        this.styleText \u003d options.styleText || null;\n        this.data \u003d options.data || {};\n        this.cb \u003d cb || null;\n\n        if (!(this.viewText \u0026\u0026 this.styleText)) {\n            if (options.application) {\n                this.application \u003d options.application;\n            } else if (this.module.page \u0026\u0026 this.module.page.app) {\n                if (this.module.page.app.portal) {\n                    this.application \u003d this.module.page.app.portal.id;\n                } else if (this.module.page.app.pageInfor) {\n                    this.application \u003d this.module.page.app.pageInfor.portal;\n                }\n            } else {\n                return;\n            }\n        }\n\n        this.load();\n    }\n    load() {\n        this.node.empty();\n        this.loadStyle();\n        this.loadHtml();\n    }\n    async getScriptText(name) {\n        const portal \u003d this.application;\n        \n        let json \u003d await o2.Actions.load(\"x_portal_assemble_surface\").ScriptAction.getImported(portal, name);\n        if(json \u0026\u0026 json.data \u0026\u0026 json.data.text){\n            return json.data.text\n        }else{\n            return \"\"\n        }\n\n    }\n    async loadHtml() {\n        const _viewText \u003d this.viewText || await this.getScriptText(this.view);\n        const json \u003d { \"data\": this.data };\n        o2.injectHtml(_viewText, { \"dom\": this.node, \"bind\": json, \"module\": this.module });\n        if(this.cb) this.cb()\n    }\n    async loadStyle() {\n        const _css \u003d this.styleText || await this.getScriptText(this.style);\n        if (_css !\u003d\u003d \u0027\u0027) this.node.loadCssText(_css);\n    }\n};\n\nif (window.Element) {\n    if (!(Object.prototype.hasOwnProperty.call(Element.prototype, \u0027loadHtmlDomDB\u0027) \u0026\u0026 typeof Element.prototype[\u0027loadHtmlDomDB\u0027] \u003d\u003d\u003d \"function\")) {\n        Element.prototype.loadHtmlDomDB \u003d function(op, callback) {\n            new O8_model(this,op,callback);\n        }\n    }\n}\n\n",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
