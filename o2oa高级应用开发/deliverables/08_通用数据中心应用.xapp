          "text": "@font-face {\r\n  font-family: \"o2-table\"; /* Project id 3921524 */\r\n  src: url(\u0027../x_portal_assemble_surface/jaxrs/file/iconfont.woff2/portal/数据管理/content?t\u003d16775654017\u0027) format(\u0027woff2\u0027),\r\n       url(\u0027../x_portal_assemble_surface/jaxrs/file/iconfont.woff/portal/数据管理/content?t\u003d16775654017\u0027) format(\u0027woff\u0027),\r\n       url(\u0027../x_portal_assemble_surface/jaxrs/iconfont.ttf/portal/数据管理/content.ttf?t\u003d16775654017\u0027) format(\u0027truetype\u0027),\r\n       url(\u0027../x_portal_assemble_surface/jaxrs/file/iconfont.svg/portal/数据管理/content?t\u003d16775654017#o2-table\u0027) format(\u0027svg\u0027);\r\n}\r\n\r\n\r\n.o2-table {\r\n  font-family: \"o2-table\" !important;\r\n  font-size: 16px;\r\n  font-style: normal;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n}\r\n\r\n.o2-table-baocun1:before {\r\n  content: \"\\e64a\";\r\n}\r\n\r\n.o2-table-Vector-6:before {\r\n  content: \"\\e605\";\r\n}\r\n\r\n.o2-table-shanchu:before {\r\n  content: \"\\e608\";\r\n}\r\n\r\n.o2-table-grid:before {\r\n  content: \"\\eb60\";\r\n}\r\n\r\n.o2-table-view:before {\r\n  content: \"\\e91f\";\r\n}\r\n\r\n.o2-table-jiantou-up:before {\r\n  content: \"\\e6b7\";\r\n}\r\n\r\n.o2-table-jiantou-down:before {\r\n  content: \"\\e6b8\";\r\n}\r\n\r\n.o2-table-huiche:before {\r\n  content: \"\\e65a\";\r\n}\r\n\r\n.o2-table-close-bold:before {\r\n  content: \"\\e685\";\r\n}\r\n\r\n.o2-table-youjiantou:before {\r\n  content: \"\\e6b5\";\r\n}\r\n\r\n.o2-table-zuojiantou:before {\r\n  content: \"\\e6b6\";\r\n}\r\n\r\n.o2-table-tianjia:before {\r\n  content: \"\\e61f\";\r\n}\r\n\r\n.o2-table-youjiantou-fill:before {\r\n  content: \"\\e617\";\r\n}\r\n\r\n.o2-table-zuojiantou-fill:before {\r\n  content: \"\\e619\";\r\n}\r\n\r\n.o2-table-refresh:before {\r\n  content: \"\\e981\";\r\n}\r\n\r\n.o2-table-shangjiantou:before {\r\n  content: \"\\e600\";\r\n}\r\n\r\n.o2-table-xiajiantou:before {\r\n  content: \"\\e601\";\r\n}\r\n\r\n",
