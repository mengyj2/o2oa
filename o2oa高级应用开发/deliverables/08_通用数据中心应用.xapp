        {
          "id": "2dd0a981-e7d4-439b-a44a-87064666badf",
          "name": "viewPagination.html",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003cdiv class\u003d\"layout_pagination\"\u003e\n    \n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"刷新\"  data-o2-events\u003d\"click:viewReload;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-refresh\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"上页\"  data-o2-events\u003d\"click:viewPrev;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-zuojiantou\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"下页\"  data-o2-events\u003d\"click:viewNext;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-youjiantou\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_paging\"\u003e\n        \u003cdiv\u003e\n            \u003cspan\u003e每页\u003c/span\u003e\n            \u003cspan\u003e{{$.data.size}}\u003c/span\u003e\n            \u003cspan\u003e条\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e{{$.data.page}}/{{$.data.totalPage}}\u003c/div\u003e\n        \u003cdiv\u003e\u003cspan\u003e总共\u003cspan\u003e\u003cspan\u003e{{$.data.total}}\u003c/span\u003e\u003cspan\u003e条\u003cspan\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-09-25 15:57:43",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
