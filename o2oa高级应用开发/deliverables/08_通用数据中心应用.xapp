        {
          "id": "2bf1b4da-c152-4063-b549-b9874418a1d2",
          "name": "navi.html",
          "alias": "",
          "description": "",
          "validated": false,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "{{each $.data}}\n    \u003cdiv class\u003d\"navi_item_layout\"\u003e\n        \u003cdiv class\u003d\"navi_item_title\" data-o2-events\u003d\"click:naviItemOpen;\" id\u003d\"{{$.id}}\" o2-element-status\u003d\"false\"\u003e\n            \u003cdiv\u003e\n                \u003cdiv class\u003d\"navi_item_title_name\"\u003e{{$.name}}\u003c/div\u003e\n                \u003cdiv class\u003d\"navi_item_title_count\"\u003e({{$.table.length + $.viewList.length}})\u003c/div\u003e\n            \u003c/div\u003e\n            \u003cdiv class\u003d\"navi_item_arrow o2-table o2-table-jiantou-down\"\u003e\u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"navi_item_content\"\u003e\n            {{each $.viewList}}\n            \u003cdiv class\u003d\"navi_item_table_title\"  id\u003d\"{{$.query}}\" data-o2-events\u003d\"click:openView:{{$.name}}:{{$.query}};\"\u003e\n                \u003cdiv class\u003d\"navi_item_table_title_icon o2-table o2-table-view\"\u003e\u003c/div\u003e\u003cdiv class\u003d\"navi_item_table_title_name\"\u003e{{$.name}}\u003c/div\u003e\n            \u003c/div\u003e\n            {{end each}}\n            {{each $.table}}\n            \u003cdiv class\u003d\"navi_item_table_title\"  id\u003d\"{{$.id}}\" data-o2-events\u003d\"click:openTable:{{$.id}};\" title\u003d\"{{$.description}}\"\u003e\n                \u003cdiv class\u003d\"navi_item_table_title_icon o2-table o2-table-grid\"\u003e\u003c/div\u003e\u003cdiv class\u003d\"navi_item_table_title_name\"\u003e{{$.name}}\u003c/div\u003e\n            \u003c/div\u003e\n            {{end each}}\n        \u003c/div\u003e\n    \u003c/div\u003e\n{{end each}}\n",
