          "data": "SELECT o FROM Task o where o.person\u003d:person and ( o.applicationName \u003d \u0027发文管理\u0027 or o.applicationName \u003d \u0027收文管理\u0027 or o.applicationName \u003d \u0027会议既要类\u0027) order by o.startTime desc",
          "scriptText": "var pars \u003d  this.parameters;\nvar sql \u003d \"SELECT o FROM Read o where o.person\u003d:person \";\n\nif (pars.application){\n    sql +\u003d \" AND (o.application\u003d:application OR o.applicationName\u003d:application OR o.applicationAlias\u003d:application)\";\n}\nif(pars.processList){\n    sql +\u003d \" AND o.processName in (:processList)\";\n}\nif(pars.creator){\n    sql +\u003d \" AND o.creatorPerson\u003d:creator\"\n}\nif(pars.creatorUnit){\n    sql +\u003d \" AND o.creatorUnit\u003d:creatorUnit\"\n}\nif(pars.title){\n    sql +\u003d \" AND o.title like :title \"\n}\nsql \u003d sql + \" order by o.startTime desc\"\n\nconsole.log(sql);\nreturn sql;",
          "countData": "SELECT count(o.id) FROM Task o where o.person\u003d:person and ( o.applicationName \u003d \u0027发文管理\u0027 or o.applicationName \u003d \u0027收文管理\u0027 or o.applicationName \u003d \u0027会议既要类\u0027)",
          "countScriptText": "var pars \u003d  this.parameters;\nvar sql \u003d \"SELECT count(o.id) FROM Read o where o.person\u003d:person \";\n\nif (pars.application){\n    sql +\u003d \" AND (o.application\u003d:application OR o.applicationName\u003d:application OR o.applicationAlias\u003d:application)\";\n}\nif(pars.processList){\n    sql +\u003d \" AND o.processName in \" + pars.processList;\n}\nif(pars.creator){\n    sql +\u003d \" AND o.creatorPerson like :creator\"\n}\nif(pars.creatorUnit){\n    sql +\u003d \" AND o.creatorUnit like :creatorUnit\"\n}\nif(pars.title){\n    sql +\u003d \" AND o.title like :title \"\n}\nreturn sql;",
