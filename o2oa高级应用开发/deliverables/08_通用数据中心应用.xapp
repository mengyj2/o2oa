          "executeUnitList": [],
          "executeGroupList": [],
          "data": "SELECT o FROM Task o where o.person\u003d:person and ( o.applicationName \u003d \u0027发文管理\u0027 or o.applicationName \u003d \u0027收文管理\u0027 or o.applicationName \u003d \u0027会议既要类\u0027) order by o.startTime desc",
          "scriptText": "var pars \u003d  this.parameters;\nvar sql \u003d \"SELECT o FROM Review o where o.person\u003d:person \";\nif (pars.application){\n    sql +\u003d \" AND (o.application\u003d:application OR o.applicationName\u003d:application OR o.applicationAlias\u003d:application)\";\n}\nif(pars.processList){\n    sql +\u003d \" AND o.processName in (:processList)\";\n}\nif(pars.creator){\n    sql +\u003d \" AND o.creatorPerson\u003d:creator\"\n}\nif(pars.creatorUnit){\n    sql +\u003d \" AND o.creatorUnit\u003d:creatorUnit\"\n}\nif(pars.title){\n    sql +\u003d \" AND o.title like :title \"\n}\nsql \u003d sql + \" order by o.startTime desc\"\n\n\nreturn sql;",
          "countData": "SELECT count(o.id) FROM Task o where o.person\u003d:person and ( o.applicationName \u003d \u0027发文管理\u0027 or o.applicationName \u003d \u0027收文管理\u0027 or o.applicationName \u003d \u0027会议既要类\u0027)",
          "countScriptText": "var pars \u003d  this.parameters;\nvar sql \u003d \"SELECT count(o.id) FROM Review o where o.person\u003d:person AND o.completed\u003dFalse \";\n\nif (pars.application){\n    sql +\u003d \" AND (o.application\u003d:application OR o.applicationName\u003d:application OR o.applicationAlias\u003d:application)\";\n}\nif(pars.processList){\n    sql +\u003d \" AND o.processName in \" + pars.processList;\n}\nif(pars.creator){\n    sql +\u003d \" AND o.creatorPerson like :creator\"\n}\nif(pars.creatorUnit){\n    sql +\u003d \" AND o.creatorUnit like :creatorUnit\"\n}\nif(pars.title){\n    sql +\u003d \" AND o.title like :title \"\n}\nreturn sql;",
          "sqlScriptText": "var paramObj \u003d  parameters || {};\r\nvar application \u003d paramObj.application;\r\nvar processList \u003d paramObj.processList;\r\nvar creator \u003d paramObj.creator;\r\nvar creatorUnit \u003d paramObj.creatorUnit;\r\nvar title \u003d paramObj.title;\r\nvar activityName \u003d paramObj.activityName;\r\n\r\nvar field \u003d \"xid,xjob,xtitle,xstartTime,xcreateTime,xcreatorPerson,xcreatorUnit,xapplication,xapplicationName,xapplicationAlias,xprocess,xprocessName,xactivityName,xdoubleValue01\";\r\n\r\nvar jpqlstring\u003d\"SELECT * FROM (SELECT \"+field+\" FROM PP_C_WORK UNION ALL SELECT \"+field+\" FROM PP_C_WORKCOMPLETED) o where 1\u003d1 \"\r\n\r\nif (application \u0026\u0026 application !\u003d \"\"){\r\n    jpqlstring +\u003d \" AND (o.xapplication\u003d:application OR o.xapplicationName\u003d:application OR o.xapplicationAlias\u003d:application)\";\r\n}\r\nif(processList \u0026\u0026 processList !\u003d \"\"){\r\n    var processListStr \u003d \"(\u0027\"+processList.join(\"\u0027,\u0027\")+\"\u0027)\";\r\n    jpqlstring +\u003d\" AND o.xprocessName in \" + processListStr;\r\n}\r\nif(creator \u0026\u0026 creator !\u003d \"\"){\r\n    jpqlstring +\u003d \" AND o.xcreatorPerson\u003d:creator\"\r\n}\r\nif(creatorUnit \u0026\u0026 creatorUnit !\u003d \"\"){\r\n    jpqlstring +\u003d \" AND o.xcreatorUnit\u003d:creatorUnit\"\r\n}\r\nif(title \u0026\u0026 title !\u003d \"\"){\r\n    jpqlstring +\u003d \" AND o.xtitle like :title\"\r\n}\r\nif(activityName \u0026\u0026 activityName !\u003d \"\"){\r\n    jpqlstring +\u003d \" AND o.xactivityName \u003d :activityName\"\r\n}\r\njpqlstring +\u003d \" order by o.xstartTime desc\";\r\n\r\nconsole.log(jpqlstring);\r\nreturn jpqlstring",
          "view": "{\"id\":\"d189eb26-6354-45a5-80f7-011d17c2bfa6_view\",\"data\":{\"noDataText\":\"未找到数据\",\"selectList\":[{\"id\":\"C99946D232F00001F8DF72E01450B770\",\"column\":\"C99946D232F00001F8DF72E01450B770\",\"displayName\":\"流程类型\",\"orderType\":\"original\",\"events\":{\"loadTitle\":{\"code\":\"\",\"html\":\"\"},\"loadContent\":{\"code\":\"\",\"html\":\"\"},\"click\":{\"code\":\"\",\"html\":\"\"},\"mousedown\":{\"code\":\"\",\"html\":\"\"},\"mouseup\":{\"code\":\"\",\"html\":\"\"},\"mouseout\":{\"code\":\"\",\"html\":\"\"},\"mouseover\":{\"code\":\"\",\"html\":\"\"}},\"vid\":\"d189eb26-6354-45a5-80f7-011d17c2bfa6_view\",\"pid\":\"d189eb26-6354-45a5-80f7-011d17c2bfa6_viewC99946D232F00001F8DF72E01450B770\",\"allowOpen\":false,\"hideColumn\":false,\"isName\":false,\"isHtml\":false,\"isTime\":false,\"path\":\"processName\",\"mid\":\"C99946D232F00001F8DF72E01450B770\",\"isNumber\":false,\"exportEnable\":true,\"total\":\"no\"},{\"id\":\"C9967AAD94700001513912A91C173540\",\"column\":\"C9967AAD94700001513912A91C173540\",\"displayName\":\"标题\",\"orderType\":\"original\",\"events\":{\"loadTitle\":{\"code\":\"\",\"html\":\"\"},\"loadContent\":{\"code\":\"\",\"html\":\"\"},\"click\":{\"code\":\"\",\"html\":\"\"},\"mousedown\":{\"code\":\"\",\"html\":\"\"},\"mouseup\":{\"code\":\"\",\"html\":\"\"},\"mouseout\":{\"code\":\"\",\"html\":\"\"},\"mouseover\":{\"code\":\"\",\"html\":\"\"}},\"vid\":\"d189eb26-6354-45a5-80f7-011d17c2bfa6_view\",\"pid\":\"d189eb26-6354-45a5-80f7-011d17c2bfa6_viewC9967AAD94700001513912A91C173540\",\"allowOpen\":false,\"hideColumn\":false,\"isName\":false,\"isHtml\":false,\"isTime\":false,\"path\":\"title\",\"clickCode\":\"\",\"code\":\"if(this.target.value \u003d\u003d \\\"\\\"){\\n    return \\\"无标题\\\"\\n}else{\\n    if(this.target.value.length \u003e 43){\\n        return this.target.value.substr(0,43) + \\\"...\\\"\\n    }else{\\n        return this.target.value\\n    }\\n}\",\"idPath\":\"work\",\"contentStyles\":{\"text-align\":\"left\"},\