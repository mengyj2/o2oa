执行总数语句\\r\\n    \\\"page\\\": 1, //（number）可选，当前页码，默认为1\\r\\n    \\\"pageSize\\\": 1000, //（number）可选，每页的数据条数，默认为20\\r\\n    \\\"parameter\\\": {jobs}\\r\\n}, (json)\u003d\u003e{\\r\\n    const o \u003d {};\\r\\n    json.data.forEach((d)\u003d\u003e{\\r\\n        if (!o[d.job]) o[d.job] \u003d {activityName: new Set(), person: new Set()};\\r\\n        o[d.job].activityName.add(d.activityName);\\r\\n        o[d.job].person.add(o2.name.cn(d.person));\\r\\n    });\\r\\n\\r\\n    data.forEach((d)\u003d\u003e{\\r\\n        if (o[d.job]){\\r\\n            d.currentActivityName \u003d [...o[d.job].activityName].join(\u0027, \u0027);\\r\\n            d.currentPerson \u003d [...o[d.job].person].join(\u0027, \u0027);\\r\\n        }\\r\\n    });\\r\\n}, false);\\r\\n\",\"html\":\"const data \u003d this.target.gridJson;\\r\\nconst jobs \u003d data.map((d) \u003d\u003e {\\r\\n    return d.job;\\r\\n});\\r\\n\\r\\nthis.statement.execute({\\r\\n    \\\"name\\\": \\\"common-queryWorkInfoWithJob\\\", //（String）必选，查询配置的名称、别名或ID\\r\\n    \\\"mode\\\": \\\"data\\\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\\r\\n    \\\"page\\\": 1, //（number）可选，当前页码，默认为1\\r\\n    \\\"pageSize\\\": 1000, //（number）可选，每页的数据条数，默认为20\\r\\n    \\\"parameter\\\": {jobs}\\r\\n}, (json)\u003d\u003e{\\r\\n    const o \u003d {};\\r\\n    json.data.forEach((d)\u003d\u003e{\\r\\n        if (!o[d.job]) o[d.job] \u003d {activityName: new Set(), person: new Set()};\\r\\n        o[d.job].activityName.add(d.activityName);\\r\\n        o[d.job].person.add(o2.name.cn(d.person));\\r\\n    });\\r\\n\\r\\n    data.forEach((d)\u003d\u003e{\\r\\n        if (o[d.job]){\\r\\n            d.currentActivityName \u003d [...o[d.job].activityName].join(\u0027, \u0027);\\r\\n            d.currentPerson \u003d [...o[d.job].person].join(\u0027, \u0027);\\r\\n        }\\r\\n    });\\r\\n}, false);\\r\\n\"},\"postLoadPage\":{\"code\":\"\",\"html\":\"\"},\"queryLoadItemRow\":{\"code\":\"\",\"html\":\