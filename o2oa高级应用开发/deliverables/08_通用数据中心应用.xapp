        {
          "id": "c9b8b7c0-4808-4ec9-a77d-a6f9026107df",
          "name": "tablePagination.html",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "\u003cdiv class\u003d\"layout_pagination\"\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"删除\"  data-o2-events\u003d\"click:tableDelete;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-shanchu\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"清空\"  data-o2-events\u003d\"click:tableRemove;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-Vector-6\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"新增\"  data-o2-events\u003d\"click:tableAdd;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-tianjia\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"刷新\"  data-o2-events\u003d\"click:tableReload;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-refresh\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"上页\"  data-o2-events\u003d\"click:tablePrev;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-zuojiantou\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_item\" title\u003d\"下页\"  data-o2-events\u003d\"click:tableNext;\"\u003e\n        \u003cdiv class\u003d\"o2-table o2-table-youjiantou\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"pagination_paging\"\u003e\n        \u003cdiv\u003e\n            \u003cspan\u003e每页\u003c/span\u003e\n            \u003cselect data-o2-events\u003d\"change:tableSizeLoad;\"\u003e\n                \u003coption {{ (function(){  if($.data.size \u003d\u003d 20){ return \"selected\" } })() }}\u003e20\u003c/option\u003e\n                \u003coption {{ (function(){  if($.data.size \u003d\u003d 50){ return \"selected\" } })() }}\u003e50\u003c/option\u003e\n                \u003coption {{ (function(){  if($.data.size \u003d\u003d 100){ return \"selected\" } })() }}\u003e100\u003c/option\u003e\n                \u003coption {{ (function(){  if($.data.size \u003d\u003d 200){ return \"selected\" } })() }}\u003e200\u003c/option\u003e\n            \u003c/select\u003e\n            \u003cspan\u003e条\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e{{$.data.page}}/{{$.data.totalPage}}\u003c/div\u003e\n        \u003cdiv\u003e\u003cspan\u003e总共\u003cspan\u003e\u003cspan\u003e{{$.data.total}}\u003c/span\u003e\u003cspan\u003e条\u003cspan\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e",
          "dependScriptList": [],
          "creatorPerson": "金飞@jf@P",
          "lastUpdatePerson": "金飞@jf@P",
          "lastUpdateTime": "2025-09-25 17:06:28",
          "createTime": "2026-09-21 16:25:46",
          "updateTime": "2026-09-21 18:00:59"
        },
        {
          "id": "e9242df4-4b81-423e-af61-90ca1d43fdb8",
          "name": "ViewClass",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "ba003d9d-024e-418f-aef4-6b2b2b44c2ea",
          "text": "var _this \u003d this;\nconst ViewClass \u003d class{\n    constructor(options){ \n        this.name \u003d options.name;\n        this.query \u003d options.query;\n        this.bundleList \u003d []; //总的条数\n        this.page \u003d 1;\n        this.totalPage \u003d 1;\n    }\n    async loadView(){ \n        _this.form.get(\u0027statement\u0027).node.getElement(\u0027input\u0027).set(\u0027placeholder\u0027,\u0027查询条件,如：title\u003d\"标题\" and name\u003d\"张三\"\u0027);\n        var tableInfor \u003d await Table.actions_view.getWithQuery(this.name,this.query);\n        \n        var data \u003d tableInfor.data;\n        this.type \u003d data.type;\n        this.id \u003d data.id;\n        this.count \u003d data.count; //总共返回多少行\n        this.pageSize \u003d data.pageSize; //每页多少行\n        var _data \u003d data.data;\n        var _json \u003d JSON.parse(_data); \n        this.fields \u003d _json.selectList; \n        this.loadViewInfor(data);\n        this.loadTable()\n    }\n    loadViewInfor(data){\n        var node \u003d _this.form.get(\u0027layout_infor\u0027).node;\n        node.loadHtmlDomDB({\"view\":\"viewInfor.html\",data:data,\u0027module\u0027:_this})\n    }\n    getCurrentBundleList(){\n        var res \u003d [];\n        this.bundleList.forEach(function(bundle,index){\n            if(index \u003e\u003d (this.page - 1) * this.pageSize \u0026\u0026 index \u003c\u003d (this.page * this.pageSize - 1) ){\n                res.push(bundle)\n            }\n        }.bind(this))\n        return res;\n    }\n    async loadTable(){\n        var node \u003d _self.form.get(\u0027layout_table\u0027).node;\n        node.empty();\n        // Tools.loading(node); \n        Tools.loading({\"node\":node,\"color\":\"var(--o2-table-main)\"}); \n        this.tableLoading \u003d true;\n        \n        if(!this.key){\n            var json \u003d await this.loadBundle(); \n            this.key \u003d json.key;\n            this.bundleList \u003d json.valueList; \n            this.totalPage \u003d Math.ceil(this.bundleList.length / this.pageSize);\n            this.loadQuery();\n            this.loadPagination()\n            \n        }else{\n            this.loadQuery();\n            this.loadPagination()\n        }\n    }\n    async loadBundle(){\n        var data \u003d {\n            \u0027count\u0027:this.count\n        };\n        var _json \u003d await Table.actions_view.bundle(this.id,data);\n        return _json.data\n    }\n    loadQuery(){\n        var node \u003d _self.form.get(\u0027layout_table\u0027).node;\n        var json \u003d {\n            \"key\":this.key,\n            \"bundleList\":this.getCurrentBundleList()\n        }\n        node.empty();\n        // Tools.loading(node); \n        Tools.loading({\"node\":node,\"color\":\"var(--o2-table-main)\"}); \n        this.tableLoading \u003d true;\n        var res \u003d Table.actions_view.executeWithQuery(this.id,this.query,json);\n        res.then(function(data){\n            var _data \u003d data.data.grid;\n            \n            _data.forEach(function(d){\n                d.fields \u003d this.fields\n            }.bind(this))\n            \n            var data \u003d {\n                \"data\":_data,\n                \"fields\":this.fields\n            }\n            \n            node.loadHtmlDomDB({\"view\":\"view.html\",\"style\":\"style.css\",\"data\":data,\"application\":_self.form.infor.portal,\u0027module\u0027:_this});\n            this.tableLoading \u003d false;\n        }.bind(this))\n    }\n    loadPagination(){ \n        var node \u003d _self.form.get(\u0027layout_pagination\u0027).node;\n        var data \u003d {\n            \"page\":this.page,\n            \"size\":this.pageSize,\n            \"total\":this.bundleList.length,\n            \"totalPage\":this.totalPage\n        };\n        \n        node.loadHtmlDomDB({\"view\":\u0027viewPagination.html\u0027,\"data\":data,\u0027module\u0027:_this})\n    }\n    reload(){\n        _self.form.get(\"statement\").setData(\"\");\n        this.bundleList \u003d [];\n        this.page \u003d 1;\n        delete this.key;\n        this.totalPage \u003d 1;\n        this.loadView()\n    }\n    loadNext(){ \n        if(this.totalPage \u003d\u003d 0 || this.page \u003d\u003d this.totalPage || this.tableLoading) return;\n        this.page \u003d this.page + 1;\n        this.loadPagination();\n        this.loadQuery()\n    }\n    loadPrev(){\n        if(this.page \u003d\u003d 1 || this.tableLoading) return;\n        this.page \u003d this.page - 1;\n        this.loadPagination();\n        this.loadTable()\n    }\n    parseStatement(statement){ \n        var res \u003d []\n        //解析语句\n        var _statementList \u003d [];\n        var ands \u003d statement.split(\u0027 and \u0027);\n        ands.forEach(function(and){\n            if(and.indexOf(\u0027or\u0027)\u003e-1){\n                var ors \u003d and.split(\u0027or\u0027);\n                ors.forEach(function(or,index){\n                    if(index \u003d\u003d 0){\n                        _statementList.push({\u0027logic\u0027:\u0027and\u0027,\u0027expression\u0027:or})\n                    }else{\n                        _statementList.push({\u0027logic\u0027:\u0027or\u0027, \u0027expression\u0027:or})\n                    }\n                })\n            }else{\n                _statementList.push({\u0027logic\u0027:\u0027and\u0027,\u0027expression\u0027:and}) \n            }\n        })\n        \n        var statementList \u003d [];\n        _statementList.forEach(function(s){\n            var comparison \u003d \u0027\u003d\u0027;\n            var value \u003d \u0027\u0027;\n            if(s[\"expression\"].indexOf(\u0027!\u003d\u0027)\u003e0){\n                comparison \u003d \u0027!\u003d\u0027\n            }else if(s[\"expression\"].indexOf(\u0027\u003d\u0027)\u003e0){\n                comparison \u003d \u0027\u003d\u0027\n            }else if(s[\"expression\"].indexOf(\u0027like\u0027)\u003e0){\n                comparison \u003d \u0027like\u0027\n            }\n            \n            var name \u003d s[\"expression\"].split(comparison)[0].trim();\n            var value \u003d s[\"expression\"].split(comparison)[1].replaceAll(\u0027\"\u0027,\u0027\u0027).trim();\n            \n            this.fields.forEach(function(field){\n                if(field[\u0027displayName\u0027] \u003d\u003d name){\n                    statementList.push({\n                        \u0027logic\u0027:s.logic,\n                        \u0027path\u0027:field[\u0027path\u0027],\n                        \u0027comparison\u0027:comparison\u003d\u003d\"\u003d\"?\"\u003d\u003d\":comparison,\n                        \u0027value\u0027:value,\n                        \u0027formatType\u0027:isNaN(value)?\u0027textValue\u0027:\u0027numberValue\u0027\n                    })\n                }\n            })\n            \n        }.bind(this))\n        \n        res \u003d statementList;\n        return res;\n    }\n    search(statement){ \n        if(this.tableLoading) return;\n        var node \u003d _self.form.get(\u0027layout_table\u0027).node;\n        var _statement \u003d statement.toLowerCase();\n        this.statementList \u003d this.parseStatement(_statement)\n        \n        if(this.statementList.length \u003d\u003d 0) return;\n        \n        node.empty();\n        // Tools.loading(node); \n        Tools.loading({\"node\":node,\"color\":\"var(--o2-table-main)\"}); \n        this.tableLoading \u003d true;\n        \n        var filterList \u003d _self.view.lookup({\n          \"view\": this.name,\n          \"application\": this.query,\n          \"filter\": this.statementList\n        });\n        \n        filterList.then(function(json){\n            this.loadSearchBar(json.grid.length);\n            \n            var _data \u003d json.grid;\n            _data.forEach(function(d){\n                d.fields \u003d this.fields\n            }.bind(this));\n            \n            var data \u003d {\n                \"data\":_data,\n                \"fields\":this.fields\n            }\n            \n            node.loadHtmlDomDB({\"view\":\"view.html\",\"style\":\"style.css\",\"data\":data,\"application\":_self.form.infor.portal,\u0027module\u0027:_this});\n            this.tableLoading \u003d false;\n            \n            \n        }.bind(this),function(){\n            this.tableLoading \u003d false\n        }.bind(this))\n    }\n    loadSearchBar(total){\n        var node \u003d _self.form.get(\u0027layout_pagination\u0027).node;\n        node.empty();\n        var back \u003d new Element(\"div\",{\"title\":\"返回\",styles:{\n            \"float\":\"left\",\n            \"width\":\"40px\",\n            \"height\":\"40px\",\n            \"cursor\":\"pointer\",\n            \"display\":\"flex\",\n            \"justify-content\":\"center\",\n            \"align-items\":\"center\"\n        }}).inject(node);\n        new Element(\"img\",{\n            \"src\":\"data:image/png;base64,\u003d\",\n            \"styles\":{\n                \"width\":\"20px\",\n                \"height\":\"20px\"\n            }\n        }).inject(back);\n        back.addEvents({\n            mouseover:function(){\n                this.setStyles({\"background-color\":\"#dddddd\"})\n            },\n            mouseout:function(){\n                this.setStyles({\"background-color\":\"\"})\n            },\n            click:function(){\n                _self.form.get(\u0027statement\u0027).setData(\u0027\u0027)\n                this.loadView()\n            }.bind(this)\n        })\n        new Element(\"div\",{text:\"总共\"+total+\"条\",styles:{\n            \"float\":\"left\",\n            \"line-height\":\"40px\",\n            \"font-size\":\"16px\"\n        }}).inject(node)\n    }\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
