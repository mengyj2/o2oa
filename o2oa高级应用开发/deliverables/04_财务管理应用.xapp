      "applicationDictList": [],
      "scriptList": [
        {
          "id": "ef7b5275-3d87-4d0e-a2dc-caec7a320dd1",
          "name": "amountInWords",
          "alias": "",
          "description": "金额转大写脚本",
          "validated": true,
          "application": "5bb6e61e-10ea-4e85-b5af-76a368d222da",
          "text": "this.define(\"getAmountInWords\", function( num ){\r\n    debugger;\r\n    var strOutput \u003d \"\";  \r\n    var strUnit \u003d \u0027仟佰拾亿仟佰拾万仟佰拾元角分\u0027;  \r\n    num +\u003d \"00\";  \r\n    var intPos \u003d num.indexOf(\u0027.\u0027);  \r\n    if (intPos \u003e\u003d 0) num \u003d num.substring(0, intPos) + num.substr(intPos + 1, 2);  \r\n    strUnit \u003d strUnit.substr(strUnit.length - num.length);  \r\n    for (var i\u003d0; i \u003c num.length; i++) strOutput +\u003d \u0027零壹贰叁肆伍陆柒捌玖\u0027.substr(num.substr(i,1),1) + strUnit.substr(i,1);  \r\n    var dx \u003d strOutput.replace(/零角零分$/, \u0027整\u0027).replace(/零[仟佰拾]/g, \u0027零\u0027).replace(/零{2,}/g, \u0027零\u0027).replace(/零([亿|万])/g, \u0027$1\u0027).replace(/零+元/, \u0027元\u0027).replace(/亿零{0,3}万/, \u0027亿\u0027).replace(/^元/, \"零元\");  \r\n    return dx;\r\n});\r\n\r\n//检查发票\r\nthis.define(\u0027checkInvioce\u0027, function(){\r\n    \r\n    if( [\u0027draft\u0027,\u0027verify\u0027].contains(this.workContext.getWork().activityAlias) ){\r\n        if( [\u0027请审核\u0027, \u0027完成\u0027].contains(this.form.currentRouteName) ){\r\n            const job \u003d this.workContext.getWork().job;\r\n            var invoiceList \u003d this.form.get(\u0027datatable_invoice\u0027).getData().data;\r\n            if( invoiceList \u0026\u0026 invoiceList.length ){\r\n                var errorList \u003d [];\r\n                invoiceList.each((d)\u003d\u003e{\r\n                    \r\n                    o2.Actions.load(\u0027x_processplatform_assemble_surface\u0027).AttachmentAction.getInvoiceInfo(d.id,job, function(json){\r\n                        if( json.data.applyStatus \u003d\u003d\u003d \u0027已报销\u0027 ){\r\n                            errorList.push( d.detail + \u0027[\u0027+d.number+\u0027]\u0027 + \u0027已报销。\u0027 );\r\n                        }\r\n                    }, function(xhr){\r\n                        let result;\r\n                        try{\r\n                            result \u003d JSON.parse(xhr.responseText);\r\n                        }catch (e) {\r\n                            result \u003d {message: xhr.responseText};\r\n                        }\r\n                        errorList.push( d.detail + \u0027[\u0027+d.number+\u0027]\u0027 + result.message + \u0027。\u0027 );\r\n                    }, false);\r\n                });\r\n                return errorList.length ? errorList.join(\"\") : true;\r\n            }else{\r\n                return true;\r\n            }\r\n        }else{\r\n            return true;\r\n        }\r\n    }else{\r\n        return true;\r\n    }\r\n})\r\n\r\n\r\n//检查关联的出差流程\r\nthis.define(\u0027checkTrip\u0027, function(){\r\n\r\n    if( [\u0027draft\u0027,\u0027verify\u0027].contains(this.workContext.getWork().activityAlias) ){\r\n        if( [\u0027请审核\u0027, \u0027完成\u0027].contains(this.form.currentRouteName) ){\r\n            var tripList \u003d this.form.get(\u0027datatable_trip\u0027).getData().data;\r\n            if( tripList \u0026\u0026 tripList.length ){\r\n                var tripErrorList \u003d [];\r\n                tripList.each((d)\u003d\u003e{\r\n                    if(d.tripJob){\r\n\r\n                        const invokeData \u003d {\"job\":d.tripJob};\r\n                        o2.Actions.load(\"x_program_center\").InvokeAction.execute(//平台封装好的方法\r\n                            \"getTripProcess\",//uri的参数\r\n                            invokeData,//body请求参数\r\n                            function( json ){ //服务调用成功的回调函数, json为服务传回的数据\r\n                                if( json.data.reimburseType \u003d\u003d\u003d \u0027已报销\u0027 ){\r\n                                    tripErrorList.push( d.tripStartDate +\"至\"+ d.tripEndDate + \u0027的出差已报销。\u0027 );\r\n                                }\r\n                                \r\n                            }.bind(this),\r\n                            function( json ){ //服务调用失败的回调函数, json为服务传回的数据\r\n                            }.bind(this),false\r\n                        );\r\n\r\n                    \r\n                    }\r\n\r\n                });\r\n                return tripErrorList.length ? tripErrorList.join(\"\") : true;\r\n            }else{\r\n                return true;\r\n            }\r\n        }else{\r\n            return true;\r\n        }\r\n    }else{\r\n        return true;\r\n    }\r\n})\r\n",
          "dependScriptList": [],
          "creatorPerson": "吴恒水@whs@P",
          "lastUpdatePerson": "吴恒水@whs@P",
          "lastUpdateTime": "2025-06-26 15:28:30",
          "createTime": "2026-09-21 16:00:55",
          "updateTime": "2026-09-21 16:00:55"
        }
      ],
