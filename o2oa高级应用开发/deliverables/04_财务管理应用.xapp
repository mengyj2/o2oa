003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"control-panel\\\\\\\" title\u003d\\\\\\\"调度文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"rerouteWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"调度\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-control-panel\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e调度\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-split\\\\\\\" title\u003d\\\\\\\"增加拆分分支\\\\\\\" mwfbuttonaction\u003d\\\\\\\"addSplit\\\\\\\" mwfbuttontext\u003d\\\\\\\"增加分支\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-split\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e增加分支\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"retract\\\\\\\" title\u003d\\\\\\\"待办撤回\\\\\\\" mwfbuttonaction\u003d\\\\\\\"retractWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"撤回\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-retract\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e撤回\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-rollback\\\\\\\" title\u003d\\\\\\\"回溯到指定的环节，不保留流程记录\\\\\\\" mwfbuttonaction\u003d\\\\\\\"rollback\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程回溯\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-rollback\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e流程回溯\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"delete\\\\\\\" title\u003d\\\\\\\"删除文件\\\\\\\" mwfbuttonaction\u003d\\\\\\\"deleteWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"删除文档\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-delete\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e删除文档\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-end\\\\\\\" title\u003d\\\\\\\"结束文件流转\\\\\\\" mwfbuttonaction\u003d\\\\\\\"terminate\\\\\\\" mwfbuttontext\u003d\\\\\\\"终止文件\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-end\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e终止文件\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"print\\\\\\\" title\u003d\\\\\\\"打印文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"printWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"打印\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-print\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e打印\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"publish\\\\\\\" title\u003d\\\\\\\"催促办理\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pressWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"催促办理\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-publish\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e催促办理\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"stop\\\\\\\" title\u003d\\\\\\\"待办挂起\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pauseTask\\\\\\\" mwfbuttontext\u003d\\\\\\\"挂起\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-stop\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e挂起\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-begin\\\\\\\" title\u003d\\\\\\\"从挂起状态恢复\\\\\\\" mwfbuttonaction\u003d\\\\\\\"resumeTask\\\\\\\" mwfbuttontext\u003d\\\\\\\"挂起恢复\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-begin\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e挂起恢复\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"file_download\\\\\\\" title\u003d\\\\\\\"一键下载\\\\\\\" mwfbuttonaction\u003d\\\\\\\"downloadAll\\\\\\\" mwfbuttontext\u003d\\\\\\\"一键下载\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-file_download\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e一键下载\u003c/span\u003e\