style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e调度\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-split\\\\\\\" title\u003d\\\\\\\"增加拆分分支\\\\\\\" mwfbuttonaction\u003d\\\\\\\"addSplit\\\\\\\" mwfbuttontext\u003d\\\\\\\"增加分支\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-split\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer;\\\\\\\"\u003e增加分支\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"retract\\\\\\\" title\u003d\\\\\\\"待办撤回\\\\\\\" mwfbuttonaction\u003d\\\\\\\"retractWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"撤回\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer;