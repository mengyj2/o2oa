ht: #f3f4f5;\\\\r\\\\n    --oo-color-hover: #ededef;\\\\r\\\\n    --oo-color-icon: #9293A6;\\\\r\\\\n    --oo-color-hover2: #ededef;\\\\r\\\\n    --oo-color-odd-even: #FAFAFA;\\\\r\\\\n} */\\\\r\\\\n\\\\r\\\\n.ooicon-create {\\\\r\\\\n    background-color: var(--oo-color-deep);\\\\r\\\\n    border-radius: 100%;\\\\r\\\\n    height: 3em;\\\\r\\\\n    width: 3em;\\\\r\\\\n    opacity: 0.1;\\\\r\\\\n    color: var(--oo-color-text-white);\\\\r\\\\n    position: absolute;\\\\r\\\\n    right: 1em;\\\\r\\\\n    bottom: 1em;\\\\r\\\\n    display: flex !important;\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: center;\\\\r\\\\n    cursor: pointer;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n    transition: opacity 0.3s;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.ooicon-create:hover {\\\\r\\\\n    opacity: 0.8;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 自定义布局样式 *************************/\\\\r\\\\n.page-custom-layout {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 60em;\\\\r\\\\n    right: -60em;\\\\r\\\\n    padding: 2em;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n.page-custom-layout-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 30em;\\\\r\\\\n    right: -30em;\\\\r\\\\n    padding: 2em 0;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.page-custom-widget-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n.page-custom-title {\\\\r\\\\n    display: flex;\\\\r\\\\n    font-size: 1.125rem;\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: space-between;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close:hover {\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-description {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-area {\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n    position: relative;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category {\\\\r\\\\n    /* border-left: 0.25rem solid var(--oo-color-main); */\\\\r\\\\n    background-color: var(--oo-color-bg-white);\\\\r\\\\n    padding: 1em 0;\\\\r\\\\n    gap: 0.5em;\\\\r\\\\n    display: flex;\\\\r\\\\n    align-items: center;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:first-child {\\\\r\\\\n    font-size: 1.125em;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:last-child {\\\\r\\\\n    transform: rotate(90deg);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item {\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n.add-widget-item:hover .title {\\\\r\\\\n    color: var(--oo-color-main);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-it