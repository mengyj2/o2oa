ue\\\\\\\"\u003e\u003c/oo-input\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_7_1\\\\\\\" style\u003d\\\\\\\"display: flex;\\\\\\\" class\u003d\\\\\\\"content-item flex\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_1_1\\\\\\\" style\u003d\\\\\\\"text-align: right;\\\\\\\" class\u003d\\\\\\\"item-label\\\\\\\"\u003e申　请　人\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_35\\\\\\\" style\u003d\\\\\\\"flex: 1 1 0%; display: flex; align-items: center; background-color: rgb(247, 247, 247); padding: 0.5em 0.6em;\\\\\\\"\u003e\u003coo-org mwftype\u003d\\\\\\\"common\\\\\\\" id\u003d\\\\\\\"common\\\\\\\" style\u003d\\\\\\\"\\\\\\\" type\u003d\\\\\\\"text\\\\\\\"\u003e\u003c/oo-org\u003e\u003c/div\u003e\u003c/div\u003e\u003coo-input mwftype\u003d\\\\\\\"OOInput\\\\\\\" id\u003d\\\\\\\"draftDepartment\\\\\\\" placeholder\u003d\\\\\\\"draftDepartment\\\\\\\" style\u003d\\\\\\\"\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" type\u003d\\\\\\\"text\\\\\\\" label\u003d\\\\\\\"申 请 部 门\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\" label-style\u003d\\\\\\\"width:6.2vw; min-width:4.3em; max-width:9em\\\\\\\" label-align\u003d\\\\\\\"right\\\\\\\" view-style\u003d\\\\\\\"background-color:#f7f7f7\\\\\\\"\u003e\u003c/oo-input\u003e\u003coo-input mwftype\u003d\\\\\\\"OOInput\\\\\\\" id\u003d\\\\\\\"draftDate\\\\\\\" placeholder\u003d\\\\\\\"draftDate\\\\\\\" style\u003d\\\\\\\"\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" type\u003d\\\\\\\"text\\\\\\\" label\u003d\\\\\\\"申 请 时 间\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\" label-style\u003d\\\\\\\"width:6.2vw; min-width:4.3em; max-width:9em\\\\\\\" label-align\u003d\\\\\\\"right\\\\\\\" view-style\u003d\\\\\\\"background-color:#f7f7f7\\\\\\\"\u003e\u003c/oo-input\u003e\u003coo-input mwftype\u003d\\\\\\\"OOInput\\\\\\\" id\u003d\\\\\\\"costSerial\\\\\\\" placeholder\u003d\\\\\\\"costSerial\\\\\\\" style\u003d\\\\\\\"\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" typ