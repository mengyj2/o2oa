      "statementList": [
        {
          "id": "q4004001-project-cost-summary-0000000001",
          "name": "项目成本汇总查询",
          "alias": "项目成本汇总查询",
          "description": "按项目汇总报销成本并计算偏差率",
          "query": "a4004001-finance-dataapp-000000000000001",
          "creatorPerson": "xadmin",
          "lastUpdatePerson": "xadmin",
          "lastUpdateTime": "2026-09-21 12:12:14",
          "statement": "SELECT p.project_no, p.project_name, p.total_budget, SUM(e.total_amount) AS expense_total, SUM(e.total_amount) - p.total_budget AS variance, ROUND((SUM(e.total_amount) - p.total_budget) * 100.0 / p.total_budget, 2) AS variance_rate FROM 项目主表 p LEFT JOIN 报销主表 e ON p.project_no = e.project_no GROUP BY p.project_no",
          "sql": "SELECT p.project_no, p.project_name, p.total_budget, SUM(e.total_amount) AS expense_total, SUM(e.total_amount) - p.total_budget AS variance, ROUND((SUM(e.total_amount) - p.total_budget) * 100.0 / p.total_budget, 2) AS variance_rate FROM 项目主表 p LEFT JOIN 报销主表 e ON p.project_no = e.project_no GROUP BY p.project_no",
          "queryType": "sql",
          "format": "sql",
          "countMethod": "ignore",
          "entityCategory": "dynamic",
          "table": "",
          "data": "",
          "countData": "",
          "properties": {}
        },
        {
          "id": "q4004002-budget-exec-check-00000000000001",
          "name": "预算执行核查",
          "alias": "预算执行核查",
          "description": "核查预算余额，防止超预算支出",
          "query": "a4004001-finance-dataapp-000000000000001",
          "creatorPerson": "xadmin",
          "lastUpdatePerson": "xadmin",
          "lastUpdateTime": "2026-09-21 12:12:14",
          "statement": "SELECT b.budget_no, b.budget_name, b.total_amount AS budget_amount, SUM(e.total_amount) AS expense_amount, b.total_amount - SUM(e.total_amount) AS remain FROM 预算主表 b LEFT JOIN 报销主表 e ON b.budget_no = e.budget_no GROUP BY b.budget_no",
          "sql": "SELECT b.budget_no, b.budget_name, b.total_amount AS budget_amount, SUM(e.total_amount) AS expense_amount, b.total_amount - SUM(e.total_amount) AS remain FROM 预算主表 b LEFT JOIN 报销主表 e ON b.budget_no = e.budget_no GROUP BY b.budget_no",
          "queryType": "sql",
          "format": "sql",
          "countMethod": "ignore",
          "entityCategory": "dynamic",
          "table": "",
          "data": "",
          "countData": "",
          "properties": {}
