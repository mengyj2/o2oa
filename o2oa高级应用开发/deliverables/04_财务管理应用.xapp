              "route": "1a1a9da0-9d09-4ead-a7c0-70a7fa298ba8",
              "script": "",
              "scriptText": "var dt \u003d this.data.datatable_invoice;\r\nif( dt \u0026\u0026 dt.data \u0026\u0026 dt.data.length ){\r\n    var list \u003d dt.data;\r\n    list.forEach((d)\u003d\u003e{\r\n        this.Actions.load(\u0027x_general_assemble_control\u0027).InvoiceAction.updateApplyStatus(d.id);\r\n    })\r\n}\r\n\r\n\r\nvar trip \u003d this.data.datatable_trip;\r\nif( trip \u0026\u0026 trip.data \u0026\u0026 trip.data.length ){\r\n    var tripList \u003d trip.data;\r\n\r\n    tripList.forEach((d)\u003d\u003e{\r\n        if(d.tripJob){\r\n            const updateData \u003d {\"reimburseType\":\"已报销\"};\r\n            var action \u003d this.Actions.load(\"x_processplatform_assemble_surface\");\r\n            action.DataAction.updateWithJob(//平台封装好的方法\r\n                d.tripJob,//uri的参数\r\n                updateData,//body请求参数\r\n                function( json ){ //服务调用成功的回调函数, json为服务传回的数据\r\n                }.bind(this),\r\n                function( json ){ //服务调用失败的回调函数, json为服务传回的数据\r\n                }.bind(this)\r\n            );\r\n        }\r\n    })\r\n    \r\n}\r\n\r\n",
              "edition": "CB23A00D96800001E695D86013B06900",
              "properties": {},
              "createTime": "2026-09-21 16:00:55",
              "updateTime": "2026-09-26 00:41:40"
            }
