utton\\\",\\\"img\\\":\\\"submit.png\\\",\\\"title\\\":\\\"{{$.lp.flowTitle}}\\\",\\\"action\\\":\\\"flowWork\\\",\\\"text\\\":\\\"{{$.lp.flow}}\\\",\\\"id\\\":\\\"action_flowWork\\\",\\\"control\\\":\\\"allowFlow\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"process-submit\\\",\\\"read\\\":false,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"addTask.png\\\",\\\"title\\\":\\\"{{$.lp.addTaskTitle}}\\\",\\\"action\\\":\\\"addTask\\\",\\\"text\\\":\\\"{{$.lp.addTask}}\\\",\\\"id\\\":\\\"action_addTask\\\",\\\"control\\\":\\\"allowAddTask\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"process-add-task-person\\\",\\\"read\\\":false,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"retract.png\\\",\\\"title\\\":\\\"{{$.lp.retractTitle}}\\\",\\\"action\\\":\\\"retractWork\\\",\\\"text\\\":\\\"{{$.lp.retract}}\\\",\\\"id\\\":\\\"action_retract\\\",\\\"control\\\":\\\"allowRetract\\\",\\\"icon\\\":\\\"retract\\\",\\\"condition\\\":\\\"\\\",\\\"read\\\":true,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"read.png\\\",\\\"title\\\":\\\"{{$.lp.setReaded}}\\\",\\\"action\\\":\\\"readedWork\\\",\\\"text\\\":\\\"{{$.lp.readed}}\\\",\\\"id\\\":\\\"action_readed\\\",\\\"icon\\\":\\\"process-read\\\",\\\"control\\\":\\\"allowReadProcessing\\\",\\\"condition\\\":\\\"\\\",\\\"read\\\":true,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"del.png\\\",\\\"title\\\":\\\"{{$.lp.deleteTitle}}\\\",\\\"action\\\":\\\"deleteWork\\\",\\\"text\\\":\\\"{{$.lp.delete}}\\\",\\\"id\\\":\\\"action_delete\\\",\\\"icon\\\":\\\"delete\\\",\\\"control\\\":\\\"allowDelete\\\",\\\"condition\\\":\\\"\\\",\\\"read\\\":false,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"press.png\\\",\\\"title\\\":\\\"{{$.lp.pressTitle}}\\\",\\\"action\\\":\\\"pressWork\\\",\\\"text\\\":\\\"{{$.lp.press}}\\\",\\\"id\\\":\\\"action_press\\\",\\\"icon\\\":\\\"publish\\\",\\\"control\\\":\\\"allowPress\\\",\\\"condition\\\":\\\"\\\",\\\"read\\\":true,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"goback.png\\\",\\\"title\\\":\\\"{{$.lp.goBackTitle}}\\\",\\\"action\\\":\\\"goBack\\\",\\\"text\\\":\\\"{{$.lp.goBack}}\\\",\\\"id\\\":\\\"action_goBack\\\",\\\"control\\\":\\\"allowGoBack\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"process-goback\\\",\\\"read\\\":false,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"reset.png\\\",\\\"title\\\":\\\"{{$.lp.resetTitle}}\\\",\\\"action\\\":\\\"resetWork\\\",\\\"text\\\":\\\"{{$.lp.reset}}\\\",\\\"id\\\":\\\"action_reset\\\",\\\"control\\\":\\\"allowReset\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"reset\\\",\\\"read\\\":false,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"monitor.png\\\",\\\"title\\\":\\\"{{$.lp.monitorTitle}}\\\",\\\"action\\\":\\\"monitor\\\",\\\"text\\\":\\\"{{$.lp.monitor}}\\\",\\\"id\\\":\\\"action_monitor\\\",\\\"control\\\":\\\"\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"work-management\\\",\\\"read\\\":true,\\\"system\\\":true}],\\\"actionIconType\\\":\\\"font\\\",\\\"selectorStyle\\\":{\\\"style\\\":\\\"v10\\\",\\\"tabStyle\\\":\\\"v10\\\"}},\\\"html\\\":\\\"\u003cdiv mwftype\u003d\\\\\\\"form\\\\\\\" id\u003d\\\\\\\"ddaea6b8-e69b-41d7-98a8-a9bfa25fc1f2\\\\\\\" class\u003d\\\\\\\"form-layout\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv id\u003d\\\\\\\"actionbar_1\\\\\\\" mwftype\u003d\\\\\\\"actionbar\\\\\\\" class\u003d\\\\\\\"form-toolbar-area\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv class\u003d\\\\\\\"form-toolbar\\\\\\\" style\u003d\\\\\\\"background-color: rgb(255, 255, 255); padding: 0px 1em; border-radius: 0px; overflow-wrap: normal; word-break: keep-all; cursor: pointer; overflow: hidden; height: auto; display: flex; font-size: 1em; border-top: 0px; margin: 0px auto; border-bottom: 0px; flex-wrap: wrap; gap: 0.5em 0.3em;\\\\\\\"\u003e\u003cdiv mwfnodetype\u003d\