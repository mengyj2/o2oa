          "portal": "97e0d459-a574-4ed7-be2e-31194349fdfa",
          "text": "\r\nthis.define(\u0027reimburseConfig\u0027, ()\u003d\u003e{\r\n    const config \u003d {\r\n        \"application\":\"finance\",\r\n        \"dictName\":\"reimburse\"\r\n    }\r\n    \r\n    return config;\r\n})\r\n\r\n\r\nthis.define(\"setWorkCount\",function(){\r\n    const parameter \u003d {\r\n        \"application\":this.page.parameters.parameters.application,\r\n        \"processList\":this.page.parameters.parameters.processList\r\n    };\r\n    this.Actions.load(\"x_query_assemble_surface\").StatementAction.execute( \"common-task\", 1, 2000, parameter ).then(function(json){\r\n        var data \u003d json.data;\r\n        var navi \u003d this.form.get(\u0027navi\u0027);\r\n        debugger;\r\n        if (navi){\r\n            var naviNode \u003d navi.node;\r\n            if (naviNode \u0026\u0026 data.length\u003e0){\r\n                naviNode.getItem(\u0027task\u0027).data.count \u003d data.length || 0;\r\n            }\r\n        }\r\n    }.bind(this));\r\n    \r\n})\r\n\r\nthis.page.addEvent(\"postLoad\",function(){\r\n    \r\n    //待办数量\r\n    this.setWorkCount();\r\n    \r\n}.bind(this))",
