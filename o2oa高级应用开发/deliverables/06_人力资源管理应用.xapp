: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-end\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e终止文件\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"print\\\\\\\" title\u003d\\\\\\\"打印文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"printWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"打印\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-print\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e打印\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"publish\\\\\\\" title\u003d\\\\\\\"催促办理\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pressWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"催促办理\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left