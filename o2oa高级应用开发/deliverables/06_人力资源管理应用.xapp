          "data": "{\\\"html\\\":\\\"\u003cdiv mwftype\u003d\\\\\\\"form\\\\\\\" id\u003d\\\\\\\"664e8b82-c43f-4cdb-80c8-30531c3cf97e\\\\\\\" class\u003d\\\\\\\"form-layout\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv id\u003d\\\\\\\"actionbar\\\\\\\" mwftype\u003d\\\\\\\"actionbar\\\\\\\" class\u003d\\\\\\\"form-toolbar-area\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv class\u003d\\\\\\\"form-toolbar\\\\\\\" style\u003d\\\\\\\"background-color: rgb(255, 255, 255); padding: 0px 1em; overflow-wrap: normal; word-break: keep-all; cursor: pointer; height: auto; display: flex; font-size: 1em; margin: 0px auto; border-top: 0px; border-bottom: 0px; flex-wrap: wrap; gap: 0.5em 0.3em;\\\\\\\"\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"close\\\\\\\" title\u003d\\\\\\\"关闭文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"closeWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"关闭\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-close\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e关闭\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"save\\\\\\\" title\u003d\\\\\\\"保存文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"saveWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"保存\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-save\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e保存\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-submit\\\\\\\" title\u003d\\\\\\\"继续流转文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"flowWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"继续流转\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-submit\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e继续流转\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"control-panel\\\\\\\" title\u003d\\\\\\\"调度文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"rerouteWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"调度\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-control-panel\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e调度\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-split\\\\\\\" title\u003d\\\\\\\"增加拆分分支\\\\\\\" mwfbuttonaction\u003d\\\\\\\"addSplit\\\\\\\" mwfbuttontext\u003d\\\\\\\"增加分支\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-split\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e增加分支\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"retract\\\\\\\" title\u003d\\\\\\\"待办撤回\\\\\\\" mwfbuttonaction\u003d\\\\\\\"retractWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"撤回\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-retract\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e撤回\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-rollback\\\\\\\" title\u003d\\\\\\\"回溯到指定的环节，不保留流程记录\\\\\\\" mwfbuttonaction\u003d\\\\\\\"rollback\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程回溯\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-rollback\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e