              "beforeArriveScript": "",
              "afterArriveScript": "",
              "afterArriveScriptText": "//离职流程走完，人员的离岗学习、内部转岗、内部待岗、待解除劳动合同标记去除。\r\nif( !this.Action.applications )this.Action.applications \u003d  this.applications;\r\nvar applications \u003d this.Action.applications;\r\n\r\nvar e \u003d this.data.employee;\r\ntry{\r\n    var resp \u003d applications.getQuery(\u0027x_query_assemble_surface\u0027,\u0027table/list/hrMarketResourcePool/row/select/where/o.employeeCode\u003d\"\u0027+e+\u0027\"\u0027); //获取资源池列表\r\n    var json \u003d JSON.parse( resp.toString() );\r\n    if( json \u0026\u0026 json.data ){\r\n        for( var j\u003d0; j\u003cjson.data.length; j++ ){\r\n            var resourceData \u003d json.data[j];\r\n            applications.deleteQuery(\u0027x_query_assemble_surface\u0027, \u0027table/hrMarketResourcePool/row/\u0027+resourceData.id); //删除资源池中对应的人\r\n        }\r\n    }  \r\n\r\n    resp \u003d applications.getQuery(\u0027x_query_assemble_surface\u0027,\u0027table/list/hrMarketAwaitJobPool/row/select/where/o.employeeCode\u003d\"\u0027+e+\u0027\"\u0027); //获取待岗池列表\r\n    json \u003d JSON.parse( resp.toString() );\r\n    if( json \u0026\u0026 json.data ){\r\n        for( var j\u003d0; j\u003cjson.data.length; j++ ){\r\n            var awaitData \u003d json.data[j];\r\n            applications.deleteQuery(\u0027x_query_assemble_surface\u0027, \u0027table/hrMarketAwaitJobPool/row/\u0027+awaitData.id); //删除待岗池里的人\r\n        }\r\n    }\r\n}catch(err){\r\n    print(err);\r\n}",
              "beforeExecuteScript": "",
              "afterExecuteScript": "",
              "allowReroute": false,
              "allowRerouteTo": false,
              "edition": "C9C3973F0A800001937A89402CE01D71",
              "properties": {},
              "createTime": "2026-09-21 16:01:12",
              "updateTime": "2026-09-26 00:41:55"
            }
