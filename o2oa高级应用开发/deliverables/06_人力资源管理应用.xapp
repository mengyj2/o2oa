:\\\"36px\\\",\\\"padding\\\":\\\"0px 15px\\\",\\\"background-color\\\":\\\"#f4f7f6\\\"},\\\"errorStyle\\\":{\\\"node\\\":{\\\"background\\\":\\\"url(../x_component_process_FormDesigner/Module/Form/notice/icon/error_v10.png) no-repeat 0px center\\\",\\\"color\\\":\\\"var(--oo-color-error)\\\",\\\"min-height\\\":\\\"30px\\\",\\\"padding-left\\\":\\\"20px\\\",\\\"line-height\\\":\\\"30px\\\",\\\"position\\\":\\\"relative\\\",\\\"background-color\\\":\\\"initial\\\",\\\"border\\\":\\\"none\\\",\\\"display\\\":\\\"flex\\\",\\\"border-radius\\\":\\\"\\\"},\\\"close\\\":\\\"\\\"},\\\"validationOpinion\\\":{\\\"code\\\":\\\"var opinion \u003d this.form.opinion;\\\\r\\\\n// if( !opinion ){\\\\r\\\\n//     return \\\\\\\"请填写意见\\\\\\\"\\\\r\\\\n// }\\\\r\\\\n\\\\r\\\\nif( this.form.currentRouteName.indexOf(\\\\\\\"不通过\\\\\\\") \u003e -1 ){\\\\r\\\\n    this.data.add(\\\\\\\"applyFailure\\\\\\\",\\\\\\\"yes\\\\\\\",true);\\\\r\\\\n    // this.saveToResourcePool();\\\\r\\\\n}\\\\r\\\\nreturn true;\\\"},\\\"appType\\\":\\\"process.FormDesigner\\\"},\\\"html\\\":\\\"\u003cdiv id\u003d\\\\\\\"b06fa362-7327-4d8c-b12d-f541f51828ba\\\\\\\" mwftype\u003d\\\\\\\"form\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-layout\\\\\\\"\u003e\u003cdiv id\u003d\\\\\\\"actionbar\\\\\\\" mwftype\u003d\\\\\\\"actionbar\\\\\\\" class\u003d\\\\\\\"form-toolbar-area\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv class\u003d\\\\\\\"form-toolbar\\\\\\\" style\u003d\\\\\\\"background-color: rgb(255, 255, 255); padding: 0px 1em; overflow-wrap: normal; word-break: keep-all; cursor: pointer; height: auto; display: flex; font-size: 1em; margin: 0px auto; border-top: 0px; border-bottom: 0px; flex-wrap: wrap; gap: 0.5em 0.3em;\\\\\\\"\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"close\\\\\\\" title\u003d\\\\\\\"关闭文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"closeWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"关闭\\\\\\\" sty