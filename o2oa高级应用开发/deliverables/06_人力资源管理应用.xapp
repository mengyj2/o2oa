          "data": "SELECT o FROM employeeBaseInf o",
          "scriptText": "var wheres \u003d [];\r\n// if( parameters.partyBCompany ){\r\n//     wheres.push( \" xpartyBCompany like \u0027%\" + parameters.partyBCompany + \"%\u0027\")\r\n// }\r\nif( parameters.draftUnitUnique ){\r\n    wheres.push( \" o.draftUnitUnique \u003d \u0027\" + parameters.draftUnitUnique + \"\u0027\")\r\n}\r\nif( parameters.draftUnit ){\r\n    wheres.push( \" o.draftUnit like \u0027%\" + parameters.draftUnit + \"%\u0027\")\r\n}\r\n// if( parameters.employmentType ){\r\n//     wheres.push( \" xemploymentType like \u0027%\" + parameters.employmentType + \"%\u0027\")\r\n// }\r\nif( parameters.year ){\r\n    wheres.push( \" o.year \u003d \u0027\"+ parameters.year + \"\u0027\" )\r\n}\r\nif( parameters.monthRange ){\r\n    wheres.push( \" o.month in \"+ parameters.monthRange )\r\n}\r\n// if( parameters.dimissionYear ){\r\n//     wheres.push( \" o.dimissionTime \u003e\u003d {ts \u0027\"+parameters.dimissionYear+\"-01-01 00:00:00\u0027}\");\r\n//     wheres.push( \" o.dimissionTime \u003c\u003d {ts \u0027\"+parameters.dimissionYear+\"-12-31 23:59:59\u0027}\");\r\n// }\r\nvar where \u003d wheres.length ? (\" where \" + wheres.join( \"and \")) : \"\";\r\n\r\nvar sql \u003d \"SELECT o.draftUnit as draftUnit, o.month as month, sum(o.serviceFee_hasTax) as fee  \"+\r\n\" FROM salaryMonthStat o\"+ where +\r\n\" GROUP BY o.draftUnit, o.month\";\r\n\r\nreturn sql;",
          "countData": "SELECT count(o.id) FROM employeeBaseInf o",
          "sql": "SELECT * FROM table",
          "sqlScriptText": "var wheres \u003d [];\r\n// if( parameters.partyBCompany ){\r\n//     wheres.push( \" xpartyBCompany like \u0027%\" + parameters.partyBCompany + \"%\u0027\")\r\n// }\r\nif( parameters.draftUnitUnique ){\r\n    wheres.push( \" xdraftUnitUnique \u003d \u0027\" + parameters.draftUnitUnique + \"\u0027\")\r\n}\r\nif( parameters.draftUnit ){\r\n    wheres.push( \" xdraftUnit like \u0027%\" + parameters.draftUnit + \"%\u0027\")\r\n}\r\n// if( parameters.employmentType ){\r\n//     wheres.push( \" xemploymentType like \u0027%\" + parameters.employmentType + \"%\u0027\")\r\n// }\r\nif( parameters.monthRange ){\r\n    wheres.push( \" xmonth in \"+ parameters.monthRange )\r\n}\r\n// if( parameters.dimissionYear ){\r\n//     wheres.push( \" o.dimissionTime \u003e\u003d {ts \u0027\"+parameters.dimissionYear+\"-01-01 00:00:00\u0027}\");\r\n//     wheres.push( \" o.dimissionTime \u003c\u003d {ts \u0027\"+parameters.dimissionYear+\"-12-31 23:59:59\u0027}\");\r\n// }\r\nvar where \u003d wheres.length ? (\" where \" + wheres.join( \"and \")) : \"\";\r\n\r\nvar sql \u003d \"SELECT xdraftUnit as draftUnit, xmonth as yearMonth, sum(xserviceFee_hasTax) as fee  \"+\r\n\" FROM QRY_DYN_SALARYMONTHSTAT \"+ where +\r\n\" GROUP BY xdraftUnit, xmonth\";\r\n\r\nreturn sql;",
