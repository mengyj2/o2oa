35454;\\\\r\\\\n    --oo-color-main-deep: #c53333;\\\\r\\\\n    --oo-color-over: #f8e3e3;\\\\r\\\\n    --oo-color-deep: #400606;\\\\r\\\\n    --oo-color-light: #FFF7F7;\\\\r\\\\n    --oo-color-hover: #FFF7F7;\\\\r\\\\n    --oo-color-icon: #a69292;\\\\r\\\\n    --oo-color-hover2: #fce3e3;\\\\r\\\\n    --oo-color-odd-even: #FAFAFA;\\\\r\\\\n} */\\\\r\\\\n\\\\r\\\\n/* :root {\\\\r\\\\n    --oo-color-main: #232f3e;\\\\r\\\\n    --oo-color-main-light: #545B64;\\\\r\\\\n    --oo-color-main-deep: #121923;\\\\r\\\\n    --oo-color-over: #e7eaec;\\\\r\\\\n    --oo-color-deep: #1e2a38;\\\\r\\\\n    --oo-color-light: #f3f4f5;\\\\r\\\\n    --oo-color-hover: #ededef;\\\\r\\\\n    --oo-color-icon: #9293A6;\\\\r\\\\n    --oo-color-hover2: #ededef;\\\\r\\\\n    --oo-color-odd-even: #FAFAFA;\\\\r\\\\n} */\\\\r\\\\n\\\\r\\\\n.ooicon-create {\\\\r\\\\n    background-color: var(--oo-color-deep);\\\\r\\\\n    border-radius: 100%;\\\\r\\\\n    height: 3em;\\\\r\\\\n    width: 3em;\\\\r\\\\n    opacity: 0.1;\\\\r\\\\n    color: var(--oo-color-text-white);\\\\r\\\\n    position: absolute;\\\\r\\\\n    right: 1em;\\\\r\\\\n    bottom: 1em;\\\\r\\\\n    display: flex !important;\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: center;\\\\r\\\\n    cursor: pointer;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n    transition: opacity 0.3s;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.ooicon-create:hover {\\\\r\\\\n    opacity: 0.8;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 自定义布局样式 *************************/\\\\r\\\\n.page-custom-layout {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 60em;\\\\r\\\\n    right: -60em;\\\\r\\\\n    padding: 2em;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n.page-custom-layout-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 30em;\\\\r\\\\n    right: -30em;\\\\r\\\\n    padding: 2em 0;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.page-custom-widget-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n.page-custom-title {\\\\r\\\\n    display: flex;\\\\r\\\\n    font-size: 1.125rem;\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: space-between;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close:hover {\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-description {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-area {\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n    position: relative;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category {\\\\r\\\\n    /* border-left: 0.25rem solid var(--oo-color-main); */\\\\r\\\\n    background-color: var(--oo-color-bg-white);\\\\r\\\\n    padding: 1em 0;\\\\r\\\\n    gap: 0.5em;\\\\r\\\\n    display: flex;\\\\r\\\\n    align-items: center;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:first-child {\\\\r\\\\n    font-size: 1.125em;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:last-child {\\\\r\\\\n    transform: rotate(90deg);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item {\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n.add-widget-item:hover .title {\\\\r\\\\n    color: var(--oo-color-main);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .title {\\\\r\\\\n    color: var(--oo-color-text1);\\\\r\\\\n    text-align: center;\\\\r\\\\n    line-height: 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .big-title {\\\\r\\\\n    color: var(--oo-color-text1);\\\\r\\\\n    text-align: center;\\\\r\\\\n    line-height: 2em;\\\\r\\\\n    font-size: 1.125em;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .preview {\\\\r\\\\n    background: #F7F7F7;\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    text-align: center;\\\\r\\\\n    padding: 0.5em;\\\\r\\\\n    justify-content: center;\\\\r\\\\n    position: relative;\\\\r\\\\n}\\\\r\\\\n.add-widget-item .preview:hover {\\\\r\\\\n    box-shadow: 0 0 1px 2px var(--oo-color-main);\\\\r\\\\n}\\\\r\\\\n.add-widget-item .preview div {\\\\r\\\\n    position: absolute;\\\\r\\\\n    top: 1em;\\\\r\\\\n    right: 1em;\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n.add-widget-item .preview:hover div {\\\\r\\\\n    color: var(--oo-color-main);\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .preview\u003eimg {\\\\r\\\\n    width: 18em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .description {\\\\r\\\\n    padding: 0.5em;\\\\r\\\\n    font-size: 0.875em;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-area{\\\\r\\\\n    display: flex;\\\\r\\\\n    gap: 1em;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-area .preview{\\\\r\\\\n    flex: 2;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-content{\\\\r\\\\n    flex: 3;\\\\r\\\\n    background: #F7F7F7;\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    display: flex;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    padding: 1em;\\\\r\\\\n    position: relative;\\\\r\\\\n    flex-wrap: wrap;\\\\r\\\\n    align-content: flex-start;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-tab{\\\\r\\\\n    display: flex;\\\\r\\\\n    flex: 100%;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-tab-title{\\\\r\\\\n    padding: 0.5em 0.35em;\\\\r\\\\n    margin-right: 0.5em;\\\\r\\\\n    height: 100%;\\\\r\\\\n    display: flex;\\\\r\\\\n    align-items: center;\\\\r\\\\n    min-width: 4.4em;\\\\r\\\\n    max-width: 4.4em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-par-tab-content{\\\\r\\\\n    border: 1px solid #dedede;\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    border-radius: 4px;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-tab-content td, .add-widget-par-tab-content th{\\\\r\\\\n    border-bottom: 1px solid #dedede;\\\\r\\\\n    text-align: center;\\\\r\\\\n}\\\\r\\\\n.add-widget-par-tab-content th{\\\\r\\\\n    background-color: #f7f7f7;\\\\r\\\\n    padding: 0.3em;\\\\r\\\\n}\\\\r\\\\n\\\"},\\\"pageStyleType\\\":\\\"blue-simple\\\",\\\"pid\\\":\\\"Mobile0a1f1082-cd7b-4a88-946c-9f64004af72d0a1f1082-cd7b-4a88-946c-9f64004af72d\\\",\\\"languageType\\\":\\\"none\\\",\\\"languageScript\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"widgetList\\\":[],\\\"formStyleType\\\":\\\"v10\\\",\\\"cssLink\\\":\\\"../x_component_process_FormDesigner/Module/Form/skin/styles_v10.css\\\",\\\"styleConfig\\\":{\\\"name\\\":\\\"v10\\\",\\\"file\\\":\\\"styles_v10.json\\\",\\\"extendFile\\\":\\\"styles_v10_extend.json\\\",\\\"mode\\\":[\\\"pc\\\",\\\"mobile\\\"]},\\\"validationOpinion\\\":{},\\\"validationRoute\\\":{},\\\"validationFormCustom\\\":{},\\\"textareaDisableResize\\\":