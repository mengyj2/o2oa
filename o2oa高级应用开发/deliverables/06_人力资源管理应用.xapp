        {
          "id": "7344e520-02ee-499a-bf6f-4e1ac4b96547",
          "name": "SalaryView",
          "alias": "",
          "description": "工资视图",
          "validated": true,
          "portal": "f7186604-c886-4341-9fc8-bdbf5a55afbd",
          "text": "//引入math.js\r\no2.load(\u0027../x_portal_assemble_surface/jaxrs/file/f0a17dca-d80d-4207-9e4d-e75a230a8436/portal/f7186604-c886-4341-9fc8-bdbf5a55afbd/content\u0027);\r\n\r\nthis.define(\u0027validAndImportSalary\u0027, function( event, target ){\r\n    var employeeList \u003d event.rowList.map(function(r){\r\n        return r.data.idNumber.trim();\r\n    }).unique();\r\n    var p1 \u003d this.statement.execute({\r\n        \"name\": \"queryEmployeefile\", \"mode\" : \"data\", \"pageSize\" : 100000000,\r\n        \"parameter\" : { \"employees\" : employeeList }\r\n    }).then(function(json){\r\n        var map \u003d {};\r\n        json.data.each(function(d){ map[d.employee] \u003d d; });\r\n        return map;\r\n    });\r\n    var p2 \u003d this.statement.execute({\r\n        \"name\": \"salaryIdNumberMatch\", \"mode\" : \"data\", \"pageSize\" : 100000000,\r\n        \"parameter\" : {\r\n            \"employees\" : employeeList,\r\n            \"month\": target.options.month\r\n        }\r\n    }).then(function(json){\r\n        var map \u003d {};\r\n        json.data.each(function(d){ map[d.employee] \u003d d; });\r\n        return map;\r\n    });\r\n    var curDepartment \u003d o2common.getCurrentDepartmentDn() || \"\";\r\n    var currentPerson \u003d o2common.getPerson() || \"\";\r\n    event.promise \u003d Promise.all([p1, p2]).then(function( arr ){\r\n        var employeeMap \u003d arr[0];\r\n        var salaryMap \u003d arr[1];\r\n        var flag \u003d true;\r\n        event.rowList.each(function(r){\r\n            var employee \u003d r.data.idNumber.trim();\r\n            if( !employeeMap[employee] ){\r\n                r.errorTextList.push(`该员工在系统中不存在(员工号：${employee})`);\r\n                r.errorTextListExcel.push(`该员工在系统中不存在(员工号：${employee})`);\r\n                flag \u003d false;\r\n            }else{\r\n                var d \u003d employeeMap[employee];\r\n                Object.assign(r.data, {\r\n                    draftUnitDn: curDepartment,\r\n                    draftUnit: curDepartment.split(\u0027@\u0027)[0] || \u0027\u0027,\r\n                    draftUnitUnique: curDepartment.split(\u00271\u0027)[0] || \u0027\u0027,\r\n                    draftPersonDn: currentPerson,\r\n                    draftPerson: currentPerson.split(\u0027@\u0027)[0] || \u0027\u0027,\r\n                    draftPersonUnique: currentPerson.split(\u0027@\u0027)[1] || \u0027\u0027,\r\n                    unique: d.userunique,\r\n                    distinguishedName: `${d.name}@${d.userunique}@P`,\r\n                    unit: d.salaryUnit || \u0027\u0027,\r\n                    unitName: d.salaryUnit?.split(\"@\")[0] || \u0027\u0027,\r\n                    unitUnique: d.salaryUnit?.split(\"@\")[1] || \u0027\u0027,\r\n                    ...d\r\n                });\r\n            }\r\n            if( salaryMap[employee] ){\r\n                r.errorTextList.push(`该员工在${target.options.month}的工资在系统中已存在。`);\r\n                r.errorTextListExcel.push(`该员工在${target.options.month}的工资在系统中已存在。`);\r\n                flag \u003d false;\r\n            }\r\n        }.bind(this))\r\n        if( !flag )event.validted \u003d false;\r\n    }.bind(this))\r\n});\r\n\r\nthis.define(\"afterImportSalary\", function(event){\r\n    if( event.status \u003d\u003d\u003d \u0027导入成功\u0027 ){\r\n        var monthUnitMap \u003d {};\r\n        event.rowList.each(function(item){\r\n            var d \u003d item.data;\r\n            if( !monthUnitMap[d.month] )monthUnitMap[d.month] \u003d [];\r\n            var unitList \u003d monthUnitMap[d.month];\r\n            if( !unitList.contains(d.unit) ){\r\n                unitList.push( d.unit );\r\n            }\r\n        })\r\n        var ps2 \u003d [];\r\n        for( var month in monthUnitMap ){\r\n            monthUnitMap[month].each(function(u){\r\n                var p \u003d _self.createSalaryMonthData( month, null, u, true );\r\n                ps2.push(p);\r\n            })\r\n        }\r\n        Promise.all(ps2).then(function(){\r\n            console.log(\u0027导入成功\u0027, console.log(\u0027monthUnitMap\u0027, monthUnitMap))\r\n        })\r\n    }\r\n})\r\n\r\nthis.define(\"deleteSelectedSalary\", function( target ){\r\n    var list \u003d target.view.selectedItems;\r\n    var table \u003d new this.Table(\"salaryDetails\");\r\n    if(list.length\u003e0){\r\n        this.form.confirm(\"wran\", \"删除确认\", \"您确定要删除选中的工资条吗？\", 300, 100,function(){\r\n            //执行删除代码\r\n            for(i\u003d0; i\u003clist.length; i++){\r\n                table.deleteRow( list[i].data.id, null, null, false );\r\n            }\r\n            \r\n            var closeDlg \u003d function(){\r\n                target.view.reload();\r\n                _self.form.notice(\"删除成功\", \"success\", null)\r\n                this.close();\r\n            }.bind(this)\r\n\r\n            debugger;\r\n            \r\n            var monthUnitMap \u003d {};\r\n            list.each(function(item){\r\n                var d \u003d item.data;\r\n                if( !monthUnitMap[d.month] )monthUnitMap[d.month] \u003d [];\r\n                var unitList \u003d monthUnitMap[d.month];\r\n                if( !unitList.contains(d.unit) ){\r\n                    unitList.push( d.unit );\r\n                }\r\n            })\r\n            var ps2 \u003d [];\r\n            for( var month in monthUnitMap ){\r\n                monthUnitMap[month].each(function(u){\r\n                    var p \u003d _self.createSalaryMonthData( month, null, u, true );\r\n                    ps2.push(p);\r\n                })\r\n            }\r\n            Promise.all(ps2).then(function(){\r\n                closeDlg();\r\n            })\r\n            \r\n        \r\n        }, function(){\r\n            this.close();\r\n        });\r\n    }else{\r\n        this.form.notice(\"请选择要删除工资条目\", \"info\", null); //, {\"x\": \"center\", \"y\": \"center\"}\r\n    }\r\n})\r\n\r\nthis.define(\u0027deleteFeeByCondition\u0027, function(){\r\n    // var partyBCompany \u003d this.form.get(\"partyBCompany\").getData();\r\n    var filter \u003d this.form.get(\"statement\").view.getCondition();\r\n\r\n    debugger;\r\n    var month;\r\n    var hasMonth \u003d filter.some(function(d){\r\n        if( d.path \u003d\u003d\u003d \u0027o.month\u0027 ){\r\n            month \u003d d.value;\r\n            return true;\r\n        }\r\n    })\r\n    \r\n    if( !hasMonth ){\r\n        this.form.notice(\u0027请填写需要删除的月份\u0027, \u0027info\u0027);\r\n        return;\r\n    }\r\n    \r\n    \r\n    var html \u003d \"您将删除\u003cspan style\u003d\u0027color:red;\u0027\u003e\" + new Date(month+\"-01\").format(\u0027%Y年%m月\u0027) + \"\u003c/span\u003e\"\r\n    \r\n    var isAll \u003d true;\r\n    \r\n    html +\u003d \"的\"\r\n        \r\n    this.statement.execute(\r\n        {\r\n         \"name\" : \"salaryDetail_id\", //（String）必选，查询配置的名称、别名或ID\r\n         \"mode\" : \"all\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n         \"page\" : 1,\r\n         \"pageSize\" : 20000000,\r\n         \"filter\": filter,\r\n         \"parameter\" : {}\r\n        }, function(json){\r\n            var list \u003d json.data;\r\n            if(list.length\u003e0){\r\n                this.form.confirm(\"wran\", \"删除确认\", \"\"+html+\"的\u003cspan style\u003d\u0027color:red;\u0027\u003e\"+json.count+\"\u003c/span\u003e条工资数据。确定要执行？\", 300, 100,function(){\r\n                    //执行删除代码\r\n                    var confirmDlg \u003d this;\r\n                    var table \u003d new _self.Table(\"salaryDetails\");\r\n                    var ps \u003d list.map(function(d){\r\n                        return table.deleteRow( d.id );\r\n                    })\r\n                    var closeDlg \u003d function(){\r\n                        _self.form.get(\u0027statement\u0027).reload();\r\n                        _self.form.notice(\"删除成功\", \"success\", null)\r\n                        confirmDlg.close();\r\n                    }\r\n                    Promise.all(ps).then(function(){\r\n                        if( isAll ){\r\n                            _self.createSalaryMonthData( month, function(){\r\n                                closeDlg();\r\n                            }, \"\", true )\r\n                        }else{\r\n                            var unitList \u003d [];\r\n                            list.each(function(d){\r\n                                if( !unitList.contains(d.unit) ){\r\n                                   unitList.push( d.unit );\r\n                                }\r\n                            })\r\n                            var ps2 \u003d unitList.map(function(u){\r\n                                return _self.createSalaryMonthData( month, null, u, true )\r\n                            })\r\n                            Promise.all(ps2).then(function(){\r\n                                closeDlg();\r\n                            })\r\n                        }\r\n                    })\r\n                }, function(){\r\n                    this.close();\r\n                });\r\n            }else{\r\n                this.form.notice(\"没有符合条件的工资条。\", \"info\", null); //, {\"x\": \"center\", \"y\": \"center\"}\r\n            }\r\n        }.bind(this), true\r\n    );\r\n    \r\n    \r\n    \r\n\r\n\r\n})",
          "dependScriptList": [],
          "creatorPerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdatePerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdateTime": "2025-02-14 15:25:39",
          "createTime": "2026-09-21 16:09:31",
          "updateTime": "2026-09-21 17:56:39"
        },
        {
          "id": "a66704fa-69ae-48b0-bc54-4be700c6b424",
          "name": "SalaryChart",
          "alias": "",
          "description": "工资图表",
          "validated": true,
          "portal": "f7186604-c886-4341-9fc8-bdbf5a55afbd",
          "text": "var _self \u003d this;\r\n\r\nthis.define(\u0027value\u0027, function(d, name){\r\n    if( typeOf( d[name] ) !\u003d\u003d \u0027null\u0027 )return d[name];\r\n    if( typeOf( d[name.toUpperCase()] ) !\u003d\u003d \u0027null\u0027 )return d[name.toUpperCase()];\r\n    return d[name.toLowerCase()] || \"其他\"\r\n});\r\n\r\nthis.define(\u0027mathformat\u0027, function(v){\r\n    return math.format(v, { notation: \u0027fixed\u0027, precision: 2 });\r\n});\r\n\r\nthis.define(\u0027loadMainPageFeeChart\u0027, function(){\r\n    var filter \u003d [];\r\n    var parameter \u003d {};\r\n    var ranges \u003d [new Date().format(\u0027%Y-01\u0027), new Date().format(\u0027%Y-%m\u0027)].map(function(r){\r\n        return \"\u0027\"+r+\"\u0027\"\r\n    });\r\n    parameter.monthRange \u003d \"(\"+ ranges.join(\",\") +\")\";\r\n\r\n    this.loadFeeBarChart(filter, parameter);\r\n    //this.loadFeePieChart(filter, parameter);\r\n\r\n    var par2 \u003d Object.clone(parameter);\r\n    delete par2.company;\r\n    par2.companyEquals \u003d (this.getCompany()[0])?.distinguishedName;\r\n    this.loadFeeBarChart_unit(filter, par2);\r\n    //this.loadCurrentCompanyFeePieChart(filter, par2);\r\n})\r\n\r\nthis.define(\u0027filterFeeChart\u0027, function(){\r\n    var company \u003d this.form.get(\"company\").getData();\r\n    //var unit \u003d this.form.get(\"unit\").getData();\r\n    var startMonth \u003d this.form.get(\"startMonth\").getData();\r\n    var endtMonth \u003d this.form.get(\"endMonth\").getData();\r\n\r\n    var filter \u003d [];\r\n    var parameter \u003d {};\r\n\r\n    if( company ){\r\n        parameter.company \u003d company;\r\n    }\r\n    // if( unit ){\r\n    //     parameter.unit \u003d unit;\r\n    // }\r\n    // if(employmentType){\r\n    //     parameter.employmentType \u003d employmentType;\r\n    // }\r\n    if(startMonth || endtMonth){\r\n        var range;\r\n        if( !startMonth || !endtMonth ){\r\n            range \u003d monthRange.filter(function(month){ return !!month; });\r\n        }else{\r\n            range \u003d o2common.getAllMonthsBetween(startMonth, endtMonth);\r\n        }\r\n        if( range.length ){\r\n            var ranges \u003d range.map(function(r){\r\n                return \"\u0027\"+r+\"\u0027\"\r\n            });\r\n            parameter.monthRange \u003d \"(\"+ ranges.join(\",\") +\")\"\r\n        }\r\n    }\r\n\r\n    // if( !this.hasPermission([\u0027Manager\u0027,\u0027业务数据查看者\u0027,\u0027费用数据查看者\u0027]) ){\r\n    //     parameter.unitUnique \u003d o2common.getCurrentDepartmentUnique();\r\n    // }\r\n\r\n    this.loadFeeBarChart(filter, parameter, true);\r\n    //this.loadFeePieChart(filter, parameter);\r\n    this.loadFeeLineChart(filter, parameter, true);\r\n\r\n    var par2 \u003d Object.clone(parameter);\r\n    if( par2.company ){\r\n        par2.companyEquals \u003d par2.company;\r\n        delete par2.company;\r\n    }else{\r\n        par2.companyEquals \u003d (this.getCompany()[0])?.distinguishedName;\r\n    }\r\n    this.loadFeeBarChart_unit(filter, par2);\r\n    // this.loadCompanyFeeMonthListChart(filter, par2);\r\n    this.loadFeeLineChart_unit(filter, par2);\r\n    //  this.loadUnitFeePieChart(filter, parameter);\r\n})\r\n\r\nthis.define(\u0027listUnit\u0027, function(nameList, callback){\r\n    if( this.unitMap )callback( this.unitMap );\r\n    var promise \u003d this.org.getUnit( nameList, true, true);\r\n    return promise.then(function(unitList){\r\n        //unitList 为返回的组织，单个是对象，多个是数组。\r\n        this.unitMap \u003d {};\r\n        unitList.each(function(u){\r\n            this.unitMap[u.matchKey] \u003d u;\r\n        }.bind(this))\r\n        callback( this.unitMap );\r\n    }.bind(this))\r\n})\r\n\r\nthis.define(\u0027getUnitShortName\u0027, function(draftName){\r\n    var shortName;\r\n    if( this.unitMap[draftName] ){\r\n        shortName \u003d this.unitMap[draftName].shortName;\r\n    }\r\n    return shortName || draftName.split(\u0027@\u0027)[0];\r\n})\r\n\r\nthis.define(\u0027loadFeeBarChart\u0027, function(filter, parameter, hasTitle){\r\n    if( this.feeLineChart ){\r\n        this.feeLineChart.destroy();\r\n    }\r\n    this.feeLineChart \u003d new O2EhartsUtils();\r\n\r\n    this.statement.execute(\r\n        {\r\n            \"name\" : \"chart-unitFee\", //（String）必选，查询配置的名称、别名或ID\r\n            \"mode\" : \"data\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n            \"page\" : 1, //（number）可选，当前页码，默认为1\r\n            \"pageSize\" : 200000, //（number）可选，每页的数据条数，默认为20\r\n            \"filter\": filter || [],\r\n            \"parameter\" : parameter || {}\r\n        },\r\n        function(json){\r\n            var companys \u003d json.data.map(function(d){\r\n                return _self.value(d, \u0027company\u0027);\r\n            })\r\n            _self.listUnit( companys,\r\n                function(){\r\n                    var feeMap \u003d {};\r\n\r\n                    var companyList \u003d json.data.map(function(d){\r\n                        var company \u003d _self.value(d, \u0027company\u0027);\r\n                        var unit \u003d _self.value(d, \u0027unit\u0027);\r\n                        var fee \u003d _self.value(d, \u0027fee\u0027);\r\n\r\n                        if(!feeMap[company]){\r\n                            feeMap[company] \u003d {\r\n                                company: company,\r\n                                fee: fee,\r\n                                unitList: [d],\r\n                                description: unit.split(\u0027@\u0027)[0] + \": \" + (fee / 10000).toFixed(2) + \"万元\"\r\n                            };\r\n                        }else{\r\n                            var da \u003d feeMap[company];\r\n                            da.fee \u003d da.fee + d.fee;\r\n                            da.description \u003d da.description + \u0027\u003cbr\u003e\u0027 + unit.split(\u0027@\u0027)[0] + \": \" + (fee / 10000).toFixed(2) + \"万元\"\r\n                            da.unitList.push(d);\r\n                        }\r\n\r\n                        return _self.getUnitShortName(_self.value(d, \u0027company\u0027));\r\n                    });\r\n\r\n\r\n                    // var feeList \u003d json.data.map(function(d){\r\n                    //     total \u003d total + _self.value(d, \u0027fee\u0027);\r\n                    //     d.value \u003d (_self.value(d, \u0027fee\u0027) / 10000).toFixed(2); // \"123.46\"\r\n                    //     d.name \u003d _self.getUnitShortName(_self.value(d, \u0027unit\u0027));\r\n                    //     return d;\r\n                    // });\r\n\r\n\r\n\r\n                    var total \u003d 0;\r\n                    var feeList \u003d [];\r\n                    Object.each(feeMap, function(d){\r\n                        total \u003d total + _self.value(d, \u0027fee\u0027);\r\n                        d.value \u003d (_self.value(d, \u0027fee\u0027) / 10000).toFixed(2); // \"123.46\"\r\n                        d.name \u003d _self.getUnitShortName(_self.value(d, \u0027company\u0027));\r\n                        feeList.push(d);\r\n                    })\r\n\r\n                    feeList.sort(function(a, b){\r\n                        return a.name.localeCompare(b.name);\r\n                    })\r\n\r\n\r\n                    var option \u003d {\r\n                        title: {\r\n                            text: hasTitle ? \"各分公司工资情况\" : null,\r\n                            subtext: \u0027总费用：\u0027+ (total / 10000).toFixed(2) + \"万元\",\r\n                            subtextStyle: {\r\n                                fontSize: 14,\r\n                                color:\"#000\"\r\n                            },\r\n                            left: \u0027center\u0027\r\n                        },\r\n                        grid: {\r\n                            left: \u002780px\u0027,    // 图表距离容器左侧的距离\r\n                            right: \u00274%\u0027,   // 图表距离容器右侧的距离\r\n                            bottom: \u002750px\u0027,  // 图表距离容器底部的距离\r\n                            top: \u002750px\u0027,    // 图表距离容器顶部的距离\r\n                            // 其他grid配置...\r\n                        },\r\n                        tooltip: {\r\n                            trigger: \u0027axis\u0027, // 触发类型，可选为：\u0027item\u0027、\u0027axis\u0027\r\n                            axisPointer: { // 坐标轴指示器，坐标轴触发有效\r\n                                type: \u0027shadow\u0027 // 默认为直线，可选为：\u0027line\u0027 | \u0027shadow\u0027\r\n                            },\r\n                            formatter: function(params) {\r\n                                return `${_self.value(params[0].data, \u0027company\u0027).split(\"@\")[0]}:  ${params[0].value + \u0027 万元\u0027}\u003cbr\u003e\r\n                                   ${params[0].data.description} `; // 自定义显示内容\r\n                            }\r\n                        },\r\n                        xAxis: {\r\n                            type: \u0027category\u0027,\r\n                            data: feeList.map(function(d){return d.name}),\r\n                            axisLabel: {\r\n                                rotate: -20 // 这里设置旋转的角度\r\n                            }\r\n                        },\r\n                        yAxis: {\r\n                            name: \"工资\",\r\n                            axisLabel: {\r\n                                formatter: \u0027{value} 万元\u0027\r\n                            }\r\n                        },\r\n                        series: [\r\n                            {\r\n                                type: \u0027bar\u0027,\r\n                                data: feeList,\r\n                                barWidth: \u002730%\u0027,\r\n                                label: {\r\n                                    show: true,\r\n                                    position: \u0027top\u0027, // 标签的位置，这里设置为柱子的顶部\r\n                                    formatter: function(params) {\r\n                                        return params.value; // 返回百分比字符串作为标签\r\n                                    }\r\n                                }\r\n                            }\r\n                        ]\r\n                    };\r\n\r\n                    this.feeLineChart.load( this.form.get(\u0027div_feeBarChart\u0027).node, function(){\r\n                        this.feeLineChart.setOption( option )\r\n                    }.bind(this));\r\n                }.bind(this))\r\n        }.bind(this)\r\n    );\r\n});\r\n\r\n\r\nthis.define(\u0027loadFeePieChart\u0027, function(filter, parameter){\r\n    if( this.feePieChart ){\r\n        this.feePieChart.destroy();\r\n    }\r\n    this.feePieChart \u003d new O2EhartsUtils();\r\n\r\n    this.statement.execute(\r\n        {\r\n            \"name\" : \"chart-companyFee\", //（String）必选，查询配置的名称、别名或ID\r\n            \"mode\" : \"data\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n            \"page\" : 1, //（number）可选，当前页码，默认为1\r\n            \"pageSize\" : 200000, //（number）可选，每页的数据条数，默认为20\r\n            \"filter\": filter || [],\r\n            \"parameter\" : parameter || {}\r\n        },\r\n        function(json){\r\n            var total \u003d 0;\r\n            json.data.each(function(d){\r\n                total \u003d total + _self.value(d, \u0027fee\u0027);\r\n                d.value \u003d (_self.value(d, \u0027fee\u0027) / 10000).toFixed(2);;\r\n                d.name \u003d _self.value(d, \u0027unit\u0027).split(\u0027@\u0027)[0] ;\r\n            });\r\n\r\n            json.data.sort(function(a, b){\r\n                return a.name.localeCompare(b.name);\r\n            })\r\n\r\n            var subtextNode \u003d this.form.get(\"label_draftUnitFeePie\");\r\n            if(subtextNode){\r\n                subtext \u003d {};\r\n                subtextNode.node.set(\"text\", \u0027总费用：\u0027+ (total / 10000).toFixed(2) + \"万元\")\r\n            }else{\r\n                subtext \u003d {\r\n                    subtext: \u0027总费用：\u0027+ (total / 10000).toFixed(2) + \"万元\",\r\n                    subtextStyle: {\r\n                        fontSize: 14,\r\n                        color:\"#000\"\r\n                    },\r\n                    left: \u0027right\u0027\r\n                };\r\n            }\r\n\r\n            var option \u003d {\r\n                title: subtext,\r\n                series: [\r\n                    {\r\n                        type: \u0027pie\u0027,\r\n                        data: json.data,\r\n                        label: {\r\n                            position: \"outside\",\r\n                            show: true,\r\n                            formatter: function (params) {\r\n                                return params.data.name + \u0027(\u0027+ params.data.value+\u0027万元)\u0027 + \u0027\u0027 + _self.mathformat(params.percent) + \u0027%\u0027; // 返回格式化后的百分比字符串\r\n                            }\r\n                        },\r\n                        emphasis: {\r\n                            label: {\r\n                                show: true,\r\n                                fontSize: \u002720\u0027,\r\n                                fontWeight: \u0027normal\u0027\r\n                                // formatter: function(params) {\r\n                                //     // 这里可以根据需要自定义悬停时的标签文字\r\n                                //     return params.data.name + \u0027\\n（\u0027+ params.data.value+\u0027万元）\u0027 + _self.mathformat(params.percent) + \u0027%\u0027; // 返回格式化后的百分比字符串\r\n                                // }\r\n                            },\r\n                        }\r\n                    }\r\n                ]\r\n            };\r\n\r\n            this.feePieChart.load( this.form.get(\u0027div_feePieChart\u0027).node, function(){\r\n                this.feePieChart.setOption( option )\r\n            }.bind(this));\r\n        }.bind(this)\r\n    );\r\n})\r\n\r\n\r\nthis.define(\u0027loadFeeLineChart\u0027, async function(filter, parameter){\r\n    // 数据\r\n    const json \u003d await this.statement.execute(\r\n        {\r\n            \"name\" : \"chart-companyFee-month\", //（String）必选，查询配置的名称、别名或ID\r\n            \"mode\" : \"data\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n            \"page\" : 1, //（number）可选，当前页码，默认为1\r\n            \"pageSize\" : 200000, //（number）可选，每页的数据条数，默认为20\r\n            \"filter\": filter || [],\r\n            \"parameter\" : parameter || {}\r\n        }\r\n    );\r\n\r\n    const data \u003d json.data;\r\n\r\n\r\n    var chart \u003d this.feeMonthLineChart;\r\n\r\n    if( chart )chart.destroy();\r\n\r\n    this.feeMonthLineChart \u003d chart \u003d new O2EhartsUtils();\r\n\r\n    // 数据处理\r\n    const processedData \u003d {};\r\n    let totalFee \u003d 0; // 总费用\r\n\r\n    data.forEach((item) \u003d\u003e {\r\n        const month \u003d item.month;\r\n        const unit \u003d item.unit.split(\"@\")[0]; // 提取分公司名称\r\n        const fee \u003d item.fee;\r\n\r\n        if (!processedData[unit]) {\r\n            processedData[unit] \u003d {\r\n                name: unit,\r\n                data: [],\r\n            };\r\n        }\r\n\r\n        processedData[unit].data.push({\r\n            month,\r\n            fee,\r\n        });\r\n\r\n        totalFee +\u003d fee; // 累加总费用\r\n    });\r\n\r\n    // 提取月份和分公司数据\r\n    const months \u003d [...new Set(data.map((item) \u003d\u003e item.month))].sort(); // 去重并排序\r\n    const series \u003d Object.values(processedData).map((unit) \u003d\u003e ({\r\n        name: unit.name,\r\n        type: \"line\",\r\n        data: months.map((month) \u003d\u003e {\r\n            const item \u003d unit.data.find((d) \u003d\u003e d.month \u003d\u003d\u003d month);\r\n            return item ? item.fee : 0; // 如果某个月份没有数据，填充为 0\r\n        }),\r\n    }));\r\n\r\n    // 配置 ECharts\r\n    const option \u003d {\r\n        title: {\r\n            text: \"分公司每月工资情况\",\r\n            subtext: `总费用: ${(totalFee / 10000).toFixed(2)} 万元`, // 显示总费用（万元）\r\n            left: \"center\",\r\n        },\r\n        grid: {\r\n            left: \u002780px\u0027,    // 图表距离容器左侧的距离\r\n            right: \u00274%\u0027,   // 图表距离容器右侧的距离\r\n            bottom: \u002750px\u0027,  // 图表距离容器底部的距离\r\n            top: \u002750px\u0027,    // 图表距离容器顶部的距离\r\n            // 其他grid配置...\r\n        },\r\n        tooltip: {\r\n            trigger: \"axis\",\r\n            formatter: function (params) {\r\n                let tooltipText \u003d `${params[0].axisValue}\u003cbr\u003e`; // 显示月份\r\n                params.forEach((item) \u003d\u003e {\r\n                    const value \u003d (item.value / 10000).toFixed(2); // 转换为万元并保留两位小数\r\n                    tooltipText +\u003d `${item.marker} ${item.seriesName}: ${value} 万元\u003cbr\u003e`;\r\n                });\r\n                return tooltipText;\r\n            },\r\n        },\r\n        legend: {\r\n            data: Object.values(processedData).map((unit) \u003d\u003e unit.name),\r\n            bottom: 10,\r\n        },\r\n        xAxis: {\r\n            type: \"category\",\r\n            data: months,\r\n            name: \"月份\",\r\n        },\r\n        yAxis: {\r\n            type: \"value\",\r\n            name: \"工资\",\r\n        },\r\n        series,\r\n    };\r\n\r\n    chart.load( this.form.get(\u0027div_feeLineChart\u0027).node, function(){\r\n        chart.setOption( option )\r\n    }.bind(this));\r\n})\r\n\r\n\r\n\r\nthis.define(\u0027loadFeeBarChart_unit\u0027, function(filter, parameter){\r\n    if( this.currentCompanyFeeLineChart ){\r\n        this.currentCompanyFeeLineChart.destroy();\r\n    }\r\n    this.currentCompanyFeeLineChart \u003d new O2EhartsUtils();\r\n\r\n    var par \u003d parameter || {};\r\n    this.statement.execute(\r\n        {\r\n            \"name\" : \"chart-unitFee\", //（String）必选，查询配置的名称、别名或ID\r\n            \"mode\" : \"data\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n            \"page\" : 1, //（number）可选，当前页码，默认为1\r\n            \"pageSize\" : 200000, //（number）可选，每页的数据条数，默认为20\r\n            \"filter\": filter || [],\r\n            \"parameter\" : par\r\n        },\r\n        function(json){\r\n            var units \u003d json.data.map(function(d){\r\n                return _self.value(d, \u0027unit\u0027);\r\n            })\r\n            _self.listUnit( units,\r\n                function(){\r\n                    var total \u003d 0;\r\n\r\n                    var feeList \u003d json.data.map(function(d){\r\n                        total \u003d total + _self.value(d, \u0027fee\u0027);\r\n                        d.value \u003d (_self.value(d, \u0027fee\u0027) / 10000).toFixed(2); // \"123.46\"\r\n                        d.name \u003d _self.getUnitShortName(_self.value(d, \u0027unit\u0027));\r\n                        return d;\r\n                    });\r\n\r\n                    feeList.sort(function(a, b){\r\n                        return a.name.localeCompare(b.name);\r\n                    })\r\n\r\n\r\n                    var option \u003d {\r\n                        title: {\r\n                            subtext: par.companyEquals.split(\u0027@\u0027)[0]+\u0027总费用：\u0027+ (total / 10000).toFixed(2) + \"万元\",\r\n                            subtextStyle: {\r\n                                fontSize: 14,\r\n                                color:\"#000\"\r\n                            },\r\n                            left: \u0027right\u0027\r\n                        },\r\n                        grid: {\r\n                            left: \u002780px\u0027,    // 图表距离容器左侧的距离\r\n                            right: \u00274%\u0027,   // 图表距离容器右侧的距离\r\n                            bottom: \u002750px\u0027,  // 图表距离容器底部的距离\r\n                            top: \u002750px\u0027,    // 图表距离容器顶部的距离\r\n                            // 其他grid配置...\r\n                        },\r\n                        tooltip: {\r\n                            trigger: \u0027axis\u0027, // 触发类型，可选为：\u0027item\u0027、\u0027axis\u0027\r\n                            axisPointer: { // 坐标轴指示器，坐标轴触发有效\r\n                                type: \u0027shadow\u0027 // 默认为直线，可选为：\u0027line\u0027 | \u0027shadow\u0027\r\n                            },\r\n                            formatter: function(params) {\r\n                                return `${_self.value(params[0].data, \u0027unit\u0027).split(\"@\")[0]}:  ${params[0].value + \u0027 万元\u0027} `; // 自定义显示内容\r\n                            }\r\n                        },\r\n                        xAxis: {\r\n                            type: \u0027category\u0027,\r\n                            data: feeList.map(function(d){return d.name}),\r\n                            axisLabel: {\r\n                                rotate: -20 // 这里设置旋转的角度\r\n                            }\r\n                        },\r\n                        yAxis: {\r\n                            name: \"费用支出总量\",\r\n                            axisLabel: {\r\n                                formatter: \u0027{value} 万元\u0027\r\n                            }\r\n                        },\r\n                        series: [\r\n                            {\r\n                                type: \u0027bar\u0027,\r\n                                data: feeList,\r\n                                barWidth: \u002730%\u0027,\r\n                                label: {\r\n                                    show: true,\r\n                                    position: \u0027top\u0027, // 标签的位置，这里设置为柱子的顶部\r\n                                    formatter: function(params) {\r\n                                        return params.value; // 返回百分比字符串作为标签\r\n                                    }\r\n                                }\r\n                            }\r\n                        ]\r\n                    };\r\n\r\n                    this.currentCompanyFeeLineChart.load( this.form.get(\u0027div_feeBarChart_unit\u0027).node, function(){\r\n                        this.currentCompanyFeeLineChart.setOption( option );\r\n                    }.bind(this));\r\n                }.bind(this))\r\n        }.bind(this)\r\n    );\r\n});\r\n\r\nthis.define(\u0027loadFeePieChart_unit\u0027, function(filter, parameter){\r\n    if( this.currentCompanyFeePieChart ){\r\n        this.currentCompanyFeePieChart.destroy();\r\n    }\r\n    this.currentCompanyFeePieChart \u003d new O2EhartsUtils();\r\n\r\n    var par \u003d parameter || {};\r\n    this.statement.execute(\r\n        {\r\n            \"name\" : \"chart-unitFee\", //（String）必选，查询配置的名称、别名或ID\r\n            \"mode\" : \"data\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n            \"page\" : 1, //（number）可选，当前页码，默认为1\r\n            \"pageSize\" : 200000, //（number）可选，每页的数据条数，默认为20\r\n            \"filter\": filter || [],\r\n            \"parameter\" : par\r\n        },\r\n        function(json){\r\n            var total \u003d 0;\r\n            json.data.each(function(d){\r\n                total \u003d total + _self.value(d, \u0027fee\u0027);\r\n                d.value \u003d (_self.value(d, \u0027fee\u0027) / 10000).toFixed(2);\r\n                d.name \u003d _self.value(d, \u0027unit\u0027).split(\u0027@\u0027)[0] ;\r\n            });\r\n\r\n            json.data.sort(function(a, b){\r\n                return a.name.localeCompare(b.name);\r\n            })\r\n\r\n            var subtextNode \u003d this.form.get(\"label_draftUnitFeePie\");\r\n            if(subtextNode){\r\n                subtext \u003d {};\r\n                subtextNode.node.set(\"text\", par.companyEquals.split(\u0027@\u0027)[0]+\u0027总费用：\u0027+ (total / 10000).toFixed(2) + \"万元\")\r\n            }else{\r\n                subtext \u003d {\r\n                    subtext: par.companyEquals.split(\u0027@\u0027)[0]+\u0027总费用：\u0027+ (total / 10000).toFixed(2) + \"万元\",\r\n                    subtextStyle: {\r\n                        fontSize: 14,\r\n                        color:\"#000\"\r\n                    },\r\n                    left: \u0027right\u0027\r\n                };\r\n            }\r\n\r\n            var option \u003d {\r\n                title: subtext,\r\n                series: [\r\n                    {\r\n                        type: \u0027pie\u0027,\r\n                        data: json.data,\r\n                        label: {\r\n                            position: \"outside\",\r\n                            show: true,\r\n                            formatter: function (params) {\r\n                                return params.data.name + \u0027(\u0027+ params.data.value+\u0027万元)\u0027 + \u0027\u0027 + _self.mathformat(params.percent) + \u0027%\u0027; // 返回格式化后的百分比字符串\r\n                            }\r\n                        },\r\n                        emphasis: {\r\n                            label: {\r\n                                show: true,\r\n                                fontSize: \u002720\u0027,\r\n                                fontWeight: \u0027normal\u0027\r\n                                // formatter: function(params) {\r\n                                //     // 这里可以根据需要自定义悬停时的标签文字\r\n                                //     return params.data.name + \u0027\\n（\u0027+ params.data.value+\u0027万元）\u0027 + _self.mathformat(params.percent) + \u0027%\u0027; // 返回格式化后的百分比字符串\r\n                                // }\r\n                            },\r\n                        }\r\n                    }\r\n                ]\r\n            };\r\n\r\n            this.currentCompanyFeePieChart.load( this.form.get(\u0027div_feePieChart_unit\u0027).node, function(){\r\n                this.currentCompanyFeePieChart.setOption( option )\r\n            }.bind(this));\r\n        }.bind(this)\r\n    );\r\n})\r\n\r\n\r\nthis.define(\u0027loadFeeLineChart_unit\u0027, async function(filter, parameter){\r\n    // 数据\r\n    const json \u003d await this.statement.execute(\r\n        {\r\n            \"name\" : \"chart-unitFee-month\", //（String）必选，查询配置的名称、别名或ID\r\n            \"mode\" : \"data\", //（String）必选，“all”、“data”或者“count”，all表示同时执行查询语句和总数语句，data表示执行查询语句，count表示执行总数语句\r\n            \"page\" : 1, //（number）可选，当前页码，默认为1\r\n            \"pageSize\" : 200000, //（number）可选，每页的数据条数，默认为20\r\n            \"filter\": filter || [],\r\n            \"parameter\" : parameter || {}\r\n        }\r\n    );\r\n\r\n    const data \u003d json.data;\r\n\r\n\r\n    var chart \u003d this.feeMonthLineChart_unit;\r\n\r\n    if( chart )chart.destroy();\r\n\r\n    this.feeMonthLineChart_unit \u003d chart \u003d new O2EhartsUtils();\r\n\r\n    // 数据处理\r\n    const processedData \u003d {};\r\n    let totalFee \u003d 0; // 总费用\r\n\r\n    data.forEach((item) \u003d\u003e {\r\n        const month \u003d item.month;\r\n        const unit \u003d item.unit.split(\"@\")[0]; // 提取分公司名称\r\n        const fee \u003d item.fee;\r\n\r\n        if (!processedData[unit]) {\r\n            processedData[unit] \u003d {\r\n                name: unit,\r\n                data: [],\r\n            };\r\n        }\r\n\r\n        processedData[unit].data.push({\r\n            month,\r\n            fee,\r\n        });\r\n\r\n        totalFee +\u003d fee; // 累加总费用\r\n    });\r\n\r\n    // 提取月份和分公司数据\r\n    const months \u003d [...new Set(data.map((item) \u003d\u003e item.month))].sort(); // 去重并排序\r\n    const series \u003d Object.values(processedData).map((unit) \u003d\u003e ({\r\n        name: unit.name,\r\n        type: \"line\",\r\n        data: months.map((month) \u003d\u003e {\r\n            const item \u003d unit.data.find((d) \u003d\u003e d.month \u003d\u003d\u003d month);\r\n            return item ? item.fee : 0; // 如果某个月份没有数据，填充为 0\r\n        }),\r\n    }));\r\n\r\n    // 配置 ECharts\r\n    const option \u003d {\r\n        title: {\r\n            text: \"各部门每月工资情况\",\r\n            subtext: `总费用: ${(totalFee / 10000).toFixed(2)} 万元`, // 显示总费用（万元）\r\n            left: \"center\",\r\n        },\r\n        grid: {\r\n            left: \u002780px\u0027,    // 图表距离容器左侧的距离\r\n            right: \u00274%\u0027,   // 图表距离容器右侧的距离\r\n            bottom: \u002750px\u0027,  // 图表距离容器底部的距离\r\n            top: \u002750px\u0027,    // 图表距离容器顶部的距离\r\n            // 其他grid配置...\r\n        },\r\n        tooltip: {\r\n            trigger: \"axis\",\r\n            formatter: function (params) {\r\n                let tooltipText \u003d `${params[0].axisValue}\u003cbr\u003e`; // 显示月份\r\n                params.forEach((item) \u003d\u003e {\r\n                    const value \u003d (item.value / 10000).toFixed(2); // 转换为万元并保留两位小数\r\n                    tooltipText +\u003d `${item.marker} ${item.seriesName}: ${value} 万元\u003cbr\u003e`;\r\n                });\r\n                return tooltipText;\r\n            },\r\n        },\r\n        legend: {\r\n            data: Object.values(processedData).map((unit) \u003d\u003e unit.name),\r\n            bottom: 10,\r\n        },\r\n        xAxis: {\r\n            type: \"category\",\r\n            data: months,\r\n            name: \"月份\",\r\n        },\r\n        yAxis: {\r\n            type: \"value\",\r\n            name: \"工资\",\r\n        },\r\n        series,\r\n    };\r\n\r\n    chart.load( this.form.get(\u0027div_feeLineChart_unit\u0027).node, function(){\r\n        chart.setOption( option )\r\n    }.bind(this));\r\n})\r\n\r\n",
          "dependScriptList": [],
          "creatorPerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdatePerson": "huqi@huqi@P",
          "lastUpdateTime": "2026-01-31 15:11:53",
          "createTime": "2026-09-21 16:09:31",
          "updateTime": "2026-09-21 17:56:39"
        },
        {
          "id": "d4b961a9-ab3a-48d6-8f35-f0b850f9fd72",
          "name": "FeeCommon",
          "alias": "",
          "description": "",
          "validated": true,
          "portal": "f7186604-c886-4341-9fc8-bdbf5a55afbd",
          "text": "this.define(\"createSalaryMonthData\", function( month, callback, departmentDn, asy ){\r\n    return o2.Actions.load(\u0027x_program_center\u0027).InvokeAction.execute(\"createSalartMonthStatData\", {\r\n        month: month,\r\n        unit: departmentDn\r\n    }, function( json ){\r\n        if( !json.success ){\r\n            _self.form.notice( json.msg || \"创建工资统计数据出错，请联系管理员\", \"error\" );\r\n        }\r\n        if(callback)callback(json);\r\n    }, asy \u003d\u003d\u003d true)\r\n})\r\n\r\n// this.define(\"getFeeConditionSync\", function(key){\r\n//     if( !this.feeConditionData ){\r\n//         var par \u003d {};\r\n//         if( this.hasPermission([\"人事员\",\"业务科室长\",\"主管领导\"], null, [\u0027Manager\u0027,\u0027业务数据查看者\u0027,\u0027费用数据查看者\u0027] ) ){\r\n//             var unit \u003d o2common.getCurrentUnitsByDutys([\"人事员\",\"业务科室长\",\"主管领导\"]);\r\n//             if( unit \u0026\u0026 unit.length ){\r\n//                 var draftUnits \u003d unit.map(function(u){\r\n//                     return \"\u0027\"+u.name+\"\u0027\";\r\n//                 })\r\n//                 par.draftUnitList \u003d \"(\"+ draftUnits.join(\",\") +\")\"\r\n//             }\r\n//         } \r\n//         this.statement.execute({\r\n//              \"name\" : \"getFeeSearchCondition\",\r\n//              \"mode\" : \"data\",\r\n//              \"page\" : 1,\r\n//              \"pageSize\" : 2000,\r\n//              parameter : par\r\n//             }, function(json){\r\n//                 this.feeConditionData \u003d json.data;\r\n//             }.bind(this), false)\r\n//     };\r\n//     var data \u003d this.feeConditionData.map(function(d){\r\n//         return d[key]\r\n//     }).unique().trim();\r\n//     data.sort(function(a, b){\r\n//         return a.localeCompare(b);\r\n//     })\r\n//     return data;\r\n// })\r\n\r\n\r\n// this.define(\"getFeeCondition\", function(key){\r\n//     if( !this.feeConditionPromise ){\r\n//         var par \u003d {};\r\n//         if( this.hasPermission([\"人事员\",\"业务科室长\",\"主管领导\"], null, [\u0027Manager\u0027,\u0027业务数据查看者\u0027,\u0027费用数据查看者\u0027] ) ){\r\n//             var unit \u003d o2common.getCurrentUnitsByDutys([\"人事员\",\"业务科室长\",\"主管领导\"]);\r\n//             if( unit \u0026\u0026 unit.length ){\r\n//                 var draftUnits \u003d unit.map(function(u){\r\n//                     return \"\u0027\"+u.name+\"\u0027\";\r\n//                 })\r\n//                 par.draftUnitList \u003d \"(\"+ draftUnits.join(\",\") +\")\"\r\n//             }\r\n//         } \r\n//         this.feeConditionPromise \u003d this.statement.execute({\r\n//              \"name\" : \"getFeeSearchCondition\",\r\n//              \"mode\" : \"data\",\r\n//              \"page\" : 1,\r\n//              \"pageSize\" : 2000,\r\n//              parameter : par\r\n//             }, null, true)\r\n//     }\r\n//     return Promise.resolve(this.feeConditionPromise).then(function(json){\r\n//         var data \u003d json.data.map(function(d){\r\n//             return d[key]\r\n//         }).unique().trim();\r\n//         data.sort(function(a, b){\r\n//             return a.localeCompare(b);\r\n//         })\r\n//         return [\"\"].concat( data );\r\n//     })\r\n// })",
          "dependScriptList": [],
          "creatorPerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdatePerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
