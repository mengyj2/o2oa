        {
          "id": "583ccf68-862f-4711-8b3e-920684328a1e",
          "name": "费用统计表_汇总",
          "alias": "feeStat_total",
          "format": "jpql",
          "description": "feeStat_total",
          "query": "b20993ae-79ee-43ee-a56e-f764a459c520",
          "fv": 8.0,
          "executePersonList": [],
          "executeUnitList": [],
          "executeGroupList": [],
          "data": "select o.month, o.draftUnit, o.partyBCompany, o.employmentType,\r\n        sum(case when o.managementFee \u003e 0 then 1 else 0 end) as personCount,\r\n        sum(\r\n            o.postWage + o.floatingWage + o.overtimeWage + o.overtimeWage1 + o.backpay + o.skillAllowance \r\n            + o.startingAllowance + o.nightAllowance + o.trafficAllowance + o.commuterBusFee + o.shiftAllowance\r\n        ) as payableWagesTotal,\r\n        sum(\r\n            o.performanceBonus + o.specialPurposeFund + o.quarterlySecurityAwards + o.otherAwards\r\n        ) as bonusTotal,\r\n        sum(o.missMealAllowance) as missMealAllowance,\r\n        sum(o.expatriateAllowance) as expatriateAllowance,\r\n        sum(o.seaAllowance) as seaAllowance,\r\n        sum(o.travelExpense) as travelExpense,\r\n        sum(o.trainBonus) as trainBonus,\r\n        sum(o.medicalCosts) as medicalCosts,\r\n        sum(o.coolingFee) as coolingFee,\r\n        sum(o.monetaryCompensation) as monetaryCompensation,\r\n        sum(o.laborInsurance) as laborInsurance,\r\n        sum(o.otherWage) as otherWage,\r\n\r\n        sum(o.pension_c + o.pension_refund_c) as pension_c,\r\n        sum(o.unemploymentInsurance_c + o.unemploymentInsurance_refund_c) as unemploymentInsurance_c,\r\n        sum(o.medicalInsurance_c + o.medicalInsurance_refund_c) as medicalInsurance_c,\r\n        sum(o.maternityInsurance_c + o.maternityInsurance_refund_c) as maternityInsurance_c,\r\n        sum(o.workInjuryInsurance_c + o.workInjuryInsurance_refund_c) as workInjuryInsurance_c,\r\n        sum(o.housingProvidentFund_c + o.housingProvidentFund_refund_c) as housingProvidentFund_c,\r\n        sum(o.criticalIllnessInsurance_c + o.other_refund_c) as criticalIllnessInsurance_c,\r\n        sum(o.longTermCareInsurance_c) as longTermCareInsurance_c,\r\n        sum(o.employersLiabilityInsurance_c) as employersLiabilityInsurance_c,\r\n        sum(o.accidentInsurance_c) as accidentInsurance_c,\r\n\r\n        sum(o.disabilityPension) as disabilityPension,\r\n        sum(o.managementFee) as managementFee,\r\n        \r\n        sum(o.laborCostsSubtotal_includeTax) as serviceFee_hasTax\r\n\r\n\r\nFROM salaryDetails o \r\ngroup by o.draftUnit, o.month, o.partyBCompany, o.employmentType\r\norder by o.draftUnit asc, o.month asc, o.partyBCompany asc, o.employmentType asc",
          "countData": "SELECT count(o.id) FROM salaryDetails o",
          "view": "{\"id\":\"583ccf68-862f-4711-8b3e-920684328a1e_view\",\"data\":{\"noDataText\":\"未找到数据\",\"selectList\":[{\"id\":\"CAAFD4745430000142472E001C80D010\",\"column\":\"month\",\"displayName\":\"月份\",\"orderType\":\"original\",\"events\":{\"loadTitle\":{\"code\":\"\",\"html\":\"\"},\"loadContent\":{\"code\":\"\",\"html\":\"\"},\"click\":{\"code\":\"\",\"html\":\"\"},\"mousedown\":{\"code\":\"\",\"html\":\"\"},\"mouseup\":{\"code\":\"\",\"html\":\"\"},\"mouseout\":{\"code\":\"\",\"html\":\"\"},\"mouseover\":{\"code\":\"\",\"html\":\"\"}},\"vid\":\"583ccf68-862f-4711-8b3e-920684328a1e_view\",\"pid\":\"583ccf68-862f-4711-8b3e-920684328a1e_viewCAAFD4745430000142472E001C80D010\",\"mid\":\"CAAFD4745430000142472E001C80D010\",\"allowOpen\":false,\"hideColumn\":false,\"isName\":false,\"isHtml\":false,\"exportEnable\":true,\"isTime\":false,\"isNumber\":false,\"path\":\"month\",\"total\":\"no\",\"exportWidth\":\"100\"},{\"id\":\"CAAFD4748B400001219B49D01590B550\",\"column\":\"draftUnit\",\"displayName\":\"服务主体\",\"orderType\":\"original\",\"events\":{\"loadTitle\":{\"code\":\"\",\"html\":\"\"},\"loadContent\":{\"code\":\"\",\"html\":\"\"},\"click\":{\"code\":\"\",\"html\":\"\"},\"mousedown\":{\"code\":\"\",\"html\":\"\"},\"mouseup\":{\"code\":\"\",\"html\":\"\"},\"mouseout\":{\"code\":\"\",\"html\":\"\"},\"mouseover\":{\"code\":\"\",\"html\":\"\"}},\"vid\":\"583ccf68-862f-4711-8b3e-920684328a1e_view\",\"pid\":\"583ccf68-862f-4711-8b3e-920684328a1e_viewCAAFD4748B400001219B49D01590B550\",\"mid\":\"CAAFD4748B400001219B49D01590B550\",\"allowOpen\":false,\"hideColumn\":false,\"isName\":false,\"isHtml\":false,\"exportEnable\":true,\"isTime\":false,\"isNumber\":false,\"path\":\"draftUnit\",\"total\":\"no\"},{\"id\":\"CAAF6A0BCEA0000195F0C4906010E8E0\",\"column\":\"partyBCompany\",\"displayName\":\"乙方服务公司\",\"orderType\":\"original\",\"events\":{\"loadTitle\":{\"code\":\"\",\"html\":\"\"},\"loadContent\":{\"code\":\"\",\"html\":\"\"},\"click\":{\"code\":\"\",\"html\":\"\"