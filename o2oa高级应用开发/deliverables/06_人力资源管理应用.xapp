\n//             \u003coo-button class\u003d\\\\\\\"page-nav-title-create-button\\\\\\\" left-icon\u003d\\\\\\\"${tool.icon}\\\\\\\" style\u003d\\\\\\\"width: 100%;\\\\\\\" type\u003d\\\\\\\"${isMobile ? \u0027icon-simple\u0027 : \u0027default\u0027}\\\\\\\"\u003e${isMobile ? \u0027\u0027 : \u0027\u0027}\u003c/oo-button\u003e\\\\r\\\\n//         \u003c/div\u003e`;\\\\r\\\\n//         menuNode.insertAdjacentHTML(\u0027afterbegin\u0027, createHtml);\\\\r\\\\n//         createNode \u003d navi.querySelector(`.page-nav-title-create-button`);\\\\r\\\\n//         createNode.addEvent(\u0027click\u0027, ()\u003d\u003e{\\\\r\\\\n//             var action \u003d view.actionbarAreaNode.querySelector(\u0027[mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\"]\u0027);\\\\r\\\\n//             action?.click();\\\\r\\\\n//         })\\\\r\\\\n\\\\r\\\\n//         view.actionbarAreaNode?.hide();\\\\r\\\\n//     }\\\\r\\\\n// }\\\\r\\\\n\\\\r\\\\nif(o2.isMediaMobile() ){\\\\r\\\\n    const navi \u003d this.form.get(\u0027navi\u0027).node;\\\\r\\\\n\\\\r\\\\n    let menuNode \u003d navi.querySelector(`.page-content-section-menu`);\\\\r\\\\n    if(!menuNode){\\\\r\\\\n        const menuHtml \u003d `\u003cdiv slot\u003d\\\\\\\"before-outer\\\\\\\" class\u003d\\\\\\\"page-content-section-menu\\\\\\\"\u003e\u003c/div\u003e`;\\\\r\\\\n        navi.insertAdjacentHTML(\u0027afterbegin\u0027, menuHtml);\\\\r\\\\n        menuNode \u003d navi.querySelector(`.page-content-section-menu`);\\\\r\\\\n    }else{\\\\r\\\\n        menuNode.empty();\\\\r\\\\n    }\\\\r\\\\n    \\\\r\\\\n    checkTools(navi, menuNode);\\\\r\\\\n    checkSearch(navi, menuNode);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n\\\",\\\"html\\\":\\\"const view \u003d this.target.view;\\\\r\\\\n// const actionbarList \u003d view.viewJson.actionbarHidden !\u003d\u003d true \u0026\u0026 view.viewJson.actionbarList;\\\\r\\\\n// const tools \u003d (!!actionbarList.length \u0026\u0026 actionbarList[0].multiTools) || [];\\\\r\\\\n// const hasTools \u003d tools.length \u003e 0;\\\\r\\\\n\\\\r\\\\n\\\\r\\\\nconst filterList \u003d  view.viewJson.customFilterList || [];\\\\r\\\\nconst hasSearch \u003d filterList.length \u003e 0;\\\\r\\\\n\\\\r\\\\nconst isMobile \u003d o2.isMediaMobile(); \\\\r\\\\n\\\\r\\\\nconst checkSearch \u003d (navi, menuNode)\u003d\u003e{\\\\r\\\\n    // let searchNode \u003d navi.querySelector(`.page-nav-title-search-button`);\\\\r\\\\n    // if( searchNode ){\\\\r\\\\n    //     searchNode.destroy();\\\\r\\\\n    // }\\\\r\\\\n    let searchNode;\\\\r\\\\n    if(hasSearch){\\\\r\\\\n        const searchHtml \u003d `\u003cdiv class\u003d\\\\\\\"page-nav-title-search\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\\\\r\\\\n            \u003coo-button class\u003d\\\\\\\"page-nav-title-search-button\\\\\\\" left-icon\u003d\\\\\\\"search\\\\\\\" style\u003d\\\\\\\"width: 100%; display: ;\\\\\\\" type\u003d\\\\\\\"icon-simple\\\\\\\"\u003e\u003c/oo-button\u003e\\\\r\\\\n        \u003c/div\u003e`;\\\\r\\\\n        menuNode.insertAdjacentHTML(\u0027afterbegin\u0027, searchHtml);\\\\r\\\\n        searchNode \u003d navi.querySelector(`.page-nav-title-search-button`);\\\\r\\\\n        searchNode.addEvent(\u0027click\u0027, () \u003d\u003e {\\\\r\\\\n            const searchAreaNode \u003d this.form.node().querySelector(\u0027.searchAreaNodeV10\u0027);\\\\r\\\\n            const searchArea \u003d searchAreaNode?.querySelector(\u0027.page-content-section-search, .search-area\u0027);\\\\r\\\\n            if (searchArea) {\\\\r\\\\n                if (searchAreaNode.offsetParent) {\\\\r\\\\n                    searchAreaNode.hide();\\\\r\\\\n                    //this.hideSearch();\\\\r\\\\n                    searchArea.removeClass(\u0027show\u0027);\\\\r\\\\n                    searchArea.addClass(\u0027hide\u0027);\\\\r\\\\n                } else {\\\\r\\\\n                    var titleNoe \u003d navi.querySelector(\u0027.page-nav-title\u0027);\\\\r\\\\n                    var y \u003d titleNoe.getSize().y;\\\\r\\\\n                    searchAreaNode.show();\\\\r\\\\n                    //this.showSearch();\\\\r\\\\n                    searchArea.addClass(\u0027show\u0027);\\\\r\\\\n                    searchArea.removeClass(\u0027hide\u0027);\\\\r\\\\n                    searchArea.setStyle(\u0027top\u0027, `${y}px`)\\\\r\\\\n                    searchArea.setStyle(\u0027height\u0027, `calc( 100% - ${y}px )`)\\\\r\\\\n                    if(this.hideNai)this.hideNai();\\\\r\\\\n                }\\\\r\\\\n            }\\\\r\\\\n        });\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    const searchAreaNode \u003d this.form.node().querySelector(\u0027.searchAreaNodeV10\u0027);\\\\r\\\\n    searchAreaNode?.hide();\\\\r\\\\n\\\\r\\\\n    const searchArea \u003d searchAreaNode.querySelector(\u0027.page-content-section-search, .search-area\u0027);\\\\r\\\\n    searchArea?.hide();\\\\r\\\\n\\\\r\\\\n    if(searchArea){\\\\r\\\\n        searchNode?.setStyle(\u0027display\u0027, \u0027block\u0027);\\\\r\\\\n    }else{\\\\r\\\\n        searchNode?.hide();\\\\r\\\\n    }\\\\r\\\\n};\\\\r\\\\n\\\\r\\\\nconst checkTools \u003d (navi, menuNode)\u003d\u003e{\\\\r\\\\n    // let createNode \u003d navi.querySelector(`.page-nav-title-create-button`);\\\\r\\\\n    // if( createNode ){\\\\r\\\\n    //     createNode.destroy();\\\\r\\\\n    // }\\\\r\\\\n    // const actionbarList \u003d view.viewJson.actionbarHidden !\u003d\u003d true \u0026\u0026 view.viewJson.actionbarList;\\\\r\\\\n    // const tools \u003d (!!actionbarList.length \u0026\u0026 actionbarList[0].multiTools) || [];\\\\r\\\\n    // const hasTools \u003d tools.length \u003e 0;\\\\r\\\\n\\\\r\\\\n    const action \u003d view.actionbarAreaNode.querySelector(\u0027[mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\"]\u0027);\\\\r\\\\n\\\\r\\\\n    if(!!action){\\\\r\\\\n        const createHtml \u003d `\u003cdiv class\u003d\\\\\\\"page-nav-title-create\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\\\\r\\\\n            \u003coo-button class\u003d\\\\\\\"page-nav-title-create-button\\\\\\\" left-icon\u003d\\\\\\\"${action.get(\u0027MWFButtonIcon\u0027)}\\\\\\\" style\u003d\\\\\\\"width: 100%;\\\\\\\" type\u003d\\\\\\\"${isMobile ? \u0027icon-simple\u0027 : \u0027default\u0027}\\\\\\\"\u003e${isMobile ? \u0027\u0027 : \u0027\u0027}\u003c/oo-button\u003e\\\\r\\\\n        \u003c/div\u003e`;\\\\r\\\\n        menuNode.insertAdjacentHTML(\u0027afterbegin\u0027, createHtml);\\\\r\\\\n        createNode \u003d navi.querySelector(`.page-nav-title-create-button`);\\\\r\\\\n        createNode.addEvent(\u0027click\u0027, ()\u003d\u003e{\\\\r\\\\n            var action \u003d view.actionbarAreaNode.querySelector(\u0027[mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\"]\u0027);\\\\r\\\\n            action?.click();\\\\r\\\\n        })\\\\r\\\\n\\\\r\\\\n        view.actionbarAreaNode?.hide();\\\\r\\\\n    }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n// const checkTools \u003d (navi, menuNode)\u003d\u003e{\\\\r\\\\n//     // let createNode \u003d navi.querySelector(`.page-nav-title-create-button`);\\\\r\\\\n//     // if( createNode ){\\\\r\\\\n//     //     createNode.destroy();\\\\r\\\\n//     // }\\\\r\\\\n//     if(hasTools){\\\\r\\\\n//         const tool \u003d tools[0];\\\\r\\\\n//         const createHtml \u003d `\u003cdiv class\u003d\\\\\\\"page-nav-title-create\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\\\\r\\\\n//             \u003coo-button class\u003d\\\\\\\"page-nav-title-create-button\\\\\\\" left-icon\u003d\\\\\\\"${tool.icon}\\\\\\\" style\u003d\\\\\\\"width: 100%;\\\\\\\" type\u003d\\\\\\\"${isMobile ? \u0027icon-simple\u0027 : \u0027default\u0027}\\\\\\\"\u003e${isMobile ? \u0027\u0027 : \u0027\u0027}\u003c/oo-button\u003e\\\\r\\\\n//         \u003c/div\u003e`;\\\\r\\\\n//         menuNode.insertAdjacentHTML(\u0027afterbegin\u0027, createHtml);\\\\r\\\\n//         createNode \u003d navi.querySelector(`.page-nav-title-create-button`);\\\\r\\\\n//         createNode.addEvent(\u0027click\u0027, ()