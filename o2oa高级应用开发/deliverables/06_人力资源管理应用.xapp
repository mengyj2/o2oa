tyle\\\":\\\"v10\\\",\\\"nodeStyleWithhideModuleIcon\\\":{\\\"margin-right\\\":\\\"0px\\\"},\\\"confirmIcon\\\":{\\\"success\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/ok.png\\\",\\\"error\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/error.png\\\",\\\"info\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/info.png\\\",\\\"warn\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/notice.png\\\"},\\\"buttonStyle\\\":{\\\"color\\\":\\\"#777\\\",\\\"border-radius\\\":\\\"4px\\\",\\\"border\\\":\\\"1px solid #DCDFE6\\\",\\\"cursor\\\":\\\"pointer\\\",\\\"height\\\":\\\"36px\\\",\\\"line-height\\\":\\\"36px\\\",\\\"padding\\\":\\\"0px 15px\\\",\\\"background-color\\\":\\\"#f4f7f6\\\"},\\\"errorStyle\\\":{\\\"node\\\":{\\\"background\\\":\\\"url(../x_component_process_FormDesigner/Module/Form/notice/icon/error_v10.png) no-repeat 0px center\\\",\\\"color\\\":\\\"var(--oo-color-error)\\\",\\\"min-height\\\":\\\"30px\\\",\\\"padding-left\\\":\\\"20px\\\",\\\"line-height\\\":\\\"30px\\\",\\\"position\\\":\\\"relative\\\",\\\"background-color\\\":\\\"initial\\\",\\\"border\\\":\\\"none\\\",\\\"display\\\":\\\"flex\\\",\\\"border-radius\\\":\\\"\\\"},\\\"close\\\":\\\"\\\"},\\\"selectorStyle\\\":{\\\"style\\\":\\\"v10\\\",\\\"tabStyle\\\":\\\"v10\\\"},\\\"appType\\\":\\\"process.FormDesigner\\\"},\\\"html\\\":\\\"\u003cdiv id\u003d\\\\\\\"b040c313-3368-4033-86c8-e4ffe3e68827\\\\\\\" mwftype\u003d\\\\\\\"form\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-layout\\\\\\\"\u003e\u003cdiv id\u003d\\\\\\\"actionbar\\\\\\\" mwftype\u003d\\\\\\\"actionbar\\\\\\\" class\u003d\\\\\\\"form-toolbar-area\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv class\u003d\\\\\\\"form-toolbar\\\\\\\" style\u003d\\\\\\\"background-color: rgb(255, 255, 255); padding: 0px 1em; border-radius: 0px; overflow-wrap: normal; word-break: keep-all; cursor: pointer; overflow: hidden; height: auto; display: flex; font-size: 1em; border-top: 0px; margin: 0px auto; border-bottom: 0px; flex-wrap: wrap; gap: 0.5em 0.3em;\\\\\\\"\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"close\\\\\\\" title\u003d\\\\\\\"关闭文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"closeWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"关闭\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-close\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e关闭\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"save\\\\\\\" title\u003d\\\\\\\"保存文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"saveWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"保存\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-save\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e保存\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-submit\\\\\\\" title\u003d\\\\\\\"继续流转文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"flowWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"继续流转\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-submit\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e继续流转\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"control-panel\\\\\\\" title\u003d\\\\\\\"调度文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"rerouteWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"调度\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 1px solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: none;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-control-panel\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e调度\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-split\\\\\\\" title\u003d\\\\\\\"增加拆分分支\\\\\\\" mwfbuttonaction\u003d\\\\\\\"addSplit\\\\\\\" mwfbuttontext\u003d\\\\\\\"增加分支\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-split\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e增加分支\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"retract\\\\\\\" title\u003d\\\\\\\"待办撤回\\\\\\\" mwfbuttonaction\u003d\\\\\\\"retractWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"撤回\\\\\\\" style\u003d\\\\\\\"dis