          "text": "this.define(\"addWorkExperienceList_this\", function(data, docData) {\n    \n    debugger;\n    \n    if( !docData.workExperienceList_this ){\n        docData.workExperienceList_this \u003d { data: [] };\n        exprienceList \u003d docData.workExperienceList_this.data;\n    }else{\n        exprienceList \u003d docData.workExperienceList_this.data || [];\n    }\n    \n    exprienceList.sort(function(a, b){\n        var adate \u003d Date.parse( a.startDate_this || \"1900-01-01\" );\n        var bdate \u003d Date.parse( b.startDate_this || \"1900-01-01\" );\n        return new Date(adate) - new Date(bdate);\n    });\n    \n    var now \u003d new Date().format(\"%Y-%m-%d\");\n    if( !data.startDate_this )data.startDate_this \u003d now;\n    \n    switch (data.type_this) {\n        case \u0027入职\u0027:\n            exprienceList.push( data );\n            docData.workExperienceList_this.data \u003d exprienceList;\n            break;\n        case \u0027转正\u0027:\n            debugger;\n            for( var i\u003dexprienceList.length-1; i--; i\u003e\u003d0 ){\n                var d \u003d exprienceList[i];\n                if( d.type_this\u003d\u003d\u003d\"入职\" ){\n                    if( d.unit_this \u0026\u0026 !data.unit_this )data.unit_this \u003d d.unit_this;\n                    if( d.duty_this \u0026\u0026 !data.duty_this )data.duty_this \u003d d.duty_this;\n                    if( !d.endDate_this )d.endDate_this \u003d data.endDate_this || now;\n                    break;\n                }\n            }\n            exprienceList.push( data );\n            docData.workExperienceList_this.data \u003d exprienceList;\n            break;\n        case \u0027离职\u0027:\n            if( exprienceList.length ){\n                var d \u003d exprienceList[exprienceList.length-1];\n                if( !d.endDate_this )d.endDate_this \u003d data.endDate_this || now;\n            }\n            docData.workExperienceList_this.data \u003d exprienceList;\n            break; \n        default:\n            if( exprienceList.length ){\n                var d \u003d exprienceList[exprienceList.length-1];\n                if( d.unit_this \u0026\u0026 !data.unit_this )data.unit_this \u003d d.unit_this;\n                if( d.duty_this \u0026\u0026 !data.duty_this )data.duty_this \u003d d.duty_this;\n                if( !d.endDate_this )d.endDate_this \u003d data.endDate_this || now;\n            }\n            exprienceList.push( data );\n            docData.workExperienceList_this.data \u003d exprienceList;\n            break; \n    }\n    return exprienceList;\n})",
