          "data": "SELECT o.id, o.month, o.idNumber, o.name, o.draftUnitUnique, o.draftUnit FROM salaryDetails o",
          "scriptText": "var whereList \u003d [];\r\nfunction parseInParam( arr ){\r\n    var ar \u003d arr.map( function(j){ return \"\u0027\" + j + \"\u0027\" })\r\n    return \" (\" + ar.join(\",\") +\")\"\r\n}\r\nif( parameters.salaryUnit ){\r\n    whereList.push( \" o.salaryUnit \u003d \u0027\" + parameters.salaryUnit + \"\u0027\");\r\n}\r\nif( parameters.month ){\r\n    whereList.push( \" o.month \u003d \u0027\" + parameters.month + \"\u0027\");\r\n}\r\nif( parameters.employees ){\r\n    whereList.push( \" o.idNumber in \" + parseInParam( parameters.employees )  );\r\n}\r\nvar where \u003d whereList.length ? (\" where \" + whereList.join( \" and \")) : \"\";\r\n\r\nreturn `\r\n    SELECT o.id, o.month, o.idNumber as employee, o.name, o.draftUnitUnique, o.draftUnit\r\n    FROM salaryDetails o ${where}\r\n`;",
          "countData": "SELECT count(o.id) FROM salaryDetails o",
