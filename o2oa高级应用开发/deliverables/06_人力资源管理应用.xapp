          "text": "// var _language;\n// try {\n//     _language \u003d localStorage.getItem(\"o2.language\");\n// } catch (e) {};\n// if( !_language ){\n//     localStorage.setItem(\u0027o2.language\u0027, \u0027zh-cn\u0027);\n//     o2.languageName \u003d \u0027zh-cn\u0027;\n//     o2.language \u003d \u0027zh-cn\u0027;\n// }\n\n\nthis.form.getApp().addEvent(\u0027current\u0027, function(){\n    switch (this.currentModuleType ){\n        case \u0027view\u0027:\n            var view \u003d this.form.get(\u0027view\u0027);\n            if( view \u0026\u0026 view.view \u0026\u0026 view.node.offsetParent !\u003d\u003d null ){\n                !!view.view.searchRender ? view.view.searchRender.searchView() : view.view.search();\n            }\n            break;\n        case \u0027statement\u0027:\n            var statement \u003d this.form.get(\u0027statement\u0027);\n            if( statement \u0026\u0026 statement.view \u0026\u0026 statement.node.offsetParent !\u003d\u003d null ){\n                !!statement.view.searchRender ? statement.view.searchRender.searchView() : statement.view.search();\n            }\n            break;\n        case \u0027widget\u0027:\n            break;\n    }\n    \n}.bind(this));\n\nif(layout.desktop \u0026\u0026 layout.desktop.addEvent)layout.desktop.addEvent(\"wsmessage\", (data)\u003d\u003e{\n    console.log(\u0027data\u0027, data);\n})\n\n\nvar _self \u003d this;\nvar navMenu \u003d [\n    // {\n    //     \"name\": \"home\",\n    //     \"icon\": \"workcenter\",\n    //     \"title\": \"首页\",\n    //     \"text\": \"首页\",\n    //     \"selected\": true,\n    //     \"action\": function () {\n    //         this.showMask();\n    //         this.changeWidget(\u0027\u0027,\u0027人力首页\u0027, {});\n    //     }.bind(this)\n    // },\n    // {\n    //     \"name\": \"todoPage\",\n    //     \"icon\": \"information\",\n    //     \"title\": \"我的工作\",\n    //     \"text\": \"我的工作\",\n    //     \"counts\": function (callback, refresh) {\n    //         return Promise.resolve(_self.loadReadAndTaskCount(refresh)).then(function (json) {\n    //             if(callback)callback(json);\n    //             return json.count;\n    //         });\n    //     },\n    //     \"expanded\": true,\n    //     \"children\": [\n    //         {\n    //             \"icon\": \"create\",\n    //             \"name\": \"create\",\n    //             \"selectable\": \"no\",\n    //             \"text\": \"流程起草\",\n    //             \"action\": function ( par ) {\n    //                 this.showMask();\n    //                 this.page.startProcess(SystemConfig.applicationAlias);\n    //             }.bind(this)\n    //         },\n    //         {\n    //             \"icon\": \"daiban\",\n    //             \"name\": \"task\",\n    //             \"text\": \"待办工作\",\n    //             \"counts\": function (callback, refresh) {\n    //                 return Promise.resolve(_self.loadTaskCount(refresh)).then(function (json) {\n    //                     if(callback)callback(json);\n    //                     return json.count;\n    //                 });\n    //             },\n    //             \"action\": function () {\n    //                 this.showMask();\n    //                 this.changeStatement(\u0027task\u0027, this.getTodoFilter(), []);\n    //             }.bind(this)\n    //         },\n    //         {\n    //             \"icon\": \"daiyue\",\n    //             \"name\": \"read\",\n    //             \"text\": \"待阅工作\",\n    //             \"counts\": function (callback, refresh) {\n    //                 return Promise.resolve(_self.loadReadCount(refresh)).then(function (json) {\n    //                     if(callback)callback(json);\n    //                     return json.count;\n    //                 });\n    //             },\n    //             \"action\": function () {\n    //                 this.showMask();\n    //                 this.changeStatement(\u0027read\u0027, this.getTodoFilter(), []);\n    //             }.bind(this)\n    //         },\n    //         {\n    //             \"icon\": \"yiban\",\n    //             \"name\": \"taskCompleted\",\n    //             \"text\": \"已办工作\",\n    //             \"action\": function () {\n    //                 this.showMask();\n    //                 this.changeStatement(\u0027taskCompleted\u0027, this.getTodoFilter(), []);\n    //             }.bind(this)\n    //         },\n    //         {\n    //             \"icon\": \"process-read\",\n    //             \"name\": \"readCompleted\",\n    //             \"text\": \"已阅工作\",\n    //             \"action\": function () {\n    //                 this.showMask();\n    //                 this.changeStatement(\u0027readCompleted\u0027, this.getTodoFilter(), []);\n    //             }.bind(this)\n    //         }\n    //     ]\n    // },\n    {\n        \"name\": \"myInfor\",\n        \"icon\": \"information\",\n        \"title\": \"我的人事\",\n        \"text\": \"我的人事\",\n        \"select\": ()\u003d\u003e{\n            this.showMask();\n            this.changeWidget(\u0027\u0027,\u0027我的人事\u0027, {});\n        },\n        // \"counts\": function (callback, refresh) {\n        //     return Promise.resolve(_self.loadReadAndTaskCount(refresh)).then(function (json) {\n        //         if(callback)callback(json);\n        //         return json.count;\n        //     });\n        // },\n        \"selectable\": \"yes\",\n        // \"selected\": true,\n        \"expanded\": true,\n        \"children\": [\n            {\n                \"name\": \"myfile\",\n                \"icon\": \"role\",\n                \"title\": \"我的档案\",\n                \"text\": \"我的档案\",\n                \"selectable\": \"no\",\n                \"action\": function ( par ) {\n                    this.showMask();\n                    this.openMyFile()\n                }.bind(this)\n            },\n            {\n                \"name\": \"mySalary\",\n                \"icon\": \"asset\",\n                \"title\": \"我的工资\",\n                \"text\": \"我的工资\",\n                \"action\": function ( par ) {\n                    this.showMask();\n                    this.changeStatement(\u0027salaryDetail_my\u0027, [{\n                        path : \"o.idNumber\",\n                        type : \"filter\",\n                        comparison : \"equals\",\n                        formatType : \"textValue\",\n                        value : \"\",\n                        otherValue : \"\",\n                        code:{ code : \"return \u0027\"+this.session.user.employee+ \"\u0027\" }\n                    }], {}, {});\n                }.bind(this)\n            },\n            {\n                \"name\": \"myContract\",\n                \"icon\": \"contract\",\n                \"title\": \"我的合同\",\n                \"text\": \"我的合同\",\n                \"action\": function ( par ) {\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事合同-我的合同\", [{\n                        \"logic\":\"and\",\n                        \"path\":\"person.0\",\n                        \"comparison\":\"equals\",\n                        \"code\": {\n                            \u0027code\u0027: `return \u0027${this.session.user.distinguishedName}\u0027`\n                        },\n                        \"formatType\":\"textValue\"\n                    }]);\n                }.bind(this)\n            },\n        ]\n    },\n    {\n        \"name\": \"employeeSelfservice\",\n        \"icon\": \"forum\",\n        \"title\": \"员工自助\",\n        \"text\": \"员工自助\",\n        \"select\": ()\u003d\u003e{\n            this.showMask();\n            this.changeWidget(\u0027\u0027,\u0027员工自助首页\u0027, {});\n        },\n        \"selectable\": \"yes\",\n        \"collapse\": false,\n        \"children\": [\n            {\n                \"icon\": \"qingjia\",\n                \"name\": \"leaving\",\n                \"text\": \"请假申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027selfservice\u0027, \"员工自助-请假申请\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"working_hours\",\n                \"name\": \"extrawork\",\n                \"text\": \"加班申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027selfservice\u0027, \"员工自助-加班申请\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"seal\",\n                \"name\": \"seal\",\n                \"text\": \"证明申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027selfservice\u0027, \"员工自助-证明申请\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"travel\",\n                \"name\": \"travel\",\n                \"text\": \"出差申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027selfservice\u0027, \"员工自助-出差申请\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"waiqin\",\n                \"name\": \"outer\",\n                \"text\": \"外勤申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027selfservice\u0027, \"员工自助-外勤申请\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"duty\",\n                \"name\": \"zhuangzheng\",\n                \"text\": \"转正申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动-员工转正\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"work-overtime-record\",\n                \"name\": \"change\",\n                \"text\": \"调动申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动-岗位调动申请\");\n                }.bind(this)\n            },\n        ]\n    },\n    {\n        \"name\": \"attendance\",\n        \"icon\": \"a-attendanceprocess-invoke\",\n        \"title\": \"考勤管理\",\n        \"text\": \"考勤管理\",\n        \"selectable\": \"no\",\n        \"action\": function ( par ) {\n            this.page.openApplication(\u0027attendancev2\u0027);\n        }.bind(this)\n    },\n    {\n        \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n        \"name\": \"employeefile\",\n        \"icon\": \"employee-file\",\n        \"title\": \"员工档案\",\n        \"text\": \"员工档案\",\n        \"children\": [\n            {\n                \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n                \"name\": \"draft\",\n                \"icon\": \"create\",\n                \"title\": \"新建档案\",\n                \"text\": \"新建档案\",\n                \"selectable\": \"no\",\n                \"action\": function ( par ) {\n                    this.form.createDocument(\"\", \"employeeInfo\");\n                }.bind(this)\n            },\n            {\n                \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n                \"name\": \"employeelist\",\n                \"icon\": \"duty\",\n                \"title\": \"在职员工\",\n                \"text\": \"在职员工\",\n                \"action\": function (par) {\n                    this.showMask();\n                    // this.page.openPortal(\"hrPortal\", \"档案查询_全部\", par)\n                    this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, [], []);\n                }.bind(this)\n            },\n            {\n                \"icon\": \"dimission\",\n                \"name\": \"ex\",\n                \"text\": \"离职员工\",\n                \"action\": function (par) {\n                    this.showMask();\n                    //this.page.openPortal(\"hrPortal\", \"档案查询_离职\",par)\n                    this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询_离职\u0027, this.getStatusFilter(4), []);\n                }.bind(this)\n            },\n            // {\n            //     \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n            //     \"name\": \"filelist\",\n            //     \"icon\": \"employee-file\",\n            //     \"title\": \"档案查询\",\n            //     \"text\": \"档案查询\",\n            //     \"action\": function (par) {\n            //         this.showMask();\n            //         // this.page.openPortal(\"hrPortal\", \"档案查询_全部\", par)\n            //         this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, [], [], this.changeInfoFilter);\n            //     }.bind(this),\n            //     \"children\": [\n            //         {\n            //             \"icon\": \"group\",\n            //             \"name\": \"allfile\",\n            //             \"text\": \"全部档案\",\n            //             \"action\": function (par) {\n            //                 this.showMask();\n            //                 // this.page.openPortal(\"hrPortal\", \"档案查询_全部\", par)\n            //                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, []);\n            //             }.bind(this)\n            //         },\n            //         {\n            //             \"icon\": \"duty\",\n            //             \"name\": \"fulltime\",\n            //             \"text\": \"正式员工\",\n            //             \"action\": function (par) {\n            //                 this.showMask();\n            //                 // this.page.openPortal(\"hrPortal\", \"档案查询_正式\", par)\n            //                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, this.getStatusFilter(3));\n            //             }.bind(this)\n            //         },\n            //         {\n            //             \"icon\": \"personnel_export\",\n            //             \"name\": \"probationary\",\n            //             \"text\": \"试用期员工\",\n            //             \"action\": function (par) {\n            //                 this.showMask();\n            //                 //this.page.openPortal(\"hrPortal\", \"档案查询_试用\",par)\n            //                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, this.getStatusFilter(2));\n            //             }.bind(this)\n            //         },\n            //         {\n            //             \"icon\": \"gonghai\",\n            //             \"name\": \"trainee\",\n            //             \"text\": \"见习期员工\",\n            //             \"action\": function (par) {\n            //                 this.showMask();\n            //                 //this.page.openPortal(\"hrPortal\", \"档案查询_见习\",par)\n            //                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, this.getStatusFilter(1));\n            //             }.bind(this)\n            //         },\n            //         {\n            //             \"icon\": \"dimission\",\n            //             \"name\": \"ex\",\n            //             \"text\": \"离职员工\",\n            //             \"action\": function (par) {\n            //                 this.showMask();\n            //                 //this.page.openPortal(\"hrPortal\", \"档案查询_离职\",par)\n            //                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询_离职\u0027, this.getStatusFilter(4));\n            //             }.bind(this)\n            //         }\n            //     ]\n            // },\n            {\n                \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n                \"name\": \"import\",\n                \"icon\": \"export\",\n                \"title\": \"导入档案\",\n                \"text\": \"导入档案\",\n                \"action\": function (par) {\n                    this.showMask();\n                    this.include(\u0027EmployeeImporter\u0027, ()\u003d\u003e{\n                        this.changeWidget(\u0027\u0027,\u0027员工档案导入\u0027, {});\n                    }, true);\n                }.bind(this)\n            }\n        ]\n    },\n    {\n        \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n        \"name\": \u0027hrcontract\u0027,\n        \"icon\": \"contract\",\n        \"title\": \"人事合同\",\n        \"text\": \"人事合同\",\n        \"collapse\": false,\n        \"children\": [\n            {\n                \"name\": \"draftContract\",\n                \"icon\": \"create\",\n                \"title\": \"新建合同\",\n                \"text\": \"新建合同\",\n                \"selectable\": \"no\",\n                \"action\": function ( par ) {\n                    this.form.createDocument(\"\", \"hrcontract\");\n                }.bind(this)\n            },\n            {\n                \"name\": \"startContractRenewal\",\n                \"icon\": \"create\",\n                \"title\": \"发起续签\",\n                \"text\": \"发起续签\",\n                \"selectable\": \"no\",\n                \"action\": function ( par ) {\n                    this.form.startProcess(\"emplyeemanager\", \"contractRenewal\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"list-alt\",\n                \"name\": \"contractView\",\n                \"text\": \"合同查询\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事合同-合同查询\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"caogao\",\n                \"name\": \"hrcontractRenewal\",\n                \"text\": \"续签流程\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动-合同续签\");\n                }.bind(this)\n            },\n            {\n                \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n                \"name\": \"importContract\",\n                \"icon\": \"export\",\n                \"title\": \"导入合同\",\n                \"text\": \"导入合同\",\n                \"action\": function (par) {\n                    this.showMask();\n                    this.changeWidget(\u0027\u0027,\u0027人事合同导入\u0027, {});\n                }.bind(this)\n            },\n        ]\n    },\n    {\n        \"name\": \"employeemanager\",\n        \"icon\": \"personnel\",\n        \"title\": \"员工管理\",\n        \"text\": \"员工管理\",\n        \"select\": ()\u003d\u003e{\n            this.showMask();\n            this.changeWidget(\u0027\u0027,\u0027员工管理首页\u0027, {});\n        },\n        \"selectable\": \"yes\",\n        \"collapse\": false,\n        \"permission\": [\"Manager\", \"SYS-EmployeeManageManager\"],\n        \"children\": [\n            {\n                \"icon\": \"forum\",\n                \"name\": \"recruitment\",\n                \"text\": \"招聘需求\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事管理-招聘需求\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"personnel_export\",\n                \"name\": \"join\",\n                \"text\": \"入职申请\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动-员工入职\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"work-overtime-record\",\n                \"name\": \"change2\",\n                \"text\": \"组织调配\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动-组织调配\");\n                }.bind(this)\n            },\n            {\n                \"icon\": \"dimission\",\n                \"name\": \"dimissionNote\",\n                \"text\": \"辞退通知\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动-辞退通知\");\n                }.bind(this)\n            },\n            // {\n            //     \"icon\": \"dimission\",\n            //     \"name\": \"leave\",\n            //     \"text\": \"离职申请\",\n            //     \"action\": function(par){\n            //         this.showMask();\n            //         this.changeView(\u0027employeeManager\u0027, \"人事变动-离职申请\");\n            //     }.bind(this)\n            // },\n            {\n                \"icon\": \"log-viewer\",\n                \"name\": \"allnotice\",\n                \"text\": \"变动日志\",\n                \"action\": function(par){\n                    this.showMask();\n                    this.changeView(\u0027employeeManager\u0027, \"人事变动日志\", []);\n                }.bind(this)\n            },\n            {\n                \"name\": \"statistics\",\n                \"icon\": \"work-management\",\n                \"title\": \"变动统计\",\n                \"text\": \"变动统计\",\n                \"action\": function(){\n                    this.showMask();\n                    this.changeWidget(\u0027\u0027,\u0027人事统计\u0027, {});\n                }.bind(this)\n            }\n        ]\n    },\n    {\n        \"name\": \"salary\",\n        \"icon\": \"zhichuzhengming\",\n        \"title\": \"工资管理\",\n        \"text\": \"工资管理\",\n        \"permission\": [\"Manager\", \"SYS-SalaryManager\"],\n        \"children\": [\n            {\n                \"name\": \"createSalary\",\n                \"icon\": \"create\",\n                \"title\": \"新建工资条\",\n                \"text\": \"新建工资条\",\n                \"selectable\": \"no\",\n                \"action\": function ( par ) {\n                    this.form.createDocument(\"\", \"salaryDetail\");\n                }.bind(this)\n            },\n            {\n                \"name\": \"importSalary\",\n                \"icon\": \"export\",\n                \"title\": \"导入工资\",\n                \"text\": \"导入工资\",\n                \"action\": function (par) {\n                    this.showMask();\n                    this.changeWidget(\u0027\u0027,\u0027工资条导入\u0027, {});\n                }.bind(this)\n            },\n            {\n                \"icon\": \"cost\",\n                \"name\": \"salaryView\",\n                \"text\": \"个人工资查询\",\n                \"action\": function () {\n                    this.showMask();\n                    this.changeStatement(\u0027salaryDetail_simple\u0027, {}, [], {select: \"multi\"});\n                }.bind(this)\n            },\n            {\n                //\"permission\": [\"Manager\", \"SYS-SalaryManager\"],\n                \"icon\": \"cost\",\n                \"name\": \"salaryStatView\",\n                \"text\": \"工资汇总查询\",\n                \"action\": function () {\n                    this.showMask();\n                    this.changeStatement(\u0027salaryMonthStat_simple\u0027, {}, [], {});\n                }.bind(this)\n            },\n            {\n                //\"permission\": [\"Manager\", \"SYS-SalaryManager\"],\n                \"icon\": \"work-management\",\n                \"name\": \"salaryStatChart\",\n                \"text\": \"工资统计图表\",\n                \"action\": function () {\n                    this.showMask();\n                    this.changeWidget(\u0027\u0027, \u0027工资统计图表\u0027);\n                }.bind(this)\n            }\n        ]\n    },\n    {\n        \"name\": \"cert\",\n        \"icon\": \"shouwen\",\n        \"title\": \"证书管理\",\n        \"text\": \"证书管理\",\n        \"permission\": [\"Manager\", \"SYS-CertManager\"],\n        \"children\": [\n            {\n                \"name\": \"createCert\",\n                \"icon\": \"create\",\n                \"title\": \"创建证书\",\n                \"text\": \"创建证书\",\n                \"selectable\": \"no\",\n                \"action\": function ( par ) {\n                    this.form.createDocument(\"\", \"certDetail\");\n                }.bind(this)\n            },\n            // {\n            //     \"name\": \"importSalary\",\n            //     \"icon\": \"export\",\n            //     \"title\": \"导入工资\",\n            //     \"text\": \"导入工资\",\n            //     \"action\": function (par) {\n            //         this.showMask();\n            //         this.changeWidget(\u0027\u0027,\u0027工资条导入\u0027, {});\n            //     }.bind(this)\n            // },\n            {\n                \"icon\": \"list-alt\",\n                \"name\": \"certView\",\n                \"text\": \"证书查询\",\n                \"action\": function () {\n                    this.showMask();\n                    this.changeView(\u0027cert\u0027,\u0027certView\u0027);\n                }.bind(this)\n            },\n            // {\n            //     //\"permission\": [\"Manager\", \"SYS-SalaryManager\"],\n            //     \"icon\": \"cost\",\n            //     \"name\": \"salaryStatView\",\n            //     \"text\": \"工资汇总查询\",\n            //     \"action\": function () {\n            //         this.showMask();\n            //         this.changeStatement(\u0027salaryMonthStat_simple\u0027, {}, [], {});\n            //     }.bind(this)\n            // },\n            // {\n            //     //\"permission\": [\"Manager\", \"SYS-SalaryManager\"],\n            //     \"icon\": \"work-management\",\n            //     \"name\": \"salaryStatChart\",\n            //     \"text\": \"工资统计图表\",\n            //     \"action\": function () {\n            //         this.showMask();\n            //         this.changeWidget(\u0027\u0027, \u0027工资统计图表\u0027);\n            //     }.bind(this)\n            // }\n        ]\n    },\n    {\n        \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\", \"SYS-EmployeeManageManager\", \"SYS-SalaryManager\"],\n        \"icon\": \"config\",\n        \"name\": \"config\",\n        \"text\": \"维护设置\",\n        \"children\": [\n            {\n                \"permission\": [\"Manager\", \"SYS-EmployeeFileManager\"],\n                \"name\": \"fileconfig\",\n                \"text\": \"档案和合同设置\",\n                \"icon\": \"employee-file\",\n                \"action\": function(){\n                    this.changeWidget(\u0027\u0027, \u0027设置_员工档案和人事合同\u0027);\n                }.bind(this)\n            },\n            {\n                \"permission\": [\"Manager\", \"SYS-EmployeeManageManager\"],\n                \"name\": \"emplyeemanagerconfig\",\n                \"text\": \"员工管理设置\",\n                \"icon\": \"personnel\",\n                \"action\": function(){\n                    this.changeWidget(\u0027\u0027, \u0027设置_员工管理\u0027);\n                }.bind(this)\n            },\n            {\n                \"permission\": [\"Manager\", \"SYS-SalaryManager\"],\n                \"name\": \"salaryconfig\",\n                \"text\": \"工资管理设置\",\n                \"icon\": \"zhichuzhengming\",\n                \"action\": function(){\n                    this.changeWidget(\u0027\u0027, \u0027设置_工资管理\u0027);\n                }.bind(this)\n            },\n            {\n                \"permission\": [\"Manager\", \"SYS-SelfServiceManager\"],\n                \"name\": \"selfserviceconfig\",\n                \"text\": \"员工自助设置\",\n                \"icon\": \"forum\",\n                \"action\": function(){\n                    this.changeWidget(\u0027\u0027, \u0027设置_员工自助\u0027);\n                }.bind(this)\n            },\n            {\n                \"name\": \"certconfig\",\n                \"text\": \"证书管理设置\",\n                \"icon\": \"shouwen\",\n                \"action\": function(){\n                    this.changeWidget(\u0027\u0027, \u0027设置_证书管理\u0027);\n                }.bind(this)\n            },\n            // {\n            //     \"name\": \"hrconfig\",\n            //     \"text\": \"人力资源设置\",\n            //     \"icon\": \"person_manage\",\n            //     \"action\": function(){\n            //         this.changeWidget(\u0027\u0027, \u0027设置_人力资源\u0027);\n            //     }.bind(this)\n            // },\n        ]\n    }\n];\n\nthis.define(\"getTodoFilter\", function(){\n    return [{\n        path : \"o.applicationAlias\",\n        title : \"应用别名\",\n        type : \"filter\",\n        comparison : \"in\",\n        formatType : \"textValue\",\n        value : \"\",\n        otherValue : \"\",\n        code:{ code : \"return \"+this.parseInParam(SystemConfig.applicationAlias)+ \"\" }\n    }]\n});\n\nthis.define(\u0027getChangeTypeFilter\u0027, function( value ){\n    return [{\n        \"logic\":\"and\",\n        \"path\":\"type\",\n        \"comparison\":\"equals\",\n        \"formatType\":\"textValue\",\n        \"code\": { \"code\": \"return \u0027\"+value+\"\u0027;\" },\n        \"otherValue\":\"\"\n    }];\n})\n\nthis.define(\u0027getStatusFilter\u0027, function( statusNumber ){\n    return [{\n        \"logic\":\"and\",\n        \"path\":\"statusNumber\",\n        \"comparison\":\"equals\",\n        \"code\": { \"code\": \"return \"+statusNumber+\";\" },\n        \"formatType\":\"numberValue\"\n    }];\n})\n\nthis.define(\u0027hide\u0027, function(el){\n    el.style.setProperty(\u0027display\u0027, \u0027none\u0027, \u0027important\u0027);\n})\n\nthis.define(\u0027show\u0027, function(el){\n    el.style.display \u003d \u0027\u0027; // 清空 display 属性\n})\n\n// this.define(\u0027changeInfoFilter\u0027, (e, filterObj)\u003d\u003e{\n//     var view \u003d this.page.get(\u0027view\u0027);\n//     let oldFilters \u003d [], searchRenderDate \u003d [];\n//     if( view \u0026\u0026 view.view ){\n//         // if( view.view.filterItems ){\n//         //     oldFilters \u003d view.view.filterItems.forEach((f)\u003d\u003e{\n//         //         return f.code \u003d {\n//         //             code: filterObj.path \u003d\u003d\u003d \"status\" ? `return ${f.value?.toInt()}` : `return ${f.value}`\n//         //         }\n//         //     })\n//         // }\n//         if( view.view.searchRender ){\n//             searchRenderDate \u003d view.view.searchRender.getCondition()\n//         }\n//     };\n//     if( filterObj.path \u003d\u003d\u003d \"status\" ){\n//         switch(filterObj.node.value){\n//             case \u0027\u0027:\n//                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, oldFilters, searchRenderDate, this.changeInfoFilter); break;\n//             case \u0027离职\u0027:\n//                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询_离职\u0027, oldFilters || this.getStatusFilter(4), searchRenderDate, this.changeInfoFilter); break;\n//             default:\n//                 this.changeView(\u0027employeeInfoQuery\u0027,\u0027档案查询\u0027, oldFilters || this.getStatusFilter(filterObj.node.value.toInt()), searchRenderDate, this.changeInfoFilter); break;\n//         }\n//     }\n// })\n\nthis.define(\u0027changeView\u0027, function( appName, viewName, filterList){\n\n    [\u0027div_view\u0027].each(function(f){\n        this.show( this.form.get(f).node );\n    }.bind(this));\n    [\u0027div_searchCondition\u0027, \u0027div_widget\u0027, \u0027statement\u0027].each(function(f){\n        this.hide( this.form.get(f).node );\n    }.bind(this));\n\n    var view \u003d this.page.get(\u0027view\u0027);\n    view.node.show();\n    this.currentView \u003d {\n        \"application\": appName, //应用名称、别名、id\n        \"view\": viewName //视图\n    };\n    view.json.filterList \u003d filterList;\n\n    this.currentModuleType \u003d \u0027view\u0027;\n\n    // view.searchRenderDate \u003d searchRenderDate;\n    // if( !view._beforeLoadView )view._beforeLoadView \u003d (viewJson)\u003d\u003e{\n    //     viewJson.searchRenderDate \u003d view.searchRenderDate;\n    // };\n    // view.removeEvent(\u0027beforeLoadView\u0027, view._beforeLoadView);\n    // view.addEvent(\u0027beforeLoadView\u0027, view._beforeLoadView);\n    \n    view.reload(()\u003d\u003e{\n        // view.view.addEvent(\u0027filterChange\u0027, (e, filterObject)\u003d\u003e{\n        //     if(filterChangeFun)filterChangeFun(e, filterObject);\n        //     console.log(e, filterObject);\n        // })\n    });\n\n    this.pushState({\n        \u0027type\u0027: \u0027hr\u0027,\n        \u0027method\u0027: \u0027changeView\u0027,\n        \u0027args\u0027: [appName, viewName, filterList]\n    })\n})\n\nthis.define(\u0027getCurrentView\u0027, function(){\n    return this.currentView;\n})\n\nthis.define(\u0027changeStatement\u0027, function(statementName, filterList, parameters,options){\n    [ \u0027div_view\u0027].each(function(f){\n        this.show( this.form.get(f).node );\n    }.bind(this));\n    [\u0027div_searchCondition\u0027,\u0027div_widget\u0027, \u0027view\u0027].each(function(f){\n        this.hide( this.form.get(f).node );\n    }.bind(this));\n    var view \u003d this.page.get(\u0027statement\u0027);\n    view.node.show();\n    this.currentStatement \u003d statementName;\n\n    this.currentModuleType \u003d \u0027statement\u0027;\n\n    if( !view.orginialJson )view.orginialJson \u003d Object.clone(view.json);\n    view.json \u003d Object.clone(view.orginialJson);\n    view.json.filterList \u003d filterList;\n    view.json.parameterList \u003d parameters;\n    Object.assign(view.json, options||{});\n    debugger;\n    view.reload();\n\n    this.pushState({\n        \u0027type\u0027: \u0027hr\u0027,\n        \u0027method\u0027: \u0027changeStatement\u0027,\n        \u0027args\u0027: [statementName, filterList, parameters,options]\n    })\n})\n\nthis.define(\u0027getCurrentStatement\u0027, function(){\n    return this.currentStatement;\n})\n\n\nthis.define(\u0027changeWidget\u0027, function(widgetApp, widgetName, parameters){\n    [\u0027div_searchCondition\u0027, \u0027div_view\u0027].each(function(f){\n        this.hide( this.form.get(f).node );\n    }.bind(this));\n    [\u0027div_widget\u0027].each(function(f){\n        this.show( this.form.get(f).node );\n    }.bind(this));\n\n    this.currentModuleType \u003d \u0027widget\u0027;\n    \n    var widget \u003d this.page.get(\u0027widget\u0027);\n    this.currentWidgetApp \u003d widgetApp;\n    this.currentWidget \u003d widgetName;\n    widget.json.parametersMapList \u003d parameters;\n    widget.reload();\n\n    this.pushState({\n        \u0027type\u0027: \u0027hr\u0027,\n        \u0027method\u0027: \u0027changeWidget\u0027,\n        \u0027args\u0027: [widgetApp, widgetName, parameters]\n    })\n})\n\nthis.define(\u0027getCurrentWidget\u0027, function(){\n    if( this.currentWidgetApp ){\n        return {\n            \"application\" : this.currentWidgetApp, //应用名称、别名、id\n            \"widget\" : this.currentWidget //部件名称、id\n        };\n    }else{\n        return this.currentWidget;\n    }\n})\n\nthis.define(\u0027pushState\u0027, function( state ){\n    if( layout.inBrowser ){\n        debugger;\n        // var navNode \u003d _self.form.get(\u0027div_navi\u0027).node.getElement(\u0027oo-nav\u0027);\n        // var nav \u003d navNode.getSelectedItem()?.data.name;\n        // if(nav)state.nav \u003d nav;\n        // history.pushState(state, \"\");\n    }\n})\n\n// if( layout.inBrowser ){\n//     if(o2.portalPopstate){\n//         window.removeEventListener(\u0027popstate\u0027, o2.portalPopstate);\n//         o2.portalPopstateOrigin \u003d o2.portalPopstate;\n//     }\n//     o2.portalPopstate \u003d function(event){\n//         if(event.state?.type \u003d\u003d\u003d \u0027hr\u0027){\n//             _self[event.state.method].apply(_self, event.state.args);\n//             if( event.state.nav ){\n//                 var nav \u003d _self.form.get(\u0027div_navi\u0027).node.getElement(\u0027oo-nav\u0027);\n//                 nav.getItem(event.state.nav).data.selected \u003d true;\n//             }\n//         }else{\n//             if(o2.portalPopstateOrigin)o2.portalPopstateOrigin(event);\n//         }\n//     }\n//     window.addEventListener(\u0027popstate\u0027, o2.portalPopstate);\n// }\n\n\n\nthis.define(\"syncEmployeefile\", function(e){\n    this.form.confirm(\"wran\", \"同步档案\", \"该操作会将组织管理中无档案的用户同步成正式员工，是否继续？\", 300, 100,function(){\n        MWF.require(\u0027MWF.widget.Mask\u0027, null, false);\n        var mask \u003d new MWF.widget.Mask({ \"style\": \"desktop\", \"zIndex\": 50000, \"html\": \"同步时间较长，请耐心等待。\", onQueryLoad: function(){\n            debugger;  \n            if( this.loadBar )this.loadBar.setStyles({\n                \"width\": \"220px\",\n                \"height\": \"30px\",\n            })\n        }});\n        mask.loadNode(_self.form.getApp().content);\n        var p1 \u003d o2.Actions.load(\"x_program_center\").InvokeAction.execute(\"createEmployeeFile\", {});\n    //    var p2 \u003d o2.Actions.load(\"x_program_center\").InvokeAction.execute(\"syncEmployeeFileUnit\", {});\n        Promise.all([p1]).then(function(){\n            _self.form.notice(\u0027根据组织管理同步员工信息成功！\u0027);\n            mask.hide();\n        })\n        this.close();\n    }, function(){\n        this.close();\n    });\n    \n})\n\n\nthis.define(\u0027openMyFile\u0027, function(){\n    var p \u003d this.getCurrentUserFile();\n    Promise.resolve(p).then(function(json){\n        if(json \u0026\u0026 json.data \u0026\u0026 json.data.length){\n            this.page.openDocument(json.data[0].id);\n        }else{\n            O2Common.getCMSProfile( \"employeeInfoUserConfig\", function(d){\n                if( d.data \u0026\u0026 d.data.isUserCanCreate \u003d\u003d\u003d \"是\" ){\n                    var obj \u003d {\n                        name: this.session.user.name,\n                        genderType: o2Common.getGenderType(this.session.user.genderType),\n                        employee: this.session.user.employee,\n                        unique: this.session.user.unique,\n                        mobile: this.session.user.mobile,\n                        officePhone: this.session.user.officePhone,\n                        subject: this.session.user.name,\n                        qq: this.session.user.qq,\n                        weixin: this.session.user.weixin,\n                        mail:this.session.user.mail,\n                        officePhone: this.session.user.officePhone,\n                        unit: (this.session.user.identityList || []).map(function(i){\n                            return this.org.getUnit(i.unit);\n                        }.bind(this)),\n                        status: \"正式\",\n                        statusNumber: 3\n                    };\n                    var unit \u003d (obj.unit \u0026\u0026 obj.unit.length) ? obj.unit : [];\n                    obj.salaryUnit \u003d this.getSalaryUnit(unit)[0]?.distinguishedName;\n                    obj.company \u003d this.getCompany(unit)[0]?.distinguishedName;\n                    obj.department \u003d this.getDepartment(unit)[0]?.distinguishedName;\n                    this.page.createDocument(\"employeefile\",\"employeeInfo\", obj);\n                    // var p1 \u003d o2.Actions.load(\"x_program_center\").InvokeAction.execute(\"createEmployeeFile\", {\n                    //     employee: this.session.user.employee\n                    // });\n                    // p1.then(function(json){\n                    //     if( json.id ){\n                    //         this.page.openDocument(json.id);\n                    //     }\n                    // }.bind(this))\n                }else{\n                    this.page.notice(\u0027系统内还没有您的个人档案！\u0027,\u0027info\u0027)\n                }\n            }.bind(this), {\n                needData: true\n            })\n        }\n    }.bind(this))\n})\n\n\nthis.define(\"loadReadAndTaskCount\", function (callback, refresh) {\n    return Promise.all(\n        [\n            _self.loadReadCount(refresh),\n            _self.loadTaskCount(refresh)\n        ]).then(function (list) {\n            var count \u003d 0;\n            list.each(function (json, index) {\n                count \u003d count + json.count;\n            })\n            var result \u003d {count: count};\n            if (callback) callback(result);\n            return result\n        }\n    )\n})\n\n\nthis.define(\"loadReadCount\", function (refresh) {\n    if (this.readCount \u0026\u0026 !refresh) {\n        return this.readCount;\n    }\n    this.readCount \u003d o2.Actions.load(\"x_query_assemble_surface\").StatementAction.executeV2(\"read\", \"count\", 1, 1, {\n        \"filterList\":[\n            {\n                \"path\":\"o.applicationAlias\",\n                \"title\":\"流程别名\",\n                \"type\":\"filter\",\n                \"comparison\":\"in\",\n                \"formatType\":\"textValue\",\n                \"value\": \"o_applicationAlias\",\n                \"logic\":\"and\"\n            }\n        ],\n        \"parameter\": {\n            \"person\": \"\",\n            \"o_applicationAlias\": SystemConfig.applicationAlias\n        }\n    });\n    return this.readCount;\n})\n\nthis.define(\"loadTaskCount\", function (refresh) {\n    if (this.taskCount \u0026\u0026 !refresh) {\n        return this.taskCount;\n    }\n    this.taskCount \u003d o2.Actions.load(\"x_query_assemble_surface\").StatementAction.executeV2(\"task\", \"count\", 1, 1, {\n        \"filterList\":[\n            {\n                \"path\":\"o.applicationAlias\",\n                \"title\":\"流程别名\",\n                \"type\":\"filter\",\n                \"comparison\":\"in\",\n                \"formatType\":\"textValue\",\n                \"value\": \"o_applicationAlias\",\n                \"logic\":\"and\"\n            }\n        ],\n        \"parameter\": {\n            \"person\": \"\",\n            \"o_applicationAlias\": SystemConfig.applicationAlias\n        }\n    })\n    return this.taskCount;\n})\n\nthis.define( \"parseInParam\", function( arr ){\n    var ar \u003d arr.map( function(j){ return \"\u0027\" + j + \"\u0027\" })\n    return \"[\" + ar.join(\",\") +\"]\"\n})\n\nthis.define(\"getMenu\", function(){\n    var ps \u003d [];\n    var parse \u003d function(children){\n        return children.filter(function(m){\n            if( !m.permission )return true;\n            return _self.hasPermission(m.permission);\n        }).map(function(m){\n            if( m.counts ){\n                var p \u003d Promise.resolve(m.counts()).then(function( c ){\n                    m.count \u003d c;\n                });\n                ps.push(p);\n            }\n            if( m.children )m.children \u003d parse( m.children );\n            return m;\n        }.bind(this))\n    };\n    var menu \u003d parse(navMenu);\n    return Promise.all(ps).then(function(){\n        return menu;\n    });\n})\n",
          "dependScriptList": [],
          "creatorPerson": "木婉清@3b9c6a87-4614-47e7-91ca-7ad15e3d988c@P",
          "lastUpdatePerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdateTime": "2025-10-13 11:20:16",
          "createTime": "2026-09-21 16:09:31",
          "updateTime": "2026-09-21 17:56:39"
        },
        {
          "id": "5cd1ae0e-aa9a-440a-bec8-a8c21cab0814",
          "name": "视图搜索组件生成器",
          "alias": "ViewSearchRender",
          "description": "",
          "validated": true,
          "portal": "f7186604-c886-4341-9fc8-bdbf5a55afbd",
          "text": "MWF.xDesktop.requireApp(\"query.Query\", \"Viewer\", null, false);\r\n MWF.QViewer.implement({\r\n    createSearchNode: function(){\r\n        if( this.viewJson.searchbarHidden \u003d\u003d\u003d true ){\r\n            return;\r\n        }\r\n        if( this.json.searchBar \u003d\u003d\u003d \"custom\" ){\r\n            if( !this.app?.appForm?.all?.div_searchCondition ){\r\n                return;\r\n            }\r\n            if (this.viewJson.customFilterList \u0026\u0026 this.viewJson.customFilterList.length){\r\n                if( !this.searchAreaHidden ){\r\n                    this.searchAreaNode.hide();\r\n                    this.searchRender \u003d new MWF.xApplication.query.Query.Viewer.ViewSearchRender( this, _self );\r\n                    this.searchAreaHidden \u003d true\r\n                }\r\n            }\r\n        }else{\r\n            this.searchAreaNode.setStyle(\u0027display\u0027, \u0027block\u0027);\r\n            //this.content.style.setProperty(\u0027box-sizing\u0027, \u0027content-box\u0027, \u0027important\u0027);\r\n            if (this.viewJson.customFilterList \u0026\u0026 this.viewJson.customFilterList.length){\r\n                this.searchStatus \u003d \"default\";\r\n                this.loadFilterSearch();\r\n            }else{\r\n                this.loadSimpleSearch();\r\n            }\r\n        }\r\n    },\r\n    getCondition(){\r\n        return (this.searchRender?.getCondition() || []).map(function(c){\r\n            return c.data;\r\n        });\r\n    }\r\n})\r\n\r\nvar _self \u003d this;\r\nMWF.xApplication.query.Query.Viewer.ViewSearchRender \u003d new Class({\r\n    initialize: function(view, env){\r\n        this.app \u003d env.form.getApp();\r\n        this.view \u003d view;\r\n        if( !view.viewJson.customFilterList || !view.viewJson.customFilterList.length )return;\r\n\r\n        var searchConditionNode \u003d _self.form.get(\u0027div_searchCondition\u0027).node;\r\n        searchConditionNode.empty();\r\n        _self.show(searchConditionNode);\r\n\r\n        view.searchConditionNode \u003d searchConditionNode;\r\n        view.searchAreaNode \u003d view.searchConditionNode;\r\n        \r\n        \r\n        this.css \u003d {};\r\n        var count \u003d 0;\r\n        view.viewJson.customFilterList.each(function( entry, i ){\r\n            if( [\"dateTimeValue\",\"timeValue\",\"dateValue\"].contains( entry.formatType ) ){\r\n                entry.node \u003d this.loadViewSearchInput( entry, searchConditionNode );\r\n                count++;\r\n\r\n                entry.title \u003d \"至\";\r\n                entry.nodeTo \u003d this.loadViewSearchInput( entry, searchConditionNode );\r\n                count++;\r\n                if( count \u003e 6){\r\n                    _self.hide( entry.node );\r\n                    _self.hide( entry.nodeTo );\r\n                }\r\n            }else{\r\n                entry.node \u003d this.loadViewSearchInput(entry, searchConditionNode);\r\n                count++;\r\n                if( count \u003e 6){\r\n                    _self.hide( entry.node );\r\n                }\r\n            }\r\n        }.bind(this));\r\n\r\n        var searchActionNode \u003d new Element(\"div\").inject( searchConditionNode);\r\n\r\n        var searchButton \u003d new Element(\"oo-button.operation\", {\r\n            \"left-icon\": \"search\",\r\n            styles: {\r\n                \"width\": \"8em\",\r\n                \"margin-right\": \"1em\"\r\n            },\r\n            text: \"查询\",\r\n            events: {\r\n                click: function () { this.searchView() }.bind(this)\r\n            }\r\n        }).inject(searchActionNode);\r\n\r\n        var resetButton \u003d new Element(\"oo-button.operation\", {\r\n            \"left-icon\": \"process-cancel\",\r\n            \"type\": \"cancel\",\r\n            text: \"重置\",\r\n            events: {\r\n                click: function () { this.reset() }.bind(this)\r\n            }\r\n        }).inject(searchActionNode);\r\n\r\n        \r\n        if( count \u003e 6 ){\r\n            this.expandNode \u003d new Element(\u0027oo-button\u0027, {\r\n                \"left-icon\": \"drop_down\",\r\n                styles: {\r\n                    \"width\": \"6em\",\r\n                    \"margin-left\": \"1em\"\r\n                },\r\n                text: \"展开\",\r\n                events: {\r\n                    click: function () { this.expand() }.bind(this)\r\n                }\r\n            }).inject( searchActionNode );\r\n\r\n            this.collapseNode \u003d new Element(\u0027oo-button\u0027, {\r\n                \"left-icon\": \"icon_arrow_up\",\r\n                styles: {\r\n                    \"width\": \"6em\",\r\n                    \"margin-left\": \"1em\"\r\n                },\r\n                text: \"折叠\",\r\n                events: {\r\n                    click: function () { this.collapse() }.bind(this)\r\n                }\r\n            }).inject( searchActionNode );\r\n            _self.hide(this.collapseNode)\r\n        }\r\n\r\n        view.setContentHeight();\r\n    },\r\n    expand: function(){\r\n        this.view.viewJson.customFilterList.each(function( entry, i ){\r\n            if( [\"dateTimeValue\",\"timeValue\",\"dateValue\"].contains( entry.formatType ) ){\r\n                _self.show( entry.node );\r\n                _self.show( entry.nodeTo );\r\n            }else{\r\n                _self.show( entry.node );\r\n            }\r\n        }.bind(this));\r\n        _self.hide( this.expandNode );\r\n        _self.show( this.collapseNode );\r\n    },\r\n    collapse: function(){\r\n        var count \u003d 0;\r\n        this.view.viewJson.customFilterList.each(function( entry, i ){\r\n            if( [\"dateTimeValue\",\"timeValue\",\"dateValue\"].contains( entry.formatType ) ){\r\n                count++;\r\n                count++;\r\n                if( count \u003e 6){\r\n                    _self.hide( entry.node );\r\n                    _self.hide( entry.nodeTo );\r\n                }\r\n            }else{\r\n                count++;\r\n                if( count \u003e 6){\r\n                    _self.hide( entry.node );\r\n                }\r\n            }\r\n        }.bind(this));\r\n        _self.show( this.expandNode );\r\n        _self.hide( this.collapseNode );\r\n    },\r\n    reset: function(){\r\n        this.view.viewJson.customFilterList.each(function (entry) {\r\n            var value, comparison;\r\n            switch (entry.node.tagName){\r\n                case \u0027SELECT\u0027:\r\n                    entry.node.selectedIndex \u003d 0;\r\n                    break;\r\n                case \u0027OO-SELECT\u0027:\r\n                    entry.node.value \u003d \u0027\u0027;\r\n                    break;\r\n                default:   \r\n                    entry.node.set(\"value\", \"\");\r\n                    if(entry.nodeTo)entry.nodeTo.set(\"value\", \"\");\r\n            }\r\n        })\r\n        this.view.filterItems \u003d [];\r\n        this.view.searchCustomView();\r\n    },\r\n    searchView: function(){\r\n        this.view.filterItems \u003d this.getCondition();\r\n        this.view.searchCustomView();\r\n    },\r\n    getCondition: function(){\r\n        var filterData \u003d [];\r\n        var filterItems \u003d [];\r\n        this.view.viewJson.customFilterList.each(function (entry) {\r\n            var value, comparison;\r\n            if( entry.node.get(\"type\") \u003d\u003d\u003d \"select\" ){\r\n                value \u003d entry.node.options[entry.node.selectedIndex].value\r\n            }else{\r\n                value \u003d entry.node.get(\"value\");\r\n            }\r\n            if( value \u003d\u003d\u003d \"\" )return;\r\n\r\n            switch (entry.formatType) {\r\n                case \"booleanValue\":\r\n                    value \u003d (value\u003d\u003d\u003d\"true\");\r\n                    comparison \u003d \"equals\";\r\n                    break;\r\n                case \"numberValue\":\r\n                    comparison \u003d \"equals\";\r\n                    break;\r\n                case \"dateTimeValue\":\r\n                case \"timeValue\":\r\n                case \"dateValue\":\r\n                    comparison \u003d \"greaterThanOrEqualTo\";\r\n                    break;\r\n                default:\r\n                    comparison \u003d \"like\";\r\n                    break;\r\n            }\r\n\r\n            var d \u003d {\r\n                \"logic\": \"and\",\r\n                \"path\": entry.path,\r\n                \"comparison\": comparison,\r\n                \"value\": value,\r\n                \"formatType\": (entry.formatType\u003d\u003d\"datetimeValue\") ? \"dateTimeValue\": entry.formatType\r\n            };\r\n\r\n            filterItems.push({\"data\":d});\r\n        }.bind(this));\r\n\r\n\r\n        this.view.viewJson.customFilterList.each(function (entry) {\r\n            var value, comparison;\r\n            if(![\"dateTimeValue\",\"timeValue\",\"dateValue\"].contains( entry.formatType ) )return;\r\n            value \u003d entry.nodeTo.get(\"value\");\r\n            if( value \u003d\u003d\u003d \"\" )return;\r\n            comparison \u003d \"lessThanOrEqualTo\";\r\n            var d \u003d {\r\n                \"logic\": \"and\",\r\n                \"path\": entry.path,\r\n                \"comparison\": comparison,\r\n                \"value\": value,\r\n                \"formatType\": (entry.formatType\u003d\u003d\"datetimeValue\") ? \"dateTimeValue\": entry.formatType\r\n            };\r\n           filterItems.push({\"data\":d});\r\n        }.bind(this));\r\n\r\n        // if( this.view.filterItems.length \u003d\u003d\u003d 0 ){\r\n        //     this.app.notice(\"请先填写条件\", \"info\");\r\n        //     return;\r\n        // }\r\n        \r\n        return filterItems;\r\n    },\r\n    getDefaultValue: function( entry ){\r\n        debugger;\r\n        var data \u003d ( this.view.json.searchRenderDate || [] ).filter((f)\u003d\u003e{\r\n            return f.data.path \u003d\u003d\u003d entry.path;\r\n        });\r\n        if( data.length ){\r\n            return  data[0].data.value\r\n        }else{\r\n            return null;\r\n        }\r\n    },\r\n    loadViewSearchInput: function( entry, td ){\r\n        \r\n        var selectableList \u003d this.getCustomSelectScriptResult(entry);\r\n        var node;\r\n        var properties \u003d {\r\n            \"label-style\": \"width:6.2vw; min-width:4.3em; max-width:9em\",\r\n            \"label-Align\": \"right\",\r\n            \"view-style\": \"background-color:#f7f7f7\"\r\n        };\r\n        if( selectableList.length \u003e 0 ){\r\n            node \u003d this.loadViewSerchCustomSelectByScript(entry, selectableList, td)\r\n        }else{\r\n            switch (entry.formatType){\r\n                case \"numberValue\":\r\n                    node \u003d new Element(\"oo-input\", {\r\n                        type: \u0027number\u0027,\r\n                        label: entry.title\r\n                    }).inject(td);\r\n                    break;\r\n                case \"dateTimeValue\":\r\n                    node \u003d new Element(\"oo-datetime\", {\r\n                        label: entry.title\r\n                    }).inject(td);\r\n                    break;\r\n                case \"dateValue\":\r\n                    node \u003d new Element(\"oo-datetime\", {\r\n                        label: entry.title,\r\n                        mode : \"date\",\r\n                        format : \"YYYY-MM-DD\"\r\n                    }).inject(td);\r\n                    break;\r\n                case \"timeValue\":\r\n                    node \u003d new Element(\"oo-datetime\", {\r\n                        label: entry.title,\r\n                        mode : \"time\",\r\n                        format : \"HH:mm:ss\"\r\n                    }).inject(td);\r\n                    break;\r\n                case \"booleanValue\":\r\n                    node \u003d new Element(\"oo-select.field_select\", {\r\n                        label: entry.title\r\n                    }).inject(td);\r\n                    var option \u003d new Element(\"oo-option\", {\"value\": \"\"}).inject(node);\r\n                    option \u003d new Element(\"oo-option\", {\"value\": \"true\"}).inject(node);\r\n                    option.setAttribute(\u0027text\u0027, \u0027是\u0027);\r\n                    option \u003d new Element(\"oo-option\", {\"value\": \"false\"}).inject(node);\r\n                    option.setAttribute(\u0027text\u0027, \"否\");\r\n                    break;\r\n                default:\r\n                    node \u003d new Element(\"oo-input\", { label: entry.title }).inject(td);\r\n            }\r\n        }\r\n        node.set(properties);\r\n\r\n        const value \u003d this.getDefaultValue( entry );\r\n        if( value !\u003d\u003d null )node.value \u003d value;\r\n\r\n        node.addEvent(\u0027change\u0027, (e)\u003d\u003e{\r\n            this.view.fireEvent(\u0027filterChange\u0027, [e, entry])\r\n        })\r\n        return node;\r\n    },\r\n    getCustomSelectScriptResult : function( entry ){\r\n        var scriptResult \u003d [];\r\n        if( entry.valueType \u003d\u003d\u003d \"script\" ){\r\n            if( entry.valueScript \u0026\u0026 entry.valueScript.code ){\r\n                var result \u003d this.view.Macro.exec(entry.valueScript.code, this);\r\n                var array \u003d typeOf( result ) \u003d\u003d\u003d \"array\" ? result : [result];\r\n                for( var i\u003d0; i\u003carray.length; i++ ){\r\n                    if( array[i].indexOf( \"|\" ) \u003e -1 ){\r\n                        var arr \u003d array[i].split(\"|\");\r\n                        scriptResult.push({ \"text\" : arr[0], \"value\" : arr[1] })\r\n                    }else{\r\n                        scriptResult.push({ \"text\" : array[i], \"value\" : array[i] })\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return scriptResult;\r\n    },\r\n    loadViewSerchCustomSelectByScript: function(entry, array, td ){\r\n        var node \u003d new Element(\"oo-select\", {\r\n            label: entry.title\r\n        }).inject(td);\r\n        new Element(\"oo-option\", { \"value\": \"\" }).inject(node);\r\n        array.each(function( v ){\r\n            var option \u003d new Element(\"oo-option\", { \"value\": v.value }).inject(node);\r\n            option.setAttribute(\u0027text\u0027, v.text);\r\n        }.bind(this));\r\n        return node;\r\n    }\r\n})",
          "dependScriptList": [],
          "creatorPerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdatePerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdateTime": "2025-11-26 13:32:27",
