          "scriptText": "// {\n//     selectStr: selectStr,\n//     groupByStr: groupByStr,\n//     orderByStr: orderByStr\n// }\nvar sql \u003d \"Select \";\nif( parameters.selectStr ){\n    sql \u003d sql + parameters.selectStr\n}else{\n    sql \u003d sql + \" o \"\n}\nsql \u003d sql + \"  FROM salaryDetails o \";\nif( parameters.draftUnitUnique ){\n    sql \u003d sql + \" where o.draftUnitUnique \u003d \u0027\"+parameters.draftUnitUnique+\"\u0027 \"\n    if( parameters.whereStr ){\n        sql \u003d sql + \u0027 and \u0027 + parameters.whereStr;\n    }\n}else if( parameters.whereStr ){\n    sql \u003d sql + \u0027 where \u0027 + parameters.whereStr;\n}\nif( parameters.groupByStr ){\n    sql \u003d sql + \" group by \" + parameters.groupByStr\n}\nif( parameters.orderByStr ){\n    sql \u003d sql + \" order by \" + parameters.orderByStr\n}\nreturn sql;",
          "countData": "SELECT count(o.id) FROM salaryDetails o",
          "countScriptText": "var sql \u003d \"Select count(o) FROM salaryDetails o\";\n\nif( parameters.draftUnitUnique ){\n    sql \u003d sql + \" where o.draftUnitUnique \u003d \u0027\"+parameters.draftUnitUnique+\"\u0027 \"\n    if( parameters.whereStr ){\n        sql \u003d sql + \u0027 and \u0027 + parameters.whereStr;\n    }\n}else if( parameters.whereStr ){\n    sql \u003d sql + \u0027 where \u0027 + parameters.whereStr;\n}\n\n// if( parameters.groupByStr ){\n//   return \"Select count(o) FROM salaryDetails o\"\n// }else{\n//   return \"Select count(o) FROM salaryDetails o\"\n// }\nreturn sql;",
