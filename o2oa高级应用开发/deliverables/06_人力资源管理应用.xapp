        {
          "id": "258b185d-05dd-4de4-814b-7e5c84558770",
          "name": "费用统计表",
          "alias": "feeStat",
          "format": "jpql",
          "description": "feeStat",
          "query": "b20993ae-79ee-43ee-a56e-f764a459c520",
          "fv": 8.0,
          "executePersonList": [],
          "executeUnitList": [],
          "executeGroupList": [],
          "data": "select o.month, o.draftUnit, o.draftUnitDn, o.draftUnitUnique, o.partyBCompany, o.employmentType, o.year, o.quarter, o.monthNumber,\r\n        sum(case when o.managementFee \u003e 0 then 1 else 0 end) as personCount,\r\n        sum(\r\n            o.postWage + o.floatingWage + o.overtimeWage + o.overtimeWage1 + o.backpay + o.skillAllowance \r\n            + o.startingAllowance + o.nightAllowance + o.trafficAllowance + o.commuterBusFee + o.shiftAllowance\r\n        ) as payableWagesTotal,\r\n        sum(\r\n            o.performanceBonus + o.specialPurposeFund + o.quarterlySecurityAwards + o.otherAwards\r\n        ) as bonusTotal,\r\n        sum(o.missMealAllowance) as missMealAllowance,\r\n        sum(o.expatriateAllowance) as expatriateAllowance,\r\n        sum(o.seaAllowance) as seaAllowance,\r\n        sum(o.travelExpense) as travelExpense,\r\n        sum(o.trainBonus) as trainBonus,\r\n        sum(o.medicalCosts) as medicalCosts,\r\n        sum(o.coolingFee) as coolingFee,\r\n        sum(o.monetaryCompensation) as monetaryCompensation,\r\n        sum(o.laborInsurance) as laborInsurance,\r\n        sum(o.otherWage) as otherWage,\r\n\r\n        sum(o.pension_c + o.pension_refund_c) as pension_c,\r\n        sum(o.unemploymentInsurance_c + o.unemploymentInsurance_refund_c) as unemploymentInsurance_c,\r\n        sum(o.medicalInsurance_c + o.medicalInsurance_refund_c) as medicalInsurance_c,\r\n        sum(o.maternityInsurance_c + o.maternityInsurance_refund_c) as maternityInsurance_c,\r\n        sum(o.workInjuryInsurance_c + o.workInjuryInsurance_refund_c) as workInjuryInsurance_c,\r\n        sum(o.housingProvidentFund_c + o.housingProvidentFund_refund_c) as housingProvidentFund_c,\r\n        sum(o.criticalIllnessInsurance_c + o.other_refund_c) as criticalIllnessInsurance_c,\r\n        sum(o.longTermCareInsurance_c) as longTermCareInsurance_c,\r\n        sum(o.employersLiabilityInsurance_c) as employersLiabilityInsurance_c,\r\n        sum(o.accidentInsurance_c) as accidentInsurance_c,\r\n\r\n        sum(o.disabilityPension) as disabilityPension,\r\n        sum(o.managementFee) as managementFee,\r\n        \r\n        sum(o.laborCostsSubtotal_includeTax) as serviceFee_hasTax\r\n\r\n\r\nFROM salaryDetails o \r\ngroup by o.draftUnit, o.draftUnitDn, o.draftUnitUnique, o.month, o.partyBCompany, o.employmentType, o.year, o.quarter, o.monthNumber\r\norder by o.month asc, o.draftUnit asc, o.partyBCompany asc, o.employmentType asc",
          "countData": "SELECT count(o.id) FROM salaryDetails o",
