        {
          "id": "e28a1e45-3946-435f-a8c6-e8a9d6ac9658",
          "name": "EchartsUtils",
          "alias": "",
          "description": "使用echarts的类",
          "validated": true,
          "portal": "f7186604-c886-4341-9fc8-bdbf5a55afbd",
          "text": "\r\nO2EhartsUtils \u003d new Class({\r\n    Implements: [Options, Events],\r\n    initialize: function () {\r\n       \r\n    },\r\n    load: function( node, callback){\r\n        this.loadResource(function(){\r\n            //名称为dataList的单元格为插入的位置\r\n           this.myChart \u003d window.echarts.init(node);\r\n            if(callback)callback( this.myChart );\r\n        }.bind(this));\r\n    },\r\n    setOption: function(option){\r\n        this.myChart.setOption(option);\r\n    },\r\n    destroy: function(){\r\n        if(this.myChart)this.myChart.dispose()\r\n    },\r\n    loadResource: function( callback ){\r\n        if( !window.echarts ){\r\n            var uri \u003d \"../x_portal_assemble_surface/jaxrs/file/a04aa574-fe3b-4251-bafd-8323fd833ea3/portal/f7186604-c886-4341-9fc8-bdbf5a55afbd/content\";\r\n            COMMON.AjaxModule.load(uri, function(){\r\n                callback();\r\n            }.bind(this))\r\n        }else{\r\n            callback();\r\n        }\r\n    }\r\n});",
          "dependScriptList": [],
          "creatorPerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdatePerson": "蔡祥熠@e506d5e8-5346-4d0b-b1e5-77c1b7aa6cf5@P",
          "lastUpdateTime": "2025-01-19 12:58:00",
          "createTime": "2026-09-21 16:09:31",
          "updateTime": "2026-09-21 17:56:39"
        },
        {
          "id": "ea219abd-115b-42ea-92b7-8f3e2af2d040",
          "name": "通用脚本",
          "alias": "common",
          "description": "",
          "validated": true,
          "portal": "f7186604-c886-4341-9fc8-bdbf5a55afbd",
          "text": "var _self \u003d this;\r\n\r\n\r\n\r\nwindow.SystemConfig \u003d {\r\n    \"applicationAlias\": [\"selfservice\", \"emplyeemanager\"],\r\n    \"applicationNames\": [\"员工自助\", \"员工管理\"],\r\n    \"salaryUnitLevel\": 2, //工资统计单位,数字表示组织层次，字符串表示组织类型\r\n    \"companyLevel\": 1, //公司所在层级,数字表示组织层次，字符串表示组织类型\r\n    \"departmentLevel_1\": 2, //2级部门所在层级,数字表示组织层次，字符串表示组织类型\r\n    \"departmentLeaderDuty\": \"部门正职\",\r\n    \"HrDepartmenttNameList\": [\"人力资源部\", \"人力部\"] //人力资源部部门名称\r\n}\r\n\r\nthis.define(\u0027getUserStatus\u0027, (user)\u003d\u003e{\r\n    var p \u003d !!user ? this.getUserFile(user) : this.getCurrentUserFile();\r\n    return p.then((json)\u003d\u003e{\r\n        if( json.data.length ){\r\n            return json.data[0].longValue01;\r\n        }\r\n        return \u0027\u0027;\r\n    })\r\n})\r\n\r\nthis.define(\"getCurrentUserFile\", function (needData) {\r\n    var employee \u003d this.session.user.employee;\r\n    if (employee) {\r\n        return this.getUserFile(employee, needData);\r\n    } else {\r\n        return \"\"\r\n    }\r\n})\r\n\r\nthis.define(\"getUserFile\", function (employee, needData) {\r\n    return o2.Actions.load(\"x_cms_assemble_control\").DocumentAction.query_listWithFilterPaging(1, 1, {\r\n        categoryAliasList: [\"employeeInfo\"],\r\n        documentType: \"全部\",\r\n        stringValue01: employee,\r\n        needData: !!needData\r\n    })\r\n});\r\n\r\n\r\nthis.define(\"getBaseInfoId\", function () {\r\n    var par \u003d this.page.parameters;\r\n    if (par.type) {\r\n        return Promise.resolve(this.getBaseInfo(par.type)).then(function (data) {\r\n            return data.id;\r\n        });\r\n    } else {\r\n        return \"\"\r\n    }\r\n})\r\n\r\nthis.define(\"getBaseInfo\", function (cms_categoryAlias, callback) {\r\n    var data \u003d {\r\n        categoryAliasList: [cms_categoryAlias],\r\n        documentType: \"全部\"\r\n    };\r\n    return o2.Actions.load(\"x_cms_assemble_control\").DocumentAction.query_listWithFilterPaging(1, 1, data, function (json) {\r\n        if (json \u0026\u0026 json.data \u0026\u0026 json.data.length) {\r\n            if (callback) callback(json.data);\r\n            return json.data[0];\r\n        } else {\r\n            if (callback) callback(\"\");\r\n            return {};\r\n        }\r\n    }, null, !!callback);\r\n})\r\n\r\n\r\nthis.define(\u0027getSalaryUnit\u0027, function(identityOrUnit){\r\n    if( !identityOrUnit )identityOrUnit \u003d this._getCurUnit();\r\n    return o2common.listUnitWithTypeOrLevel(identityOrUnit, SystemConfig.salaryUnitLevel);\r\n});\r\n\r\nthis.define(\u0027getCompany\u0027, function(identityOrUnit){\r\n    if( !identityOrUnit )identityOrUnit \u003d this._getCurUnit();\r\n    return o2common.listUnitWithTypeOrLevel(identityOrUnit, SystemConfig.companyLevel);\r\n});\r\n\r\nthis.define(\u0027getDepartment\u0027, function(identityOrUnit){\r\n    if( !identityOrUnit )identityOrUnit \u003d this._getCurUnit();\r\n    return o2common.listUnitWithTypeOrLevel(identityOrUnit, SystemConfig.departmentLevel_1);\r\n});\r\n\r\nthis.define(\u0027_getCurUnit\u0027, function(){\r\n    switch(this.appType){\r\n            case \u0027cms\u0027:\r\n                return this.documentContext.getDocument().creatorUnitName;\r\n            case \u0027process\u0027:\r\n                return this.workContext.getWork().creatorIdentityDn || this.workContext.getWork().creatorIdentity;\r\n            default:\r\n                return O2Common.getFirstIdentityDn();\r\n    }\r\n})\r\n\r\nwindow.O2Common \u003d window.o2Common \u003d window.o2common \u003d {\r\n    antiShake: function(fun, wait){\r\n        var time \u003d null;\r\n        return function(){\r\n            if(time){\r\n                clearTimeout(time)\r\n            }\r\n            time \u003d setTimeout(fun, wait);\r\n        }\r\n    },\r\n    toPY: function (value, cacheFlag) {\r\n        if (!value) return value;\r\n        if (typeOf(value) !\u003d\u003d \"string\") return valse;\r\n        if (!o2.widget.PinYin) o2.require(\"o2.widget.PinYin\", null, false);\r\n        if (cacheFlag) {\r\n            if (!window.o2common.PYMap) window.o2common.PYMap \u003d {};\r\n            if (o2common.PYMap[value]) return o2common.PYMap[value];\r\n        }\r\n        var py \u003d o2.widget.PinYin.toPY(value);\r\n        py \u003d py.toLowerCase();\r\n        if (cacheFlag) {\r\n            o2common.PYMap[value] \u003d py;\r\n        }\r\n        ;\r\n        return py;\r\n    },\r\n    getGenderType(str) {\r\n        return {\r\n            \"m\": \"男\",\r\n            \"f\": \"女\",\r\n            \"o\": \"其他\",\r\n            \"女\": \"f\",\r\n            \"男\": \u0027m\u0027,\r\n            \"其他\": \"o\"\r\n        }[str]\r\n    },\r\n    setFieldValue: function (name, value) {\r\n        if( value \u003d\u003d\u003d undefined || value \u003d\u003d\u003d null )value \u003d \u0027\u0027;\r\n        var form \u003d _self.form || _self.page;\r\n        if (form.get(name)) {\r\n            if (form.get(name).setData) {\r\n                form.get(name).setData(value);\r\n            } else if (form.get(name).node) {\r\n                form.get(name).node.set(\"text\", value);\r\n            }\r\n        } else {\r\n            return _self.data[name] \u003d value;\r\n        }\r\n    },\r\n    getAllMonthsBetween: function (startMonthStr, endMonthStr) {\r\n        // 将字符串转换为日期对象，注意这里我们假设月份字符串的格式是 \"YYYY-MM\"\r\n        var startMonthDate \u003d new Date(startMonthStr + \u0027-01\u0027); // 添加日部分 \"-01\" 来确保月份正确\r\n        var endMonthDate \u003d new Date(endMonthStr + \u0027-01\u0027); // 同上\r\n\r\n        // 初始化结果数组\r\n        var allMonths \u003d [];\r\n\r\n        // 当前月份设置为开始月份\r\n        var currentMonthDate \u003d new Date(startMonthDate);\r\n\r\n        // 循环直到当前月份超过结束月份\r\n        while (currentMonthDate \u003c\u003d endMonthDate) {\r\n            // 格式化当前月份为字符串并添加到数组中\r\n            var year \u003d currentMonthDate.getFullYear();\r\n            var month \u003d currentMonthDate.getMonth() + 1; // 月份是从0开始的，所以加1\r\n            var formattedMonth \u003d year + \u0027-\u0027 + (month \u003c 10 ? \u00270\u0027 + month : month); // 手动添加前导零（如果需要）\r\n            allMonths.push(formattedMonth);\r\n\r\n            // 设置下一个月份（加一个月）\r\n            currentMonthDate.setMonth(currentMonthDate.getMonth() + 1);\r\n        }\r\n\r\n        return allMonths;\r\n    },\r\n    getQuarter: function (date) {\r\n        if (typeOf(date) \u003d\u003d\u003d \"string\") {\r\n            date \u003d Date.parse(date)\r\n        }\r\n        var month \u003d (date || new Date()).getMonth();\r\n        if (month \u003c 3) {\r\n            return \u00271\u0027;\r\n        } else if (month \u003c 6) {\r\n            return \u00272\u0027;\r\n        } else if (month \u003c 9) {\r\n            return \u00273\u0027;\r\n        } else if (month \u003c 12) {\r\n            return \u00274\u0027;\r\n        }\r\n    },\r\n    getField: function (name) {\r\n        var form \u003d _self.form || _self.page;\r\n        return form.get(name) || null;\r\n    },\r\n    getFieldValue: function (name) {\r\n        var form \u003d _self.form || _self.page;\r\n        try {\r\n            if (form.get(name)) return form.get(name).getData();\r\n        } catch (e) {\r\n            return _self.data[name];\r\n        }\r\n        return _self.data[name];\r\n    },\r\n    getCompanyLeaderDuty: function (company) {\r\n        var list \u003d [];\r\n        var dutyList \u003d _self.org.listUnitAllDuty(company);\r\n        for (var i \u003d 0; i \u003c dutyList.length; i++) {\r\n            var duty \u003d dutyList[i];\r\n            if (duty.name.indexOf(\"主任\") \u003e -1 || duty.name.indexOf(\"经理\") \u003e -1 || duty.name.indexOf(\"领导\") \u003e -1 || duty.name.indexOf(\"正职\") \u003e -1) {\r\n                list.push(duty.name);\r\n            }\r\n        }\r\n        return list;\r\n    },\r\n    getCompanyLeader: function (company) {\r\n        var dutyList \u003d O2Common.getCompanyLeaderDuty(company);\r\n        var identityList \u003d [];\r\n\r\n        for (var i \u003d 0; i \u003c dutyList.length; i++) {\r\n            var duty \u003d dutyList[i];\r\n            var identitys \u003d _self.org.getDuty(duty, company);\r\n            identityList \u003d identityList.concat(identitys || []);\r\n        }\r\n        return identityList;\r\n    },\r\n    getDepartment1LeaderDutyByCreatorIdentity: function () {\r\n        var identity \u003d _self.workContext.getWork().creatorIdentityDn || _self.workContext.getWork().creatorIdentity;\r\n        var unit \u003d O2Common.getDepartment1DnByIdentity(identity);\r\n        return O2Common.getDepartmentLeaderDuty(unit);\r\n    },\r\n    getDepartmentLeaderDuty: function (department) {\r\n        var list \u003d [];\r\n        var dutyList \u003d _self.org.listUnitAllDuty(department);\r\n        for (var i \u003d 0; i \u003c dutyList.length; i++) {\r\n            var duty \u003d dutyList[i];\r\n            if (duty.name.indexOf(\"主任\") \u003e -1 || duty.name.indexOf(\"经理\") \u003e -1 || duty.name.indexOf(\"领导\") \u003e -1 || duty.name.indexOf(\"正职\") \u003e -1) {\r\n                list.push(duty.name);\r\n            }\r\n        }\r\n        return list;\r\n    },\r\n    getDepartmentChiefDuty: function (department) {\r\n        var dutyList \u003d O2Common.getDepartmentLeaderDuty(department);\r\n        var list \u003d [];\r\n        for (var i \u003d 0; i \u003c dutyList.length; i++) {\r\n            var duty \u003d dutyList[i];\r\n            if (duty.indexOf(\"副\") \u003d\u003d\u003d -1) {\r\n                list.push(duty);\r\n            }\r\n        }\r\n        return list;\r\n    },\r\n    getDepartmentChief: function (department) {\r\n        var dutyList \u003d O2Common.getDepartmentChiefDuty(department);\r\n        var identityList \u003d [];\r\n\r\n        for (var i \u003d 0; i \u003c dutyList.length; i++) {\r\n            var duty \u003d dutyList[i];\r\n            var identitys \u003d _self.org.getDuty(duty, department);\r\n            identityList \u003d identityList.concat(identitys || []);\r\n        }\r\n        return identityList;\r\n    },\r\n    getHrDepartmentDn: function (company) {\r\n        var unitList \u003d _self.org.listSubUnit(company, false);\r\n        if (unitList) {\r\n            for (var i \u003d 0; i \u003c unitList.length; i++) {\r\n                if (SystemConfig.HrDepartmenttNameList.contains(unitList[i].name)) {\r\n                    return unitList[i].distinguishedName;\r\n                }\r\n            }\r\n        }\r\n        return \"\"\r\n    },\r\n    listAllCityHrDepartmentDn: function () {\r\n        var dept \u003d O2Common.listAllCityHrDepartment() || [];\r\n        return O2Common.getKeyFromObject(dept, \"distinguishedName\");\r\n    },\r\n    listAllCityHrDepartment: function () {\r\n        var dept \u003d O2Common.listAllHrDepartment() || [];\r\n        var d \u003d [];\r\n        for (var i \u003d 0; i \u003c dept.length; i++) {\r\n            if (dept[i].levelName.indexOf(\"省公司\") \u003d\u003d\u003d -1) {\r\n                d.push(dept[i]);\r\n            }\r\n        }\r\n        return d;\r\n    },\r\n    listAllHrDepartmentDn: function () {\r\n        var dept \u003d O2Common.listAllHrDepartment() || [];\r\n        return O2Common.getKeyFromObject(dept, \"distinguishedName\");\r\n    },\r\n    listAllHrDepartment: function () {\r\n        var dept \u003d [];\r\n        o2.Actions.get(\"x_organization_assemble_control\").listUnitByKey(function (json) {\r\n            dept \u003d json.data;\r\n        }, null, {\"key\": \"人力\"}, false)\r\n        return dept\r\n    },\r\n    getPersonDnByIdentity: function (identity) {\r\n        return O2Common.getFirstValueFromObject(O2Common.getPersonByIdentity(identity), \"distinguishedName\");\r\n    },\r\n    getPersonByIdentity: function (identity) {\r\n        var personList \u003d _self.org.listPersonWithIdentity(identity);\r\n        return personList[0];\r\n    },\r\n    listUnitWithTypeOrLevel: function (identityOrUnit, levelOrType) {\r\n        if( !_self.UnitMap )_self.UnitMap \u003d {};\r\n        var array \u003d Array.isArray(identityOrUnit) ?  identityOrUnit : [identityOrUnit];\r\n        var units \u003d array.map(function(v){\r\n            var value \u003d typeOf(v) \u003d\u003d\u003d \"string\" ? v : v.distinguishedName;\r\n            var key \u003d value +\"_\"+ levelOrType;\r\n            if( _self.UnitMap[key] ){\r\n                return _self.UnitMap[key];\r\n            }\r\n            var flag \u003d value.substr(value.length-1, 1);\r\n            var unit;\r\n            switch (flag.toLowerCase()){\r\n                case \"i\":\r\n                    unit \u003d _self.org.getUnitByIdentity(value, levelOrType);\r\n                    break;\r\n                    // unit \u003d typeOf(levelOrType) \u003d\u003d\u003d \u0027number\u0027 ?\r\n                    //     O2Common.getUnitByIdentityByLevel(unit, levelOrType) :\r\n                    //     O2Common.getUnitByIdentityByType(unit, levelOrType)\r\n                case \"u\":\r\n                    unit \u003d typeOf(levelOrType) \u003d\u003d\u003d \u0027number\u0027 ?\r\n                        _self.org.listSupUnitWithLevel(value, levelOrType) :\r\n                        _self.org.listSupUnitWithType(value, levelOrType);\r\n                    break;\r\n            }\r\n            _self.UnitMap[key] \u003d unit;\r\n            return unit;\r\n        })\r\n        return units.flat();\r\n    },\r\n    getCompanyDnByIdentity: function (identity) {\r\n        return O2Common.getFirstValueFromObject(O2Common.getCompanyByIdentity(identity), \"distinguishedName\");\r\n    },\r\n    getCompanyByIdentity: function (identity) {\r\n        return O2Common.getUnitByIdentityByLevel(identity, SystemConfig.companyLevel);\r\n    },\r\n    getCompanyDnByUnit: function (unit) {\r\n        return O2Common.getFirstValueFromObject(O2Common.getCompanyByUnit(unit), \"distinguishedName\");\r\n    },\r\n    getCompanyByUnit: function (unit) {\r\n        var units \u003d _self.org.listSupUnitWithLevel(unit, SystemConfig.companyLevel)\r\n        return Array.isArray(units) ? units : [units];\r\n    },\r\n    getDraftUnitDn: function (unit) {\r\n        return O2Common.getFirstValueFromObject(O2Common.getDraftUnit(unit), \"distinguishedName\")\r\n    },\r\n    getDraftUnit: function (unit) {\r\n        var units \u003d _self.org.listSupUnitWithLevel(unit, SystemConfig.departmentLevel_1);\r\n        Array.isArray(units) ? units : [units];\r\n    },\r\n    getCurrentUnitByDuty: function (duty) {\r\n        if (!o2common.CurrentUnitByDuty) o2common.CurrentUnitByDuty \u003d {};\r\n        if (o2common.CurrentUnitByDuty[duty]) return o2common.CurrentUnitByDuty[duty];\r\n        var user \u003d _self.session.user;\r\n        var identityList \u003d user.identityList || [];\r\n        if (!identityList.length) return [];\r\n        var unitList \u003d identityList.map(function (identity) {\r\n            return _self.org.listUnitWithDuty(duty, identity);\r\n        });\r\n        unitList \u003d unitList.flatten();\r\n        unitList \u003d unitList.filter(function (d) {\r\n            return !!d\r\n        });\r\n        o2common.CurrentUnitByDuty[duty] \u003d unitList;\r\n        return unitList;\r\n    },\r\n    getCurrentUnitsByDutys: function (dutys) {\r\n        var unitList \u003d dutys.map(function (duty) {\r\n            return o2common.getCurrentUnitByDuty(duty);\r\n        }).flatten();\r\n\r\n        var uList \u003d o2common.uniqueListByKey(unitList, \u0027unique\u0027);\r\n\r\n        return uList;\r\n    },\r\n    getAllCurrentDraftUnit: function () {\r\n        if (o2common.allCurrentDraftUnit) return o2common.allCurrentDraftUnit;\r\n        var user \u003d _self.session.user;\r\n        var unitList \u003d (user.identityList || []).map(function (i) {\r\n            return i.unit;\r\n        });\r\n        if (!unitList.length) {\r\n            return [];\r\n        } else {\r\n            return _self.org.listSupUnitWithLevel(unitList, SystemConfig.departmentLevel_1);\r\n        }\r\n    },\r\n    getDepartment1DnByIdentity: function (identity) {\r\n        return O2Common.getFirstValueFromObject(O2Common.getDepartment1ByIdentity(identity), \"distinguishedName\")\r\n    },\r\n    getDepartment1ByIdentity: function (identity) {\r\n        return O2Common.getUnitByIdentityByLevel(identity, SystemConfig.departmentLevel_1);\r\n    },\r\n    getDepartment1DnByUnit: function (unit) {\r\n        return O2Common.getFirstValueFromObject(O2Common.getDepartment1ByUnit(unit), \"distinguishedName\")\r\n    },\r\n    getDepartment1ByUnit: function (unit) {\r\n        var units \u003d _self.org.listSupUnitWithLevel(unit, SystemConfig.departmentLevel_1);\r\n        return Array.isArray(units) ? units : [units];\r\n    },\r\n    getUnitByIdentityByLevel: function (identity, level) {\r\n        var unitList \u003d _self.org.listAllSupUnitWithIdentity(identity);\r\n        var result;\r\n        if (unitList) {\r\n            unitList.each(function (u) {\r\n                if (u.level \u003d\u003d level) {\r\n                    result \u003d u;\r\n                }\r\n            })\r\n        }\r\n        return result;\r\n    },\r\n    getUnitByIdentityByType: function (identity, type) {\r\n        var unitList \u003d _self.org.listAllSupUnitWithIdentity(identity);\r\n        var result;\r\n        if (unitList) {\r\n            unitList.each(function (u) {\r\n                if (u.typeList.contains(type)) {\r\n                    result \u003d u;\r\n                }\r\n            })\r\n        }\r\n        return result;\r\n    },\r\n    getSuperUnitByUnitByShortname: function (unit, shortName) {\r\n\r\n        var unitList \u003d _self.org.listSupUnit(unit, true);\r\n        var result \u003d (unitList || []).filter(function (u) {\r\n            return u.shortName \u003d\u003d\u003d shortName;\r\n        })\r\n        if (!result.length) {\r\n            unitList \u003d _self.org.getUnit(unit);\r\n            if (typeOf(unitList) \u003d\u003d \"object\") unitList \u003d [unitList];\r\n            result \u003d (unitList || []).filter(function (u) {\r\n                return u.shortName \u003d\u003d\u003d shortName;\r\n            })\r\n        }\r\n        return result[0] || null;\r\n    },\r\n    getSuperUnitByEmployeeByShortname: function (employee, Shortname) {\r\n        var unitList \u003d _self.org.listUnitWithPerson(employee);\r\n        var result \u003d [];\r\n        unitList.each(function (unit) {\r\n            result.push(o2common.getSuperUnitByUnitByShortname(unit, Shortname))\r\n        })\r\n        return result.filter(function (r) {\r\n            return !!r\r\n        })\r\n    },\r\n    getSuperUnitByEmployeeByType: function (employee, type) {\r\n        var unitList \u003d _self.org.listUnitWithPerson(employee);\r\n        var result \u003d [];\r\n        unitList.each(function (unit) {\r\n            result.push(_self.org.listSupUnitWithType(unit, type))\r\n        })\r\n        var uniqueList \u003d [];\r\n        return result.filter(function (r) {\r\n            if (r \u0026\u0026 r.unique) {\r\n                if (uniqueList.contains(r.unique)) {\r\n                    return false;\r\n                } else {\r\n                    uniqueList.push(r.unique);\r\n                }\r\n            }\r\n            return !!r\r\n        })\r\n    },\r\n    getFirstValueFromObject: function (object, key) {\r\n        var list \u003d O2Common.getKeyFromObject(object, key);\r\n        if (list.length) return list[0];\r\n        return \"\";\r\n    },\r\n    getKeyFromObject: function (object, key) {\r\n        if (!key) return [];\r\n        if (!object) return [];\r\n        var result \u003d [];\r\n        var array \u003d typeOf(object) \u003d\u003d\u003d \"object\" ? [object] : object;\r\n        array.each(function (item) {\r\n            if (item[key]) result.push(item[key]);\r\n        }.bind(this));\r\n        return result;\r\n    },\r\n    uniqueListByKey: function (list, key) {\r\n        var arr \u003d [];\r\n        list.each(function (d) {\r\n            var flag \u003d false;\r\n            for (var i \u003d 0; i \u003c arr.length; i++) {\r\n                if (arr[i][key] \u003d\u003d\u003d d[key]) {\r\n                    flag \u003d true;\r\n                    break;\r\n                }\r\n            }\r\n            if (!flag) arr.push(d);\r\n        })\r\n        return arr;\r\n    },\r\n    getPerson: function () {\r\n        return layout.desktop.session.user.distinguishedName;\r\n    },\r\n    getCurrentDepartmentObj: function () {\r\n        var identity \u003d O2Common.getFirstIdentity();\r\n        return O2Common.getDepartment1ByIdentity(identity);\r\n    },\r\n    getCurrentDepartment: function () {\r\n        var identity \u003d O2Common.getFirstIdentity();\r\n        return O2Common.getDepartment1DnByIdentity(identity);\r\n    },\r\n    getCurrentDepartmentDn: function () {\r\n        var department \u003d o2Common.getCurrentDepartment();\r\n        return department || \"\";\r\n    },\r\n    getCurrentDepartmentUnique: function () {\r\n        var department \u003d o2Common.getCurrentDepartment();\r\n        return department ? department.split(\u0027@\u0027)[1] : \"\";\r\n    },\r\n    getCurrentDepartmentPY: function () {\r\n        var dn \u003d o2Common.getCurrentDepartmentDn();\r\n        var obj \u003d _self.org.getUnit(dn);\r\n        if (obj) {\r\n            return obj.pinyin;\r\n        }\r\n    },\r\n    getCurrentUnit: function () {\r\n        var user \u003d _self.session.user;\r\n        var identityList\r\n        if (user.identityList \u0026\u0026 user.identityList.length) {\r\n            identityList \u003d user.identityList.filter(function (i) {\r\n                return i.major;\r\n            })\r\n            if (!identityList.length) {\r\n                identityList \u003d user.identityList;\r\n            }\r\n        }\r\n        if (!identityList) {\r\n            return;\r\n        } else {\r\n            return _self.org.getUnit(identityList[0].unit);\r\n        }\r\n    },\r\n    getCurrentUnitDn: function () {\r\n        var department \u003d o2Common.getCurrentUnit();\r\n        if (department) return department.distinguishedName;\r\n    },\r\n    getEmployee: function () {\r\n        return layout.desktop.session.user.employee;\r\n    },\r\n    isValidIDCard: function (id) {\r\n        // 身份证号码长度应为18位\r\n        if (id.length !\u003d\u003d 18) {\r\n            return false;\r\n        }\r\n\r\n        // 前17位应为数字\r\n        for (var i \u003d 0; i \u003c 17; i++) {\r\n            if (isNaN(id[i])) {\r\n                return false;\r\n            }\r\n        }\r\n\r\n        // 校验最后一位校验码\r\n        var weights \u003d [7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2];\r\n        var checkCodes \u003d [\u00271\u0027, \u00270\u0027, \u0027X\u0027, \u00279\u0027, \u00278\u0027, \u00277\u0027, \u00276\u0027, \u00275\u0027, \u00274\u0027, \u00273\u0027, \u00272\u0027];\r\n        var sum \u003d 0;\r\n        for (var j \u003d 0; j \u003c 17; j++) {\r\n            sum +\u003d parseInt(id[j], 10) * weights[j];\r\n        }\r\n        var remainder \u003d sum % 11;\r\n        var expectedCheckCode \u003d checkCodes[remainder];\r\n\r\n        // 忽略大小写比较校验码\r\n        if (expectedCheckCode.toLowerCase() !\u003d\u003d id.substring(17, 18).toLowerCase()) {\r\n            return false;\r\n        }\r\n\r\n        return true;\r\n    },\r\n    getAge: function (birthDateString) {\r\n        // 解析出生日期字符串为日期对象\r\n        var birthDate \u003d new Date(birthDateString);\r\n        if (isNaN(birthDate)) {\r\n            return \u0027\u0027;\r\n        }\r\n\r\n        // 获取当前日期\r\n        var currentDate \u003d new Date();\r\n\r\n        // 计算年龄：当前年份减去出生年份\r\n        var age \u003d currentDate.getFullYear() - birthDate.getFullYear();\r\n\r\n        // 处理同年出生的情况：如果当前月份小于出生月份或月份相同但当前日期小于出生日期，则年龄减1\r\n        if (currentDate.getMonth() \u003c birthDate.getMonth() ||\r\n            (currentDate.getMonth() \u003d\u003d\u003d birthDate.getMonth() \u0026\u0026 currentDate.getDate() \u003c birthDate.getDate())) {\r\n            age--;\r\n        }\r\n\r\n        return age;\r\n    },\r\n    calculateAge: function (birthDateString) {\r\n        return o2common.getAge(birthDateString);\r\n    },\r\n    getBirthDateFromIDCard: function (idNumber) {\r\n        // 确保身份证号码至少有14位\r\n        if (idNumber.length \u003c 14) {\r\n            return \u0027\u0027;\r\n        }\r\n\r\n        // 从身份证号码中提取出生年月日（YYYYMMDD格式），位于第7位到第14位\r\n        var birthDate \u003d idNumber.substring(6, 14);\r\n\r\n        // 将出生年月日（YYYYMMDD）转换为年月日（YYYY-MM-DD）格式\r\n        var year \u003d birthDate.substring(0, 4);\r\n        var month \u003d birthDate.substring(4, 6);\r\n        var day \u003d birthDate.substring(6, 8);\r\n\r\n        // 使用加号（+）来连接字符串\r\n        return year + \u0027-\u0027 + month + \u0027-\u0027 + day;\r\n    },\r\n    getFirstIdentityDn: function () {\r\n        var identity \u003d O2Common.getFirstIdentity();\r\n        return identity ? identity.distinguishedName : \"\";\r\n    },\r\n    getFirstIdentity: function () {\r\n        var user \u003d _self.session.user;\r\n        var identityList\r\n        if (user.identityList \u0026\u0026 user.identityList.length) {\r\n            identityList \u003d user.identityList.filter(function (i) {\r\n                return i.major;\r\n            })\r\n            if (!identityList.length) {\r\n                identityList \u003d user.identityList;\r\n            }\r\n        }\r\n        if (!identityList) {\r\n            return;\r\n        } else {\r\n            return identityList[0];\r\n        }\r\n    },\r\n    isDate: function (d) {\r\n        return isNaN(d) \u0026\u0026 !isNaN(Date.parse(d));\r\n    },\r\n    isNumber: function (d) {\r\n        return parseFloat(d).toString() !\u003d\u003d \"NaN\"\r\n    },\r\n    getInt: function (value) {\r\n        return O2Common.isNumber(value) ? parseInt(value) : 0;\r\n    },\r\n    getFloat: function (value) {\r\n        return O2Common.isNumber(value) ? parseFloat(value) : 0;\r\n    },\r\n    openMyCMSProfile: function (cms_categoryAlias, d, options, callback) {\r\n        O2Common.getMyCMSProfile(cms_categoryAlias, function (data) {\r\n            if (data) {\r\n                _self.form.openDocument(data.id, \"\", options);\r\n            } else {\r\n                var p1 \u003d o2Common.createCMSProfileByServer(cms_categoryAlias, options.title);\r\n                if(p1)p1.then(function (json) {\r\n                    _self.form.openDocument(json.data.id, \"\", options);\r\n                })\r\n            }\r\n        }.bind(this));\r\n    }.bind(this),\r\n    createCMSProfileByServer: function (cms_categoryAlias, title) {\r\n        var identity \u003d O2Common.getFirstIdentityDn();\r\n        if (!identity) return;\r\n        var promise \u003d o2Common[\u0027profile_promise_\u0027+cms_categoryAlias];\r\n        if( promise ){\r\n            return promise;\r\n        }\r\n        var p \u003d o2.Actions.load(\"x_cms_assemble_control\").CategoryInfoAction.getByAlias(cms_categoryAlias);\r\n        promise \u003d p.then(function (json) {\r\n            return o2.Actions.load(\"x_cms_assemble_control\").DocumentAction.persist_publishContent({\r\n                identity: identity,\r\n                title: title || json.data.categoryName,\r\n                categoryId: json.data.id,\r\n                docData: {\r\n                    subject: title || json.data.categoryName\r\n                }\r\n            })\r\n        });\r\n        o2Common[\u0027profile_promise_\u0027+cms_categoryAlias] \u003d promise;\r\n        return promise;\r\n    },\r\n    getMyCMSProfile: function (cms_categoryAlias, callback, options) {\r\n        var data \u003d {\r\n            \"creatorList\": [this.session.user.distinguishedName]\r\n        }\r\n        if (o2.typeOf(options) \u003d\u003d\u003d \"object\") {\r\n            data \u003d Object.merge(data, options);\r\n        }\r\n        O2Common.getCMSProfile(cms_categoryAlias, function (d) {\r\n            if (callback) callback(d);\r\n        }.bind(this), data);\r\n    }.bind(this),\r\n    openCMSProfile: function (cms_categoryAlias, d, callback) {\r\n        O2Common.getCMSProfile(cms_categoryAlias, function (data) {\r\n            if (data) {\r\n                _self.form.openDocument(data.id);\r\n            } else {\r\n                o2Common.createCMSProfile(cms_categoryAlias, d, callback);\r\n            }\r\n        }.bind(this));\r\n    }.bind(this),\r\n    createCMSProfile: function (cms_categoryAlias, d, callback) {\r\n        var identity \u003d O2Common.getFirstIdentityDn();\r\n        if (!identity) return false;\r\n        // this.page.createDocument(\"\",cms_categoryAlias, data, identity );\r\n        _self.form.createDocument({\r\n            \"category\": cms_categoryAlias, //（string）可选，要创建的文档所属的分类的名称、别名或ID\r\n            \"data\": d, //（json object）可选，创建文档时默认的业务数据\r\n            \"identity\": identity, //（string）可选，创建文档所使用的身份。如果此参数为空，且当前人有多个身份的情况下，会弹出身份选择对话框；否则使用默认身份。\r\n            \"callback\": callback, //（funcation）可选，文档创建后的回调函数。\r\n            \"target\": false, //（boolean）可选，为true时，在当前页面打开创建的文档；否则打开新窗口。默认false。\r\n            \"latest\": true, //（boolean）可选，为true时，如果当前用户已经创建了此分类的文档，并且没有发布过，直接调用此文档为新文档；否则创建一个新文档。默认true。\r\n            \"selectColumnEnable\": false, //（boolean）可选，是否可以选择应用和分类进行创建文档。有category参数时为默认false,否则默认为true。\r\n            \"ignoreTitle\": true //（boolean）可选，值为false时，创建的时候需要强制填写标题，默认为false。\r\n        })\r\n    }.bind(this),\r\n    getCMSProfile: function (cms_categoryAlias, callback, options) {\r\n        const key \u003d options ? `${cms_categoryAlias}-${JSON.stringify(options)}` : cms_categoryAlias;\r\n\r\n        if (window.CMSProfile \u0026\u0026 window.CMSProfile[key]) {\r\n            var profile \u003d window.CMSProfile[key];\r\n            if( profile.then ){\r\n                if( callback )profile.then((data)\u003d\u003e{ callback(data); });\r\n            }else{\r\n                if (callback) callback(profile);\r\n            }\r\n            return profile;\r\n        }\r\n        if (!window.CMSProfile) window.CMSProfile \u003d {};\r\n        var data \u003d {\r\n            categoryAliasList: [cms_categoryAlias],\r\n            documentType: \"全部\",\r\n            justData: true\r\n        };\r\n        if (o2.typeOf(options) \u003d\u003d\u003d \"object\") {\r\n            data \u003d Object.merge(data, options);\r\n        }\r\n        var result;\r\n        var p \u003d o2.Actions.load(\"x_cms_assemble_control\").DocumentAction.query_listWithFilterPaging(1, 1, data, function (json) {\r\n            result \u003d json?.data?.length ? json.data[0] : \"\";\r\n            return result;\r\n        }, null, !!callback);\r\n        if( callback ){\r\n            window.CMSProfile[key] \u003d p.then((result)\u003d\u003e{\r\n                callback( result );\r\n                if( !result ){\r\n                    window.CMSProfile[key] \u003d \u0027\u0027;\r\n                }\r\n                return result;\r\n            });\r\n        }else{\r\n            if(result)window.CMSProfile[key] \u003d result;\r\n        }\r\n        return window.CMSProfile[key];\r\n    }.bind(this),\r\n    loadCMSProfile: function(cms_categoryAlias, callback, options){\r\n        o2Common.getCMSProfile( cms_categoryAlias, (data)\u003d\u003e{\r\n            if( !data ){\r\n                o2Common.createCMSProfileByServer(cms_categoryAlias).then(()\u003d\u003e{\r\n                    o2Common.getCMSProfile( cms_categoryAlias, callback, options)\r\n                })\r\n            }else{\r\n                callback(data);\r\n            }\r\n        }, options )\r\n    },\r\n    getCMSData: function (id, callback, async) { //callback 为成功后执行回调方法\r\n        var data;\r\n        var action \u003d O2Common.getCMSAction(\"GET\", id);\r\n        action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                data \u003d json.data;\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n        return data;\r\n    }.bind(this),\r\n    createCMSData: function (id, data, callback, async) { //callback 为成功后执行回调方法\r\n        var action \u003d O2Common.getCMSAction(\"POST\", id);\r\n        return action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"data\": data,\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n    }.bind(this),\r\n    updateCMSData: function (id, data, callback, async) { //callback 为成功后执行回调方法\r\n        var action \u003d O2Common.getCMSAction(\"PUT\", id);\r\n        return action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"data\": data,\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n    }.bind(this),\r\n    deleteCMSData: function (id, callback, async) { //callback 为成功后执行回调方法\r\n        var action \u003d O2Common.getCMSAction(\"DELETE\", id);\r\n        return action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n    }.bind(this),\r\n    getCMSAction: function (method, id) {\r\n        var uri \u003d \"/jaxrs/data/document/\" + id;\r\n        return new this.Action(\"x_cms_assemble_control\", {\r\n            \"execute\": {\r\n                \"uri\": uri,\r\n                \"method\": method || \"GET\"\r\n            }\r\n        });\r\n    }.bind(this),\r\n    getCMSPathData: function (id, pathList, callback, async) { //callback 为成功后执行回调方法\r\n        var data;\r\n        var action \u003d O2Common.getCMSPathAction(\"GET\", id, pathList);\r\n        action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                data \u003d json.data;\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n        return data;\r\n    }.bind(this),\r\n    createCMSPathData: function (id, pathList, data, callback, async) { //callback 为成功后执行回调方法\r\n        var action \u003d O2Common.getCMSPathAction(\"POST\", id, pathList);\r\n        return action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"data\": data,\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n    }.bind(this),\r\n    updateCMSPathData: function (id, pathList, data, callback, async) { //callback 为成功后执行回调方法\r\n        if( !pathList || pathList.length \u003d\u003d\u003d 0 ){\r\n            return _self.Actions.load(\u0027x_program_center\u0027).InvokeAction.execute(\r\n                \u0027updateDataWithDocument\u0027,\r\n                {id, data},\r\n                function (json) {\r\n                    if (callback) callback(json);\r\n                }.bind(this),\r\n                null,\r\n                async \u003d\u003d\u003d false ? false : true\r\n            )\r\n        }else{\r\n            var action \u003d O2Common.getCMSPathAction(\"PUT\", id, pathList);\r\n            return action.invoke({\r\n                \"name\": \"execute\",\r\n                \"success\": function (json) {\r\n                    if (callback) callback(json);\r\n                }.bind(this),\r\n                \"data\": data,\r\n                \"async\": async \u003d\u003d\u003d false ? false : true\r\n            });\r\n        }\r\n    }.bind(this),\r\n    deleteCMSPathData: function (id, pathList, callback, async) { //callback 为成功后执行回调方法\r\n        var action \u003d O2Common.getCMSPathAction(\"DELETE\", id, pathList);\r\n        return action.invoke({\r\n            \"name\": \"execute\",\r\n            \"success\": function (json) {\r\n                if (callback) callback(json);\r\n            }.bind(this),\r\n            \"async\": async \u003d\u003d\u003d false ? false : true\r\n        });\r\n    }.bind(this),\r\n    getCMSPathAction: function (method, id, pathList) {\r\n        var uri \u003d \"/jaxrs/data/document/\" + id;\r\n        if (pathList \u0026\u0026 typeOf(pathList) \u003d\u003d\u003d \"array\" \u0026\u0026 pathList.length \u003e 0) {\r\n            var pList \u003d pathList.map(function (v) {\r\n                return encodeURIComponent(v);\r\n            });\r\n            uri \u003d uri + \"/\" + pList.join(\"/\");\r\n        }\r\n        return new this.Action(\"x_cms_assemble_control\", {\r\n            \"execute\": {\r\n                \"uri\": uri,\r\n                \"method\": method || \"GET\"\r\n            }\r\n        });\r\n    }.bind(this),\r\n    getUnitFlag: function (json) {\r\n        return json.flag || json.distinguishedName || json.unique || json.id || json.name;\r\n    },\r\n    isOrgIntersect: function (source, target) {\r\n        if (typeOf(source) !\u003d\u003d \"array\") source \u003d [source];\r\n        if (typeOf(target) !\u003d\u003d \"array\") target \u003d [target];\r\n        var map \u003d {};\r\n        source.each(function (s) {\r\n            if (!s) return;\r\n            if (typeOf(s) \u003d\u003d\u003d \"string\") {\r\n                map[s] \u003d true;\r\n            } else {\r\n                if (s.distinguishedName) map[s.distinguishedName] \u003d true;\r\n                if (s.id) map[s.id] \u003d true;\r\n                if (s.unique) map[s.unique] \u003d true;\r\n                if (s.employee) map[s.employee] \u003d true;\r\n                if (s.levelName) map[s.levelName] \u003d true;\r\n            }\r\n        })\r\n        for (var i \u003d 0; i \u003c target.length; i++) {\r\n            var t \u003d target[i];\r\n            if (!t) continue;\r\n            if (typeOf(t) \u003d\u003d\u003d \"string\") {\r\n                if (map[t]) return true;\r\n            } else {\r\n                if (t.distinguishedName \u0026\u0026 map[t.distinguishedName]) return true;\r\n                if (t.id \u0026\u0026 map[t.id]) return true;\r\n                if (t.unique \u0026\u0026 map[t.unique]) return true;\r\n                if (t.employee \u0026\u0026 map[t.employee]) return true;\r\n                if (t.levelName \u0026\u0026 map[t.levelName]) return true;\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n    multipleScheduleRangeDateOverlaps: function () {\r\n        var length, i, j, k, ignoreSingleEquals, args \u003d [];\r\n        if (typeOf(arguments[arguments.length - 1]) \u003d\u003d\u003d \"boolean\") {\r\n            ignoreSingleEquals \u003d arguments[arguments.length - 1];\r\n            length \u003d arguments.length - 1;\r\n        } else {\r\n            ignoreSingleEquals \u003d false;\r\n            length \u003d arguments.length;\r\n        }\r\n        for (k \u003d 0; k \u003c length; k++) {\r\n            args.push(arguments[k].startDate);\r\n            args.push(arguments[k].endDate);\r\n        }\r\n        for (i \u003d 0; i \u003c args.length - 2; i +\u003d 2) {\r\n            for (j \u003d i + 2; j \u003c args.length; j +\u003d 2) {\r\n                if (args[i].getTime() \u003d\u003d args[j].getTime() \u0026\u0026 args[i + 1].getTime() \u003d\u003d args[j + 1].getTime()) return true;\r\n                var a_start \u003d args[i];\r\n                var a_end \u003d args[i + 1];\r\n                var b_start \u003d args[j];\r\n                var b_end \u003d args[j + 1];\r\n                if (\r\n                    o2common.dateRangeOverlaps(\r\n                        a_start, a_end,\r\n                        b_start, b_end,\r\n                        ignoreSingleEquals\r\n                    )\r\n                ) return true;\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n    multipleScheduleRangeOverlaps: function () {\r\n        var length, i, j, k, ignoreSingleEquals, args \u003d [];\r\n        var dateStr \u003d \"2020-1-1\";\r\n\r\n        if (typeOf(arguments[arguments.length - 1]) \u003d\u003d\u003d \"boolean\") {\r\n            ignoreSingleEquals \u003d arguments[arguments.length - 1];\r\n            length \u003d arguments.length - 1;\r\n        } else {\r\n            ignoreSingleEquals \u003d false;\r\n            length \u003d arguments.length;\r\n        }\r\n\r\n        if (length \u003c 2) return false;\r\n\r\n        for (k \u003d 0; k \u003c length; k++) {\r\n            var startEndObj \u003d o2common.getStartEndBySchedule(dateStr, arguments[k]);\r\n            args.push(startEndObj.startDate);\r\n            args.push(startEndObj.endDate);\r\n        }\r\n\r\n        for (i \u003d 0; i \u003c args.length - 2; i +\u003d 2) {\r\n            for (j \u003d i + 2; j \u003c args.length; j +\u003d 2) {\r\n                if (args[i].getTime() \u003d\u003d args[j].getTime() \u0026\u0026 args[i + 1].getTime() \u003d\u003d args[j + 1].getTime()) return true;\r\n                var a_start \u003d args[i];\r\n                var a_end \u003d args[i + 1];\r\n                var b_start \u003d args[j];\r\n                var b_end \u003d args[j + 1];\r\n                if (\r\n                    o2common.dateRangeOverlaps(\r\n                        a_start, a_end,\r\n                        b_start, b_end,\r\n                        ignoreSingleEquals\r\n                    )\r\n                ) return true;\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n    multipleTimeRangeOverlaps: function () {\r\n        var i, j, k, ignoreSingleEquals, args \u003d [];\r\n        if (arguments.length % 2 \u003d\u003d 0) {\r\n            ignoreSingleEquals \u003d false;\r\n            args \u003d arguments;\r\n        } else {\r\n            ignoreSingleEquals \u003d arguments[arguments.length - 1];\r\n            for (k \u003d 0; k \u003c arguments.length - 1; k++) {\r\n                args.push(arguments[k]);\r\n            }\r\n        }\r\n\r\n        for (i \u003d 0; i \u003c args.length - 2; i +\u003d 2) {\r\n            for (j \u003d i + 2; j \u003c args.length; j +\u003d 2) {\r\n                if (args[i] \u003d\u003d args[j] \u0026\u0026 args[i + 1] \u003d\u003d args[j + 1]) return true;\r\n\r\n                var a_start \u003d new Date(\"2020-1-1 \" + args[i]);\r\n                var a_end \u003d new Date(\"2020-1-1 \" + args[i + 1]);\r\n                if (a_start \u003e\u003d a_end) a_end.increment();\r\n                var b_start \u003d new Date(\"2020-1-1 \" + args[j]);\r\n                var b_end \u003d new Date(\"2020-1-1 \" + args[j + 1]);\r\n                if (b_start \u003e\u003d b_end) b_end.increment();\r\n                if (\r\n                    o2common.dateRangeOverlaps(\r\n                        a_start, a_end,\r\n                        b_start, b_end,\r\n                        ignoreSingleEquals\r\n                    )\r\n                ) return true;\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n    dateRangeOverlaps: function (a_start, a_end, b_start, b_end, ignoreSingleEquals) {\r\n        if (a_start.getTime() \u003d\u003d b_start.getTime() \u0026\u0026 a_end.getTime() \u003d\u003d b_end.getTime()) return true;\r\n        if (ignoreSingleEquals) {\r\n            if (a_start \u003c b_start \u0026\u0026 b_start \u003c a_end) return true; // b starts in a\r\n            if (a_start \u003c b_end \u0026\u0026 b_end \u003c a_end) return true; // b ends in a\r\n            if (b_start \u003c a_start \u0026\u0026 a_end \u003c b_end) return true; // a in b\r\n\r\n            if (b_start \u003c a_start \u0026\u0026 a_start \u003c b_end) return true; // a starts in b\r\n            if (b_start \u003c a_end \u0026\u0026 a_end \u003c b_end) return true; // a ends in b\r\n            if (a_start \u003c b_start \u0026\u0026 b_end \u003c a_end) return true; // b in a\r\n\r\n            return false;\r\n        } else {\r\n            if (a_start \u003c\u003d b_start \u0026\u0026 b_start \u003c\u003d a_end) return true; // b starts in a\r\n            if (a_start \u003c\u003d b_end \u0026\u0026 b_end \u003c\u003d a_end) return true; // b ends in a\r\n            if (b_start \u003c a_start \u0026\u0026 a_end \u003c b_end) return true; // a in b\r\n\r\n            if (b_start \u003c\u003d a_start \u0026\u0026 a_start \u003c\u003d b_end) return true; // a starts in b\r\n            if (b_start \u003c\u003d a_end \u0026\u0026 a_end \u003c\u003d b_end) return true; // a ends in b\r\n            if (a_start \u003c b_start \u0026\u0026 b_end \u003c a_end) return true; // b in a\r\n\r\n            return false;\r\n        }\r\n    },\r\n    multipleDateRangeOverlaps: function () {\r\n        var i, j, k, ignoreSingleEquals, args \u003d [];\r\n        if (arguments.length % 2 \u003d\u003d 0) {\r\n            ignoreSingleEquals \u003d false;\r\n            args \u003d arguments;\r\n        } else {\r\n            ignoreSingleEquals \u003d arguments[arguments.length - 1];\r\n            for (k \u003d 0; k \u003c arguments.length - 1; k++) {\r\n                args.push(arguments[k]);\r\n            }\r\n        }\r\n        for (i \u003d 0; i \u003c args.length - 2; i +\u003d 2) {\r\n            for (j \u003d i + 2; j \u003c args.length; j +\u003d 2) {\r\n                if (args[i].getTime() \u003d\u003d args[j].getTime() \u0026\u0026 args[i + 1].getTime() \u003d\u003d args[j + 1].getTime()) return true;\r\n\r\n                if (\r\n                    o2common.dateRangeOverlaps(\r\n                        args[i], args[i + 1],\r\n                        args[j], args[j + 1],\r\n                        ignoreSingleEquals\r\n                    )\r\n                ) return true;\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n    cloneDate: function (date) {\r\n        return new Date(date.getTime());\r\n    },\r\n    parseDate(date, isClone) {\r\n        if (!date) return null;\r\n        return typeOf(date) \u003d\u003d\u003d \"date\" ? (isClone ? o2common.cloneDate(date) : date) : new Date(date);\r\n    },\r\n    lastDayOfMonth: function (year, month) {\r\n        var date \u003d new Date(year + \"-\" + month + \"-01\");\r\n        date.setMonth(date.getMonth() + 1);\r\n        date.setDate(date.getDate() - 1);\r\n        return date;\r\n    },\r\n    lastTimeOfMonth: function (year, month) {\r\n        var date \u003d o2common.lastDayOfMonth(year, month)\r\n        return o2common.lastTimeOfDate(date);\r\n    },\r\n    lastTimeOfDate: function (date, isClone) {\r\n        if (!date) return null;\r\n        var d \u003d o2common.parseDate(date, isClone);\r\n        d.setHours(23);\r\n        d.setMinutes(59);\r\n        d.setSeconds(59);\r\n        d.setMilliseconds(999);\r\n        return d;\r\n    },\r\n    /** 将日期时间格式化为指定的格式，并返回格式化后的字符串\r\n     * @param {Date} date 需格式化日期\r\n     * @param {String} format 格式化字符串，如 YYYY-MM-DD HH:mm:ss\r\n     * Y - 年份\r\n     * M - 月份\r\n     * D - 日期\r\n     * H - 小时（24 小时制）\r\n     * h - 小时（12 小时制）\r\n     * m - 分\r\n     * s - 秒\r\n     * q - 季度\r\n     * S - 毫秒\r\n     * a - 上午/下午\r\n     * A - AM/PM\r\n     * @example\r\n     * const date \u003d new Date();\r\n     * formatDate(date, \u0027YYYY-MM-DD HH:mm:ss\u0027); // 2023-02-16 08:25:05\r\n     * formatDate(date, \u0027YYYY年MM月DD日 HH:mm:ss\u0027); // 2023年02月16日 08:25:05\r\n     * formatDate(date, \u0027YYYY-MM-DD HH:mm:ss S\u0027); // 2023-02-16 08:25:05 950\r\n     * formatDate(date, \u0027YYYY-MM-DD HH:mm:ss A\u0027); // 2023-02-16 08:25:05 上午\r\n     */\r\n    formatDate: function (date, format) {\r\n        const o \u003d {\r\n            \u0027M+\u0027: date.getMonth() + 1, // 月份\r\n            \u0027D+\u0027: date.getDate(), // 日\r\n            \u0027h+\u0027: date.getHours() % 12 \u003d\u003d\u003d 0 ? 12 : date.getHours() % 12, // 小时\r\n            \u0027H+\u0027: date.getHours(), // 小时\r\n            \u0027m+\u0027: date.getMinutes(), // 分\r\n            \u0027s+\u0027: date.getSeconds(), // 秒\r\n            \u0027q+\u0027: Math.floor((date.getMonth() + 3) / 3), // 季度\r\n            S: date.getMilliseconds(), // 毫秒\r\n            a: date.getHours() \u003c 12 ? \u0027上午\u0027 : \u0027下午\u0027, // 上午/下午\r\n            A: date.getHours() \u003c 12 ? \u0027AM\u0027 : \u0027PM\u0027, // AM/PM\r\n        };\r\n        if (/(Y+)/.test(format)) {\r\n            format \u003d format.replace(RegExp.$1, (date.getFullYear() + \u0027\u0027).substr(4 - RegExp.$1.length));\r\n        }\r\n        // if (/(w+)/.test(format)) {\r\n        //     o[\u0027w+\u0027] \u003d weekNumberOfDate(date);\r\n        // }\r\n        for (let k in o) {\r\n            if (new RegExp(\u0027(\u0027 + k + \u0027)\u0027).test(format)) {\r\n                format \u003d format.replace(\r\n                    RegExp.$1,\r\n                    RegExp.$1.length \u003d\u003d\u003d 1 ? o[k] : (\u002700\u0027 + o[k]).substr((\u0027\u0027 + o[k]).length)\r\n                );\r\n            }\r\n        }\r\n        return format;\r\n    },\r\n    getStatementTitleData(statementFlag, callback, async) {\r\n        if (!window.o2StatementTitleData) window.o2StatementTitleData \u003d {};\r\n        if (window.o2StatementTitleData[statementFlag]) return window.o2StatementTitleData[statementFlag];\r\n        var list \u003d [];\r\n        _self.statement.execute(\r\n            {\r\n                \"name\": statementFlag,\r\n                \"mode\": \"data\",\r\n                \"page\": 1,\r\n                \"pageSize\": 20000\r\n            },\r\n            function (json) {\r\n                list \u003d json.data.map(function (d) {\r\n                    return d.xtitle || d.title || d.TITLE || d.XTITLE;\r\n                })\r\n                if (callback) callback(list);\r\n            },\r\n            false\r\n        );\r\n        window.o2StatementTitleData[statementFlag] \u003d list;\r\n        return list;\r\n    },\r\n    getDataWithPath: function (obj, path) {\r\n        var pathList \u003d  typeOf(path) \u003d\u003d\u003d \u0027string\u0027 ? path.split(\u0027.\u0027) : path;\r\n        for (var i \u003d 0; i \u003c pathList.length; i++) {\r\n            var p \u003d pathList[i];\r\n            if ((/(^[1-9]\\d*$)/.test(p))) p \u003d p.toInt();\r\n            if (obj[p]) {\r\n                obj \u003d obj[p];\r\n            } else if(obj[p] \u003d\u003d\u003d undefined || obj[p] \u003d\u003d\u003d null) {\r\n                obj \u003d \"\";\r\n                break;\r\n            } else {\r\n                obj \u003d obj[p];\r\n                break;\r\n            }\r\n        }\r\n        return obj\r\n    },\r\n    setDataWithPath: function(obj, path, data){\r\n        var names \u003d  typeOf(path) \u003d\u003d\u003d \u0027string\u0027 ? path.split(\u0027.\u0027) : path;\r\n        var d \u003d obj;\r\n        Array.each(names, function (n, idx) {\r\n            if( idx \u003d\u003d\u003d names.length -1 )return;\r\n            if ( !d[n] ){\r\n                var value \u003d this.isNumberString( names[idx+1] ) ? [] : {};\r\n                var n1 \u003d this.isNumberString( n ) ? n.toInt() : n;\r\n                d[n1] \u003d value;\r\n                d \u003d d[n1];\r\n            }else{\r\n                d \u003d d[n];\r\n            }\r\n        }.bind(this));\r\n        d[names[names.length -1]] \u003d data;\r\n    },\r\n    parseData: function( list, keyMap, reverse ){\r\n        return list.map((d)\u003d\u003e{\r\n            let entry \u003d {};\r\n            Object.entries(keyMap).forEach(([key, value])\u003d\u003e{\r\n                if( reverse ){\r\n                    if( !value ){\r\n                        entry[key] \u003d d;\r\n                    }else{\r\n                        d.hasOwnProperty(value) \u0026\u0026 (entry[key] \u003d d[value]);\r\n                    }\r\n                }else{\r\n                    if( !value ){\r\n                         d.hasOwnProperty(key) \u0026\u0026 (entry \u003d d[key]);\r\n                    }else{\r\n                        d.hasOwnProperty(key) \u0026\u0026 (entry[value] \u003d d[key]);\r\n                    }\r\n                }\r\n            })\r\n            return entry;\r\n        })\r\n    }\r\n};\r\n\r\nthis.define(\u0027moduleBindDict\u0027, function(module, dictOpt, pathList, keyMap){\r\n    if( !pathList )pathList \u003d module.json.id;\r\n    const path \u003d typeOf(pathList) \u003d\u003d\u003d \u0027string\u0027 ? pathList : pathList.join(\".\");\r\n    const dict \u003d new this.Dict(dictOpt);\r\n    const data \u003d !!keyMap ? o2Common.parseData( dict.get(path), keyMap, true ) : dict.get(path);\r\n    module.setData( module.json.type \u003d\u003d\u003d \u0027Datatable\u0027 ? { data } : data );\r\n    \r\n    module.addEvent(\u0027change\u0027, (e)\u003d\u003e{\r\n        const data \u003d module.json.type \u003d\u003d\u003d \u0027Datatable\u0027 ? module.getData().data : module.getData();\r\n        dict.set( path, !!keyMap ? o2Common.parseData( data, keyMap ) : data )\r\n    });\r\n})\r\n\r\nthis.define(\"moduleBindDoc\", function (module, category, pathList) {\r\n    if( !pathList )pathList \u003d module.json.id;\r\n    const paths \u003d typeOf(pathList) \u003d\u003d\u003d \u0027string\u0027 ? pathList.split(\u0027.\u0027) : pathList;\r\n    let docid;\r\n    o2Common.loadCMSProfile( category, (data)\u003d\u003e{\r\n        docid \u003d data.id;\r\n        const d \u003d o2Common.getDataWithPath( data.data, paths);\r\n        if( d )module.setData( d );\r\n    }, { needData: true });\r\n\r\n    module.addEvent(\u0027change\u0027, (e)\u003d\u003e{\r\n        const obj \u003d {};\r\n        o2Common.setDataWithPath( obj, paths, module.getData() );\r\n        o2.Actions.load(\u0027x_cms_assemble_control\u0027).DataAction.updateWithDocument(docid, obj, ()\u003d\u003e{}, false);\r\n    });\r\n}.bind(this));\r\n\r\nthis.define(\"moduleBindGroup\", function (module, groupDn) {\r\n    return this.getPermissionObj().moduleBindGroup(module, groupDn);\r\n}.bind(this));\r\n\r\n\r\nthis.define(\"hasPermission\", function (roleList, person, denyList) {\r\n    return this.getPermissionObj().hasPermission(roleList, person, denyList);\r\n}.bind(this));\r\n\r\nthis.define(\"listUnitByDuty\", function (dutyName, key, person) {\r\n    return this.getPermissionObj().listUnitByDuty(dutyName, key, person);\r\n}.bind(this));\r\n\r\nthis.define(\"listUnitObjectByDuty\", function (dutyName, person) {\r\n    return this.getPermissionObj().listUnitObjectByDuty(dutyName, person);\r\n}.bind(this));\r\n\r\nthis.define(\"saveGroup\", function () {\r\n    this.getPermissionObj().saveGroup(this);\r\n}.bind(this));\r\n\r\nthis.define(\"getSuperUnitByUnitByLevel\", function (unit, level) {\r\n    return this.getPermissionObj().getSuperUnitByUnitByLevel(this, unit, level)\r\n}.bind(this));\r\n\r\nthis.define(\"getPermissionObj\", function () {\r\n    if (this.org_custom) return this.org_custom;\r\n    this.org_custom \u003d new O2Permission(this.HrRole);\r\n    return this.org_custom;\r\n})\r\n\r\nthis.define(\"saveHrPerson\", function () {\r\n    var org \u003d this.getPermissionObj();\r\n    var docData \u003d this.data;\r\n    if (!docData.datatable || !docData.datatable.data) return;\r\n    var memberList \u003d [];\r\n    docData.datatable.data.each(function (d) {\r\n        if (!d.department || !d.department.length) return;\r\n        memberList \u003d memberList.concat(d.MemberList);\r\n        org.saveDuty(this.data.dutyName, d.department, d.MemberList);\r\n    }.bind(this))\r\n    org.saveDutyToGroup(memberList, this)\r\n});\r\n\r\nthis.HrRole \u003d { //permission\r\n    \"Manager\": {\r\n        \"roleList\": [\"Manager\"]\r\n    },\r\n    \"SYS-EmployeeFileManager\": {\r\n        \"groupList\": [\"SYS-档案和人事合同管理员\"]\r\n    },\r\n    \"SYS-EmployeeManageManager\": {\r\n        \"groupList\": [\"SYS-员工管理管理员\"]\r\n    },\r\n    \"SYS-SalaryManager\": {\r\n        \"groupList\" : [\"SYS-工资管理员\"]\r\n    },\r\n    \"SYS-SelfServiceManager\": {\r\n        \"groupList\" : [\"SYS-员工自助管理员\"]\r\n    },\r\n    \"SYS-CertManager\": {\r\n        \"groupList\" : [\"SYS-证书管理员\"]\r\n    },\r\n    // \"MarketDepartmentManager\" : {\r\n    //     \"dutyList\" : [\"人才市场部门管理员\"]\r\n    // }\r\n    // \"部门领导\" : {\r\n    //     \"dutyList\" : [\"部门领导\",\"部门正职领导\"]\r\n    // },\r\n    // \"部门正职领导\" : {\r\n    //     \"dutyList\" : [\"部门正职领导\"]\r\n    // }\r\n};\r\n\r\n//权限相关\r\nwindow.O2Permission \u003d new Class({\r\n    initialize: function (Role) {\r\n        //Role形如\r\n        // {\r\n        //     \"Manager\" : {\r\n        //         \"roleList\" : [\"Manager\"]\r\n        //     },\r\n        //     \"EmployeeFileManager\" : {\r\n        //         \"groupList\" : [\"员工档案管理员\"]\r\n        //     },\r\n        //     \"MarketHrManager\" : {\r\n        //         \"dutyList\" : [\"人才市场人力管理员\"]\r\n        //     },\r\n        //     \"MarketDepartmentManager\" : {\r\n        //         \"dutyList\" : [\"人才市场部门管理员\"]\r\n        //     }\r\n        //     \"部门领导\" : {\r\n        //         \"dutyList\" : [\"部门领导\",\"部门正职领导\"]\r\n        //     },\r\n        //     \"部门正职领导\" : {\r\n        //         \"dutyList\" : [\"部门正职领导\"]\r\n        //     }\r\n        // };\r\n        this.Role \u003d Role;\r\n        this.actions \u003d MWF.Actions.get(\"x_organization_assemble_control\");\r\n        this.personData \u003d {};\r\n    },\r\n    moduleBindGroup: function(module, groupDn){\r\n        this.actions.getGroup(groupDn, function (json) {\r\n            var {woPersonList, woIdentityList, woGroupList, woUnitList} \u003d json.data;\r\n            module.setData( [...woPersonList, ...woIdentityList, ...woGroupList, ...woUnitList] );\r\n        }.bind(this), ()\u003d\u003e{\r\n            return true;\r\n        });\r\n        module.addEvent(\u0027change\u0027, (e)\u003d\u003e{\r\n            this._saveGroupWithModule(null, module.getData(), groupDn)\r\n        })\r\n    },\r\n    _saveGroupWithModule: function (callback, moduleData, groupDn, groupName, groupUnique) {\r\n        var groupFlag \u003d groupDn.split(\u0027@\u0027);\r\n        var data \u003d {\r\n            name: groupName || groupFlag[0],\r\n            unique: groupUnique || groupFlag[1],\r\n            distinguishedName: groupDn,\r\n            personList: [],\r\n            identityList: [],\r\n            groupList: [],\r\n            unitList: []\r\n        };\r\n        moduleData.each(function (d) {\r\n            var dn \u003d typeOf( d ) \u003d\u003d\u003d \u0027string\u0027 ?  d : d.distinguishedName;\r\n            var arr \u003d dn.split(\"@\");\r\n            switch (arr[arr.length - 1]) {\r\n                case \u0027P\u0027:\r\n                    data.personList.push(dn);\r\n                    break;\r\n                case \u0027I\u0027:\r\n                    data.identityList.push(dn);\r\n                    break;\r\n                case \u0027G\u0027:\r\n                    data.groupList.push(dn);\r\n                    break;\r\n                case \u0027U\u0027:\r\n                    data.unitList.push(dn);\r\n                    break;\r\n                default:\r\n                    break;\r\n            }\r\n        }.bind(this));\r\n        this.actions.getGroup(data.distinguishedName || data.unique || data.name, function (json) {\r\n            if (json.data) {\r\n                data.id \u003d json.data.id;\r\n                this.actions.updateGroup(data.id, data, callback, false);\r\n            }\r\n        }.bind(this), function () {\r\n            this.actions.addGroup(data, callback, false);\r\n            return true;\r\n        }.bind(this), false)\r\n    },\r\n    saveGroup: function (cmsMacro, callback) {\r\n        var docData \u003d cmsMacro.data;\r\n        var data \u003d {\r\n            name: docData.groupName,\r\n            unique: docData.groupUnique,\r\n            distinguishedName: docData.distinguishedName,\r\n            personList: [],\r\n            identityList: [],\r\n            groupList: [],\r\n            unitList: []\r\n        };\r\n        docData.MemberList.each(function (d) {\r\n            var arr \u003d d.distinguishedName.split(\"@\");\r\n            switch (arr[arr.length - 1]) {\r\n                case \u0027P\u0027:\r\n                    data.personList.push(d.id);\r\n                    break;\r\n                case \u0027I\u0027:\r\n                    data.identityList.push(d.id);\r\n                    if (d.person) data.personList.push(d.person);\r\n                case \u0027G\u0027:\r\n                    data.groupList.push(d.id);\r\n                    break;\r\n                case \u0027U\u0027:\r\n                    data.unitList.push(d.id);\r\n                    break;\r\n                default:\r\n                    break;\r\n            }\r\n        }.bind(this));\r\n        this.actions.getGroup(data.distinguishedName || data.unique || data.name, function (json) {\r\n            if (json.data) {\r\n                data.id \u003d json.data.id;\r\n                this.actions.updateGroup(data.id, data, callback, false);\r\n            }\r\n        }.bind(this), function () {\r\n            this.actions.addGroup(data, callback, false);\r\n            return true;\r\n        }.bind(this), false)\r\n    },\r\n    saveDutyToGroup: function (memberList, cmsMacro, callback) {\r\n        var docData \u003d cmsMacro.data;\r\n        if (!docData.groupName || !docData.groupUnique) return;\r\n        var data \u003d {\r\n            name: docData.groupName,\r\n            unique: docData.groupUnique,\r\n            distinguishedName: docData.groupName + \"@\" + docData.groupUnique + \"@G\",\r\n            personList: [],\r\n            identityList: [],\r\n            groupList: [],\r\n            unitList: []\r\n        };\r\n        memberList.each(function (d) {\r\n            var arr \u003d d.distinguishedName.split(\"@\");\r\n            switch (arr[arr.length - 1]) {\r\n                case \u0027P\u0027:\r\n                    data.personList.push(d.id);\r\n                    break;\r\n                case \u0027I\u0027:\r\n                    data.identityList.push(d.id);\r\n                    if (d.person) data.personList.push(d.person);\r\n                    break;\r\n                case \u0027G\u0027:\r\n                    data.groupList.push(d.id);\r\n                    break;\r\n                case \u0027U\u0027:\r\n                    data.unitList.push(d.id);\r\n                    break;\r\n                default:\r\n                    break;\r\n            }\r\n        }.bind(this));\r\n        this.actions.getGroup(data.distinguishedName || data.unique || data.name, function (json) {\r\n            if (json.data) {\r\n                data.id \u003d json.data.id;\r\n                this.actions.updateGroup(data.id, data, callback, false);\r\n            }\r\n        }.bind(this), function () {\r\n            this.actions.addGroup(data, callback, false);\r\n            return true;\r\n        }.bind(this), false)\r\n    },\r\n    saveDuty: function (dutyName, untiList, identityList, callback) {\r\n\r\n        if (!dutyName || !untiList || !identityList) return;\r\n\r\n        var idList \u003d [];\r\n        var _identityList \u003d typeOf(identityList) \u003d\u003d\u003d \"array\" ? identityList : [identityList];\r\n        _identityList.each(function (m) {\r\n            idList.push(m.id);\r\n        }.bind(this))\r\n\r\n        var _untiList \u003d typeOf(untiList) \u003d\u003d\u003d \"array\" ? untiList : [untiList];\r\n\r\n        _untiList.each(function (_unit) {\r\n            var data \u003d {\r\n                name: dutyName,\r\n                unit: \"\",\r\n                identityList: idList\r\n            };\r\n\r\n            data.unit \u003d _unit.id || _unit.distinguishedName || _unit.unique;\r\n\r\n            this.actions.listUnitdutyByUnit(data.unit, function (json) {\r\n                var id;\r\n                if (json.data) {\r\n                    json.data.each(function (duty) {\r\n                        if (duty.name \u003d\u003d dutyName) {\r\n                            id \u003d duty.id;\r\n                        }\r\n                    }.bind(this))\r\n                }\r\n                if (id) {\r\n                    data.id \u003d id;\r\n                    this.actions.updateUnitduty(id, data, callback, false);\r\n                } else {\r\n                    this.actions.addUnitduty(data, callback, false);\r\n                }\r\n            }.bind(this), false)\r\n        }.bind(this))\r\n    },\r\n    getPersonData: function (person, callback) {\r\n        if (!this.personData[person]) {\r\n            this.actions.getPerson(person, function (json) {\r\n                var p \u003d json.data;\r\n                this.personData[p.distinguishedName] \u003d p;\r\n                this.personData[p.id] \u003d p;\r\n                this.personData[p.employee] \u003d p;\r\n                this.personData[p.unique] \u003d p;\r\n                if (callback) callback(p);\r\n            }.bind(this), null, false)\r\n        } else {\r\n            if (callback) callback(this.personData[person]);\r\n        }\r\n        return this.personData[person];\r\n    },\r\n    hasPermission: function (role, person, deny) {\r\n        //role [\"PointManager\", \"BehaviorPointManager\", \"CompanyPointManager\",\"DepartmentPointManager\"]\r\n        if (!deny \u0026\u0026 !role) return true;\r\n        if (!layout.desktop.session.user) return false;\r\n        if (!person) person \u003d layout.desktop.session.user.distinguishedName;\r\n\r\n        var data \u003d {};\r\n\r\n        if (deny) {\r\n            var denyList \u003d typeOf(role) \u003d\u003d\u003d \"array\" ? deny : [deny];\r\n            denyList.each(function (r) {\r\n                var roleSetting \u003d Object.clone(this.Role[r]);\r\n                if (!roleSetting) return;\r\n                for (var key in roleSetting) {\r\n                    if (!data[key]) {\r\n                        data[key] \u003d roleSetting[key];\r\n                    } else {\r\n                        data[key].push(roleSetting[key]);\r\n                    }\r\n                }\r\n            }.bind(this))\r\n\r\n            var denyFlag \u003d false;\r\n            this.getPersonData(person, function (pData) {\r\n                denyFlag \u003d this._hasPermission(data, pData, true)\r\n            }.bind(this));\r\n            if (denyFlag) return false;\r\n        }\r\n\r\n        if (role) {\r\n            var roleList \u003d typeOf(role) \u003d\u003d\u003d \"array\" ? role : [role];\r\n            roleList.each(function (r) {\r\n                var roleSetting \u003d Object.clone(this.Role[r]);\r\n                if (!roleSetting) return;\r\n                for (var key in roleSetting) {\r\n                    if (!data[key]) {\r\n                        data[key] \u003d roleSetting[key];\r\n                    } else {\r\n                        data[key].push(roleSetting[key]);\r\n                    }\r\n                }\r\n            }.bind(this))\r\n\r\n            var flag \u003d false;\r\n            this.getPersonData(person, function (pData) {\r\n                flag \u003d this._hasPermission(data, pData)\r\n            }.bind(this));\r\n            return flag;\r\n        }\r\n\r\n        return true;\r\n\r\n    },\r\n    _hasPermission: function (data, pData, ignoreManager) {\r\n        //data 形如\r\n        // {\r\n        //     roleList : [\"Manager\"],\r\n        //     groupList : [\"积分管理员\",\"行为积分管理员\"],\r\n        //     unitList : [\"开发部\"],\r\n        //     dutyList : [\"公司积分管理员\",\"部门积分管理员\"]\r\n        // }\r\n        if (!ignoreManager) {\r\n            if (!data.roleList) {\r\n                data.roleList \u003d [\"Manager\"];\r\n            } else if (!data.roleList.contains(\"Manager\")) {\r\n                data.roleList.push(\"Manager\");\r\n            }\r\n        }\r\n\r\n        //role\r\n        var flag;\r\n        if (this.isNotEmptyArray(pData.woRoleList) \u0026\u0026 this.isNotEmptyArray(data.roleList)) {\r\n            flag \u003d pData.woRoleList.some(function (item, index) {\r\n                return this.hasAnySame(data.roleList, [item.name, item.unique, item.distinguishedName]);\r\n            }.bind(this));\r\n            if (flag) return true;\r\n        }\r\n\r\n        //group\r\n        if (this.isNotEmptyArray(pData.woGroupList) \u0026\u0026 this.isNotEmptyArray(data.groupList)) {\r\n            flag \u003d pData.woGroupList.some(function (item, index) {\r\n                return this.hasAnySame(data.groupList, [item.name, item.unique, item.distinguishedName]);\r\n            }.bind(this));\r\n            if (flag) return true;\r\n        }\r\n\r\n        //unit\r\n        if (this.isNotEmptyArray(pData.woIdentityList) \u0026\u0026 this.isNotEmptyArray(data.unitList)) {\r\n            flag \u003d pData.woIdentityList.some(function (item, index) {\r\n                return this.hasAnySame(data.unitList, [item.woUnit.name, item.woUnit.unique, item.woUnit.distinguishedName, item.woUnit.id, item.woUnit.levelName]);\r\n            }.bind(this));\r\n            if (flag) return true;\r\n        }\r\n\r\n        //duty\r\n        if (this.isNotEmptyArray(pData.woIdentityList) \u0026\u0026 this.isNotEmptyArray(data.dutyList)) {\r\n            for (var i \u003d 0; i \u003c pData.woIdentityList.length; i++) {\r\n                var identity \u003d pData.woIdentityList[i];\r\n                flag \u003d identity.woUnitDutyList.some(function (item, index) {\r\n                    return this.hasAnySame(data.dutyList, [item.name, item.unique, item.distinguishedName]);\r\n                }.bind(this));\r\n                if (flag) return true;\r\n            }\r\n        }\r\n\r\n    },\r\n    getSuperUnitByUnitByLevel: function (macro, unit, level) {\r\n        var superUnit \u003d macro.org.listSupUnit(unit, true);\r\n        if (!superUnit) return null;\r\n        var unit;\r\n        superUnit.each(function (u) {\r\n            if (u.level \u003d\u003d level) {\r\n                unit \u003d u;\r\n            }\r\n        }.bind(this));\r\n        return unit;\r\n    },\r\n    listUnitByDuty: function (dutyName, key, person) {\r\n        var unitList \u003d this.listUnitObjectByDuty(dutyName, person);\r\n        var list \u003d [];\r\n        for (var i \u003d 0; i \u003c unitList.length; i++) {\r\n            list.push(unitList[i][key || \"distinguishedName\"])\r\n        }\r\n        return list;\r\n    },\r\n    listUnitObjectByDuty: function (dutyName, person) {\r\n        if (!dutyName) return [];\r\n        if (!person) person \u003d layout.desktop.session.user.distinguishedName;\r\n        var unitList \u003d [];\r\n        var pData \u003d this.getPersonData(person);\r\n        if (this.isNotEmptyArray(pData.woIdentityList)) {\r\n            for (var i \u003d 0; i \u003c pData.woIdentityList.length; i++) {\r\n                var identity \u003d pData.woIdentityList[i];\r\n                for (var j \u003d 0; j \u003c identity.woUnitDutyList.length; j++) {\r\n                    var item \u003d identity.woUnitDutyList[j];\r\n                    if ([item.name, item.unique, item.distinguishedName].contains(dutyName)) {\r\n                        unitList \u003d unitList.concat(item.woUnit)\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return unitList;\r\n    },\r\n    isNotEmptyArray: function (array) {\r\n        if (typeOf(array) !\u003d\u003d \"array\") return false;\r\n        return array.length \u003e 0;\r\n    },\r\n    hasAnySame: function (array1, array2) {\r\n        if (typeOf(array1) !\u003d\u003d \"array\" || typeOf(array2) !\u003d\u003d \"array\") return false;\r\n        for (var i \u003d 0; i \u003c array1.length; i++) {\r\n            for (var j \u003d 0; j \u003c array2.length; j++) {\r\n                if (array1[i] \u003d\u003d array2[j]) {\r\n                    return true;\r\n                }\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n});\r\n\r\nthis.define(\"showMask\", function () {\r\n    var maskNode \u003d $(\"maskNode\");\r\n    if (maskNode) maskNode.setStyle(\"display\", \"\");\r\n}.bind(this));\r\n\r\n\r\n\r\n// if(MWF.APPStatement)MWF.APPStatement.implement({\r\n//     _afterLoaded: function(){\r\n//         if (this.json.queryStatement){\r\n//             if(!!this.json.statementType){\r\n//                 this.loadView();\r\n//             }else if (this.json.queryStatement){\r\n//                 this.loadView();\r\n//             }\r\n//         }\r\n//     }\r\n// })\r\n\r\n\r\n//通过媒体查询检测是否是移动端\r\nthis.checkMediaQuery \u003d () \u003d\u003e {\r\n\r\n    window.setTimeout(() \u003d\u003e {\r\n        // 定义媒体查询条件\r\n        const mediaQuery \u003d window.matchMedia(\u0027only screen and (max-width: 767px)\u0027);\r\n\r\n        // 检查是否满足媒体查询条件\r\n        if( this.form.getApp().appForm.json ){\r\n            if (mediaQuery.matches) {\r\n                layout.mobile \u003d true;\r\n                this.form.getApp().appForm.json.mode \u003d \"Mobile\"\r\n                this.form.getApp().appForm.json.selectorStyle \u003d {\r\n                    style: \"v10_mobile\",\r\n                    tabStyle: \"v10_mobile\",\r\n                    useBreadcrumbs: true,\r\n                    contentUrl: \"../x_component_Selector/$Selector/v10_mobile/selector.html\",\r\n                    categoryUrl: \"../x_component_Selector/$Selector/v10_mobile/category.html\",\r\n                    categoryItemUrl: \"../x_component_Selector/$Selector/v10_mobile/category_item.html\",\r\n                    itemUrl: \"../x_component_Selector/$Selector/v10_mobile/item.html\",\r\n                    useO2Load: true,\r\n                    injectToBody: true\r\n                }\r\n            } else {\r\n                layout.mobile \u003d false;\r\n                this.form.getApp().appForm.json.mode \u003d \"PC\"\r\n                // this.form.getApp().appForm.json.selectorStyle \u003d {\r\n                    \r\n                // }\r\n            }\r\n        }\r\n        \r\n    }, 750);\r\n}\r\n\r\nthis.checkMediaQuery();\r\nthis.form.getApp().appForm.addEvent(\u0027resize\u0027, this.checkMediaQuery);\r\n\r\n",
