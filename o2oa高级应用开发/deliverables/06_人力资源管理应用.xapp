        {
          "id": "df61a601-01f1-4251-9d5a-e45dbbddeb7e",
          "name": "queryEmployeefile",
          "alias": "",
          "format": "script",
          "description": "查询员工档案",
          "query": "cb89936e-864e-45ad-a846-1a2e7713219b",
          "fv": 8.0,
          "executePersonList": [],
          "executeUnitList": [],
          "executeGroupList": [],
          "data": "",
          "scriptText": "var whereList \u003d [\"o.categoryAlias \u003d \u0027employeeInfo\u0027\"];\r\nfunction parseInParam( arr ){\r\n    var ar \u003d arr.map( function(j){ return \"\u0027\" + j + \"\u0027\" })\r\n    return \" (\" + ar.join(\",\") +\")\"\r\n}\r\nif( parameters.salaryUnit ){\r\n    whereList.push( \" o.stringValue03 \u003d \u0027\" + parameters.salaryUnit + \"\u0027\");\r\n}\r\nif( parameters.statusNumber ){\r\n    whereList.push( \" o.longValue01 \u003d \u0027\" + parameters.statusNumber + \"\u0027\");\r\n}\r\nif( parameters.employees ){\r\n    whereList.push( \" o.stringValue01 in \" + parseInParam( parameters.employees )  );\r\n}\r\nvar where \u003d whereList.length ? (\" where \" + whereList.join( \" and \")) : \"\";\r\n\r\nreturn `\r\n    SELECT o.stringValue01 as employee, \r\n        o.stringValue02 as userunique,\r\n        o.stringValue03 as salaryUnit,\r\n        o.stringValue04 as company,\r\n        o.stringValue05 as department,\r\n        o.title as name,\r\n        o.longValue01 as statusNumber,\r\n        o.dateTimeValue01 as boardDate,\r\n        o.dateTimeValue02 as resignationDate\r\n    FROM Document o  ${where}\r\n    `;",
          "countData": "SELECT count(o.id) FROM table o",
