          "data": "",
          "scriptText": "var wheres \u003d [];\r\nif( parameters.draftUnitList ){\r\n    wheres.push( \"( o.draftUnit in \" + parameters.draftUnitList +\")\")\r\n}\r\nif( parameters.draftUnit ){\r\n    wheres.push( \" o.draftUnit \u003d \u0027\" + parameters.draftUnit + \"\u0027\")\r\n}\r\nif( parameters.partyBCompany ){\r\n    if( typeOf( parameters.partyBCompany ) \u003d\u003d\u003d \"array\" ){\r\n        wheres.push( \" o.partyBCompany in \" + parameters.partyBCompany + \"\")\r\n    }else{\r\n        wheres.push( \" o.partyBCompany \u003d \u0027\" + parameters.partyBCompany + \"\u0027\")\r\n    }\r\n}\r\nvar where \u003d wheres.length ? (\" where \" + wheres.join( \" and \")) : \"\";\r\nreturn \"SELECT o.draftUnit, o.partyBCompany, o.workshop FROM salaryDetails o \" + where + \r\n\" group by o.draftUnit, o.draftUnitPY, o.partyBCompany, o.partyBCompanyPY, o.workshop\" +\r\n\" order by o.draftUnitPY asc, o.partyBCompanyPY asc, o.workshop asc\"; ",
          "countData": "SELECT count(o.id) FROM employeeBaseInf o",
