          "data": "",
          "scriptText": "function parseInParam( arr ){\r\n    var ar \u003d arr.map( function(j){ return \"\u0027\" + j + \"\u0027\" })\r\n    return \" (\" + ar.join(\",\") +\")\"\r\n}\r\nvar whereList \u003d [];\r\nif( parameters.numbers ){\r\n    whereList.push( \" o.stringValue02 in \" + parseInParam( parameters.numbers )  );\r\n}\r\nreturn `\r\nSELECT o.id, o.stringValue02 as number FROM Document o where (o.categoryAlias \u003d \u0027hrcontract\u0027 and o.docStatus \u003d \u0027publish\u0027) ${ whereList.length ? ( \u0027 and \u0027 + whereList.join(\u0027 and \u0027) ) : \u0027\u0027}\r\n`",
