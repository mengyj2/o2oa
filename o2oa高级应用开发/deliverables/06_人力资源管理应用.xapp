        {
          "id": "ef9d49b4-e623-4bda-92fc-fd85ce7f2ac6",
          "name": "导出-用工个体费用统计",
          "alias": "exportSalaryDetail_total",
          "format": "jpql",
          "description": "导出-用工个体费用统计",
          "query": "b20993ae-79ee-43ee-a56e-f764a459c520",
          "fv": 8.0,
          "executePersonList": [],
          "executeUnitList": [],
          "executeGroupList": [],
          "data": "select o.name, o.account, o.idNumber, o.draftUnit, o.partyBCompany, o.positionType,\r\n        \r\n        sum(o.postWage) as postWage,\r\n        sum(o.floatingWage) as floatingWage,\r\n        sum(o.overtimeWage) as overtimeWage,\r\n        sum(o.overtimeWage1) as overtimeWage1,\r\n        sum(o.backpay) as backpay,\r\n        sum(o.skillAllowance) as skillAllowance,\r\n        sum(o.startingAllowance) as startingAllowance,\r\n        sum(o.nightAllowance) as nightAllowance,\r\n        sum(o.trafficAllowance) as trafficAllowance,\r\n        sum(o.commuterBusFee) as commuterBusFee,\r\n        sum(o.shiftAllowance) as shiftAllowance,\r\n        \r\n        sum(o.payableWagesSubtotal) as payableWagesSubtotal,\r\n        \r\n        sum(o.performanceBonus) as performanceBonus,\r\n        sum(o.specialPurposeFund) as specialPurposeFund,\r\n        sum(o.quarterlySecurityAwards) as quarterlySecurityAwards,\r\n        sum(o.otherAwards) as otherAwards,\r\n        \r\n        sum(o.missMealAllowance) as missMealAllowance,\r\n        sum(o.expatriateAllowance) as expatriateAllowance,\r\n        sum(o.seaAllowance) as seaAllowance,\r\n        sum(o.travelExpense) as travelExpense,\r\n        sum(o.trainBonus) as trainBonus,\r\n        sum(o.medicalCosts) as medicalCosts,\r\n        sum(o.coolingFee) as coolingFee,\r\n        sum(o.monetaryCompensation) as monetaryCompensation,\r\n        sum(o.laborInsurance) as laborInsurance,\r\n        sum(o.otherWage) as otherWage,\r\n        \r\n        sum(o.pension_c) as pension_c,\r\n        sum(o.pension_refund_c) as pension_refund_c,\r\n        \r\n        sum(o.unemploymentInsurance_c) as unemploymentInsurance_c,\r\n        sum(o.unemploymentInsurance_refund_c) as unemploymentInsurance_refund_c,\r\n\r\n        sum(o.medicalInsurance_c) as medicalInsurance_c,\r\n        sum(o.medicalInsurance_refund_c) as medicalInsurance_refund_c,\r\n        \r\n        sum(o.maternityInsurance_c) as maternityInsurance_c,\r\n        sum(o.maternityInsurance_refund_c) as maternityInsurance_refund_c,\r\n        \r\n        sum(o.workInjuryInsurance_c) as workInjuryInsurance_c,\r\n        sum(o.workInjuryInsurance_refund_c) as workInjuryInsurance_refund_c,\r\n        \r\n        sum(o.housingProvidentFund_c) as housingProvidentFund_c,\r\n        sum(o.housingProvidentFund_refund_c) as housingProvidentFund_refund_c,\r\n        \r\n        sum(o.criticalIllnessInsurance_c) as criticalIllnessInsurance_c,\r\n        sum(o.other_refund_c) as other_refund_c,\r\n        \r\n        sum(o.longTermCareInsurance_c) as longTermCareInsurance_c,\r\n        sum(o.employersLiabilityInsurance_c) as employersLiabilityInsurance_c,\r\n        sum(o.accidentInsurance_c) as accidentInsurance_c,\r\n        \r\n        sum(o.insuranceSubtotal_c) as insuranceSubtotal_c,\r\n\r\n        sum(o.disabilityPension) as disabilityPension,\r\n        sum(o.managementFee) as managementFee,\r\n        \r\n        sum(o.totalFee) as totalFee,\r\n        \r\n        sum(o.comprehensiveTaxes) as comprehensiveTaxes,\r\n        \r\n        sum(o.laborCostsSubtotal_noTax) as laborCostsSubtotal_noTax,\r\n        sum(o.laborCostsSubtotal_includeTax) as laborCostsSubtotal_includeTax,\r\n        \r\n        sum(o.pension_p) as pension_p,\r\n        sum(o.unemploymentInsurance_p) as unemploymentInsurance_p,\r\n        sum(o.medicalInsurance_p) as medicalInsurance_p,\r\n        sum(o.criticalIllnessInsurance_p) as criticalIllnessInsurance_p,\r\n        sum(o.housingProvidentFund_p) as housingProvidentFund_p,\r\n        sum(o.pension_refund_p) as pension_refund_p,\r\n        sum(o.unemploymentInsurance_refund_p) as unemploymentInsurance_refund_p,\r\n        sum(o.medicalInsurance_refund_p) as medicalInsurance_refund_p,\r\n        sum(o.housingProvidentFund_refund_p) as housingProvidentFund_refund_p,\r\n        sum(o.other_refund_p) as other_refund_p,\r\n        sum(o.insuranceSubtotal_p) as insuranceSubtotal_p,\r\n        sum(o.taxableWages) as taxableWages,\r\n        sum(o.personalIncomeTaxRefund) as personalIncomeTaxRefund,\r\n        sum(o.specialAdditionalDeduction) as specialAdditionalDeduction,\r\n        sum(o.taxDeductionsWages) as taxDeductionsWages,\r\n        sum(o.withholding) as withholding,\r\n        sum(o.actualWages) as actualWages\r\n\r\n\r\nFROM salaryDetails o where o.managementFee \u003e 0\r\ngroup by o.name, o.account, o.idNumber, o.draftUnit, o.partyBCompany, o.positionType, o.draftUnitPY, o.partyBCompanyPY\r\norder by o.draftUnitPY asc, o.partyBCompanyPY asc, o.name asc",
          "countData": "SELECT count(o.id) FROM salaryDetails o",
