        {
          "id": "c2a890d3-5876-4cd8-bcf7-5db0e4b62869",
          "name": "统计_按季度获取",
          "alias": "salaryMonthStat_forYear",
          "format": "jpql",
          "description": "salaryMonthStat_forYear",
          "query": "b20993ae-79ee-43ee-a56e-f764a459c520",
          "fv": 8.0,
          "executePersonList": [],
          "executeUnitList": [],
          "executeGroupList": [],
          "data": "select o.quarter as quarter,\n    sum(o.serviceFee_hasTax) as serviceFee_hasTax,\n    sum(o.subTotal + o.disabilityPension + o.managementFee + o.comprehensiveTax) as subTotal_salary,\n    sum(o.subTotal_c) as subTotal_insurance,\n    sum(o.pension_c) as pension_insurance,\n    sum(o.medicalInsurance_c + o.maternityInsurance_c + o.longTermCareInsurance_c) as medical_insurance,\n    sum(o.workInjuryInsurance_c + o.criticalIllnessInsurance_c) as workInjury_insurance,\n    sum(o.unemploymentInsurance_c + o.housingProvidentFund_c + o.employersLiabilityInsurance_c+\n        o.accidentInsurance_c + o.disabilityPension\n    ) as other_insurance\nFROM salaryMonthStat o\ngroup by o.quarter\norder by o.quarter asc",
          "countData": "SELECT count(o.id) FROM salaryMonthStat o",
