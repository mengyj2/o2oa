          "sqlScriptText": "var wheres \u003d [];\r\nif( parameters.year ){\r\n    wheres.push( \" xyear \u003d \u0027\" + parameters.year + \"\u0027\")\r\n}\r\nif( parameters.unitUnique ){\r\n    wheres.push( \" xunitUnique \u003d \u0027\" + parameters.unitUnique + \"\u0027\")\r\n}\r\nif( parameters.company ){\r\n    wheres.push( \" xcompany like \u0027%\" + parameters.company + \"%\u0027\")\r\n}\r\nif( parameters.unitName ){\r\n    wheres.push( \" xunitName like \u0027%\" + parameters.unitName + \"%\u0027\")\r\n}\r\nif( parameters.monthRange ){\r\n    wheres.push( \" xmonth in \"+ parameters.monthRange )\r\n}\r\n// if( parameters.dimissionYear ){\r\n//     wheres.push( \" o.dimissionTime \u003e\u003d {ts \u0027\"+parameters.dimissionYear+\"-01-01 00:00:00\u0027}\");\r\n//     wheres.push( \" o.dimissionTime \u003c\u003d {ts \u0027\"+parameters.dimissionYear+\"-12-31 23:59:59\u0027}\");\r\n// }\r\nvar where \u003d wheres.length ? (\" where \" + wheres.join( \"and \")) : \"\";\r\n\r\nvar sql \u003d \u0027SELECT xmonth as \"month\", xcompany as \"unit\", sum(xserviceFee_hasTax) as \"fee\", sum(xserviceFee_noTax) as \"notaxfee\"  \u0027+\r\n\u0027 FROM QRY_DYN_SALARYMONTHSTAT \u0027+ where +\r\n\u0027 GROUP BY xcompany, xmonth\u0027;\r\n\r\nreturn sql;",
          "sqlCount": "SELECT count(id) FROM table",
