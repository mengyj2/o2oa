\\\\\\\").setData(doc.id);\\\\n            this.form.get(\\\\\\\"birthday\\\\\\\").setData( d.birthday );\\\\n            this.form.get(\\\\\\\"genderType\\\\\\\").setData( d.genderType );\\\\n            this.form.get(\\\\\\\"age\\\\\\\").setData( O2Common.getAge(d.birthday) );\\\\n            this.form.get(\\\\\\\"highestEducation\\\\\\\").setData( d.highestEducation );\\\\n            this.form.get(\\\\\\\"highestEducationNumber\\\\\\\").setData( d.highestEducationNumber );\\\\n            this.form.get(\\\\\\\"boardDate\\\\\\\").setData( d.boardDate );\\\\n            this.form.get(\u0027department\u0027).setData(this.org.listUnitWithPerson(employee))\\\\n        }\\\\n    }.bind(this))\\\\n}\\\"}},\\\"includeScripts\\\":[{\\\"appType\\\":\\\"process\\\",\\\"type\\\":\\\"script\\\",\\\"name\\\":\\\"form_style_init.js\\\",\\\"alias\\\":\\\"form_style_init.js\\\",\\\"id\\\":\\\"fa713b5a-3b15-4dd2-8278-046d201cf60a\\\",\\\"appName\\\":\\\"公共资源\\\",\\\"appId\\\":\\\"003237d5-d11a-43f0-9a03-0d8887df0d2d\\\",\\\"application\\\":\\\"003237d5-d11a-43f0-9a03-0d8887df0d2d\\\"},{\\\"appType\\\":\\\"portal\\\",\\\"type\\\":\\\"script\\\",\\\"name\\\":\\\"通用脚本\\\",\\\"alias\\\":\\\"common\\\",\\\"id\\\":\\\"ea219abd-115b-42ea-92b7-8f3e2af2d040\\\",\\\"appName\\\":\\\"人力资源管理\\\",\\\"appId\\\":\\\"f7186604-c886-4341-9fc8-bdbf5a55afbd\\\"}],\\\"category\\\":\\\"离职\\\",\\\"description\\\":\\\"员工发起\\\",\\\"properties\\\":{\\\"class\\\":\\\"form-layout\\\"},\\\"isReadonly\\\":false,\\\"cssLink\\\":\\\"../x_component_process_FormDesigner/Module/Form/skin/styles_v10.css\\\",\\\"styleConfig\\\":{\\\"name\\\":\\\"v10\\\",\\\"file\\\":\\\"styles_v10.json\\\",\\\"extendFile\\\":\\\"styles_v10_extend.json\\\",\\\"mode\\\":[\\\"pc\\\",\\\"mobile\\\"]},\\\"textareaDisableResize\\\":true,\\\"confirmStyle\\\":\\\"v10_confirm\\\",\\\"dialogStyle\\\":\\\"v10\\\",\\\"hideModuleIcon\\\":true,\\\"nodeStyleWithhideModuleIcon\\\":{\\\"margin-right\\\":\\\"0px\\\"},\\\"confirmIcon\\\":{\\\"success\\