          "data": "SELECT o FROM salaryDetails o order by o.month desc, o.draftUnitPY asc, O.partyBCompanyPY asc, o.name asc",
          "scriptText": "if( parameters.positionType \u003d\u003d\u003d \u0027其他\u0027 ){\r\n    return \"SELECT o FROM salaryDetails o where o.idNumber\u003d:idNumber and ( (o.positionType is null) or (o.positionType \u003d \u0027\u0027) ) order by o.month desc,o.company asc, o.unit asc, o.name asc\"\r\n}else{\r\n    return \"SELECT o FROM salaryDetails o where o.idNumber\u003d:idNumber order by o.month desc, o.company asc, o.unit asc, o.name asc\"\r\n}\r\n",
          "countData": "SELECT count(o.id) FROM salaryDetails o",
