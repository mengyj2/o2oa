              "beforeExecuteScriptText": "",
              "afterExecuteScript": "",
              "afterExecuteScriptText": "",
              "beforeInquireScript": "",
              "beforeInquireScriptText": "",
              "afterInquireScript": "",
              "afterInquireScriptText": "",
              "allowReroute": true,
              "allowRerouteTo": false,
              "route": "a875a7ea-23a4-4040-8275-024591f16892",
              "script": "",
              "scriptText": "// if( this.data.associatedDocument \u0026\u0026 this.data.associatedDocument.targetBundle ){\r\n//     this.Actions.load(\u0027x_cms_assemble_control\u0027).DataAction.updateWithDocument(this.data.associatedDocument.targetBundle, {\r\n//         status: \u0027\u0027\r\n//     })\r\n// }\r\n\r\nvar fields \u003d {\r\n    type: \u0027type\u0027,\r\n    number: \u0027number\u0027,\r\n    position: \u0027position\u0027,\r\n    limitType: \u0027limitType\u0027,\r\n    start: \u0027renewalStartDate\u0027,\r\n    end: \u0027renewalEndDate\u0027,\r\n    employmentType: \u0027employmentType\u0027,\r\n    unit: \u0027department\u0027,\r\n    explain: \u0027explain\u0027,\r\n    // person: \u0027personDn\u0027,\r\n    employee: \u0027employee\u0027\r\n}\r\nvar data \u003d {};\r\nObject.each(fields, (source, target)\u003d\u003e{\r\n    data[target] \u003d this.data[source];\r\n})\r\ndata.name \u003d this.data.personDn.split(\u0027@\u0027)[0];\r\ndata.person \u003d [this.data.personDn];\r\ndata.subject \u003d data.name+\u0027的人事合同\u0027;\r\nif( data.limitType \u003d\u003d\u003d \u0027无固定期限合同\u0027 ){\r\n    data.status \u003d \u0027执行中\u0027\r\n}else{\r\n    if( new Date(data.start) \u003c new Date() \u0026\u0026 new Date(data.end) \u003e new Date() ){\r\n        data.status \u003d \u0027执行中\u0027\r\n    }else{\r\n        data.status \u003d \u0027待执行\u0027\r\n    }\r\n}\r\n\r\nvar json \u003d this.Actions.load(\u0027x_cms_assemble_control\u0027).DocumentAction.persist_publishContent({\r\n    identity: this.data.$work.creatorIdentityDn || this.data.$work.creatorIdentity,\r\n    categoryId: \u0027ec2e4741-763f-40c9-9b25-8c00a88667aa\u0027,\r\n    title: data.subject,\r\n    docData: data,\r\n    wf_jobId:this.data.$work.job,\r\n    wf_workId:this.data.$work.workId || this.data.$work.workCompletedId,\r\n    wf_attachmentIds: this.data.$attachmentList.filter((d)\u003d\u003e{return d.site\u003d\u003d\u003d\u0027contractFile\u0027}).map((d)\u003d\u003e{return d.id})\r\n})\r\n\r\n// var documentData \u003d {\r\n//     \"siteFileInfoList\" : [{\u0027site\u0027:\u0027attachment\u0027,\u0027type\u0027:\u0027processPlatform\u0027,\u0027fileInfoList\u0027: this.data.$attachmentList.filter(\r\n//         (d)\u003d\u003e{return d.site\u003d\u003d\u003d\u0027contractFile\u0027}\r\n//     ).map(\r\n//         (d)\u003d\u003e{return {\u0027id\u0027:d.id,\u0027name\u0027:d.name}}\r\n//     )}]\r\n// }\r\n// this.Actions.load(\u0027x_cms_assemble_control\u0027).DocumentAction.updateDocument(json.data.id, documentData);\r\n\r\n\r\nvar _self \u003d this;\r\nthis.view.lookup({\r\n    \u0027application\u0027: \u0027employeeManager\u0027,\r\n    \u0027view\u0027: \u0027hrcontract-wait-completed\u0027\r\n}, function(data){\r\n\r\n    var grid \u003d data.grid; //得到过滤后的数据\r\n    grid.each(function(d){\r\n        _self.Actions.load(\u0027x_cms_assemble_control\u0027).DataAction.updateWithDocument(d.bundle, {\r\n            status: \u0027结束\u0027\r\n        })\r\n    })\r\n})\r\n\r\n// this.view.lookup({\r\n//     \u0027application\u0027: \u0027employeeManager\u0027,\r\n//     \u0027view\u0027: \u0027hrcontract-wait-start\u0027\r\n// }, function(data){\r\n\r\n//      var grid \u003d data.grid; //得到过滤后的数据\r\n//      grid.each(function(d){\r\n//         _self.Actions.load(\u0027x_cms_assemble_control\u0027).DataAction.updateWithDocument(d.bundle, {\r\n//             status: \u0027执行中\u0027\r\n//         })\r\n//      })\r\n// })\r\n",
              "edition": "CB56CCD5770000017E19AE0090741A66",
              "properties": {},
              "createTime": "2026-09-21 16:01:12",
              "updateTime": "2026-09-26 00:41:53"
            }
