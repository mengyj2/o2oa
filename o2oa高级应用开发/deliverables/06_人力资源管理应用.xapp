          "scriptText": "var whereList \u003d [];\r\nif( parameters.personDn ){\r\n    whereList.push( `( o.stringValue01 \u003d \u0027${parameters.personDn}\u0027 )` );\r\n}\r\nif( parameters.start ){\r\n    const start \u003d `{d \u0027${parameters.start}\u0027}`;\r\n    const end \u003d `{d \u0027${parameters.end}\u0027}`;\r\n    whereList.push( ` ( ( o.dateTimeValue01 \u003e\u003d ${start} and o.dateTimeValue01 \u003c\u003d ${end} ) \r\n        or ( o.dateTimeValue02 \u003e\u003d ${start} and o.dateTimeValue02 \u003c\u003d ${end} )\r\n        or ( o.dateTimeValue01 \u003c\u003d ${start} and o.dateTimeValue02 \u003e\u003d ${end} ) ) ` \r\n    )\r\n}\r\nreturn `\r\nSELECT o.id FROM Document o where (o.categoryAlias \u003d \u0027hrcontract\u0027  and o.docStatus \u003d \u0027publish\u0027) ${ whereList.length ? ( \u0027 and \u0027 + whereList.join(\u0027 and \u0027) ) : \u0027\u0027}\r\n`",
