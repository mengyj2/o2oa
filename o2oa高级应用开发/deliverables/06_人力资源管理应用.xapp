      table.deleteRow( list[i].data.id, null, null, false );\\r\\n        }\\r\\n        \\r\\n        var closeDlg \u003d function(){\\r\\n            _self.target.view.reload();\\r\\n            _self.form.notice(\\\"删除成功\\\", \\\"success\\\", null)\\r\\n            this.close();\\r\\n        }.bind(this)\\r\\n        \\r\\n        var monthUnitMap \u003d {};\\r\\n        list.each(function(item){\\r\\n            var d \u003d item.data;\\r\\n            if( !monthUnitMap[d.month] )monthUnitMap[d.month] \u003d [];\\r\\n            var unitList \u003d monthUnitMap[d.month];\\r\\n            if( !unitList.contains(d.draftUnitDn) ){\\r\\n               unitList.push( d.draftUnitDn );\\r\\n            }\\r\\n        })\\r\\n        var ps2 \u003d [];\\r\\n        for( var month in monthUnitMap ){\\r\\n            monthUnitMap[month].each(function(u){\\r\\n                var p \u003d env.createSalaryMonthData( month, null, u, true );\\r\\n                ps2.push(p);\\r\\n            })\\r\\n        }\\r\\n        Promise.all(ps2).then(function(){\\r\\n            closeDlg();\\r\\n        })\\r\\n        \\r\\n       \\r\\n    }, function(){\\r\\n        this.close();\\r\\n    });\\r\\n}else{\\r\\n    this.form.notice(\\\"请选择要删除工资条目\\\", \\\"info\\\", null); //, {\\\"x\\\": \\\"center\\\", \\\"y\\\": \\\"center\\\"}\\r\\n}\",\"condition\":\"\",\"editShow\":true,\"readShow\":true,\"customImg\":true},{\"type\":\"MWFToolBarButton\",\"img\":\"123.png\",\"title\":\"按搜索条件删除\",\"action\":\"\",\"text\":\"按搜索条件删除\",\"actionScript\":\"var p \u003d this.queryStatement.getParentEnvironment();\\np.deleteByCondition()\",\"condition\":\"\",\"editShow\":true,\"readShow\":true,\"customImg\":true},{\"type\":\"MWFToolBarButton\",\"img\":\"export.png\",\"title\":\"{{$.lp.exportExcel}}\",\"action\":\"exportView\",\"text\":\"{{$.lp.exportExcel}}\",\"id\":\"action_export\",\"condition\":\"\",\"read\":true,\"system\":true}],\"vid\":\"ef9d49b4-e623-4bda-92fc-fd85ce7f2ac6_view\",\"pid\":\"ef9d