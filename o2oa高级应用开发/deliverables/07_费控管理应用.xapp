ht: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e挂起恢复\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"file_download\\\\\\\" title\u003d\\\\\\\"一键下载\\\\\\\" mwfbuttonaction\u003d\\\\\\\"downloadAll\\\\\\\" mwfbuttontext\u003d\\\\\\\"一键下载\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-file_download\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e一键下载\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"work-management\\\\\\\" title\u003d\\\\\\\"流程监控\\\\\\\" mwfbuttonaction\u003d\\\\\\\"monitor\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程监控\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 1px solid var(--oo-color-main); color: rgb(255, 255, 255); background-color: var(--oo-color-main); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(204, 204, 204) 0px 0px 10px 1px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: poin