          "data": "{\\\"json\\\":{\\\"id\\\":\\\"e5cb5a29-bf24-423b-b32a-028732743af0\\\",\\\"name\\\":\\\"费控管理\\\",\\\"type\\\":\\\"Form\\\",\\\"mode\\\":\\\"PC\\\",\\\"description\\\":\\\"\\\",\\\"application\\\":\\\"0c100445-8c40-4d05-a160-43c4956e555a\\\",\\\"applicationName\\\":\\\"费控管理\\\",\\\"styles\\\":{\\\"background-color\\\":\\\"#f7f7f7\\\",\\\"height\\\":\\\"100%\\\",\\\"overflow\\\":\\\"hidden auto\\\"},\\\"properties\\\":{\\\"class\\\":\\\"form-layout\\\",\\\"data-no-dragging\\\":\\\"true\\\"},\\\"cssLinks\\\":[],\\\"scriptSrc\\\":[],\\\"jsheader\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"events\\\":{\\\"queryLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"beforeLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"beforeModulesLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"afterModulesLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"postLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"load\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"afterLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"beforeClose\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"help\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"unload\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"click\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"dblclick\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"keydown\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"keypress\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"keyup\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mousedown\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mousemove\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mouseout\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mouseover\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mouseup\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"focus\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"blur\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"submit\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"reset\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"}},\\\"moduleList\\\":{\\\"widget\\\":{\\\"id\\\":\\\"widget\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"Widget\\\",\\\"description\\\":\\\"\\\",\\\"events\\\":{\\\"queryLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"postLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"load\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"beforeModulesLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"modulesLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"afterModulesLoad\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"click\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"dblclick\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"keydown\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"keypress\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"keyup\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mousedown\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mousemove\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mouseout\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mouseover\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"mouseup\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"focus\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"blur\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"}},\\\"properties\\\":{},\\\"class\\\":\\\"\\\",\\\"styles\\\":{\\\"flex\\\":\\\"1\\\"},\\\"container\\\":\\\"\\\",\\\"recoveryStyles\\\":null,\\\"isSaved\\\":true,\\\"pid\\\":\\\"PCe5cb5a29-bf24-423b-b32a-028732743af0widget\\\",\\\"widgetType\\\":\\\"select\\\",\\\"isDelay\\\":false,\\\"parameterType\\\":\\\"script\\\",\\\"hideCannotRead\\\":\\\"inherit\\\",\\\"widgetScript\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"parametersScript\\\":{\\\"code\\\":\\\"const menu \u003d this.page.getApp().options.menu;\\\\r\\\\nreturn {\\\\r\\\\n\\\\t\\\\\\\"type\\\\\\\": \\\\\\\"portal\\\\\\\",\\\\r\\\\n\\\\t\\\\\\\"application\\\\\\\": \\\\\\\"费控管理\\\\\\\",\\\\r\\\\n\\\\t\\\\\\\"name\\\\\\\": \\\\\\\"appNavi_expense\\\\\\\",\\\\r\\\\n\\\\t\\\\\\\"title\\\\\\\": \\\\\\\"费控管理\\\\\\\",\\\\r\\\\n\\\\t\\\\\\\"createText\\\\\\\": \\\\\\\"新建工作\\\\\\\",\\\\r\\\\n\\\\t\\\\\\\"createApplication\\\\\\\": \\\\\\\"费控管理\\\\\\\",\\\\r\\\\n\\\\t\\\\\\\"createProcess\\\\\\\": \\\\\\\"\\\\\\\",\\\\r\\\\n    menu\\\\r\\\\n}\\\",\\\"html\\\":\\\"\\\"},\\\"readByScriptValue\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"widgetAppSelected\\\":\\\"441f59d9-ebda-49f6-a3b8-2a7992825738\\\",\\\"widgetSelected\\\":\\\"5589eadd-a9ee-4057-ab6c-ded716d88379\\\",\\\"parametersMapList\\\":{\\\"type\\\":\\\"portal\\\",\\\"application\\\":\\\"公文管理\\\",\\\"name\\\":\\\"appNavi\\\",\\\"title\\\":\\\"公文管理\\\"},\\\"moduleName\\\":\\\"widget\\\"}},\\\"fieldList\\\":{},\\\"css\\\":{\\\"code\\\":\\\"/* :root {\\\\r\\\\n    --oo-color-main: #60bf78;\\\\r\\\\n    --oo-color-main-light: #6fd088;\\\\r\\\\n    --oo-color-main-deep: #58b971;\\\\r\\\\n    --oo-color-over: #cefada;\\\\r\\\\n    --oo-color-deep: #053311;\\\\r\\\\n    --oo-color-light: #F7FFF9;\\\\r\\\\n    --oo-color-hover: #f6fff8;\\\\r\\\\n    --oo-color-icon: #9293A6;\\\\r\\\\n} */\\\\r\\\\n\\\\r\\\\n/* :root {\\\\r\\\\n    --oo-color-main: #d94141;\\\\r\\\\n    --oo-color-main-light: #e35454;\\\\r\\\\n    --oo-color-main-deep: #c53333;\\\\r\\\\n    --oo-color-over: #f8e3e3;\\\\r\\\\n    --oo-color-deep: #400606;\\\\r\\\\n    --oo-color-light: #FFF7F7;\\\\r\\\\n    --oo-color-hover: #FFF7F7;\\\\r\\\\n    --oo-color-icon: #a69292;\\\\r\\\\n    --oo-color-hover2: #fce3e3;\\\\r\\\\n    --oo-color-odd-even: #FAFAFA;\\\\r\\\\n} */\\\\r\\\\n\\\\r\\\\n/* :root {\\\\r\\\\n    --oo-color-main: #232f3e;\\\\r\\\\n    --oo-color-main-light: #545B64;\\\\r\\\\n    --oo-color-main-deep: #121923;\\\\r\\\\n    --oo-color-over: #e7eaec;\\\\r\\\\n    --oo-color-deep: #1e2a38;\\\\r\\\\n    --oo-color-light: #f3f4f5;\\\\r\\\\n    --oo-color-hover: #ededef;\\\\r\\\\n    --oo-color-icon: #9293A6;\\\\r\\\\n    --oo-color-hover2: #ededef;\\\\r\\\\n    --oo-color-odd-even: #FAFAFA;\\\\r\\\\n} */\\\\r\\\\n\\\\r\\\\n.ooicon-create {\\\\r\\\\n    background-color: var(--oo-color-deep);\\\\r\\\\n    border-radius: 100%;\\\\r\\\\n    height: 3em;\\\\r\\\\n    width: 3em;\\\\r\\\\n    opacity: 0.1;\\\\r\\\\n    color: var(--oo-color-text-white);\\\\r\\\\n    position: absolute;\\\\r\\\\n    right: 1em;\\\\r\\\\n    bottom: 1em;\\\\r\\\\n    display: flex !important;\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: center;\\\\r\\\\n    cursor: pointer;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n    transition: opacity 0.3s;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.ooicon-create:hover {\\\\r\\\\n    opacity: 0.8;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 自定义布局样式 *************************/\\\\r\\\\n.page-custom-layout {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 60em;\\\\r\\\\n    right: -60em;\\\\r\\\\n    padding: 2em;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n.page-custom-layout-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 30em;\\\\r\\\\n    right: -30em;\\\\r\\\\n    padding: 2em 0;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.page-custom-widget-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n.page-custom-title {\\\\r\\\\n    display: flex;\\\\r\\\\n    font-size: 1.125rem;\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: space-between;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close:hover {\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-description {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-area {\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n    position: relative;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category {\\\\r\\\\n    /* border-left: 0.25rem solid var(--oo-color-main); */\\\\r\\\\n    background-color: var(--oo-color-bg-white);\\\\r\\\\n    padding: 1em 0;\\\\r\\\\n    gap: 0.5em;\\\\r\\\\n    display: flex;\\\\r\\\\n    align-items: center;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:first-child {\\\\r\\\\n    font-size: 1.125em;\\\\r\\\\n    font-weight: bold;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-category\u003ediv:last-child {\\\\r\\\\n    transform: rotate(90deg);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item-area {\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    gap: 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item {\\\\r\\\\n    border-radius: var(--oo-default-radius);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n.add-widget-item:hover .title {\\\\r\\\\n    color: var(--oo-color-main);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.add-widget-item .tit