        {
          "id": "ba74a268-e0f3-415b-bce5-1d7d2d9471b3",
          "name": "flowEvent",
          "alias": "flowEvent",
          "description": "",
          "validated": true,
          "application": "2b9622c0-ac9d-46ac-bcad-4ff55bd001a5",
          "text": "this.define(\"getRole\",function(key){\r\n    var dataList \u003d new _self.Dict({\r\n        type: \"portal\",\r\n        application: \"expense\",\r\n        name: \"expense\"\r\n    });\r\n    var data ;\r\n\r\n    dataList.get(\"role\").each(function(d){\r\n        if(d.key \u003d\u003d\u003d key){\r\n            data \u003d d;\r\n        }\r\n    })\r\n    return data.items;\r\n}.bind(this));\r\n\r\n\r\nthis.define(\"fixNumber\",function(number){\r\n    return Math.round(number * 100) / 100;\r\n})\r\n\r\n//更新预算\r\n\r\nthis.define(\"updateBudget\",function(){\r\n    var action \u003d o2.Actions.load(\"x_program_center\");\r\n\r\n    action.InvokeAction.execute(\"expense_process\", {\r\n        \"fun\": \"remove\",\r\n        \"data\": {\r\n            \"serial\": this.data.serial\r\n        }\r\n    },function (json) {\r\n\r\n    }.bind(this),null,false);\r\n\r\n    var queryAction \u003d this.Actions.load(\"x_query_assemble_surface\");\r\n\r\n    //记录报销\r\n    if(this.form.get(\"datatable\")){\r\n\r\n        this.data.datatable.data.each(function(d){\r\n\r\n\r\n            //记录费用使用明细\r\n            queryAction.TableAction.rowInsert(\"expenseBudget\",{\r\n                \"id\" : d.uuid,\r\n                \"job\": this.data.$work.job,\r\n                \"documentId\": d.documentId,\r\n                \"budget\": d.budget,\r\n                \"budgetCode\": d.budgetCode,\r\n                \"budgetDept\": d.budgetDept,\r\n                \"budgetDeptCode\": d.budgetDeptCode,\r\n                \"money\": d.money,\r\n                \"purpose\": d.purpose,\r\n                \"jobTime\": this.data.$work.startTime,\r\n                \"processName\": this.data.$work.processName,\r\n                \"person\": this.data.$work.creatorPerson,\r\n                \"department\": this.data.$work.creatorUnit,\r\n                \"serial\" : this.data.$work.serial\r\n            },function( json ){\r\n\r\n            }.bind(this),null,false);\r\n\r\n\r\n            //更新预算\r\n            action.InvokeAction.execute(\"expense_process\", {\r\n                \"fun\": \"update\",\r\n                \"data\": {\r\n                    \"documentId\": d.documentId\r\n                }\r\n            },function (json) {\r\n\r\n            }.bind(this));\r\n\r\n        }.bind(this));\r\n\r\n\r\n    }\r\n\r\n\r\n    //记录还款\r\n    if(this.form.get(\"datatable_loan\")){\r\n        this.data.datatable_loan.data.each(function(d){\r\n\r\n            //记录费用使用明细\r\n            queryAction.TableAction.rowInsert(\"expenseBudget\",{\r\n                \"id\" : d.loanUUID,\r\n                \"job\": this.data.$work.job,\r\n                \"documentId\": d.budgetDocumentId,\r\n                \"budget\": d.loanBudget,\r\n                \"loanNumber\" : d.loanNumber,\r\n                \"budgetCode\": d.loanBudgetCode,\r\n                \"budgetDept\": d.loanBudgetDept,\r\n                \"budgetDeptCode\": d.loanBudgetDeptCode,\r\n                \"money\": this.fixNumber(d.loanCurAmount)*-1,\r\n                \"purpose\": \"还款\",\r\n                \"jobTime\": this.data.$work.startTime,\r\n                \"processName\": this.data.$work.processName,\r\n                \"person\": this.data.$work.creatorPerson,\r\n                \"department\": this.data.$work.creatorUnit,\r\n                \"serial\" : this.data.$work.serial\r\n            },function( json ){\r\n\r\n            }.bind(this),null,false);\r\n\r\n\r\n            //更新预算\r\n            action.InvokeAction.execute(\"expense_process\", {\r\n                \"fun\": \"update\",\r\n                \"data\": {\r\n                    \"documentId\": d.budgetDocumentId\r\n                }\r\n            },function (json) {\r\n\r\n            }.bind(this));\r\n\r\n            // //更新借款已还款\r\n            action.InvokeAction.execute(\"expense_process\", {\r\n                \"fun\": \"updateLoan\",\r\n                \"data\": {\r\n                    \"loanId\": d.loanId\r\n                }\r\n            },function (json) {\r\n\r\n            }.bind(this));\r\n\r\n            \r\n            // //更新借款已还款\r\n\r\n            // queryAction.TableAction.rowGet(\"expenseBudget\",d.loanId,function( json ){\r\n            //     json.data.useMoney \u003d json.data.useMoney?json.data.useMoney + d.loanCurAmount : d.loanCurAmount\r\n            //     queryAction.TableAction.rowUpdate(\"expenseBudget\",d.loanId,json.data,function( json ){\r\n\r\n            //     }.bind(this),null,false);            \r\n            // }.bind(this),null,false);\r\n\r\n        }.bind(this));\r\n    }\r\n\r\n\r\n\r\n}.bind(this));\r\n\r\n//还原预算\r\nthis.define(\"removeBudget\",function(){\r\n    var action \u003d o2.Actions.load(\"x_program_center\");\r\n\r\n    action.InvokeAction.execute(\"expense_process\", {\r\n        \"fun\": \"remove\",\r\n        \"data\": {\r\n            \"serial\": this.data.serial\r\n        }\r\n    },function (json) {\r\n\r\n    }.bind(this),null,false);\r\n\r\n    //记录报销\r\n    if(this.form.get(\"datatable\")){\r\n\r\n        this.data.datatable.data.each(function(d){\r\n\r\n            //更新预算\r\n            action.InvokeAction.execute(\"expense_process\", {\r\n                \"fun\": \"update\",\r\n                \"data\": {\r\n                    \"documentId\": d.documentId\r\n                }\r\n            },function (json) {\r\n\r\n            }.bind(this));\r\n\r\n        }.bind(this));\r\n\r\n    }\r\n\r\n\r\n    //记录还款\r\n    if(this.form.get(\"datatable_loan\")){\r\n        this.data.datatable_loan.data.each(function(d){\r\n\r\n            //更新预算\r\n            action.InvokeAction.execute(\"expense_process\", {\r\n                \"fun\": \"update\",\r\n                \"data\": {\r\n                    \"documentId\": d.budgetDocumentId\r\n                }\r\n            },function (json) {\r\n\r\n            }.bind(this));\r\n\r\n            // //更新借款已还款\r\n            action.InvokeAction.execute(\"expense_process\", {\r\n                \"fun\": \"updateLoan\",\r\n                \"data\": {\r\n                    \"loanId\": d.loanId\r\n                }\r\n            },function (json) {\r\n\r\n            }.bind(this));\r\n\r\n        }.bind(this));\r\n    }\r\n\r\n\r\n\r\n}.bind(this));\r\n\r\n//检查发票\r\nthis.define(\u0027checkInvioce\u0027, function(){\r\n    \r\n    if( [\u0027draft\u0027,\u0027verify\u0027].contains(this.workContext.getWork().activityAlias) ){\r\n        if( [\u0027请审核\u0027, \u0027完成\u0027].contains(this.form.currentRouteName) ){\r\n            const job \u003d this.workContext.getWork().job;\r\n            var invoiceList \u003d this.form.get(\u0027datatable_invoice\u0027).getData().data;\r\n            if( invoiceList \u0026\u0026 invoiceList.length ){\r\n                var errorList \u003d [];\r\n                invoiceList.each((d)\u003d\u003e{\r\n                    \r\n                    o2.Actions.load(\u0027x_processplatform_assemble_surface\u0027).AttachmentAction.getInvoiceInfo(d.id,job, function(json){\r\n                        if( json.data.applyStatus \u003d\u003d\u003d \u0027已报销\u0027 ){\r\n                            errorList.push( d.detail + \u0027[\u0027+d.number+\u0027]\u0027 + \u0027已报销。\u0027 );\r\n                        }\r\n                    }, function(xhr){\r\n                        let result;\r\n                        try{\r\n                            result \u003d JSON.parse(xhr.responseText);\r\n                        }catch (e) {\r\n                            result \u003d {message: xhr.responseText};\r\n                        }\r\n                        errorList.push( d.detail + \u0027[\u0027+d.number+\u0027]\u0027 + result.message + \u0027。\u0027 );\r\n                    }, false);\r\n                });\r\n                return errorList.length ? errorList.join(\"\") : true;\r\n            }else{\r\n                return true;\r\n            }\r\n        }else{\r\n            return true;\r\n        }\r\n    }else{\r\n        return true;\r\n    }\r\n}.bind(this));\r\n\r\n//结束发送ws消息\r\n\r\nthis.define(\"sendMessage\",function(){\r\n\r\n    var data \u003d {\r\n        \"type\" : \"custom_create\",\r\n        \"person\" : this.data.$work.creatorPerson,\r\n        \"title\" : \"您提交的《\"+this.data.$work.processName+\"》已审批完成，请及时关注。\",\r\n        \"body\" : {}\r\n    }\r\n    var action \u003d this.Actions.load(\"x_message_assemble_communicate\");\r\n    action.WsAction.create(data,function( json ){\r\n        data \u003d json.data;\r\n    }.bind(this),null,false);\r\n\r\n}.bind(this));\r\n\r\n\r\n(function(){\r\n\r\n    this.form.addEvent(\"beforeProcess\", function(){\r\n        if(this.form.currentRouteName \u003d\u003d\u003d \"退回\"){\r\n            this.removeBudget();\r\n        }        \r\n    }.bind(this))\r\n    \r\n     this.form.addEvent(\"afterRetract\", function(){\r\n\r\n        this.removeBudget();\r\n        \r\n    }.bind(this))\r\n\r\n     this.form.addEvent(\"afterProcess\", function(){\r\n\r\n        if(this.form.currentRouteName \u003d\u003d\u003d \"结束\"){\r\n            this.updateBudget();\r\n            this.sendMessage();\r\n        }\r\n\r\n    }.bind(this))\r\n\r\n}.bind(this))()\r\n\r\n",
          "dependScriptList": [],
          "creatorPerson": "admin@0dcf57f4-969c-4da9-912f-3e3b407e1780@P",
          "lastUpdatePerson": "管理员@P00000@P",
          "lastUpdateTime": "2026-03-24 11:19:51",
          "createTime": "2026-09-21 16:01:17",
          "updateTime": "2026-09-21 16:01:17"
        },
        {
          "id": "c3f06f5f-f457-4076-91de-ed96d0a589af",
          "name": "common",
          "alias": "",
          "description": "流程通用方法",
          "validated": true,
          "application": "2b9622c0-ac9d-46ac-bcad-4ff55bd001a5",
          "text": "\nthis.define(\"getDic\",function(){\n    var dataList \u003d new this.Dict({\n        type: \"portal\",\n        application: \"expense\",\n        name: \"expense\"\n    });\n    var data ;\n    dataList.get(\"role\").each(function(d){\n        if(d.key \u003d\u003d\u003d key){\n            data \u003d d;\n        }\n    })\n    return data.items;\n}.bind(this));\n\n\nthis.define(\"fixNumber\",function(number){\n    return Math.round(number * 100) / 100;\n})\n\n//预算使用\nthis.define(\"useBudget\",function(){\n\n    var action \u003d this.Actions.load(\"x_cms_assemble_control\");\n    var queryAction \u003d this.Actions.load(\"x_query_assemble_surface\");\n    this.data.datatable.data.each(function(d){\n        //更新预算已使用费用\n\n        action.DataAction.getWithDocumentPath0(d.documentId,\"datatable\",function( json ){ \n            var datatable \u003d json.data; \n            datatable.data.each(function(item){\n                if(item.code \u003d\u003d\u003d d.budgetCode){\n\n\n                    item.useMoney \u003d this.fixNumber(item.useMoney + d.money)\n                }\n            }.bind(this));\n            \n            datatable.total.useMoney \u003d this.fixNumber(parseFloat(datatable.total.useMoney) + d.money) + \"\";\n            action.DataAction.updateWithDocument(d.documentId,{\n                \"datatable\":datatable,\n                \"usedMoney\":datatable.total.useMoney\n            },function( json ){}.bind(this));\n\n\n        }.bind(this),null,false);\n\n        //记录费用使用明细\n        queryAction.TableAction.rowInsert(\"expenseBudget\",{\n            \"id\" : d.uuid,\n            \"job\": this.data.$work.job,\n            \"documentId\": d.documentId,\n            \"budget\": d.budget,\n            \"budgetCode\": d.budgetCode,\n            \"budgetDept\": d.budgetDept,\n            \"budgetDeptCode\": d.budgetDeptCode,\n            \"money\": d.money,\n            \"purpose\": d.purpose,\n            \"jobTime\": this.data.$work.startTime,\n            \"processName\": this.data.$work.processName,\n            \"person\": this.data.$work.creatorPerson,\n            \"department\": this.data.$work.creatorUnit,\n            \"serial\" : this.data.$work.serial\n        },function( json ){\n\n        }.bind(this),null,false);\n\n    }.bind(this));\n\n}.bind(this));\n\n//还款\nthis.define(\"repaymentBudget\",function(){\n\n    var action \u003d this.Actions.load(\"x_cms_assemble_control\");\n    var queryAction \u003d this.Actions.load(\"x_query_assemble_surface\");\n    this.data.datatable_loan.data.each(function(d){\n        //更新预算已使用费用\n\n        action.DataAction.getWithDocumentPath0(d.budgetDocumentId,\"datatable\",function( json ){ \n            var datatable \u003d json.data; \n            datatable.data.each(function(item){\n                if(item.code \u003d\u003d\u003d d.loanBudgetCode){\n                    item.useMoney \u003d this.fixNumber(item.useMoney - d.loanCurAmount);\n                }\n            }.bind(this));\n            \n            datatable.total.useMoney \u003d this.fixNumber((parseFloat(datatable.total.useMoney) - d.loanCurAmount)) + \"\";\n\n            action.DataAction.updateWithDocument(d.budgetDocumentId,{\n                \"datatable\":datatable,\n                \"usedMoney\":datatable.total.useMoney\n            },function( json ){}.bind(this),null,false);\n\n\n        }.bind(this),null,false);\n\n        //记录费用使用明细\n        queryAction.TableAction.rowInsert(\"expenseBudget\",{\n            \"id\" : d.loanUUID,\n            \"job\": this.data.$work.job,\n            \"documentId\": d.budgetDocumentId,\n            \"loanNumber\" : d.loanNumber,\n            \"budget\": d.loanBudget,\n            \"budgetCode\": d.loanBudgetCode,\n            \"budgetDept\": d.loanBudgetDept,\n            \"budgetDeptCode\": d.loanBudgetDeptCode,\n            \"money\": this.fixNumber(d.loanCurAmount)*-1,\n            \"purpose\": \"还款\",\n            \"jobTime\": this.data.$work.startTime,\n            \"processName\": this.data.$work.processName,\n            \"person\": this.data.$work.creatorPerson,\n            \"department\": this.data.$work.creatorUnit,\n            \"serial\" : this.data.$work.serial\n        },function( json ){\n\n        }.bind(this),null,false);\n        //更新借款已还款\n\n        queryAction.TableAction.rowGet(\"expenseBudget\",d.loanId,function( json ){\n            json.data.useMoney \u003d json.data.useMoney?json.data.useMoney + d.loanCurAmount : d.loanCurAmount\n            queryAction.TableAction.rowUpdate(\"expenseBudget\",d.loanId,json.data,function( json ){\n\n            }.bind(this),null,false);            \n        }.bind(this),null,false);\n\n    }.bind(this));\n\n}.bind(this));\n\n",
          "dependScriptList": [],
          "creatorPerson": "admin@0dcf57f4-969c-4da9-912f-3e3b407e1780@P",
