          "data": "{\\\"json\\\":{\\\"id\\\":\\\"5af5e248-0757-4aae-9950-721bcb5684cb\\\",\\\"name\\\":\\\"发票信息\\\",\\\"type\\\":\\\"Form\\\",\\\"mode\\\":\\\"PC\\\",\\\"application\\\":\\\"2b9622c0-ac9d-46ac-bcad-4ff55bd001a5\\\",\\\"applicationName\\\":\\\"费控管理\\\",\\\"styles\\\":{\\\"background-color\\\":\\\"#fff\\\",\\\"height\\\":\\\"100%\\\"},\\\"cssLinks\\\":[],\\\"scriptSrc\\\":[],\\\"submitScript\\\":{\\\"code\\\":\\\"layout.mobile ? this.popupProcessorMobile() : this.popupProcessor();\\\"},\\\"formStyleType\\\":\\\"v10\\\",\\\"pid\\\":\\\"PC3392091a-fc23-46d1-89e3-ba6af2e5ca143392091a-fc23-46d1-89e3-ba6af2e5ca14\\\",\\\"isReadonly\\\":false,\\\"languageType\\\":\\\"none\\\",\\\"submitFormType\\\":\\\"default\\\",\\\"isHandwriting\\\":\\\"yes\\\",\\\"isPrompt\\\":true,\\\"promptPosition\\\":\\\"center\\\",\\\"afterProcessAction\\\":\\\"close\\\",\\\"subformList\\\":[],\\\"$version\\\":\\\"5.2\\\",\\\"category\\\":\\\"子表单\\\",\\\"moduleList\\\":{\\\"div_27\\\":{\\\"id\\\":\\\"div_27\\\",\\\"type\\\":\\\"Div\\\",\\\"defaultValue\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"moduleGroup\\\":\\\"default\\\",\\\"recoveryStyles\\\":{\\\"flex\\\":\\\"100%\\\"},\\\"isSaved\\\":true,\\\"pid\\\":\\\"PC3392091a-fc23-46d1-89e3-ba6af2e5ca14div_27\\\",\\\"preprocessing\\\":\\\"y\\\",\\\"moduleName\\\":\\\"div\\\",\\\"hideCannotRead\\\":\\\"inherit\\\"},\\\"div\\\":{\\\"id\\\":\\\"div\\\",\\\"type\\\":\\\"Div\\\",\\\"defaultValue\\\":{\\\"code\\\":\\\"\\\",\\\"html\\\":\\\"\\\"},\\\"properties\\\":{\\\"class\\\":\\\"form-content-area\\\"},\\\"moduleGroup\\\":\\\"O2OA UI\\\",\\\"recoveryStyles\\\":{\\\"padding\\\":\\\"1em\\\",\\\"display\\\":\\\"flex\\\",\\\"background-color\\\":\\\"#ffffff\\\",\\\"gap\\\":\\\"1em 2em\\\",\\\"flex-wrap\\\":\\\"wrap\\\",\\\"position\\\":\\\"relative\\\"},\\\"isSaved\\\":true,\\\"pid\\\":\\\"PCaaeda8b7-fd8e-49d6-b195-1f3b906e253ddiv\\\",\\\"templateType\\\":\\\"section\\\",\\\"preprocessing\\\":\\\"y\\\",\\\"moduleName\\\":\\\"div\\\