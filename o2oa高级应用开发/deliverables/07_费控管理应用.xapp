\":{\\\"success\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/ok.png\\\",\\\"error\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/error.png\\\",\\\"info\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/info.png\\\",\\\"warn\\\":\\\"../x_component_process_FormDesigner/Module/Form/notice/icon/notice.png\\\"},\\\"submitedDlgUseNotice\\\":true,\\\"submitedDlgStyle\\\":{\\\"style\\\":\\\"blue_flat_notice\\\",\\\"promptPosition\\\":\\\"center\\\",\\\"isTitle\\\":true,\\\"title\\\":\\\"提交成功\\\",\\\"width\\\":440,\\\"height\\\":\\\"auto\\\",\\\"promptCloseTime\\\":5,\\\"maxTitleLength\\\":30,\\\"isCountDown\\\":true,\\\"contentStyle\\\":{\\\"width\\\":\\\"340px\\\",\\\"margin-top\\\":\\\"0px\\\",\\\"margin-left\\\":\\\"0px\\\"}},\\\"errorStyle\\\":{\\\"node\\\":{\\\"height\\\":\\\"20px\\\",\\\"line-height\\\":\\\"20px\\\",\\\"margin-left\\\":\\\"20px\\\",\\\"color\\\":\\\"red\\\",\\\"word-break\\\":\\\"keep-all\\\"}},\\\"selectorStyle\\\":{\\\"style\\\":\\\"blue_flat_mobile\\\",\\\"width\\\":\\\"700\\\",\\\"height\\\":\\\"510\\\",\\\"hasLetter\\\":false,\\\"hasTop\\\":true,\\\"tabStyle\\\":\\\"blue_flat_mobile\\\",\\\"hasShuttle\\\":false,\\\"searchbarInTopNode\\\":false,\\\"hasSelectedSearchbar\\\":true,\\\"contentUrl\\\":\\\"../x_component_Selector/$Selector/blue_flat_mobile/selector.html\\\",\\\"injectToBody\\\":true,\\\"itemHeight\\\":44,\\\"flatCategory\\\":false,\\\"level1Indent\\\":0,\\\"indent\\\":14},\\\"addressStyle\\\":{\\\"style\\\":\\\"blue\\\",\\\"positionX\\\":\\\"left\\\"},\\\"comboxStyle\\\":{\\\"style\\\":\\\"default\\\",\\\"positionX\\\":\\\"left\\\"},\\\"css\\\":{\\\"code\\\":\\\".tabNodeContainerArea{\\\\n\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    margin: 0 10px;\\\\n}\\\"},\\\"isQuickSelect\\\":\\\"yes\\\"},\\\"html\\\":\\\"\u003cdiv mwftype\u003d\\\\\\\"form\\\\\\\" id\u003d\\\\\\\"e6f85009-32e0-430a-862c-1159ca0f724c\\\\\\\" class\u003d\\\\\\\"csse6f8500932e0430a862c1159ca0f724c\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003c/div\u003e\\\",\\\"isNewForm\\\":false}",
