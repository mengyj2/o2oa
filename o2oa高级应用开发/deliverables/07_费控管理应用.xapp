le\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-print\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e打印\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"publish\\\\\\\" title\u003d\\\\\\\"催促办理\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pressWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"催促办理\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-publish\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e催促办理\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"stop\\\\\\\" title\u003d\\\\\\\"待办挂起\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pauseTask\\\\\\\" mwfbuttontext\u003d\\\\\\\"挂起\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-stop\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e挂起\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-begin\\\\\\\" title\u003d\\\\\\\"从挂起状态恢复\\\\\\\" mwfbuttonaction\u003d\\\\\\\"resumeTask\\\\\\\" mwfbuttontext\u003d\\\\\\\"挂起恢复\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 1px solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: none;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-begin\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e挂起恢复\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"file_download\\\\\\\" title\u003d\\\\\\\"一键下载\\\\\\\" mwfbuttonaction\u003d\\\\\\\"downloadAll\\\\\\\" mwfbuttontext\u003d\\\\\\\"一键下载\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-file_download\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e一键下载\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"work-management\\\\\\\" title\u003d\\\\\\\"流程监控\\\\\\\" mwfbuttonaction\u003d\\\\\\\"monitor\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程监控\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-work-management\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e流程监控\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div\\\\\\\" style\u003d\\\\\\\"height: 100%; overflow: auto; position: relative; padding: 2em 0px 3em;\\\\\\\" class\u003d\\\\\\\"form-content\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_12\\\\\\\" style\u003d\\\\\\\"width: 80%; margin: auto; min-width: 42em; display: flex; flex-direction: column; gap: 2em;\\\\\\\" class\u003d\\\\\\\"form-area\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_2\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-title\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label\\\\\\\" style\u003d\\\\\\\"font-weight: normal; color: var(--oo-color-main-deep); text-align: center; font-size: 2.25em; padding: 0.3em;\\\\\\\" class\u003d\\\\\\\"form-title-text\\\\\\\"\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_1\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_1\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-content\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_2\\\\\\\" style\u003d\\\\\\\"padding: 0.8em 1em; font-size: 1.14286rem; background-color: rgb(255, 255, 255); font-weight: bold; box-shadow: rgb(222, 222, 222) 0px -1px 0px 0px inset; border-left: 4px solid var(--oo-color-main);\\\\\\\" class\u003d\\\\\\\"form-content-section\\\\\\\"\u003e基本信息\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"subform\\\\\\\" id\u003d\\\\\\\"subform\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_3\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-content\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_5\\\\\\\" style\u003d\\\\\\\"padding: 0.8em 1em; font-size: 1.14286rem; background-color: rgb(255, 255, 255); font-weight: bold; box-shadow: rgb(222, 222, 222) 0px -1px 0px 0px inset; border-left: 4px solid var(--oo-color-main);\\\\\\\" class\u003d\\\\\\\"form-content-section\\\\\\\"\u003e借款明细\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"subform\\\\\\\" id\u003d\\\\\\\"subform_1\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_7\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-content\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_6\\\\\\\" style\u003d\\\\\\\"padding: 0.8em 1em; font-size: 1.14286rem; background-color: rgb(255, 255, 255); font-weight: bold; box-shadow: rgb(222, 222, 222) 0px -1px 0px 0px inset; border-left: 4px solid var(--oo-color-main);\\\\\\\" class\u003d\\\\\\\"form-content-section\\\\\\\"\u003e付款方式\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"subform\\\\\\\" id\u003d\\\\\\\"subform_2\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_26_1\\\\\\\" style\u003d\\\\\\\"\\\\\\\" class\u003d\\\\\\\"form-content\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_7_1\\\\\\\" style\u003d\\\\\\\"padding: 0.8em 1em; font-size: 1.14286rem; background-color: rgb(255, 255, 255); font-weight: bold; box-shadow: rgb(222, 222, 222) 0px -1px 0px 0px inset; border-left: 4px solid var(--oo-color-main);\\\\\\\" class\u003d\\\\\\\"form-content-section\\\\\\\"\u003e借款相关材料\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_5_1\\\\\\\" style\u003d\\\\\\\"padding: 2em 3em; display: flex; background-color: rgb(255, 255, 255); gap: 1em 2em; flex-wrap: wrap; position: relative;\\\\\\\" class\u003d\\\\\\\"form-content-area\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"attachment