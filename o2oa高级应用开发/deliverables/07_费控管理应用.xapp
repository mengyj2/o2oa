e\\\":\\\"{{$.lp.resetTitle}}\\\",\\\"action\\\":\\\"resetWork\\\",\\\"text\\\":\\\"{{$.lp.reset}}\\\",\\\"id\\\":\\\"action_reset\\\",\\\"control\\\":\\\"allowReset\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"reset\\\",\\\"read\\\":false,\\\"system\\\":true},{\\\"type\\\":\\\"MWFToolBarButton\\\",\\\"img\\\":\\\"monitor.png\\\",\\\"title\\\":\\\"{{$.lp.monitorTitle}}\\\",\\\"action\\\":\\\"monitor\\\",\\\"text\\\":\\\"{{$.lp.monitor}}\\\",\\\"id\\\":\\\"action_monitor\\\",\\\"control\\\":\\\"\\\",\\\"condition\\\":\\\"\\\",\\\"icon\\\":\\\"work-management\\\",\\\"read\\\":true,\\\"system\\\":true}],\\\"actionIconType\\\":\\\"font\\\",\\\"selectorStyle\\\":{\\\"style\\\":\\\"v10\\\",\\\"tabStyle\\\":\\\"v10\\\"}},\\\"html\\\":\\\"\u003cdiv mwftype\u003d\\\\\\\"form\\\\\\\" id\u003d\\\\\\\"dc419afe-1691-4969-a089-ad560d0de5ca\\\\\\\" class\u003d\\\\\\\"form-layout\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv id\u003d\\\\\\\"actionbar_1\\\\\\\" mwftype\u003d\\\\\\\"actionbar\\\\\\\" class\u003d\\\\\\\"form-toolbar-area\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv class\u003d\\\\\\\"form-toolbar\\\\\\\" style\u003d\\\\\\\"background-color: rgb(255, 255, 255); padding: 0px 1em; border-radius: 0px; overflow-wrap: normal; word-break: keep-all; cursor: pointer; overflow: hidden; height: auto; display: flex; font-size: 1em; border-top: 0px; margin: 0px auto; border-bottom: 0px; flex-wrap: wrap; gap: 0.5em 0.3em;\\\\\\\"\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"close\\\\\\\" title\u003d\\\\\\\"关闭文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"closeWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"关闭\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-close\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e关闭\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"save\\\\\\\" title\u003d\\\\\\\"保存文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"saveWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"保存\\\\\\\" style\u003d\\\\\\\"display: flex; position: static; float: left; border: 0.071em solid rgb(204, 204, 204); color: inherit; background-color: rgb(255, 255, 255); height: 2.3em; margin-right: 8px; padding-left: 0.5em; padding-right: 0.5em; cursor: pointer; border-radius: 0.2em; align-items: baseline; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; padding: 0.5em 0.071em 0.071em; cursor: pointer; margin-right: 3px;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-save\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"display: block; float: left; height: 2.3em; padding-left: 0.142em; padding-right: 0.142em; line-height: 2.3em; cursor: pointer; color: rgb(0, 0, 0);\\\\\\\"\u003e保存\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-submit\\\\\\\" title\u003d\\\\\\\"继续流转文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"flowWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"继续流转\\\\\\\" style\u003d\\\\\\\"display: flex; position: sta