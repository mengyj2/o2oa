          "validated": true,
          "portal": "0c100445-8c40-4d05-a160-43c4956e555a",
          "text": "o3 \u003d this;\no3.loadCss \u003d function (name,node,callback) {\n    o2.Actions.load(\"x_portal_assemble_surface\").ScriptAction.getImported(o3.page.infor.portal,name,function( json ){ \n        var data \u003d json.data; \n        node.loadCssText(data.text, {\n            \"dom\": node\n        },function(){\n            if(callback) callback();\n        });\n    });\n};\no3.loadHtml \u003d function (name,op,callback) {\n    o2.Actions.load(\"x_portal_assemble_surface\").ScriptAction.getImported(o3.page.infor.portal,name,function( json ){ \n        var data \u003d json.data; \n        var html \u003d data.text;\n        o2.injectHtml(html,op); \n        if(callback) callback();\n    });\n};\no3.getHtml \u003d function (name,callback) {\n    o2.Actions.load(\"x_portal_assemble_surface\").ScriptAction.getImported(o3.page.infor.portal,name,function( json ){ \n        var data \u003d json.data; \n        var html \u003d data.text;\n        if(callback) callback(html);\n    });\n};\n\nthis.define(\"setWorkCount\",function(){\n    \n    this.Actions.load(\"x_query_assemble_surface\").StatementAction.execute( \"expense_task\", 1, 2000, {} ).then(function(json){\n        var data \u003d json.data;\n        var navi \u003d this.form.get(\u0027navi\u0027);\n        // debugger;\n        if (navi){\n            var naviNode \u003d navi.node;\n            if (naviNode \u0026\u0026 data.length\u003e0){\n                naviNode.getItem(\u0027fee_task\u0027).data.count \u003d data.length || 0;\n            }\n        }\n    }.bind(this));\n\n    \n})\n\nthis.page.addEvent(\"postLoad\",function(){\n    \n    //待办数量\n    this.setWorkCount();\n    \n}.bind(this))\n\n\nthis.define(\"searchTaskCenter\", function(isManager){\n\n    var viewer \u003d this.form.get(\"statement\").view;\n\n    var serial \u003d this.form.get(\"serial\").getData();\n    var process \u003d this.form.get(\"process\").getData();\n    var person \u003d this.data.person[0];\n    var start \u003d this.form.get(\"start\").getData();\n    var end \u003d this.form.get(\"end\").getData();\n    var activityName \u003d this.form.get(\"activityName\").getData();\n    var money1 \u003d this.form.get(\"money1\").getData();\n    var money2 \u003d this.form.get(\"money2\").getData();\n\n    var parameters \u003d {};\n\n\n    if(serial !\u003d\u003d\"\"){\n        parameters.serial \u003d \"%\" + serial + \"%\";\n    }\n    if(process !\u003d\u003d\"\"){\n        parameters.process \u003d process;\n    }\n    if(isManager){\n        if(person !\u003d\u003d\"\"){\n            parameters.creatorPerson \u003d person;\n        }\n    }\n    \n    if(activityName !\u003d\u003d\"\"){\n        parameters.activityName \u003d activityName;\n    }\n    if(start !\u003d\u003d\"\"){\n        parameters.beginDate \u003d start;\n    }\n    if(end !\u003d\u003d\"\"){\n        parameters.endDate \u003d end + \" 23:59:59\";\n    }\n    if(money1 !\u003d\u003d\"\"){\n        parameters.money1 \u003d money1;\n    }\n    if(money2 !\u003d\u003d\"\"){\n        parameters.money2 \u003d money2;\n    } \n\n    viewer.setFilter(null,parameters);\n})\n\n\nthis.define(\"searchProject\", function(){\n\n    var viewer \u003d this.form.get(\"statement\").view;\n\n    var filterList \u003d [];\n\n    var year \u003d this.form.get(\"s_year\").getData();\n    var name \u003d this.form.get(\"s_name\").getData();\n    var code \u003d this.form.get(\"s_code\").getData();\n    var companyName \u003d this.form.get(\"s_companyName\").getData();\n\n    if(year !\u003d\u003d\"\"){\n        filterList.push({\n            \"path\":\"o.longValue01\",\n            \"comparison\":\"\u003d\u003d\",\n            \"value\":parseInt(year),\n            \"formatType\":\"textValue\"\n        })\n    }\n\n    if(companyName !\u003d\u003d\"\"){\n\n        var companyNameArr \u003d companyName.split(\",\");\n\n        companyNameArr.each(function(d){\n            filterList.push({\n                \"path\":\"o.stringValue01\",\n                \"comparison\":\"\u003d\u003d\",\n                \"value\":d,\n                \"logic\":\"or\",\n                \"formatType\":\"textValue\"\n            })\n        })\n\n    }\n\n    if(name !\u003d\u003d\"\"){\n\n        var nameArr \u003d name.split(\",\");\n\n        nameArr.each(function(d){\n            filterList.push({\n                \"path\":\"o.title\",\n                \"comparison\":\"\u003d\u003d\",\n                \"value\":d,\n                \"logic\":\"or\",\n                \"formatType\":\"textValue\"\n            })\n        })\n\n\n    }\n\n    if(code !\u003d\u003d\"\"){\n        filterList.push({\n            \"path\":\"o.stringValue03\",\n            \"comparison\":\"like\",\n            \"value\": \"%\" + code + \"%\",\n            \"formatType\":\"textValue\"\n        })\n    }\n\n    viewer.setFilter(filterList);\n})\n\nthis.define(\"searchBudget\", function(){\n\n    \n    var viewer \u003d this.form.get(\"statement\").view;\n\n    var filterList \u003d [];\n\n    var name \u003d this.form.get(\"s_name\").getData();\n\n    if(name !\u003d\u003d\"\"){\n        filterList.push({\n            \"path\":\"o.title\",\n            \"comparison\":\"\u003d\u003d\",\n            \"value\":name,\n            \"formatType\":\"textValue\"\n        })\n    }\n\n    viewer.setFilter(filterList);\n})\n\n\nthis.define(\"resetTaskCenterInput\", function(statement){\n    [\"serial\", \"process\", \"person\", \"start\", \"end\", \"activityName\",\"money1\",\"money2\"].each(function(name){\n        if(this.form.get(name))this.form.get(name).setData(\"\");\n    }.bind(this))\n    this.form.get(statement).reload();\n})\n\nthis.define(\"resetProjectInput\", function(statement){\n    [\"s_year\", \"s_name\", \"s_code\", \"s_companyName\"].each(function(name){\n        if(this.form.get(name))this.form.get(name).setData(\"\");\n    }.bind(this))\n    this.form.get(statement).reload();\n})\n\n\nthis.define(\"hasPermission\", function( roleList ){\n    return this.hasCommonValues(layout.user.roleList,roleList);\n}.bind(this));\n\n\n//遍历第一个数组，并检查每个元素是否存在于第二个数组中\nthis.define(\"hasCommonValues\", function( arr1, arr2 ){\n    return arr1.filter(value \u003d\u003e arr2.includes(value)).length \u003e 0; \n}.bind(this));\n",
          "dependScriptList": [],
