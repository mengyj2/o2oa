          "data": "SELECT o FROM Review o where o.applicationAlias \u003d \u0027expense\u0027 and o.creatorPerson\u003d:person",
          "countData": "SELECT count(o.id) FROM Review o",
          "sql": "SELECT xjob,xtitle,xstartTime,xcreatorPerson,xcreatorUnit,xprocess,xprocessName,xapplicationAlias,xserial,xactivityName,xdoubleValue01 FROM PP_C_TASK \n\nwhere xapplicationAlias \u003d \u0027expense\u0027  and xperson \u003d :person\n\norder by xstartTime desc ",
          "sqlScriptText": "var paramObj \u003d  parameters || {};\r\nvar sql;\r\n\r\nsql \u003d \u0027SELECT xjob as \"xjob\",xtitle as \"xtitle\",xstartTime as \"xstartTime\",xcreatorPerson as \"xcreatorPerson\",xcreatorUnit as \"xcreatorUnit\",xprocess as \"xprocess\",xprocessName as \"xprocessName\",xapplicationAlias as \"xapplicationAlias\",xserial as \"xserial\",xactivityName as \"xactivityName\",xdoubleValue01 as \"xdoubleValue01\" FROM PP_C_TASK\u0027;\r\nsql +\u003d \" where xapplicationAlias \u003d \u0027expense\u0027 and xperson \u003d :person\"\r\n\r\nif(paramObj.serial \u0026\u0026 paramObj.serial!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xserial like :serial\"\r\n}\r\nif(paramObj.creatorPerson \u0026\u0026 paramObj.creatorPerson!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xcreatorPerson \u003d :creatorPerson\"\r\n}\r\nif(paramObj.processName \u0026\u0026 paramObj.processName!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xprocessName \u003d :processName\"\r\n}\r\nif(paramObj.process \u0026\u0026 paramObj.process!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xprocess \u003d :process\"\r\n}\r\nif(paramObj.activityName \u0026\u0026 paramObj.activityName!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xactivityName \u003d :activityName\"\r\n}\r\n\r\nif(paramObj.beginDate \u0026\u0026 paramObj.beginDate!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xstartTime \u003e\u003d :beginDate\"\r\n}\r\n\r\nif(paramObj.endDate \u0026\u0026 paramObj.endDate!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xstartTime \u003c\u003d :endDate\"\r\n}\r\n\r\nif(paramObj.money1 \u0026\u0026 paramObj.money1!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xdoubleValue01 \u003e\u003d :money1\" \r\n}\r\n\r\nif(paramObj.money2 \u0026\u0026 paramObj.money2!\u003d\u003d\"\"){\r\n    sql +\u003d \" and xdoubleValue01 \u003c\u003d :money2\" \r\n}\r\n\r\nsql +\u003d \" order by xstartTime desc \";\r\n\r\nprint(\"sql\u003d\u003d\u003d\u003d\"+sql)\r\nreturn sql;\r\n  ",
