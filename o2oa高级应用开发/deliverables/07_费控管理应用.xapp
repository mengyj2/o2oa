      "scriptList": [
        {
          "id": "80b9ebf4-7a75-4f32-b052-120b187da5ea",
          "name": "implement",
          "alias": "",
          "description": "代码重写",
          "validated": true,
          "application": "2b9622c0-ac9d-46ac-bcad-4ff55bd001a5",
          "text": "MWF.APPForm.implement({\n    saveFormDataInstance2: function (callback, failure, history, data, issubmit) {\n\n        var data \u003d data || this.getData(issubmit);\n\n        this.modifedData \u003d {};\n        this.setModifedData(data);\n\n       o2.Actions.load(\"x_processplatform_assemble_surface\").DataAction.updateWithJob(this.businessData.work.job,this.modifedData,function( json ){ \n            if(callback)callback();\n        }.bind(this),null);\n    }\n})\n\nMWF.xDesktop.requireApp(\"process.Xform\", \"Datatable\", null, false);\n\n    MWF.xApplication.process.Xform.Datatable.implement({\n        _loadTotal: function(){\n            var totalData \u003d {};\n            if (!this.totalFlag)return totalData;\n\n            if(layout.mobile){\n                if (!this.totalDiv) this._loadTotalTr();\n            }else{\n                if (!this.totalTr) this._loadTotalTr();\n            }\n\n\n            var data;\n            if( this.isShowAllSection ){\n                data \u003d { data : [] };\n                Object.each( this.getBusinessDataById(), function (d, key) {\n                    if( ![\"data\",\"total\"].contains(key) ){\n                        data.data \u003d data.data.concat( d.data )\n                    }\n                })\n            }else if( this.isMergeRead ){\n                data \u003d this.data;\n            }else{\n                data \u003d this.getValue();\n            }\n            this.totalColumns.each(function(column, index){\n                var json \u003d column.moduleJson;\n                if(!json)return;\n\n                var pointLength \u003d 0; //小数点后的最大数位\n                var tmpV;\n                if (column.type \u003d\u003d\u003d \"count\"){\n                    tmpV \u003d data.data.length;\n                }else if(column.type \u003d\u003d\u003d \"number\"){\n                    tmpV \u003d new Decimal(0);\n                    for (var i\u003d0; i\u003cdata.data.length; i++){\n                        var d \u003d data.data[i];\n                        if(d[json.id]){\n                            tmpV \u003d tmpV.plus(d[json.id].toFloat() || 0);\n                            var v \u003d d[json.id].toString();\n                            if( v.indexOf(\".\") \u003e -1 ){\n                                pointLength \u003d Math.max(pointLength, v.split(\".\")[1].length);\n                            }\n                        }\n                    }\n                }\n\n                if( isNaN( tmpV ) ){\n                    totalData[json.id] \u003d \"\";\n                    column.td.set(\"text\", \"\" );\n                }else{\n                    if( pointLength \u003e 0 \u0026\u0026 tmpV.toString() !\u003d\u003d \"0\" ){\n                        var s \u003d tmpV.toString();\n                        if( s.indexOf(\".\") \u003e -1 ){\n                            var length \u003d s.split(\".\")[1].length;\n                            if( length \u003c pointLength ){\n                                totalData[json.id] \u003d s + \"0\".repeat(pointLength-length);\n                            }else{\n                                totalData[json.id] \u003d s;\n                            }\n                        }else{\n                            totalData[json.id] \u003d s +\".\"+ \"0\".repeat(pointLength)\n                        }\n                    }else{\n                        totalData[json.id] \u003d tmpV.toString();\n                    }\n                    column.td.set(\"text\", this.formatRMBAmount(totalData[json.id]) );\n                }\n            }.bind(this));\n            data.total \u003d totalData;\n            return totalData;\n        },\n        formatRMBAmount : function(amount){\n            const amountStr \u003d Number(amount).toFixed(2);\n            const [integerPart, decimalPart] \u003d amountStr.split(\u0027.\u0027);\n            let formattedAmount \u003d \u0027\u0027;\n            let count \u003d 0;\n            for (let i \u003d integerPart.length - 1; i \u003e\u003d 0; i--) {\n                formattedAmount \u003d integerPart.charAt(i) + formattedAmount;\n                count++;\n                if (count \u003d\u003d\u003d 3 \u0026\u0026 i !\u003d\u003d 0) {\n                    formattedAmount \u003d \u0027,\u0027 + formattedAmount;\n                    count \u003d 0;\n                }\n            }\n            formattedAmount +\u003d \u0027.\u0027 + decimalPart;\n            formattedAmount \u003d \u0027￥\u0027 + formattedAmount;\n            return formattedAmount;\n        },\n    })\n\nMWF.APPNumber.implement({\n    formatRMBAmount : function(amount){\n        const amountStr \u003d Number(amount).toFixed(2);\n        const [integerPart, decimalPart] \u003d amountStr.split(\u0027.\u0027);\n        let formattedAmount \u003d \u0027\u0027;\n        let count \u003d 0;\n        for (let i \u003d integerPart.length - 1; i \u003e\u003d 0; i--) {\n            formattedAmount \u003d integerPart.charAt(i) + formattedAmount;\n            count++;\n            if (count \u003d\u003d\u003d 3 \u0026\u0026 i !\u003d\u003d 0) {\n                formattedAmount \u003d \u0027,\u0027 + formattedAmount;\n                count \u003d 0;\n            }\n        }\n        formattedAmount +\u003d \u0027.\u0027 + decimalPart;\n        formattedAmount \u003d \u0027￥\u0027 + formattedAmount;\n        return formattedAmount;\n    },\n    __setValue: function(value){\n\n        var v \u003d this.isNumber( value ) ? parseFloat(value) : value;\n        this._setBusinessData(v);\n        var val \u003d value;\n        if( this.json.emptyValue \u003d\u003d\u003d \"string\" ){\n            if( typeOf(v)\u003d\u003d\u003d\"null\" )val \u003d \"\";\n            if( v \u003d\u003d\u003d 0 )val \u003d \"0\";\n        }else{\n            if( v \u003d\u003d\u003d 0 || v \u003d\u003d\u003d \"\" || typeOf(v)\u003d\u003d\u003d\"null\" )val \u003d \"0\";\n        }\n\n        if (this.node.getFirst()) this.node.getFirst().set(\"value\", value || val);\n\n        if (this.isReadonly()) {\n\n            if(this.node.get(\"class\") \u003d\u003d\u003d \"money\"){\n                this.node.set(\"text\", this.formatRMBAmount(value || val)) ;\n            }else{\n                this.node.set(\"text\", value || val) ;\n            }\n        }\n\n        this.moduleValueAG \u003d null;\n        this.fieldModuleLoaded \u003d true;\n\n        return value;\n    },\n})\n\n\nMWF.xDesktop.requireApp(\"query.Query\", \"Viewer\", null, false);\nMWF.xApplication.query.Query.Viewer.Item.implement({\n    load: function(){\n        \n        if( this.lazy \u0026\u0026 this.view.io ){\n            this.view.fireEvent(\"queryLoadItemRow\", [this]);\n            this.loadNode();\n            this.view.io.observe( this.node );\n        }else{\n            this._load();\n        }\n        this.node.getElements(\".money\").each(function(td){\n            td.set(\"text\",this.formatRMBAmount(td.get(\"text\")));\n        }.bind(this));\n    },\n    formatRMBAmount : function(amount){\n        const amountStr \u003d Number(amount).toFixed(2);\n        const [integerPart, decimalPart] \u003d amountStr.split(\u0027.\u0027);\n        let formattedAmount \u003d \u0027\u0027;\n        let count \u003d 0;\n        for (let i \u003d integerPart.length - 1; i \u003e\u003d 0; i--) {\n            formattedAmount \u003d integerPart.charAt(i) + formattedAmount;\n            count++;\n            if (count \u003d\u003d\u003d 3 \u0026\u0026 i !\u003d\u003d 0) {\n                formattedAmount \u003d \u0027,\u0027 + formattedAmount;\n                count \u003d 0;\n            }\n        }\n        formattedAmount +\u003d \u0027.\u0027 + decimalPart;\n        formattedAmount \u003d \u0027￥\u0027 + formattedAmount;\n        return formattedAmount;\n    }\n})",
          "dependScriptList": [],
          "creatorPerson": "admin@0dcf57f4-969c-4da9-912f-3e3b407e1780@P",
          "lastUpdatePerson": "admin@0dcf57f4-969c-4da9-912f-3e3b407e1780@P",
          "lastUpdateTime": "2023-11-30 16:07:54",
