              "script": "",
              "scriptText": "var dn = this.workContext.getWork().creatorIdentityDn;\nvar unit = this.org.getUnitByIdentity(dn);\nif (unit && unit.length && !unit.name) { unit = unit[0]; }\nvar unitName = (unit && unit.name) ? unit.name : '';\nvar mgrList = unitName ? this.org.getDuty('部门负责人', unitName) : [];\nvar gmList = this.org.getDuty('秘书长', '中国复合材料工业协会');\nvar mgrDn = (mgrList && mgrList.length) ? mgrList[0].distinguishedName : '';\nvar gmDn = (gmList && gmList.length) ? gmList[0].distinguishedName : '';\nreturn (mgrDn === '' || mgrDn === gmDn);",
