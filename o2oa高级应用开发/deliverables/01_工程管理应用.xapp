 transition: opacity 0.3s;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.ooicon-create:hover {\\\\r\\\\n    opacity: 0.8;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 自定义布局样式 *************************/\\\\r\\\\n.page-custom-layout {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 60em;\\\\r\\\\n    right: -60em;\\\\r\\\\n    padding: 2em;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: auto;\\\\r\\\\n}\\\\r\\\\n.page-custom-layout-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-widget {\\\\r\\\\n    background-color: #ffffff;\\\\r\\\\n    box-shadow: -2px 0 8px 0 var(--oo-color-gray-d);\\\\r\\\\n    position: absolute;\\\\r\\\\n    z-index: 20000;\\\\r\\\\n    top: 0;\\\\r\\\\n    height: 100%;\\\\r\\\\n    width: 30em;\\\\r\\\\n    right: -30em;\\\\r\\\\n    padding: 2em 0;\\\\r\\\\n    display: flex;\\\\r\\\\n    flex-direction: column;\\\\r\\\\n    transition: right 0.2s;\\\\r\\\\n    gap: 1em;\\\\r\\\\n    overflow: hidden;\\\\r\\\\n}\\\\r\\\\n.page-custom-widget-show {\\\\r\\\\n    right: 0;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n.page-custom-title {\\\\r\\\\n    display: flex;\\\\r\\\\n    font-size: 1.125rem;\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n    align-items: center;\\\\r\\\\n    justify-content: space-between;\\\\r\\\\n    padding: 0 2em;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n    cursor: pointer;\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-title\u003e.ooicon-close:hover {\\\\r\\\\n    color: var(--oo-color-text);\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n.page-custom-description {\\\\r\\\\n    font-size: 1rem;\\\\r\\\\n    color: var(--oo-color-text3);\\\\r\\\\n  