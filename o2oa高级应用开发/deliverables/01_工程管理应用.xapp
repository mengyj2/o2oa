ne-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e增加分支\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"retract\\\\\\\" title\u003d\\\\\\\"待办撤回\\\\\\\" mwfbuttonaction\u003d\\\\\\\"retractWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"撤回\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-retract\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e撤回\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-rollback\\\\\\\" title\u003d\\\\\\\"回溯到指定的环节，不保留流程记录\\\\\\\" mwfbuttonaction\u003d\\\\\\\"rollback\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程回溯\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-rollback\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e流程回溯\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"delete\\\\\\\" title\u003d\\\\\\\"删除文件\\\\\\\" mwfbuttonaction\u003d\\\\\\\"deleteWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"删除文档\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-delete\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e删除文档\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-end\\\\\\\" title\u003d\\\\\\\"结束文件流转\\\\\\\" mwfbuttonaction\u003d\\\\\\\"terminate\\\\\\\" mwfbuttontext\u003d\\\\\\\"终止文件\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-end\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e终止文件\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"print\\\\\\\" title\u003d\\\\\\\"打印文档\\\\\\\" mwfbuttonaction\u003d\\\\\\\"printWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"打印\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-print\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e打印\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"publish\\\\\\\" title\u003d\\\\\\\"催促办理\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pressWork\\\\\\\" mwfbuttontext\u003d\\\\\\\"催促办理\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-publish\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e催促办理\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"stop\\\\\\\" title\u003d\\\\\\\"待办挂起\\\\\\\" mwfbuttonaction\u003d\\\\\\\"pauseTask\\\\\\\" mwfbuttontext\u003d\\\\\\\"挂起\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-stop\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e挂起\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"process-begin\\\\\\\" title\u003d\\\\\\\"从挂起状态恢复\\\\\\\" mwfbuttonaction\u003d\\\\\\\"resumeTask\\\\\\\" mwfbuttontext\u003d\\\\\\\"挂起恢复\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 0.071em solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: rgb(230, 230, 230) 0px 0px 0px 0px; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-process-begin\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e挂起恢复\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"file_download\\\\\\\" title\u003d\\\\\\\"一键下载\\\\\\\" mwfbuttonaction\u003d\\\\\\\"downloadAll\\\\\\\" mwfbuttontext\u003d\\\\\\\"一键下载\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 0.2em; box-shadow: none; color: inherit; cursor: pointer; display: flex; float: left; height: 2.3em; padding-left: 0.5em; padding-right: 0.5em; position: static;\\\\\\\"\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; margin-right: 3px; padding: 0.5em 0.071em 0.071em;\\\\\\\"\u003e\u003cspan class\u003d\\\\\\\"ooicon-file_download\\\\\\\" style\u003d\\\\\\\"display: block;\\\\\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\\\\\\\"cursor: pointer; display: block; float: left; height: 2.3em; line-height: 2.3em; padding-left: 0.142em; padding-right: 0.142em;\\\\\\\"\u003e一键下载\u003c/span\u003e\u003c/div\u003e\u003cdiv mwfnodetype\u003d\\\\\\\"MWFToolBarButton\\\\\\\" mwfbuttonimage\u003d\\\\\\\"\\\\\\\" mwfbuttonicon\u003d\\\\\\\"work-management\\\\\\\" title\u003d\\\\\\\"流程监控\\\\\\\" mwfbuttonaction\u003d\\\\\\\"monitor\\\\\\\" mwfbuttontext\u003d\\\\\\\"流程监控\\\\\\\" style\u003d\\\\\\\"align-items: baseline; background-c